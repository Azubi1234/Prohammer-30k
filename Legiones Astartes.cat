d="r41-unit-x-0-medusan-immortal-squad-opt-5-nuncio-vox-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-x-0-medusan-immortal-squad-opt-5-context" hidden="false"><ns0:description>• One different model may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Frag grenades (base unit; +1 pts/model)" hidden="false" id="r41-unit-x-0-medusan-immortal-squad-opt-6-frag-grenades"><ns0:constraints><ns0:constraint id="r41-unit-x-0-medusan-immortal-squad-opt-6-frag-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-x-0-medusan-immortal-squad-opt-6-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-x-0-medusan-immortal-squad-opt-6-squadwide" hidden="false"><ns0:description>The source prices this option at +1 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-x-0-medusan-immortal-squad-opt-7-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-x-0-medusan-immortal-squad-opt-7-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-x-0-medusan-immortal-squad-opt-7-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-x-0-medusan-immortal-squad-opt-7-squadwide" hidden="false"><ns0:description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="GORGON TERMINATOR SQUAD" hidden="false" id="r41-unit-x-1-gorgon-terminator-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="250" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-x-1-gorgon-terminator-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Gorgon Terminator" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-1-gorgon-terminator-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Gorgon Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-1-gorgon-terminator-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-x-1-gorgon-terminator-squad-source" hidden="false"><ns0:description>Gorgon Terminator | 4 | 4 | 4 | 4 | 1 | 3 | 2 | 9 | 2+/5+
Gorgon Sergeant | 5 | 4 | 4 | 4 | 1 | 3 | 3 | 9 | 2+/4+
Force Organisation:
• Elites
GORGON-PATTERN TERMINATOR ARMOUR Gorgon-pattern Terminator Armour follows all normal rules for Terminator Armour. It therefore provides a 2+ Armour Save and 5+ Invulnerable Save, and grants Relentless, Bulky and Deep Strike. Models wearing Gorgon-pattern Terminator Armour may not Pursue. GORGON FIELD If one or more models in the unit successfully pass an Invulnerable Save against shooting from an enemy unit, resolve all of that enemy unit's attacks before applying this rule. The attacking unit must then take an Initiative test. If the test is failed, it is affected by the normal ProHammer Blind rule until the end of its next turn. A unit may only be required to take one Gorgon Field test per phase.
Unit Composition:
• 4 Gorgon Terminators
• 1 Gorgon Sergeant
Unit Type:
• Infantry
• The Gorgon Sergeant is a Character
Wargear — Gorgon Terminators:
• Gorgon-pattern Terminator Armour
• Bionics
• Storm bolter
• Power weapon
Wargear — Gorgon Sergeant:
• Gorgon-pattern Terminator Armour
• Bionics
• Storm bolter
• Thunder hammer
• Iron Halo
Special Rules:
• Legiones Astartes (Iron Hands)
• Fearless
• Gorgon Field
OPTIONS
• The squad may include up to five additional Gorgon Terminators for +45 points per model.
• Any Gorgon Terminator may replace his Storm bolter with:
• Foeblaster Boltgun .............................. Free
• Combi-flamer .................................. +10 points
• Combi-volkite charger ........................ +10 points
• Combi-meltagun ............................... +15 points
• Combi-plasma gun ............................. +15 points
• Any Gorgon Terminator may replace his Power weapon with:
• Power fist ...................................... +5 points
• Lightning claw ................................. +5 points
• Chainfist ...................................... +10 points
• Any Gorgon Terminator may replace his Storm bolter and Power weapon with:
• Pair of Lightning Claws ....................... +10 points
• Up to two Gorgon Terminators may replace their Storm bolter with:
• Heavy Flamer .................................. +10 points
• Plasma Blaster ................................ +15 points
• Graviton Gun .................................. +15 points
• The Gorgon Sergeant may take:

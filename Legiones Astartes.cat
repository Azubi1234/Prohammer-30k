            <constraint id="da22-cen-orders-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Augurs of Weakness" hidden="false" id="da22-order-augurs">
              <constraints>

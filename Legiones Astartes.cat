characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Poison-master" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiv-2-mortus-poisoner-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiv-2-mortus-poisoner-squad-source" hidden="false"><ns0:description>Mortus Poisoner | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+
Poison-master | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Elites
DESTROYER CADRE The Mortus Poisoners use the normal Destroyer Cadre rule from the Legiones Astartes Army List.
Unit Composition:
• 4 Mortus Poisoners
• 1 Poison-master
Unit Type:
• Infantry
• The Poison-master is a Character
Wargear:
• Power Armour
• Alchem Flamer
• Bolt pistol
• Chainsword
• Frag grenades
• Rad grenades
Special Rules:
• Legiones Astartes (Death Guard)
• Counter-Attack
• Destroyer Cadre
OPTIONS
• The squad may include up to five additional Mortus Poisoners for +20 points per model.
• For every five models in the squad, one Mortus Poisoner may take:
• Phosphex Bomb .................................. +10 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
POISON-MASTER
The Poison-master may replace his Chainsword with:
• Rending Weapon .................................... +5 points
• Power weapon ..................................... +10 points
• Power fist ....................................... +15 points
The Poison-master may take:
• Artificer Armour ................................. +10 points
• Up to three Phosphex Bombs ...................... +10 points each
The Poison-master may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xiv-2-mortus-poisoner-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xiv-2-mortus-poisoner-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xiv-2-mortus-poisoner-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +20 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xiv-2-mortus-poisoner-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Phosphex Bomb" hidden="false" id="r41-unit-xiv-2-mortus-poisoner-squad-opt-0-phosphex-bomb"><ns0:constraints><ns0:constraint id="r41-unit-xiv-2-mortus-poisoner-squad-opt-0-phosphex-bomb-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiv-2-mortus-poisoner-squad-opt-0-context" hidden="false"><ns0:description>• For every five models in the squad, one Mortus Poisoner may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r
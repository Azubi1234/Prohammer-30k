me="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xx-3-effrit-disruption-cadre-source" hidden="false"><ns0:description>Effrit Disruptor | 4 | 5 | 4 | 4 | 1 | 4 | 1 | 8 | 3+
Effrit Principal | 4 | 5 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Elites
HYDRA'S WAIL Enemy units with at least one model within 12" of an Effrit Disruption Cadre suffer -1 Leadership when taking Pinning tests. In addition, enemy Nuncio Voxes and Teleport Homers may not be used while their bearer is within 12" of an Effrit model.
Unit Composition:
• 4 Effrit Disruptors
• 1 Effrit Principal
Unit Type:
• Infantry
• Effrit Principal is a Character
Wargear:
• Power Armour
• Bolter with Banestrike Ammunition
• Bolt pistol
• Close-combat weapon
• Frag grenades
Special Rules:
• Legiones Astartes (Alpha Legion)
• Infiltrate
• Move Through Cover
• Hydra's Wail
OPTIONS
• The squad may include up to five additional Effrit Disruptors for +25 points per model.
• Any model may take:
• Power Dagger ................................. +5 points
• Melta bombs .................................. +5 points
• For every five models, one Effrit may replace his Bolter with:
• M.40 Targeter and Stalker Bolter ............ +10 points
• Meltagun ..................................... +10 points
• Plasma Gun ................................... +15 points
• The Effrit Principal may take:
• Artificer Armour ............................ +10 points
• Venom Spheres ................................ +5 points
• The Effrit Principal may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xx-3-effrit-disruption-cadre-additional"><ns0:constraints><ns0:constraint id="r41-unit-xx-3-effrit-disruption-cadre-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xx-3-effrit-disruption-cadre-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +25 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xx-3-effrit-disruption-cadre-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Power Dagger" hidden="false" id="r41-unit-xx-3-effrit-disruption-cadre-opt-0-power-dagger"><ns0:constraints><ns0:constraint id="r41-unit-xx-3-effrit-disruption-cadre-opt-0-power-dagger-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xx-3-effrit-disruption-cadre-opt-0-context" hidden="false"><ns0:description>• Any model may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="r41-unit-xx-3-effrit-disruption-cadre-opt-1-melta-bombs"><ns0:cons
• The Legion Overseer may replace his close combat weapon with one of the following:
• Power weapon ................................ +10 points
• Power fist ........................................ +15 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvii-0-covenant-zealot-mob-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r41-unit-xvii-0-covenant-zealot-mob-opt-0-power-weapon"><ns0:constraints><ns0:constraint id="r41-unit-xvii-0-covenant-zealot-mob-opt-0-power-weapon-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-0-covenant-zealot-mob-opt-0-context" hidden="false"><ns0:description>• The Legion Overseer may replace his close combat weapon with one of the following:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power fist" hidden="false" id="r41-unit-xvii-0-covenant-zealot-mob-opt-1-power-fist"><ns0:constraints><ns0:constraint id="r41-unit-xvii-0-covenant-zealot-mob-opt-1-power-fist-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-0-covenant-zealot-mob-opt-1-context" hidden="false"><ns0:description>• The Legion Overseer may replace his close combat weapon with one of the following:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="GAL VORBAK DARK BRETHREN" hidden="false" id="
              <ns0:entryLink id="r40-da-vow-terminator-r39-phosphex-terminator-sgt-armoury" name="Phosphex Bomb (Destroyer Company)" type="selectionEntry" targetId="gear-phosphex-bomb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-vow-terminator-r39-phosphex-terminator-sgt-armoury-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-destroyer" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="r40-da-vow-terminator-terminator-sgt-halo">
                  <ns0:constraints>
                    <ns0:constraint id="r40-da-vow-terminator-terminator-sgt-halo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="25" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Iron Halo" id="r40-da-vow-terminator-terminator-sgt-halo-rule" hidden="false">
                      <ns0:description>4+ Invulnerable Save; normally no more than one Iron Halo may be selected in an army.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
                <ns0:selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="r40-da-vow-terminator-terminator-sgt-mastercraft">
                  <ns0:constraints>
                    <ns0:constraint id="r40-da-vow-terminator-terminator-sgt-mastercraft-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Master-crafted Weapon" id="r40-da-vow-terminator-terminator-sgt-mastercraft-rule" hidden="false">
                      <ns0:description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
                <ns0:selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="r40-da-vow-terminator-terminator-sgt-signum">
                  <ns0:constraints>
                    <ns0:constraint id="r40-da-vow-terminator-terminator-sgt-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Signum" id="r40-da-vow-terminator-terminator-sgt-signum-rule" hidden="false">
                      <ns0:description>Once per friendly Shooting phase, the unit may re-roll one failed shooting To Hit roll. A unit may benefit from only one Signum per Shooting phase.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
              </ns0:selectionEntries>
              <ns0:rules>
                <ns0:rule name="Terminator Armoury Restrictions" id="r40-da-vow-terminator-terminator-sgt-arm-rule" hidden="false">
                  <ns0:description>Only equipment permitted for a model wearing Terminator Armour is shown. Unit-specific weapon replacements and the Grenade Harness are not duplicated here. No item may be selected more than once unless specifically permitted.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntryGroup>
          </ns0:selectionEntryGroups>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Dedicated Transport" id="r40-da-vow-terminator-terminator-transport" hidden="false">
          <ns0:constraints>

                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Poisoned (3+), Crawling Fire, Lingering Death</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Phosphex Canister Shot — requires Siege Breaker" id="hs-aa-phosphex-rule" hidden="false">
                  <description>May only be selected if the army contains a Siege Breaker or another rule specifically granting access to Phosphex ammunition.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hs-achilles-alpha" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-hs-achilles-alpha-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-hs-achilles-alpha-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-hs-achilles-alpha-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hs-achilles-alpha-0">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-hs-achilles-alpha-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hs-achilles-alpha-1">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-hs-achilles-alpha-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hs-achilles-alpha-2">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-hs-achilles-alpha-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hs-achilles-alpha-3">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-hs-achilles-alpha-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hs-achilles-alpha-4">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-hs-achilles-alpha-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hs-achilles-alpha-5">
              <constraints>
                <constraint id="da-wing-hs-achilles-alpha-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-hs-achilles-alpha-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" name="Leviathan Siege Dreadnought" id="hs-leviathan" hidden="false" import="true">
      <categoryLinks>
        <categoryLink targetId="cat-heavy" id="hs-leviathan-cat" primary="true" name="Heavy Support" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="270" />
      </costs>
      <profiles>
        <profile name="Leviathan Siege Dreadnought" id="hs-leviathan-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">8</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">13</characteristic>
            <characteristic name="Rear" typeId="walker-rear">12</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">4</characteristic>
          </characteristics>
        </profile>
        <profile name="Meltagun" id="hs-lev-melta-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1, Melta</characteristic>
          </characteristics>
        </profile>
        <profile name="Heavy Flamer" id="hs-lev-hf-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">Template</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hs-lev-wg" hidden="false">
          <description>Two Leviathan Siege Claws, each with an inbuilt Meltagun; two Heavy Flamers; Extra Armour; Frag grenades; Searchlight; Smoke Launchers.</description>
        </rule>
        <rule name="Reinforced Atomantic Shielding" id="hs-lev-shield" hidden="false">
          <description>Each time the Leviathan suffers a Glancing or Penetrating Hit, on a 4+ the hit is ignored, before rolling on the Vehicle Damage table. If it suffers an Explodes! result, increase the Strength of the explosion by D3 and its radius by D3".</description>
        </rule>
        <rule name="Crushing Charge" id="hs-lev-charge" hidden="false">
          <description>On a turn in which the Leviathan charges, it may resolve two of its normally allowed close-combat attacks at Initiative 10 instead of only one as normally permitted by Hammer of Wrath.</description>
        </rule>
        <rule name="Move Through Cover" id="hs-lev-mtc" hidden="false">
          <description>Uses the normal ProHammer Move Through Cover rule.</description>
        </rule>
        <rule name="Leviathan Siege Claw" id="hs-lev-claw-rule" hidden="false">
          <description>Counts as a Dreadnought Close Combat Weapon.</description>
        </rule>
        <rule name="Leviathan Siege Drill" id="hs-lev-drill-rule" hidden="false">
          <description>Counts as a Dreadnought Close Combat Weapon with Armourbane.</description>
        </rule>
        <rule name="Arm Replacement and Attacks" id="hs-lev-arms-rule" hidden="false">
          <description>Either Siege Claw and its Meltagun may be replaced by a ranged weapon. For each Siege Claw replaced by a ranged weapon, reduce the Leviathan’s Attacks characteristic by 1.</description>
        </rule>
        <rule name="Graviton Collapse" id="hs-lev-grav-collapse" hidden="false">
          <description>Against non-vehicle models hit by a Grav-flux Bombard, roll 2D6; if the result is greater than the model’s Strength it suffers a wound. Against vehicles, do not use the normal ProHammer Graviton rule; instead roll 3D6 for Armour Penetration.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Arm A" id="hs-lev-arm-a" hidden="false">
          <constraints>
            <constraint id="hs-lev-arm-a-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="hs-lev-arm-a-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>

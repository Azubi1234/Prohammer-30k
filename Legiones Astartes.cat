            <ns0:characteristic name="S" typeId="ranged-s">X</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Poisoned (2+)</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Kraken Bolts" id="r40-da-serpent-seeker-fa-seeker-ammo-2" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">

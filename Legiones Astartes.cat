    <ns0:selectionEntry type="upgrade" name="Flamestorm Cannon" hidden="false" id="hsgear-flamestorm" import="true">
      <ns0:profiles><ns0:profile name="Flamestorm Cannon" id="r29-prof-flamestorm" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules>
        <ns0:rule name="Flamestorm Cannon" id="hsgear-flamestorm-rule" hidden="false">
          <ns0:description>Use the weapon profile shown above.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" name="Demolisher Cannon" hidden="false" id="hsgear-demolisher" import="true">
      <ns0:profiles><ns0:profile name="Demolisher Cannon" id="r29-prof-demolisher" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules>
        <ns0:rule name="Demolisher Cannon" id="hsgear-demolisher-rule" hidden="false">
          <ns0:description>Use the weapon profile shown above.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Close Combat Weapon" hidden="false" id="gear-hq-ccw">
      <ns0:rules>
        <ns0:rule name="Close Combat Weapon" id="gear-hq-ccw-rule" hidden="false">
          <ns0:description>Close Combat Weapon. Uses the bearer's Strength and permits normal Armour Saves.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Chainaxe" hidden="false" id="gear-hq-chainaxe">
      <ns0:rules>
        <ns0:rule name="Chainaxe" id="gear-hq-chainaxe-rule" hidden="false">
          <ns0:description>An Armour Save better than 4+ is reduced to 4+ against wounds caused by a Chainaxe. Armour Saves of 4+ or worse and Invulnerable Saves are unaffected.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Force Weapon" hidden="false" id="gear-hq-force">
      <ns0:rules>
        <ns0:rule name="Force Weapon" id="gear-hq-force-rule" hidden="false">
          <ns0:description>Power Weapon, Force. After a Psyker inflicts one or more unsaved wounds, it may take a Psychic Test; if passed, each unsaved wound becomes a Massive Wound and inflicts D3 Wounds. No additional effect against vehicles.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Relic Blade" hidden="false" id="gear-hq-relic">
      <ns0:rules>
        <ns0:rule name="Relic Blade" id="gear-hq-relic-rule" hidden="false">
          <ns0:description>Strength 6; Power Weapon; Two-Handed. Independent Characters only.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Artificer Armour" hidden="false" id="gear-hq-artificer">
      <ns0:rules>
        <ns0:rule name="Artificer Armour" id="gear-hq-artificer-rule" hidden="false">
          <ns0:description>Artificer Armour grants a 2+ Armour Save and does not count as Terminator Armour.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="gear-hq-terminator">
      <ns0:rules>
        <ns0:rule name="Terminator Armour" id="gear-hq-terminator-rule" hidden="false">
          <ns0:description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not make Pursuit moves and may not embark upon Rhinos or Drop Pods.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="gear-hq-tartaros">
      <ns0:rules>
        <ns0:rule name="Tartaros Terminator Armour" id="gear-hq-tartaros-rule" hidden="false">
          <ns0:description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may make Pursuit moves; may not embark upon Rhinos or Drop Pods.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="gear-hq-cataphractii">
      <ns0:rules>
        <ns0:rule name="Cataphractii Terminator Armour" id="gear-hq-cataphractii-rule" hidden="false">
          <ns0:description>2+ Armour Save, 4+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not Advance, make Pursuit moves or fire Overwatch; may not embark upon Rhinos or Drop Pods.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="gear-hq-refractor">
      <ns0:rules>
        <ns0:rule name="Refractor Field" id="gear-hq-refractor-rule" hidden="false">
          <ns0:description>A Refractor Field grants a 5+ Invulnerable Save. A Sergeant may only purchase a Refractor Field if his squad is purchased at its maximum starting strength. A model that already has a 5+ or better Invulnerable Save may not purchase a Refractor Field.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="gear-hq-iron-halo">
      <ns0:rules>
        <ns0:rule name="Iron Halo" id="gear-hq-iron-halo-rule" hidden="false">
          <ns0:description>Grants a 4+ Invulnerable Save. An army may normally contain no more than one Iron Halo unless specifically stated otherwise.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Boarding Shield" hidden="false" id="gear-hq-boarding">
      <ns0:rules>
        <ns0:rule name="Boarding Shield" id="gear-hq-boarding-rule" hidden="false">
          <ns0:description>Grants a 5+ Invulnerable Save, occupies one hand and prevents the bonus Attack for fighting with two weapons.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-hq-combat-shield">
      <ns0:rules>
        <ns0:rule name="Combat Shield" id="gear-hq-combat-shield-rule" hidden="false">
          <ns0:description>Grants a 6+ Invulnerable Save; does not occupy a hand and does not prevent the two-weapon bonus Attack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Jump Pack" hidden="false" id="gear-hq-jump">
      <ns0:rules>
        <ns0:rule name="Jump Pack" id="gear-hq-jump-rule" hidden="false">
          <ns0:description>The bearer becomes Jump Infantry and follows the normal ProHammer Jump Infantry rules. It may not be combined with a Bike, Jetbike or Terminator Armour.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="gear-hq-bike">
      <ns0:rules>
        <ns0:rule name="Space Marine Bike" id="gear-hq-bike-rule" hidden="false">
          <ns0:description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-hq-auspex">
      <ns0:rules>
        <ns0:rule name="Auspex" id="gear-hq-auspex-rule" hidden="false">
          <ns0:description>Detects Infiltrators and permits the pre-game anti-Infiltrator fire described in the Space Marine Armoury.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-hq-bionics">
      <ns0:rules>
        <ns0:rule name="Bionics" id="gear-hq-bionics-rule" hidden="false">
          <ns0:description>When the bearer loses its final Wound, it may recover as described by the Space Marine Armoury on a roll of 6.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Digital Weapons" hidden="false" id="gear-hq-digital">
      <ns0:rules>
        <ns0:rule name="Digital Weapons" id="gear-hq-digital-rule" hidden="false">
          <ns0:description>Independent Character only; re-roll one failed To Wound roll per Assault phase.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="gear-hq-mastercraft">
      <ns0:rules>
        <ns0:rule name="Master-crafted Weapon" id="gear-hq-mastercraft-rule" hidden="false">
          <ns0:description>Apply to one weapon; re-roll one failed To Hit roll per player turn with that weapon.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-hq-nuncio">
      <ns0:rules>
        <ns0:rule name="Nuncio Vox" id="gear-hq-nuncio-rule" hidden="false">
          <ns0:description>Assists friendly Deep Striking units as described in the Space Marine Armoury.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Psychic Hood" hidden="false" id="gear-hq-hood">
      <ns0:rules>
        <ns0:rule name="Psychic Hood" id="gear-hq-hood-rule" hidden="false">
          <ns0:description>Psykers only. May attempt to nullify enemy psychic powers using the ProHammer Psychic Hood rules.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:modifiers>
        <ns0:modifier type="set" value="true" field="hidden">
          <ns0:conditions>
            <ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian" shared="true" includeChildSelections="true" includeChildForces="false" />
          </ns0:conditions>
        </ns0:modifier>
      </ns0:modifiers>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-hq-purity">
      <ns0:rules>
        <ns0:rule name="Purity Seals" id="gear-hq-purity-rule" hidden="false">
          <ns0:description>Improves control of Fall Back distance as described in the Space Marine Armoury.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="gear-hq-signum">
      <ns0:rules>
        <ns0:rule name="Signum" id="gear-hq-signum-rule" hidden="false">
          <ns0:description>The bearer's unit may re-roll one failed shooting To Hit roll per Shooting phase.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-hq-homer">
      <ns0:rules>
        <ns0:rule name="Teleport Homer" id="gear-hq-homer-rule" hidden="false">
          <ns0:description>Friendly units arriving by teleportation do not scatter when deployed within the permitted range of the active Homer.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Terminator Honours" hidden="false" id="gear-hq-honours">
      <ns0:rules>
        <ns0:rule name="Terminator Honours" id="gear-hq-honours-rule" hidden="false">
          <ns0:description>The bearer gains +1 Attack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="gear-hq-melta-bombs">
      <ns0:rules>
        <ns0:rule name="Melta Bombs" id="gear-hq-melta-bombs-rule" hidden="false">
          <ns0:description>Against a vehicle in close combat, the bearer may exchange normal attacks for one Melta Bomb attack at Strength 8 + 2D6 Armour Penetration.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Narthecium" hidden="false" id="gear-hq-narthecium">
      <ns0:rules>
        <ns0:rule name="Narthecium" id="gear-hq-narthecium-rule" hidden="false">
          <ns0:description>A unit containing an Apothecary with a Narthecium may ignore the first eligible failed saving throw it suffers during each player turn, subject to the restrictions in the army list.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Reductor" hidden="false" id="gear-hq-reductor">
      <ns0:rules>
        <ns0:rule name="Reductor" id="gear-hq-reductor-rule" hidden="false">
          <ns0:description>If Victory Points are used and the Apothecary survives, recover 1 Victory Point for each slain friendly Legiones Astartes model that belonged to his unit, including attached Independent Characters.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-hq-vexilla">
      <ns0:rules>
        <ns0:rule name="Legion Vexilla" id="gear-hq-vexilla-rule" hidden="false">
          <ns0:description>The bearer's unit adds +1 to its combat-resolution score. This bonus is not cumulative.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Sacred Standard" hidden="false" id="gear-hq-sacred">
      <ns0:rules>
        <ns0:rule name="Sacred Standard" id="gear-hq-sacred-rule" hidden="false">
          <ns0:description>Friendly Legiones Astartes units add +1 to combat-resolution in any close combat within 6". Not cumulative with another Sacred Standard or Legion Standard.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Legion Standard" hidden="false" id="gear-hq-legion-standard">
      <ns0:rules>
        <ns0:rule name="Legion Standard" id="gear-hq-legion-standard-rule" hidden="false">
          <ns0:description>Combines the effects of a Sacred Standard and a Crusade Relic. Only an army of 2,000 points or more may include one; it normally counts as the army's Crusade Relic.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="gear-hq-grenade-harness">
      <ns0:rules>
        <ns0:rule name="Grenade Harness" id="gear-hq-grenade-harness-rule" hidden="false">
          <ns0:description>One-use 8" S3 AP– Assault 2, Blast grenade weapon; grants the Frag Grenade benefit where applicable.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Calibanite Warblade" hidden="false" id="da22-warblade">
      <ns0:rules>
        <ns0:rule name="Calibanite Warblade" id="rule-da22-warblade" hidden="false">
          <ns0:description>Strength User +1; Power Weapon. Counts as a sword-type weapon for Mastery of the Blade and Deathwing rules.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Terranic Greatsword" hidden="false" id="da22-greatsword">
      <ns0:rules>
        <ns0:rule name="Terranic Greatsword" id="rule-da22-greatsword" hidden="false">
          <ns0:description>Strength User +2; Power Weapon, Two-Handed, Murderous Strike. Natural To Wound roll of 6 causes Instant Death. Counts as a sword-type weapon.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Calibanite Plasma Pistol" hidden="false" id="da22-plasma-pistol">
      <ns0:profiles>
        <ns0:profile name="Calibanite Plasma Pistol" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-pistol">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Pistol</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Calibanite Plasma Gun" hidden="false" id="da22-plasma-gun">
      <ns0:profiles>
        <ns0:profile name="Calibanite Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-gun">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Calibanite Plasma Cannon" hidden="false" id="da22-plasma-cannon">
      <ns0:profiles>
        <ns0:profile name="Calibanite Plasma Cannon" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-cannon">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Plasma Repeater" hidden="false" id="da22-plasma-repeater">
      <ns0:profiles>
        <ns0:profile name="Plasma Repeater" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-repeater">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Salvo 2/3, Twin-linked, Gets Hot</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Plasma Burner" hidden="false" id="da22-plasma-burner">
      <ns0:profiles>
        <ns0:profile name="Plasma Burner" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-burner">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault D3+1, Ignores Cover, Plasma Flame</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Plasma Burner" id="rule-da22-plasma-burner" hidden="false">
          <ns0:description>Plasma Flame: may re-roll failed To Hit rolls when making Overwatch; roll once for number of generated shots each time it fires.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Stasis Shell — Missile" hidden="false" id="da22-stasis-missile">
      <ns0:profiles>
        <ns0:profile name="Stasis Shell — Missile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-stasis-missile">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Stasis Anomaly</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Stasis Shell — Missile" id="rule-da22-stasis-missile" hidden="false">
          <ns0:description>Stasis Anomaly: if a unit is hit, all models in it have Initiative 1 until end of current player turn; multiple anomalies do not stack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Stasis Shell — Grenade" hidden="false" id="da22-stasis-grenade">
      <ns0:profiles>
        <ns0:profile name="Stasis Shell — Grenade" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-stasis-grenade">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">2</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">-</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Blast, Stasis Anomaly</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Stasis Shell — Grenade" id="rule-da22-stasis-grenade" hidden="false">
          <ns0:description>Stasis Anomaly: if a unit is hit, all models in it have Initiative 1 until end of current player turn; multiple anomalies do not stack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Molecular Acid Heavy Bolter" hidden="false" id="da22-acid-hb">
      <ns0:profiles>
        <ns0:profile name="Molecular Acid Heavy Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-acid-hb">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Fleshbane</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Molecular Acid Heavy Bolter" id="rule-da22-acid-hb" hidden="false">
          <ns0:description>Fleshbane. A Twin-linked Heavy Bolter using Molecular Acid Shells remains Twin-linked.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Teleportation Transponders" hidden="false" id="da22-transponders">
      <ns0:rules>
        <ns0:rule name="Teleportation Transponders" id="rule-da22-transponders" hidden="false">
          <ns0:description>A model/unit equipped with these may deploy using Deep Strike even if the mission normally forbids it. Terminator unit +15 points; Terminator Independent Character +10 points; an IC intending to Deep Strike with a unit buys separately.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Plasma-caster" hidden="false" id="da22-plasma-caster">
      <ns0:profiles>
        <ns0:profile name="Plasma-caster" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-caster">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 2, Ignores Cover, Plasma Flame</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Plasma-caster" id="rule-da22-plasma-caster" hidden="false">
          <ns0:description>Plasma Flame: failed To Hit rolls may be re-rolled when firing Overwatch.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Plasma Incinerator with Suspensor Web" hidden="false" id="da22-plasma-incinerator">
      <ns0:profiles>
        <ns0:profile name="Plasma Incinerator with Suspensor Web" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-incinerator">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy D3+4, Ignores Cover, Plasma Flame</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Plasma Incinerator with Suspensor Web" id="rule-da22-plasma-incinerator" hidden="false">
          <ns0:description>When several identical Plasma Burners/Incinerators fire, roll once for shots and use it for every weapon of that type. Plasma Flame permits re-rolling failed Overwatch To Hit rolls.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Needle Pistol" hidden="false" id="da22-needle-pistol">
      <ns0:profiles>
        <ns0:profile name="Needle Pistol" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-needle-pistol">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">2</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Pistol, Poisoned, Rending</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Calibanite Charge-blade" hidden="false" id="da22-charge-blade">
      <ns0:rules>
        <ns0:rule name="Calibanite Charge-blade" id="rule-da22-charge-blade" hidden="false">
          <ns0:description>Grants +1 Strength and Rending. Supercharged Blades: at start of an Assault phase while engaged, the Cabal may make all Charge-blades also Power Weapons until phase end; each Enigmatus rolling one or more natural 1s To Hit suffers one S4 hit after its attacks, normal saves allowed.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
  <ns0:selectionEntry type="upgrade" import="true" name="Crozius Arcanum" hidden="false" id="r29-gear-crozius"><ns0:rules><ns0:rule name="Crozius Arcanum" id="r29-gear-crozius-rule" hidden="false"><ns0:description>Counts as a Power Weapon and ignores Armour Saves.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Rosarius" hidden="false" id="r29-gear-rosarius"><ns0:rules><ns0:rule name="Rosarius" id="r29-gear-rosarius-rule" hidden="false"><ns0:description>Grants a 4+ Invulnerable Save.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Servo-Arm" hidden="false" id="r29-gear-servo-arm"><ns0:rules><ns0:rule name="Servo-Arm" id="r29-gear-servo-arm-rule" hidden="false"><ns0:description>Grants one additional Power Fist-style close-combat attack, rolled separately, and +1 to Battlesmith repair rolls. A normal 5+ repair therefore succeeds on a 4+ while the Servo-Arm is retained.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Cognis Signum" hidden="false" id="r29-gear-cognis-signum"><ns0:rules><ns0:rule name="Cognis Signum" id="r29-gear-cognis-signum-rule" hidden="false"><ns0:description>The no-scatter deployment range of the bearer’s Nuncio Vox is increased from 6” to 12”. A Targeting Matrix also provides the normal Signum benefit to the bearer’s joined unit.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Aether-shock Maul" hidden="false" id="r29-gear-aether-shock-maul"><ns0:rules><ns0:rule name="Aether-shock Maul" id="r29-gear-aether-shock-maul-rule" hidden="false"><ns0:description>Counts as a Power Weapon. Against Psykers and models with the Daemon special rule, it always wounds on a 2+.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Cortex Controller" hidden="false" id="r29-gear-cortex-controller"><ns0:rules><ns0:rule name="Cortex Controller" id="r29-gear-cortex-controller-rule" hidden="false"><ns0:description>Friendly Battle-Automata within 6” automatically pass Command Uplink or equivalent control tests. The Praevian’s accompanying Maniple is controlled normally by this item.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Cortex Designator" hidden="false" id="r29-gear-cortex-designator"><ns0:rules><ns0:rule name="Cortex Designator" id="r29-gear-cortex-designator-rule" hidden="false"><ns0:description>When the Praevian scores one or more successful To Hit rolls with a shooting weapon against an enemy unit, his attached Battle-Automata Maniple gains Preferred Enemy against that unit until the end of the current player turn. No unsaved Wound is required.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Special Issue Ammunition" hidden="false" id="r29-gear-special-issue-ammunition"><ns0:profiles><ns0:profile name="Dragonfire Bolts" id="r29-sia-dragon" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Ignores Cover</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Hellfire Bolts" id="r29-sia-hellfire" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">X</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Poison (2+)</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Kraken Bolts" id="r29-sia-kraken" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">30”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Vengeance Rounds" id="r29-sia-vengeance" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Special Issue Ammunition" id="r29-sia-rule" hidden="false"><ns0:description>Each time the bearer fires an eligible bolt weapon, select one ammunition profile. Only one ammunition type may be used for that shooting attack.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r37-gear-grenade-launcher" name="Grenade Launcher" type="upgrade" hidden="false" import="true"><ns0:profiles><ns0:profile id="r37-gl-frag" name="Grenade Launcher – Frag" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile id="r37-gl-krak" name="Grenade Launcher – Krak" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry id="r40-da-forward-deployment" name="Forward Deployment — Infiltrate" type="upgrade" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-deployment-max" type="max" value="3" field="selections" scope="roster" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule id="r40-da-forward-deployment-rule" name="Forward Deployment" hidden="false"><ns0:description>Under The Serpent’s Bane, up to three Firewing Troops units may gain the Infiltrate special rule.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-phoenix-spear" name="Phoenix Spear" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-phoenix-spear-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-phoenix-spear-rule" name="Phoenix Spear" hidden="false"><ns0:description>Power Weapon, Two-Handed, Phoenix Strike. During the first round of each close combat attacks are resolved at +1 Strength; thereafter at normal Strength. Characters already equipped with a Power Weapon as basic wargear exchange it for +5 points instead; use the source restriction when applying this entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-digital-lasers" name="Digital Lasers" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-digital-lasers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-digital-lasers-rule" name="Digital Lasers" hidden="false"><ns0:description>Emperor’s Children Independent Character only. Adds +1 to the bearer’s Attacks characteristic. May not be combined with Terminator Honours.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-sonic-shrieker" name="Sonic Shrieker" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-sonic-shrieker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-sonic-shrieker-rule" name="Sonic Shrieker" hidden="false"><ns0:description>TRAITOR ONLY. During the first round of close combat an enemy model in base contact suffers -1 Weapon Skill. If every model in the unit is equipped, every enemy model engaged with it suffers -1 WS. Not cumulative; Fearless models are unaffected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-line-apothecary" name="Sergeant upgraded to Apothecary" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-line-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><ns0:constraint id="r43-ec-line-apothecary-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-line-apothecary-rule" name="Sergeant upgraded to Apothecary" hidden="false"><ns0:description>PURITY ABOVE ALL: Upgrade the Legion Sergeant to an Apothecary. The model retains its weapons and wargear and gains a Narthecium. It counts as an Apothecary and may purchase a Reductor for +5 points. Across the army, only one Tactical Squad OR Assault Squad may take this upgrade.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-vet-apothecary" name="Veteran Sergeant upgraded to Apothecary" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-vet-apothecary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-vet-apothecary-rule" name="Veteran Sergeant upgraded to Apothecary" hidden="false"><ns0:description>PURITY ABOVE ALL: Upgrade the Legion Veteran Sergeant to an Apothecary. The model retains its weapons and wargear and gains a Narthecium. It counts as an Apothecary and may purchase a Reductor for +5 points.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-reductor" name="Reductor" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-reductor-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-reductor-rule" name="Reductor" hidden="false"><ns0:description>May only be selected for a Sergeant upgraded to an Apothecary by Purity Above All.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-sonic-package" name="Sonic Weaponry Package" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-sonic-package-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><ns0:constraint id="r43-ec-sonic-package-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-sonic-package-rule" name="Sonic Weaponry Package" hidden="false"><ns0:description>TRAITOR ONLY. One Legion Heavy Support Squad may select up to four Sonic Weapons instead of normal Heavy Weapon options. The 3rd Company Elite Rite increases this allowance to two squads.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-sonic-sonic-blaster" name="Sonic Blaster" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-sonic-sonic-blaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-sonic-sonic-blaster-rule" name="Sonic Blaster" hidden="false"><ns0:description>24”, S4 AP5, Assault 2 or Heavy 3.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-sonic-doom-siren" name="Doom Siren" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-sonic-doom-siren-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-sonic-doom-siren-rule" name="Doom Siren" hidden="false"><ns0:description>Template, S5 AP4, Assault 1.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-sonic-blastmaster" name="Blastmaster" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-sonic-blastmaster-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-sonic-blastmaster-rule" name="Blastmaster" hidden="false"><ns0:description>48”, S8 AP3, Heavy 1, Blast.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ec-perfect-cacophony" name="Perfect Cacophony — Fearless" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ec-perfect-cacophony-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ec-perfect-cacophony-rule" name="Perfect Cacophony — Fearless" hidden="false"><ns0:description>A Legion Heavy Support Squad in which the majority of surviving models are equipped with Sonic Weapons gains Fearless.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-iw-shrapnel-bolts" name="Shrapnel Bolts" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-iw-shrapnel-bolts-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-iw-shrapnel-bolts-rule" name="Shrapnel Bolts" hidden="false"><ns0:description>The unit’s Bolt Pistols, Bolters, Combi-Bolters, Storm Bolters, Heavy Bolters, Twin-linked Bolters and bolter components of Combi-Weapons gain Pinning. May not be combined with Special Issue Ammunition, Hellfire Rounds or another special ammunition type.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-iw-servo-arm" name="Servo-Arm" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-iw-servo-arm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-iw-servo-arm-rule" name="Servo-Arm" hidden="false"><ns0:description>Any Iron Warriors model with Space Marine Armoury access may purchase this even without normal Techmarine access. A Jump Pack model may not purchase it. Use the normal Servo-Arm rules from the Legiones Astartes Army List.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-iw-bionics" name="Bionics" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-iw-bionics-rule" name="Bionics" hidden="false"><ns0:description>Iron Warriors Armoury price. Follows the normal Bionics rules from the Legiones Astartes Army List.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ws-power-glaive" name="Power Glaive" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ws-power-glaive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ws-power-glaive-rule" name="Power Glaive" hidden="false"><ns0:description>Character able to select a Power Weapon. One-Handed: User Strength, Power Weapon. Two-Handed: User +1 Strength, Power Weapon, Two-Handed. A model with a Power Weapon as basic wargear may exchange it for +10 instead.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ws-warlance" name="Chogorian Warlance" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ws-warlance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ws-warlance-rule" name="Chogorian Warlance" hidden="false"><ns0:description>Requires a Bike or Jetbike. Power Weapon, Cavalry Lance: +1 Initiative in the first round when charging; -1 Initiative in rounds in which the bearer did not charge. One-handed.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-ws-cyber-hawk" name="Cyber-hawk" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-ws-cyber-hawk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /><ns0:constraint id="r43-ws-cyber-hawk-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-ws-cyber-hawk-rule" name="Cyber-hawk" hidden="false"><ns0:description>0–1 White Scars Praetor. At the beginning of each White Scars turn place/move the marker. White Scars Infantry attacking an enemy within 6” of it may re-roll shooting To Hit rolls of 1 and increases charge distance against that enemy from 6” to 7”.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-frost-weapon" name="Frost Weapon" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-frost-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-frost-weapon-rule" name="Frost Weapon" hidden="false"><ns0:description>Space Wolves Character with Armoury access. User +1 Strength, Power Weapon. A model already equipped with a Power Weapon may exchange it for +5 instead.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-great-frost-blade" name="Great Frost Blade" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-great-frost-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-great-frost-blade-rule" name="Great Frost Blade" hidden="false"><ns0:description>Space Wolves Independent Character. User +2 Strength, Power Weapon, Two-Handed, Master-crafted. The bearer suffers -1 Initiative while using it.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-wolf-pelt" name="Wolf Pelt" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-wolf-pelt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-wolf-pelt-rule" name="Wolf Pelt" hidden="false"><ns0:description>When the bearer’s unit successfully uses Counter-Attack, the bearer receives +2 Attacks instead of the normal +1 granted by Counter-Attack.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-wolf-tooth-necklace" name="Wolf Tooth Necklace" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-wolf-tooth-necklace-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-wolf-tooth-necklace-rule" name="Wolf Tooth Necklace" hidden="false"><ns0:description>The bearer always hits enemy models on a 3+ in close combat unless it would normally hit on a better result.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-wolf-tail-talisman" name="Wolf Tail Talisman" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-wolf-tail-talisman-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-wolf-tail-talisman-rule" name="Wolf Tail Talisman" hidden="false"><ns0:description>When an enemy psychic power directly affects the bearer or joined unit, after the power succeeds and any normal Deny attempt, roll D6; on a 6 the bearer is unaffected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry id="r43-sw-runic-armour" name="Runic Armour" type="upgrade" hidden="false" import="true"><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:constraints><ns0:constraint id="r43-sw-runic-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:rules><ns0:rule id="r43-sw-runic-armour-rule" name="Runic Armour" hidden="false"><ns0:description>Independent Character in Power Armour only. Replaces Power Armour; grants a 2+ Armour Save and Adamantium Will and counts as Artificer Armour for other rules.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:sharedSelectionEntries>
  <ns0:selectionEntries>
    <ns0:selectionEntry type="unit" import="true" name="Legion Tactical Squad" hidden="false" id="tactical-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="tactical-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Power Armour" id="tactical-power-armour" hidden="false">
          <ns0:description>Models wearing Power Armour have a 3+ Armour Save.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="tactical-legiones" hidden="false">
          <ns0:description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="tactical-frag" hidden="false">
          <ns0:description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Fury of the Legion" id="tactical-fury" hidden="false">
          <ns0:description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Automatic Basic Wargear" id="rev23-tactical-wargear-auto" hidden="false">
          <ns0:description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="tac-marine" defaultAmount="9">
          <ns0:constraints>
            <ns0:constraint type="min" value="9" field="selections" scope="parent" shared="true" id="tac-marine-min" includeChildSelections="false" />
            <ns0:constraint type="max" value="19" field="selections" scope="parent" shared="true" id="tac-marine-max" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="15" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-marine">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="tac-sergeant" defaultAmount="1">

                <ns0:entryLink import="true" name="Purity Seals" hidden="false" id="r35-pride-terminator-terminator-sgt-purity" type="selectionEntry" targetId="gear-purity">
                  <ns0:constraints>
                    <ns0:constraint id="r35-pride-terminator-terminator-sgt-purity-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="5" />
                  </ns0:costs>

  <entryLink import="true" name="Rotor Cannon (replaces Bolter)" hidden="false" id="breacher-sp-rotor" type="selectionEntry" targetId="gear-rotor"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="breacher-sp-rotor-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="4"/></costs></entryLink>
  <entryLink import="true" name="Flamer (replaces Bolter)" hidden="false" id="breacher-sp-flamer" type="selectionEntry" targetId="gear-flamer"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="breacher-sp-flamer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
  <entryLink import="true" name="Meltagun (replaces Bolter)" hidden="false" id="breacher-sp-melta" type="selectionEntry" targetId="gear-meltagun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="breacher-sp-melta-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
  <entryLink import="true" name="Plasma Gun (replaces Bolter)" hidden="false" id="breacher-sp-plasma" type="selectionEntry" targetId="gear-plasma-gun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="breacher-sp-plasma-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>

                        <entryLink import="true" name="Combi-Meltagun" hidden="false" id="assault-sgt-combim" type="selectionEntry" targetId="gear-combi-melta"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-combim-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>

                              </costs>
                              <rules>
                                <rule name="Hunter-Killer Missile" id="hq-consul-signals-dam-vu-0-r" hidden="false">
                                  <description>One Use missile, Unlimited range, Strength 8 AP3 Heavy 1.</description>
                                </rule>
                              </rules>
                            </selectionEntry>
                            <selectionEntry type="upgrade" name="Dozer Blade" id="hq-consul-signals-dam-vu-1" hidden="false" import="true">

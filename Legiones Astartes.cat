                <ns0:rule name="Siege Breaker" id="hs-hss-siegebreaker-rule" hidden="false">
                  <ns0:description>Art of Destruction: Heavy weapons fired by this unit receive +1 to Armour Penetration rolls against vehicles and fortifications. This does not apply to pistols, grenades or close-combat attacks.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>

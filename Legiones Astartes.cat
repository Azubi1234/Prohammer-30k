    <selectionEntry type="unit" name="Damocles Command Rhino" id="hq-damocles" hidden="false" import="true">
      <constraints>
        <constraint id="hq-damocles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
        <constraint id="hq-damocles-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="100" />

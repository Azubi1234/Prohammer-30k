                  <rules>
                    <rule name="Space Marine Bike" id="techmarine-I-bike-rule" hidden="false">
                      <description>The model becomes Bike and the bike is armed with twin-linked bolters.</description>
                    </rule>
                  </rules>
                </selectionEntry>

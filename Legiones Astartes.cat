          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Assault Cannon" hidden="false" id="gear-assault-cannon">
      <ns0:profiles>

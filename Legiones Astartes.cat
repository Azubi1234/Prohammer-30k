    <selectionEntry type="upgrade" import="true" name="Combi-Flamer" hidden="false" id="gear-combi-flamer"><profiles><profile name="Combi-Flamer - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-flamer-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Flamer - Flamer" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-flamer-f"><characteristics><characteristic name="Range" typeId="ranged-range">Template</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-flamer" hidden="false"><description>Choose one component to fire. The bolter may be fired normally; the secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Chainsword" hidden="false" id="gear-chainsword">
      <rules>
        <rule name="Chainsword" id="rule-chainsword" hidden="false">
          <description>Close Combat Weapon. Uses the bearer's Strength and permits normal Armour Saves.</description>
        </rule>
      </rules>
    </selectionEntry>

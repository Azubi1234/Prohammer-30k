ctionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="MHARA GAL TAINTED DREADNOUGHT" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought"><ns0:costs><ns0:cost name="Points" typeId="pts" value="305" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Mhara Gal" typeId="prof-walker" typeName="Walker" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="walker-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="walker-bs">3</ns0:characteristic><ns0:characteristic name="S" typeId="walker-s">7</ns0:characteristic><ns0:characteristic name="Front" typeId="walker-front">13</ns0:characteristic><ns0:characteristic name="Side" typeId="walker-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="walker-rear">11</ns0:characteristic><ns0:characteristic name="I" typeId="walker-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="walker-a">3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-source" hidden="false"><ns0:description>Mhara Gal | 6 | 3 | 7 | 13 | 12 | 11 | 5 | 3
Force Organisation:
DAEMONIC ENGINE Each time the Mhara Gal suffers a Glancing or Penetrating Hit, roll a D6 before rolling on the Vehicle Damage table. On a 5+, the hit is ignored. SHROUD OF DARK FIRE When resolving a shooting attack against the Mhara Gal made with a Flame, Melta, Plasma or Volkite weapon, reduce the Strength of the attack by 1, to a minimum of 1. ACCURSED Successful Invulnerable Saves made against the Mhara Gal's close-combat attacks must be re-rolled. Enemy units taking a Fear test caused by the Mhara Gal suffer a -2 Leadership modifier. The Mhara Gal never counts as a Scoring Unit.
• Elites
• 0–1
Allegiance:
• Traitor only
Unit Composition:
• 1 Mhara Gal Tainted Dreadnought
Unit Type:
• Vehicle (Walker)
Wargear:
• Dreadnought Close Combat Weapon with built-in
Twin-linked Bolter
• Plasma Cannon
• Smoke Launchers
• Searchlight
Special Rules:
• Daemon
• Fleet
• It Will Not Die
• Adamantium Will
• Daemonic Engine
• Shroud of Dark Fire
• Accursed
OPTIONS
The Mhara Gal may replace its Plasma Cannon with:
• Multi-Melta ........................................ Free
• Twin-linked Autocannon ........................ +5 points
• Twin-linked Lascannon ......................... +20 points
• Second Dreadnought Close Combat Weapon
with built-in Twin-linked Bolter ................... Free
Any built-in Twin-linked Bolter may be replaced with:
• Heavy Flamer ................................... +10 points
• Meltagun ....................................... +15 points
• Plasma Blaster ................................. +20 points
If equipped with two Dreadnought Close Combat Weapons, the Mhara Gal gains +1 Attack.
DEDICATED TRANSPORT
The Mhara Gal may select a Legion Dreadnought Drop Pod as a Dedicated Transport.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-0-multi-melta"><ns0:constraints><ns0:constraint id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-0-multi-melta-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-0-context" hidden="false"><ns0:description>The Mhara Gal may replace its Plasma Cannon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Autocannon" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-1-twin-linked-autocannon"><ns0:constraints><ns0:constraint id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-1-twin-linked-autocannon-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-1-context" hidden="false"><ns0:description>The Mhara Gal may replace its Plasma Cannon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Lascannon" hidden="false" id="r41-unit-xvii-3-mhara-gal-tainted-dreadnought-opt-
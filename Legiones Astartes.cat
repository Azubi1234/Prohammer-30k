    <ns0:selectionEntry type="unit" import="true" name="EBON KESHIG" hidden="true" id="r43-ws-sagyar-ebon-troops"><ns0:costs><ns0:cost name="Points" typeId="pts" value="225" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="r25-rite-v-1-the-sagyar-mazan" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Ebon Keshig" typeId="prof-model" typeName="Model" hidden="false" id="r43-ws-sagyar-ebon-troops-r41-unit-v-1-ebon-keshig-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r43-ws-sagyar-ebon-troops-r41-unit-v-1-ebon-keshig-source" hidden="false"><ns0:description>Ebon Keshig | 5 | 4 | 4 | 4 | 1 | 5 | 3 | 9 | 2+/5+
DRAGON DAO A Dragon Dao is a Power Weapon. At the beginning of each Assault phase, its bearer may choose to wield the weapon with both hands. If wielded with both hands, the bearer gains +2 Strength but suffers -2 Initiative for that Assault phase. A model wielding a Dragon Dao with both hands receives no bonus Attack for fighting with two close-combat weapons.
Force Organisation:
• Elites
Unit Composition:
• 5 Ebon Keshig
Unit Type:
• Infantry
Wargear:
• Terminator Armour
• Dragon Dao
Special Rules:
• Legiones Astartes (White Scars)
• Fearless
OPTIONS
• The squad may include up to five additional Ebon Keshig for +45 points per model.
DEDICATED TRANSPORT
A squad of five models may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r43-ws-sagyar-ebon-troops-rule" name="Battlefield Role" hidden="false"><ns0:description>THE SAGYAR MAZAN: Ebon Keshig may be selected as Troops and may fulfil compulsory Troops selections.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r43-ws-sagyar-ebon-troops-r41-unit-v-1-ebon-keshig-additional"><ns0:constraints><ns0:constraint id="r43-ws-sagyar-ebon-troops-r41-unit-v-1-ebon-keshig-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="45" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r43-ws-sagyar-ebon-troops-r41-unit-v-1-ebon-keshig-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +45 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r43-ws-sagyar-ebon-troops-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry></ns0:selectionEntries>
</ns0:catalogue>
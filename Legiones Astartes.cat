        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Main Weapon Replacements" id="hs-spartan-replace" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Two Laser Destroyers (replace both Quad Lascannons)" id="hs-spartan-laser" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-spartan-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:profiles>

          </ns0:constraints>
          <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Land Raider Dedicated Transport (Armoured Spearhead)" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-spear-veteran-transport" hidden="true">
                      <ns0:constraints>

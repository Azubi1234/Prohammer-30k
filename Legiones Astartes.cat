              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Typhoon Missile Launcher" hidden="false" id="fa-land-speeder-add-typ" type="selectionEntry" targetId="fa-gear-typhoon" import="true">
              <ns0:constraints>
                <ns0:constraint id="fa-land-speeder-add-typ-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Calibanite Plasma Cannon" hidden="false" id="da22-alt-pc-2" type="selectionEntry" targetId="da22-plasma-cannon" import="true">
              <ns0:constraints>
                <ns0:constraint id="da22-alt-pc-2-2" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:modifiers>
                <ns0:modifier type="set" value="true" field="hidden">
                  <ns0:conditions>
                    <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hunter-Killer Missiles — up to two per Speeder" id="fa-land-speeder-hk" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="fa-land-speeder-hk-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="4" field="fa-land-speeder-hk-max">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="fa-land-speeder-model" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="6" field="fa-land-speeder-hk-max">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="fa-land-speeder-model" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:entryLinks>
            <ns0:entryLink name="Hunter-Killer Missile" hidden="false" id="fa-land-speeder-hk-item" type="selectionEntry" targetId="gear-hk" import="true">
              <ns0:constraints>
                <ns0:constraint id="fa-land-speeder-hk-item-max" type="max" value="6" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-fa-land-speeder" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-fa-land-speeder-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-fa-land-speeder-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-fa-land-speeder-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-fa-land-speeder-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-fa-land-speeder-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-fa-land-speeder-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-fa-land-speeder-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-fa-land-speeder-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-fa-land-speeder-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-fa-land-speeder-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-fa-land-speeder-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-fa-land-speeder-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-fa-land-speeder-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-fa-land-speeder-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-fa-land-speeder-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-fa-land-speeder-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-ammo-fa-land-speeder" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-ammo-fa-land-speeder-fa-land-speeder-add-hb" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-fa-land-speeder-fa-land-speeder-add-hb-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="fa-land-speeder-add-hb" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Legion Javelin Attack Speeder Squadron" hidden="false" id="fa-javelin" import="true">

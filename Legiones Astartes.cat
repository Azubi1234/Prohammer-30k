              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Cataphractii Terminator Armour" id="r35-pride-terminator-terminator-armour-cataphractii-rule" hidden="false">
                  <ns0:description>2+ Armour Save, 4+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Advance, Pursue or fire Overwatch. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</ns0:description>

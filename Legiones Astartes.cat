130" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xvii-4-procurator-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Procurator" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvii-4-procurator-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Procurator Prime" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvii-4-procurator-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvii-4-procurator-squad-source" hidden="false"><ns0:description>Procurator | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Procurator Prime | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 10 | 2+
Force Organisation:
• Elites
FLESH HARVESTERS When a Procurator Squad uses Ritual of Consecration, the Daemon unit nominated by that rule receives +1 to its next Reserve roll in addition to the normal re-roll. This modifier is not cumulative.
Allegiance:
• Traitor only
Unit Composition:
• 4 Procurators
• 1 Procurator Prime
Unit Type:
• Infantry
• The Procurator Prime is a Character
Wargear:
• Power Armour
• Bolt pistol
• Chainsword
• Frag grenades
The Procurator Prime additionally has:
• Artificer Armour
• Narthecium
• Reductor
Special Rules:
• Legiones Astartes (Word Bearers)
• Flesh Harvesters
OPTIONS
• The squad may include up to five additional Procurators for +20 points per model.
• For every five models in the squad, one Procurator may replace his Chainsword with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Power fist .................................... +15 points
• For every five models in the squad, one Procurator may replace his Bolt pistol with:
• Hand Flamer .................................... +5 points
• Plasma pistol ................................ +15 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
• Jump Packs .............................. +15 points per model
PROCURATOR PRIME
The Procurator Prime may replace his Chainsword with:
• Power weapon ................................... +10 points
• Power fist ...................................... +15 points
The Procurator Prime counts as an Apothecary for the purposes of his Narthecium and Reductor.
JUMP PACKS
If every model purchases a Jump Pack, the unit becomes Jump Infantry and may not select a Dedicated Transport.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod or Dreadclaw Drop Pod where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xvii-4-procurator-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xvii-4-procurator-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xvii-4-procurator-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +20 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvii-4-procurator-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="r41-unit-xvii-4-procurator-squad-opt-0-rending-weapon"><ns0:constraints><ns0:constraint id="r41-unit-xvii-4-procurator-squad-opt-0-rending-weapon-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-4-procurator-squad-opt-0-context" hidden="false"><ns0:description>• For every five models in the squad, one Procurator may replace his Chainsword with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r41-unit-xvii-4-procurator-squad-
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Proteus" id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>

                                </rule>
                              </rules>
                            </selectionEntry>
                          </selectionEntries>
                        </selectionEntryGroup>
                        <selectionEntryGroup name="Pintle-mounted Weapon" id="hq-consul-signals-dam-pintle" hidden="false">

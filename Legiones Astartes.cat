              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Breakers of Witches" id="da22-order-breakers-rule" hidden="false">
                  <ns0:description>Re-roll failed To Hit and To Wound rolls in close combat against Psykers, Brotherhoods of Psykers and Daemons.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>

characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-ix-6-raldoron-the-blooded-source" hidden="false"><ns0:description>Raldoron | 7 | 5 | 4 | 4 | 3 | 4 | 4 | 10 | 2+/4+
ENCARMINE WARBLADE The Encarmine Warblade is a Power Weapon. Attacks made with it are resolved at +1 Strength. FIRST CAPTAIN OF THE BLOOD ANGELS Raldoron and any Blood Angels unit he has joined may re-roll failed Morale tests. In addition, friendly Blood Angels units with a model within 6" of Raldoron may use his Leadership when taking Morale or Pinning tests. THE BLOODED At the beginning of each Assault phase, nominate one enemyIndependent Character or squad leader in base contact withRaldoron. Until the end of that Assault phase, Raldoron may re-roll failed To Hit rolls made against that model. COMMAND RETINUE Raldoron may select a Legion Command Squad, Legion Terminator Command Squad or Sanguinary Guard Squad as his retinue.
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Iron Halo
• Encarmine Warblade
• Combi-flamer
• Frag grenades
Special Rules:
• Legiones Astartes (Blood Angels)
• Independent Character
• Master of the Legion
• First Captain of the Blood Angels
• The Blooded
OPTIONS
• Raldoron may take:
• Krak grenades ........................................ +2 points
• Melta bombs .......................................... +5 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-ix-6-raldoron-the-blooded-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-ix-6-raldoron-the-blooded-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-ix-6-raldoron-the-blooded-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-6-raldoron-the-blooded-opt-0-context" hidden="false"><ns0:description>• Raldoron may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="r41-unit-ix-6-raldoron-the-blooded-opt-1-melta-bombs"><ns0:constraints><ns0:constraint id="r41-unit-ix-6-raldoron-the-blooded-opt-1-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-6-raldoron-the-blooded-opt-1-context" hidden="false"><ns0:description>• Raldoron may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="DOMINION ZEPHON" hidden="false" id="r41-unit-ix-7-dominion-zephon"><ns0:costs><ns0:cost name="Points" typeId="pts" value="175" /></ns0:costs><ns0:categoryLinks><ns0:categoryL
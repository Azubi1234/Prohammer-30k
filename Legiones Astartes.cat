    <ns0:selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="gear-chainfist">
      <ns0:rules>
        <ns0:rule name="Chainfist" id="gear-chainfist-rule-0" hidden="false">
          <ns0:description>Strength x2; Power Weapon; Unwieldy; Specialist Weapon; Armourbane.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Reaper Autocannon" hidden="false" id="gear-reaper-autocannon">
      <ns0:profiles>
        <ns0:profile name="Reaper Autocannon" id="gear-reaper-autocannon-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Plasma Blaster" hidden="false" id="gear-plasma-blaster">
      <ns0:profiles>
        <ns0:profile name="Plasma Blaster" id="gear-plasma-blaster-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>

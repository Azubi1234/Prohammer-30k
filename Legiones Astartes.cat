          <ns0:rules>
            <ns0:rule name="Sergeant Armoury" id="r40-da-storm-assault-assault-rule-sgt-armoury" hidden="false">
              <ns0:description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are available at the points costs shown in this squad entry and are not repeated in the additional Armoury.</ns0:description>
            </ns0:rule>
          </ns0:rules>

    <selectionEntry type="unit" import="true" name="Legion Assault Squad" hidden="false" id="assault-unit">
      <categoryLinks><categoryLink targetId="cat-troops" id="assault-cat" primary="true" name="Troops" hidden="false"/></categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="assault-standard-wargear" hidden="false"><description>Every model is equipped with Power Armour, a Bolt Pistol, a Chainsword, Frag Grenades and a Jump Pack.</description></rule>
        <rule name="Power Armour" id="assault-power-armour" hidden="false"><description>Models wearing Power Armour have a 3+ Armour Save.</description></rule>
        <rule name="Legiones Astartes" id="assault-legiones" hidden="false"><description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description></rule>
        <rule name="Frag Grenades" id="assault-frag" hidden="false"><description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description></rule>
        <rule name="Jump Packs" id="assault-jump-packs" hidden="false"><description>The squad is equipped with Jump Packs and is treated as Jump Infantry. It follows all normal ProHammer rules for Jump Infantry, including movement, terrain, Deep Strike, Fall Back movement and transport restrictions.</description></rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="assault-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="assault-standard-bp-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-standard-bp-max" includeChildSelections="false" automatic="true"/></constraints></entryLink>
        <entryLink import="true" name="Chainsword" hidden="false" id="assault-standard-cs" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="assault-standard-cs-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-standard-cs-max" includeChildSelections="false" automatic="true"/></constraints></entryLink>
      </entryLinks>

      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Assault Marine" hidden="false" id="assault-marine" defaultAmount="9">
          <constraints><constraint type="min" value="9" field="selections" scope="parent" shared="true" id="assault-marine-min" includeChildSelections="false"/><constraint type="max" value="19" field="selections" scope="parent" shared="true" id="assault-marine-max" includeChildSelections="false"/></constraints>
          <costs><cost name="Points" typeId="pts" value="18"/></costs>
          <profiles><profile name="Legion Assault Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-assault-marine"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">1</characteristic><characteristic name="Ld" typeId="model-ld">8</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
        </selectionEntry>

        <selectionEntry type="model" import="true" name="Legion Assault Sergeant" hidden="false" id="assault-sergeant" defaultAmount="1">
          <constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-max" includeChildSelections="false" automatic="true"/></constraints>
          <costs><cost name="Points" typeId="pts" value="18"/></costs>
          <profiles><profile name="Legion Assault Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-assault-sergeant"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">2</characteristic><characteristic name="Ld" typeId="model-ld">9</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
          <rules><rule name="Sergeant Armoury" id="assault-rule-sgt-armoury" hidden="false"><description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are available at the points costs shown in this squad entry and are not repeated in the additional Armoury.</description></rule></rules>

          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws (replaces Bolt Pistol and Chainsword)" hidden="false" id="assault-sgt-pair-claws">
              <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-pair-claws-max" includeChildSelections="false"/></constraints>
              <costs><cost name="Points" typeId="pts" value="20"/></costs>
              <entryLinks><entryLink import="true" name="Pair of Lightning Claws" hidden="false" id="assault-sgt-pair-claws-link" type="selectionEntry" targetId="gear-pair-claws" defaultAmount="1"/></entryLinks>
              <modifiers><modifier type="set" value="true" field="hidden"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="assault-sgt-pistol" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="parent" childId="assault-sgt-melee" shared="true" includeChildSelections="true"/><condition type="atLeast" value="1" field="selections" scope="parent" childId="assault-sgt-armoury-weapons" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier></modifiers>
            </selectionEntry>

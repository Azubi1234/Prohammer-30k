typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvii-2-ashen-circle-source" hidden="false"><ns0:description>Incendiary | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Iconoclast | 5 | 4 | 4 | 4 | 1 | 4 | 3 | 10 | 3+
Force Organisation:
AXE-RAKE An Axe-rake is a close-combat weapon. Attacks made with an Axe-rake are resolved at +1 Strength. If an enemy unit Retreats from a close combat involving one or more models armed with Axe-rakes, reduce its Retreat distance by 1", to a minimum of 1". BITTER DUTY Only an Independent Character specifically permitted to join Bitter Duty units may join an Ashen Circle Squad.
• Fast Attack
Unit Composition:
• 4 Incendiaries
• 1 Iconoclast
Unit Type:
• Jump Infantry
• The Iconoclast is a Character
Wargear:
• Hardened Power Armour
• Jump Pack
• Hand Flamer
• Axe-rake
• Frag grenades
Special Rules:
• Legiones Astartes (Word Bearers)
• Hardened Armour
• Bitter Duty
OPTIONS
• The squad may include up to five additional Incendiaries for +25 points per model.
• Any model may replace his Axe-rake with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
ICONOCLAST
The Iconoclast may replace his Hand Flamer with:
• Plasma pistol ................................... +15 points
The Iconoclast may take:
• Artificer Armour ............................... +10 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xvii-2-ashen-circle-additional"><ns0:constraints><ns0:constraint id="r41-unit-xvii-2-ashen-circle-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xvii-2-ashen-circle-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +25 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvii-2-ashen-circle-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="r41-unit-xvii-2-ashen-circle-opt-0-rending-weapon"><ns0:constraints><ns0:constraint id="r41-unit-xvii-2-ashen-circle-opt-0-rending-weapon-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-2-ashen-circle-opt-0-context" hidden="false"><ns0:description>• Any model may replace his Axe-rake with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r41-unit-xvii-2-ashen-circle-opt-1-power-weapon"><ns0:constraints><ns0:constraint id="r41-unit-xvii-2-ashen-circle-opt-1-power-weapon-max" field="selecti
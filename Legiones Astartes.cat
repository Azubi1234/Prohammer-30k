de cost note" id="r42-role-viii-1-effects-raptor-cult-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-8-squadwide" hidden="false"><ns0:description>The source prices this option at +1 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="MEDUSAN IMMORTAL SQUAD" hidden="true" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-x-1-company-of-bitter-iron" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Medusan Immortal" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Immortal Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-source" hidden="false"><ns0:description>Medusan Immortal | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+/5+
Immortal Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+/5+
Force Organisation:
• Troops
• 0–1
Unit Composition:
• 4 Medusan Immortals
• 1 Immortal Sergeant
Unit Type:
• Infantry
• The Immortal Sergeant is a Character
Wargear:
• Power Armour
• Bolter
• Boarding Shield
Special Rules:
• Legiones Astartes (Iron Hands)
• Stubborn
OPTIONS
• The squad may include up to fifteen additional Medusan Immortals for +27 points per model.
• For every five models in the squad, one Medusan Immortal may
replace his Bolter with:
• Flamer .......................................... +5 points
• Meltagun ....................................... +10 points
• Plasma Gun ..................................... +15 points
• Graviton Gun ................................... +15 points
• One model may carry:
• Legion Vexilla ................................. +10 points
• One different model may carry:
• Nuncio Vox ..................................... +10 points
• The entire squad may take:
• Frag grenades .............................. +1 point per model
• Krak grenades .............................. +2 points per model
IMMORTAL SERGEANT
The Immortal Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
DEDICATED TRANSPORT
A squad of ten models or fewer may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>After the massacre at Isstvan V, many Iron Hands renounced their former Clan and Company markings and gathered into formations of Medusan Immortals, seeking vengeance against the Traitors and redemption through death in battle.
EFFECTS
COMPANY OF IMMORTALS
Medusan Immortal Squads may be selected as Troops choices and may fulfil compulsory Troops selections.
At least one compulsory Troops choice in the Detachment must be a Medusan Immortal Squad.
IMMORTAL HATRED
All units in the Detachment with the Legiones Astartes (Iron Hands) special rule gain Hatred against Traitor forces.
For the purposes of this rule, a Traitor force is any army or unit specifically designated as Traitor by the mission, campaign or army list being used.
BITTER DUTY
A Medusan Immortal Squad gains the Fearless special rule while the majority of its surviving models are within the enemy deployment zone.
NO DEATH WITHOUT PURPOSE
Whenever a Medusan Immortal Squad is completely destroyed while the majority of its models were within the enemy deployment zone immediately before its destruction, every friendly Iron Hands unit within 6" may immediately re-roll any failed Morale or Pinning test it is required to make as a result of that destruction.
LIMITATIONS
This Rite of War may only be selected by a Loyalist Iron Hands Detachment.
The army may not include an Allied Detachment.
The army may not include Ferrus Manus.</ns0:description></ns0:rule><ns0:rule id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-opt-0-flamer"><ns0:constraints><ns0:constraint id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-opt-0-flamer-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-opt-0-context" hidden="false"><ns0:description>replace his Bolter with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-opt-1-meltagun"><ns0:constraints><ns0:constraint id="r42-role-x-1-effects-company-of-immortals-medusan-immortal-squads-r41-unit-x-0-medusan-immortal-squad-opt-1-meltagun-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" incl
          </ns0:constraints>
          <ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Jetbike (Sky Hunter Phalanx)" hidden="true" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike">
      <ns0:constraints><ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="40" /></ns0:costs><ns0:rules>
        <ns0:rule name="Space Marine Bike" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-gear-gear-hq-bike-rule" hidden="false">
          <ns0:description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Jetbike Command" id="r40-da-storm-centurion-group-r40-da-storm-tactical-r37-centurion-jetbike-rule" hidden="false"><ns0:description>Replaces the model’s Space Marine Bike. This option includes the normal +35 point Space Marine Bike and the +5 point Sky Hunter Phalanx Jetbike upgrade. The model follows the normal rules for Jetbikes.</ns0:description></ns0:rule></ns0:rules>
    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    </ns0:selectionEntries><ns0:entryLinks>
            <ns0:entryLink import="true" name="Jump Pack" id="r40-da-storm-centurion-group-r40-da-storm-tactical-hq-centurion-jump" type="selectionEntry" targetId="gear-hq-jump" hidden="false">

          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Armistos" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-armistos" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-armistos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Armistos" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-armistos-rule" hidden="false">
                  <ns0:description>Fire Control: When this Heavy Support Squad enters Overwatch, its models may declare Overwatch targets out to the normal maximum range of their weapons rather than being restricted to 24". All other Overwatch rules and restrictions apply normally.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Siege Breaker" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-siegebreaker" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-siegebreaker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="35" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Siege Breaker" id="r42-role-xiv-0-legion-heavy-support-squads-hs-hss-siegebreaker-rule" hidden="false">
                  <ns0:description>Art of Destruction: Heavy weapons fired by this unit receive +1 to Armour Penetration rolls against vehicles and fortifications. This does not apply to pistols, grenades or close-combat attacks.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>

          <ns0:profiles>
            <ns0:profile name="Legion Breacher Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-breacher-marine">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>

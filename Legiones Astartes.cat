-unit-xvi-4-ezekyle-abaddon-first-captain-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Ezekyle Abaddon" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">5</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvi-4-ezekyle-abaddon-first-captain-source" hidden="false"><ns0:description>Ezekyle Abaddon | 6 | 5 | 5 | 4 | 3 | 5 | 3 | 10 | 2+/4+
Force Organisation:
CTHONIAN DREADPLATE The Cthonian Dreadplate counts as Cataphractii Terminator Armour. In addition, add +1 to the Reserve roll made for Abaddon and any unit with which he began the battle in Reserve. MASTER OF THE JUSTAERIN If Abaddon is the army's Warlord, the army may include one additional Justaerin Terminator Squad beyond the normal 0–1 limit. A Justaerin Terminator Squad containing Abaddon gains Fearless. The squad may also purchase the Furious Charge Veteran Skill for +4 points per model. COMMAND RETINUE Abaddon may select either: • a Justaerin Terminator Squad; or • a Legion Terminator Command Squad as his retinue. The selected squad does not occupy a separate Force Organisation slot.
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Cthonian Dreadplate
• Master-crafted Power fist
• Master-crafted Power sword
• Master-crafted Storm bolter
• Banestrike Ammunition
Special Rules:
• Legiones Astartes (Sons of Horus)
• Independent Character
• Master of the Legion
• First Captain
• Master of the Justaerin
RESTRICTION
Abaddon may only be included in an army of 1,500 points or more.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="HORUS AXIMAND, “LITTLE HORUS”" hidden="false" id="r41-unit-xvi-5-horus-aximand-little-horus"><ns0:costs><ns0:cost name="Points" typeId="pts" value="175" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xvi-5-horus-aximand-little-horus-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xvi-5-horus-aximand-little-horus-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Horus Aximand" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-5-horus-aximand-little-horus-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:charac
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Reconnaissance Squad" hidden="false" id="recon-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="recon-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="recon-standard-wargear" hidden="false">
          <description>Every model is equipped with Recon Armour, a Bolter, a Bolt Pistol and Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes" id="recon-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Support Squad" id="recon-support-squad" hidden="false">
          <description>This unit may be selected as a Troops choice, but may not fulfil either of the army' two compulsory Troops selections unless a Legion-specific rule or Rite of War removes this restriction.</description>
        </rule>
        <rule name="Scout" id="recon-scout" hidden="false">
          <description>Uses the normal Scout rule from ProHammer Classic.</description>
        </rule>
        <rule name="Infiltrate" id="recon-infiltrate" hidden="false">
          <description>Uses the normal Infiltrate rule from ProHammer Classic.</description>
        </rule>
        <rule name="Move Through Cover" id="recon-mtc" hidden="false">
          <description>Uses the normal Move Through Cover rule from ProHammer Classic.</description>
        </rule>
        <rule name="Acute Senses" id="recon-acute-senses" hidden="false">
          <description>Uses the normal Acute Senses rule from ProHammer Classic.</description>
        </rule>
        <rule name="Frag Grenades" id="recon-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Recon Armour" hidden="false" id="recon-standard-armour" type="selectionEntry" targetId="gear-recon-armour" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolter" hidden="false" id="recon-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="recon-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Recon Marine" hidden="false" id="recon-marine" defaultAmount="4">
          <constraints>
            <constraint type="min" value="4" field="selections" scope="parent" shared="true" id="recon-marine-min" includeChildSelections="false" />
            <constraint type="max" value="9" field="selections" scope="parent" shared="true" id="recon-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="14" />
          </costs>
          <profiles>
            <profile name="Legion Recon Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-recon-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Recon Sergeant" hidden="false" id="recon-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="14" />
          </costs>
          <profiles>
            <profile name="Legion Recon Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-recon-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sj" typeId="model-sv">4+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="recon-rule-sgt-armoury" hidden="false">
              <description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are not repeated in the additional Armoury. Any additional Armoury weapon replaces one of the Sergeant' existing weapons so that he never carries more than two weapons; a pair of Lightning Claws replaces both.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Weapon Options" id="recon-sgt-weapons" hidden="false">
              <constraints>
                <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="recon-sgt-weapons-max" includeChildSelections="true" />
              </constraints>
              <modifiers>
                <modifier type="set" value="1" field="recon-sgt-weapons-max">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="parent" childId="recon-sgt-pair-claws" shared="true" includeChildSelections="true" />
                  </conditions>
                </modifier>
              </modifiers>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws (Armoury; replaces both weapons)" hidden="false" id="recon-sgt-pair-claws">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-pair-claws-max" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="30" />
                  </costs>
                  <entryLinks>
                    <entryLink import="true" name="Pair of Lightning Claws" hidden="false" id="recon-sgt-pair-claws-link" type="selectionEntry" targetId="gear-pair-claws" defaultAmount="1" />
                  </entryLinks>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Replace Bolter" id="recon-sgt-bolter" hidden="false">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-sgt-bolter-max" includeChildSelections="false" />
                  </constraints>
                  <entryLinks>
                    <entryLink import="true" name="Astartes Shotgun" hidden="false" id="recon-sgt-shotgun" type="selectionEntry" targetId="gear-astartes-shotgun" />
                    <entryLink import="true" name="Chainsword" hidden="false" id="recon-sgt-chainsword" type="selectionEntry" targetId="gear-chainsword" />
                    <entryLink import="true" name="Combat Blade" hidden="false" id="recon-sgt-combat-blade" type="selectionEntry" targetId="gear-combat-blade" />
                    <entryLink import="true" name="Sniper Rifle" hidden="false" id="recon-sgt-sniper" type="selectionEntry" targetId="gear-sniper-rifle">
                      <costs>
                        <cost name="Points" typeId="pts" value="5" />
                      </costs>
                    </entryLink>
                    <entryLink import="true" name="Combi-Flamer" hidden="false" id="recon-sgt-cf" type="selectionEntry" targetId="gear-combi-flamer">
                      <costs>
                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                    </entryLink>
                    <entryLink import="true" name="Combi-Volkite Charger" hidden="false" id="recon-sgt-cv" type="selectionEntry" targetId="gear-combi-volkite">
                      <costs>
                        <cost name="Points" typeId="pts" value="10" />
                      </costs>
                    </entryLink>
                    <entryLink import="true" name="Combi-Meltagun" hidden="false" id="recon-sgt-cm" type="selectionEntry" targetId="gear-combi-melta">
                      <costs>
                        <cost name="Points" typeId="pts" value="15" />

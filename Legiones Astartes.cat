            </ns0:entryLink>
            <ns0:entryLink import="true" name="Plasma Blaster (replaces built-in Twin-linked Bolter)" hidden="false" id="r35-fury-contemptor-contemptor-secondary-pb" type="selectionEntry" targetId="gear-plasma-blaster">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-contemptor-contemptor-secondary-pb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
          <ns0:modifiers>
            <ns0:modifier type="set" value="false" field="hidden">
              <ns0:conditions>

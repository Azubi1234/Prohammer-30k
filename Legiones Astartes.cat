        <profile name="Meltagun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-meltagun">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">8</characteristic>
            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1, Melta</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Melta" id="rule-melta" hidden="false">
          <description>At half the weapon's maximum range or less, roll 2D6 for Armour Penetration instead of D6.</description>
        </rule>
      </rules>
    </selectionEntry>

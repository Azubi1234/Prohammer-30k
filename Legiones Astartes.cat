lse" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-ix-9-azkaellon-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Azkaellon" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-ix-9-azkaellon-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-ix-9-azkaellon-source" hidden="false"><ns0:description>Azkaellon | 6 | 5 | 4 | 4 | 2 | 4 | 3 | 10 | 2+/5+
GLAIVE ENCARMINE The Glaive Encarmine is a Two-Handed, Master-crafted Power Weapon. Attacks made with it are resolved at Strength 6. MASTER OF THE SERAPHIM A Sanguinary Guard Squad containing Azkaellon may deploy using Deep Strike even if the mission does not normally permit Deep Strike. If the squad has been selected as a character's retinue, that character must also be capable of deploying by Deep Strike or the unit must deploy normally.
One Sanguinary Guard may be upgraded to Azkaellon for +35 points.
Azkaellon replaces one Sanguinary Guard and remains part of the unit for the entire battle. Azkaellon is a Character but is not an Independent Character.
Wargear:
• Artificer Armour
• Sanguine-pattern Jump Pack
• Death Mask
• Glaive Encarmine
• Angelus Boltgun
• Frag grenades
Special Rules:
• Legiones Astartes (Blood Angels)
• Master of the Seraphim
If the Sanguinary Guard purchase Krak grenades or Melta bombs, Azkaellon receives the same upgrade at the normal squad cost.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="NASSIR AMIT, THE FLESH TEARER" hidden="false" id="r41-unit-ix-10-nassir-amit-the-flesh-tearer"><ns0:costs><ns0:cost name="Points" typeId="pts" value="180" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-ix-10-nassir-amit-the-flesh-tearer-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-ix-10-nassir-amit-the-flesh-tearer-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Nassir Amit" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-ix-10-nassir-amit-the-flesh-tearer-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="S
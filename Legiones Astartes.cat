="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Marius Gage" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiii-4-marius-gage-first-master-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiii-4-marius-gage-first-master-source" hidden="false"><ns0:description>Marius Gage | 6 | 5 | 4 | 4 | 3 | 5 | 4 | 10 | 2+/4+
Force Organisation:
• HQ
FIRST MASTER OF THE LEGION Friendly non-Vehicle Ultramarines units with at least one model within 12" of Marius Gage may use his Leadership characteristic when taking Morale or Pinning tests. MASTER OF ORGANISATION After both armies have deployed but before the first turn begins, select one Ultramarines Infantry unit which deployed normally. That unit may immediately be redeployed anywhere wholly within the Ultramarines deployment zone. All normal deployment restrictions must still be obeyed. The unit may not be placed into Reserve. Any Independent Characters already joined to the unit are redeployed with it. CALCULATED RESPONSE Marius Gage and any Ultramarines unit he has joined have Counter-Attack. COMMAND RETINUE Marius Gage may select a Legion Command Squad, Legion Terminator Command Squad or Invictarus Suzerain Squad as his retinue. The selected squad does not occupy a separate Force Organisation slot.
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Iron Halo
• Master-crafted Power Weapon
• Bolt pistol
• Frag grenades
Special Rules:
• Legiones Astartes (Ultramarines)
• Independent Character
• Master of the Legion
• First Master of the Legion
• Master of Organisation
• Calculated Response
OPTIONS
• Marius Gage may take:
• Krak grenades ................................... +2 points
• Melta bombs .................................... +5 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xiii-4-marius-gage-first-master-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xiii-4-marius-gage-first-master-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xiii-4-marius-gage-first-master-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiii-4-marius-gage-first-master-opt-0-context" hidden="false"><ns0:description>• Marius Gage may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="r41-unit-xiii-4-marius-gage-first-master-opt-1-melta-bombs"><ns0:constraints><ns0:constraint id="r41-unit-xiii-4-marius-gage-first-master-opt-1-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiii-4-marius-gage-first-master-opt-1-context" hidden="false"><ns0:description>• Marius Gage may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="REMUS VENTANUS" hidden="false" id="r41-unit-xiii-5-remus-ventanus"><ns0:costs><ns0:cost name="Points" typeId="pts" value="145" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xiii-5-remus-ventanus-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xiii-5-remus-ventanus-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Remus Ventanus" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiii-5-remus-ventanus-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiii-5-remus-ventanus-source" hidden="false"><ns0:description>Remus Ventanus | 5 | 5 | 4 | 4 | 2 | 5 | 3 | 10 | 2+/5+
THE SAVIOUR OF CALTH Ventanus and any Ultramarines unit he has joined have Fearless while at least one model from the unit is within 6" of an objective. PRACTICAL COMMANDER After both armies have deployed but before the first turn begins, nominate one Legion Tactical Squad in the army. That squad gains Counter-Attack for the duration of the battle. COMMAND RETINUE Ventanus may select one Legion Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Refractor Field
• Power weapon
• Bolt pistol
• Nuncio Vox
• Frag grenades
• Legion Standart
Special Rules:
• Legiones Astartes (Ultramarines)
• Independent Character
• The Saviour of Calth
• Practical Commander
OPTIONS
• Remus Ventanus may take:
• Krak grenades ................................... +2 points
• Melta bombs .................................... +5 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xiii-5-remus-ventanus-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xiii-5-remus-ventanus-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xiii-5-remus-ventanus-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiii-5-remus-ventanus-opt-0-context" hidden="false"><ns0:description>• Remus Ventanus may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="r41-unit-xiii-5-remus-ventanus-opt-1-melta-bombs"><ns0:constraints><ns0:constraint id="r41-unit-xiii-5-remus-ventanus-opt-1-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiii-5-remus-ventanus-opt-1-context" hidden="false"><ns0:description>• Remus Ventanus may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="AEONID THIEL" hidden="false" id="r41-unit-xiii-6-aeonid-thiel"><ns0:costs><ns0:cost name="Points" typeId="pts" value="80" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xiii-6-aeonid-thiel-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xiii-6-aeonid-thiel-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Aeonid Thiel" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiii-6-aeonid-thiel-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiii-6-aeonid-thiel-source" hidden="false"><ns0:description>Aeonid Thiel | 5 | 5 | 4 | 4 | 2 | 5 | 3 | 10 | 3+/5+
One Legion Tactical Squad or Legion Veteran Squad may replace its Sergeant with Aeonid Thiel for +80 points. Thiel remains part of the squad for the entire battle. He is a Character but is not an Independent Character.
UNORTHODOX TACTICS After deployment but before the first turn begins, choose one of the following special rules: • Counter-Attack • Move Through Cover • Night Vision • Tank Hunters Thiel and every model in his squad gain the selected special rule for the duration of the battle. The unit retains the selected rule even if Thiel is subsequently slain.
Wargear:
• Power Armour
• Refractor Field
• Power weapon
• Bolt pistol
• Purity Seals
• Frag grenades
Special Rules:
• Legiones Astartes (Ultramarines)
• Unorthodox Tactics
If the squad purchases Krak grenades or Melta bombs,
Thiel receives the same upgrade at the normal squad cost.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="HONOURED TELEMECHRUS" hidden="false" id="r41-unit-xiii-7-honoured-telemechrus"><ns0:costs><ns0:cost name="Points" typeId="pts" value="215" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xiii-7-honoured-telemechrus-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-loyalist" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xiii-7-honoured-telemechrus-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Honoured Telemechrus" typeId="prof-walker" typeName="Walker" hidden="false" id="r41-unit-xiii-7-honoured-telemechrus-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="walker-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="walker-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="walker-s">7</ns0:characteristic><ns0:characteristic name="Front" typeId="walker-front">13</ns0:characteristic><ns0:characteristic name="Side" typeId="walker-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="walker-rear">10</ns0:characteristic><ns0:characteristic name="I" typeId="walker-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="walker-a">4</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiii-7-honoured-telemechrus-source" hidden="false"><ns0:description>Honoured Telemechrus | 6 | 5 | 7 | 13 | 12 | 10 | 4 | 4

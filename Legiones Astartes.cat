              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="215" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Standard Wargear" id="hq-centurion-ret-tc-std" hidden="false">
                  <ns0:description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Legiones Astartes" id="hq-centurion-ret-tc-la" hidden="false">
                  <ns0:description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Retinue" id="hq-centurion-ret-tc-ret" hidden="false">
                  <ns0:description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</ns0:description>
                </ns0:rule>

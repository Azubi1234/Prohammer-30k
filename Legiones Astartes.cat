        <ns0:profile name="Missile Launcher with Suspensor Web - Krak" id="gear-missile-susp-prof-1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>

      <ns0:selectionEntryGroup id="r40-da-ammo-hs-venator" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-ammo-hs-venator-hs-venator-sp-hb" name="Molecular Acid Shells (for Heavy Bolter Sponsons)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-hs-venator-hs-venator-sp-hb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hs-venator-sp-hb" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r40-da-ammo-hs-venator-hs-venator-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-hs-venator-hs-venator-p6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hs-venator-p6" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-venator-hunter-killer-missile" hidden="false" import="true">
          <ns0:constraints>

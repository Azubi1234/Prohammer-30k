        </ns0:rule>
        <ns0:rule name="Special Rules" id="da22-sedras-base" hidden="false">
          <ns0:description>Legiones Astartes (Dark Angels); Independent Character; Master of the Legion; Stubborn; Dreadwing.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Death of Worlds" id="da22-sedras-deathworlds" hidden="false">
          <ns0:description>Two-Handed Power Weapon. Attacks are Strength 6. Natural To Wound rolls of 5 or 6 inflict Massive Wound (D3).</ns0:description>
        </ns0:rule>
        <ns0:rule name="Ancient of War" id="da22-sedras-ancient" hidden="false">
          <ns0:description>After deployment but before first turn nominate one enemy faction. Sedras and friendly Dark Angels units with a model within 6" may re-roll To Hit rolls of 1 and To Wound rolls of 1 against models of that faction in Shooting and Assault.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Eskaton" id="da22-sedras-eskaton" hidden="false">
          <ns0:description>Always Dreadwing. Sedras and any Dark Angels unit he joins gain the Siege Specialists Veteran Skill.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Cenobium Retinue" id="da22-sedras-ret" hidden="false">
          <ns0:description>One Inner Circle Knights Cenobium may be his personal retinue without a separate FOC slot; Sedras and the Cenobium count as one HQ selection.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    <ns0:categoryLinks><ns0:categoryLink id="da22-sedras-cat" targetId="cat-hq" name="HQ" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry>

rue" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Dark Fury" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xix-1-dark-fury-assault-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Strike Leader" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xix-1-dark-fury-assault-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xix-1-dark-fury-assault-squad-source" hidden="false"><ns0:description>Dark Fury | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Strike Leader | 5 | 4 | 4 | 4 | 1 | 5 | 3 | 9 | 3+
Force Organisation:
• Fast Attack
Unit Composition:
• 4 Dark Furies
• 1 Dark Fury Strike Leader
Unit Type:
• Jump Infantry
• Dark Fury Strike Leader is a Character
Wargear:
• Power Armour
• Jump Pack
• Bolt pistol
• Raven's Talons
• Frag grenades
Special Rules:
• Legiones Astartes (Raven Guard)
• Swooping Killers
OPTIONS
• The squad may include up to five additional Dark Furies for +34 points per model.
• The entire squad may take:
• Krak grenades ........................... +2 points per model
• Melta bombs ............................. +5 points per model
• The Dark Fury Strike Leader may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
SWOOPING KILLERS During an Assault phase in which the Dark Furies charge, models in the squad may re-roll To Hit rolls of 1 until the end of that Assault phase. COMMAND SQUAD A Dark Fury Assault Squad may be selected as the retinue of a Raven Guard Praetor equipped with a Jump Pack. If selected in this manner, the Dark Fury Assault Squad does not occupy a Fast Attack choice. The Praetor and Dark Fury Squad count as a single HQ selection for Force Organisation purposes.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xix-1-dark-fury-assault-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xix-1-dark-fury-assault-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="34" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xix-1-dark-fury-assault-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +34 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xix-1-dark-fury-assault-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-xix-1-dark-fury-assault-squad-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xix-1-dark-fury-assault-squad-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" va
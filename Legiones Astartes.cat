                  </ns0:selectionEntryGroups><ns0:entryLinks>
            <ns0:entryLink import="true" name="Rhino" hidden="false" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tr-rhino" type="selectionEntry" targetId="transport-rhino">

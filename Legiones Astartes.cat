          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="hs-venator-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="hs-venator-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-venator-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="hs-venator-auxiliary-drive-rule" hidden="false">
              <ns0:description>On a 4+ at the start of the Movement phase, remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="hs-venator-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-venator-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="hs-venator-armoured-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Achilles-Alpha Pattern Land Raider" id="hs-achilles-alpha" hidden="false" import="true">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-heavy" id="hs-achilles-alpha-cat" primary="true" name="Heavy Support" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="300" />
      </ns0:costs>
      <ns0:profiles>
        <ns0:profile name="Achilles-Alpha" id="hs-achilles-alpha-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Quad Launcher — Frag" id="hs-aa-frag" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12–60"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Shell Shock</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Quad Launcher — Shatter" id="hs-aa-shatter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Sunder</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Twin-linked Volkite Culverin" id="hs-aa-volkite" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">45"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Rending, Twin-linked</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hs-aa-wg" hidden="false">
          <ns0:description>Quad Launcher with Frag and Shatter Shells, two Twin-linked Volkite Culverins, Extra Armour, Searchlight and Smoke Launchers. Power of the Machine Spirit; Transport Capacity 6.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Enhanced Ferromantic Rites" id="hs-aa-ferro" hidden="false">
          <ns0:description>Melta weapons do not roll an additional Armour Penetration die; Lance weapons do not reduce the Achilles-Alpha’s Armour Value; apply -1 to Vehicle Damage table rolls caused by Penetrating Hits.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Galvanic Traction Drive" id="hs-aa-traction" hidden="false">
          <ns0:description>May re-roll failed Dangerous Terrain tests.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Quad Launcher Ammunition" id="hs-aa-ammo" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Incendiary Shells" id="hs-aa-incendiary" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-aa-incendiary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher — Incendiary" id="hs-aa-incendiary-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12–60"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Ignores Cover</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Splinter Shells" id="hs-aa-splinter" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-aa-splinter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher — Splinter" id="hs-aa-splinter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12–36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">2</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Rending</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Phosphex Canister Shot — requires Siege Breaker" id="hs-aa-phosphex" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-aa-phosphex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher — Phosphex" id="hs-aa-phosphex-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12–36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Poisoned (3+), Crawling Fire, Lingering Death</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Phosphex Canister Shot — requires Siege Breaker" id="hs-aa-phosphex-rule" hidden="false">
                  <ns0:description>May only be selected if the army contains a Siege Breaker or another rule specifically granting access to Phosphex ammunition.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hs-achilles-alpha" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-hs-achilles-alpha-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-hs-achilles-alpha-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-hs-achilles-alpha-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hs-achilles-alpha-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-hs-achilles-alpha-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hs-achilles-alpha-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-hs-achilles-alpha-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hs-achilles-alpha-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-hs-achilles-alpha-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hs-achilles-alpha-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-hs-achilles-alpha-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hs-achilles-alpha-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-hs-achilles-alpha-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hs-achilles-alpha-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-achilles-alpha-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-hs-achilles-alpha-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Leviathan Siege Dreadnought" id="hs-leviathan" hidden="false" import="true">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-heavy" id="hs-leviathan-cat" primary="true" name="Heavy Support" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="270" />
      </ns0:costs>
      <ns0:profiles>
        <ns0:profile name="Leviathan Siege Dreadnought" id="hs-leviathan-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="walker-ws">5</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="walker-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="walker-s">8</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="walker-front">13</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="walker-side">13</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="walker-rear">12</ns0:characteristic>
            <ns0:characteristic name="I" typeId="walker-i">4</ns0:characteristic>
            <ns0:characteristic name="A" typeId="walker-a">4</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Meltagun" id="hs-lev-melta-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Melta</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Heavy Flamer" id="hs-lev-hf-base" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hs-lev-wg" hidden="false">
          <ns0:description>Two Leviathan Siege Claws, each with an inbuilt Meltagun; two Heavy Flamers; Extra Armour; Frag grenades; Searchlight; Smoke Launchers.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Reinforced Atomantic Shielding" id="hs-lev-shield" hidden="false">
          <ns0:description>Each time the Leviathan suffers a Glancing or Penetrating Hit, on a 4+ the hit is ignored, before rolling on the Vehicle Damage table. If it suffers an Explodes! result, increase the Strength of the explosion by D3 and its radius by D3".</ns0:description>
        </ns0:rule>
        <ns0:rule name="Crushing Charge" id="hs-lev-charge" hidden="false">
          <ns0:description>On a turn in which the Leviathan charges, it may resolve two of its normally allowed close-combat attacks at Initiative 10 instead of only one as normally permitted by Hammer of Wrath.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Move Through Cover" id="hs-lev-mtc" hidden="false">
          <ns0:description>Uses the normal ProHammer Move Through Cover rule.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Leviathan Siege Claw" id="hs-lev-claw-rule" hidden="false">
          <ns0:description>Counts as a Dreadnought Close Combat Weapon.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Leviathan Siege Drill" id="hs-lev-drill-rule" hidden="false">
          <ns0:description>Counts as a Dreadnought Close Combat Weapon with Armourbane.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Arm Replacement and Attacks" id="hs-lev-arms-rule" hidden="false">
          <ns0:description>Either Siege Claw and its Meltagun may be replaced by a ranged weapon. For each Siege Claw replaced by a ranged weapon, reduce the Leviathan’s Attacks characteristic by 1.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Graviton Collapse" id="hs-lev-grav-collapse" hidden="false">
          <ns0:description>Against non-vehicle models hit by a Grav-flux Bombard, roll 2D6; if the result is greater than the model’s Strength it suffers a wound. Against vehicles, do not use the normal ProHammer Graviton rule; instead roll 3D6 for Armour Penetration.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Arm A" id="hs-lev-arm-a" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hs-lev-arm-a-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="hs-lev-arm-a-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Leviathan Siege Claw + Meltagun" id="hs-lev-arm-a-claw" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-a-claw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Leviathan Siege Drill + Meltagun" id="hs-lev-arm-a-drill" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-a-drill-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
          <ns0:entryLinks>
            <ns0:entryLink name="Leviathan Storm Cannon" id="hs-lev-arm-a-storm" type="selectionEntry" targetId="hsgear-lev-storm" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-a-storm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Cyclonic Melta Lance" id="hs-lev-arm-a-melta" type="selectionEntry" targetId="hsgear-lev-melta" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-a-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Grav-flux Bombard" id="hs-lev-arm-a-grav" type="selectionEntry" targetId="hsgear-gravflux" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-a-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Arm B" id="hs-lev-arm-b" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hs-lev-arm-b-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="hs-lev-arm-b-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Leviathan Siege Claw + Meltagun" id="hs-lev-arm-b-claw" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-b-claw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Leviathan Siege Drill + Meltagun" id="hs-lev-arm-b-drill" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-b-drill-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
          <ns0:entryLinks>
            <ns0:entryLink name="Leviathan Storm Cannon" id="hs-lev-arm-b-storm" type="selectionEntry" targetId="hsgear-lev-storm" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-b-storm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Cyclonic Melta Lance" id="hs-lev-arm-b-melta" type="selectionEntry" targetId="hsgear-lev-melta" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-b-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Grav-flux Bombard" id="hs-lev-arm-b-grav" type="selectionEntry" targetId="hsgear-gravflux" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-arm-b-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Optional Equipment" id="hs-lev-eq" hidden="false">
          <ns0:entryLinks>
            <ns0:entryLink name="Phosphex Discharger" id="hs-lev-phosphex" type="selectionEntry" targetId="hsgear-phosphex-dis" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-phosphex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Dedicated Transport" id="hs-lev-transport" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hs-lev-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink name="Legion Dreadnought Drop Pod" id="hs-lev-dreadpod" type="selectionEntry" targetId="transport-dreadnought-pod" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hs-lev-dreadpod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hs-leviathan" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-hs-leviathan-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-hs-leviathan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-hs-leviathan-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hs-leviathan-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-hs-leviathan-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hs-leviathan-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-hs-leviathan-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hs-leviathan-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-hs-leviathan-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hs-leviathan-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-hs-leviathan-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hs-leviathan-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-hs-leviathan-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hs-leviathan-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hs-leviathan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-hs-leviathan-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="upgrade" name="Twin-linked Volkite Caliver (replaces one Heavy Flamer)" id="hs-lev-vcal" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-lev-vcal-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Twin-linked Volkite Caliver" id="hs-lev-vcal-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="Range" typeId="ranged-range">30"</ns0:characteristic>
                <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
                <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
                <ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Rending, Twin-linked</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="hs-lev-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-lev-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="hs-lev-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Legion Praetor" id="hq-praetor" hidden="false" import="true">
      <ns0:constraints>
        <ns0:constraint id="hq-praetor-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
      </ns0:constraints>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="125" />
      </ns0:costs>
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-hq" id="hq-praetor-foc-cat" primary="true" name="HQ" hidden="false" />
      </ns0:categoryLinks>
      <ns0:profiles>
        <ns0:profile name="Legion Praetor" id="hq-praetor-prof" typeId="prof-model" typeName="Model" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
            <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
            <ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic>
            <ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic>
            <ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic>
            <ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic>
            <ns0:characteristic name="Sv" typeId="model-sv">3+ / 4++</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hq-praetor-std" hidden="false">
          <ns0:description>Power Armour, Bolt Pistol, Chainsword, Frag Grenades and Iron Halo. The Iron Halo grants a 4+ Invulnerable Save and is already included in the 125-point cost.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="hq-praetor-la" hidden="false">
          <ns0:description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Independent Character" id="hq-praetor-ic" hidden="false">
          <ns0:description>Follows the Independent Character rules in ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="hq-praetor-frag" hidden="false">
          <ns0:description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Master of the Legion" id="hq-praetor-motl" hidden="false">
          <ns0:description>A Detachment containing a model with this rule may select one Rite of War for which it qualifies. An army may include no more than one model with Master of the Legion for every full 1,000 points. A model with this rule may select an eligible retinue as described by its entry.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Space Marine Armoury" id="hq-praetor-armoury-rule" hidden="false">
          <ns0:description>The Praetor may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Bolt Pistol" id="hq-praetor-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="hq-praetor-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="hq-praetor-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Chainsword" id="hq-praetor-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="hq-praetor-cs-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="hq-praetor-cs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
      <ns0:entryLink id="r43-hq-praetor-ec-spear" name="Phoenix Spear" type="selectionEntry" targetId="r43-ec-phoenix-spear" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-praetor-ec-spear-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-praetor-ec-lasers" name="Digital Lasers" type="selectionEntry" targetId="r43-ec-digital-lasers" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-praetor-ec-lasers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-praetor-ec-shrieker" name="Sonic Shrieker" type="selectionEntry" targetId="r43-ec-sonic-shrieker" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-praetor-ec-shrieker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditi
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-p7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>

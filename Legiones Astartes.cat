                      </ns0:conditions>
                    </ns0:modifier>
                    <ns0:modifier type="set" value="3" field="hs-lr-ph-pintle-max">
                      <ns0:conditions>
                        <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-lr-phobos" shared="true" includeChildSelections="true" />
                      </ns0:conditions>
                    </ns0:modifier>
                  </ns0:modifiers>
                  <ns0:entryLinks>
                    <ns0:entryLink name="Twin-linked Bolter" id="hs-lr-ph-p0" type="selectionEntry" targetId="gear-tl-bolter" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p0-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Combi-Flamer" id="hs-lr-ph-p1" type="selectionEntry" targetId="gear-combi-flamer" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p1-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Combi-Grenade Launcher" id="hs-lr-ph-p2" type="selectionEntry" targetId="gear-combi-grenade" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p2-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Combi-Meltagun" id="hs-lr-ph-p3" type="selectionEntry" targetId="gear-combi-melta" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p3-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Combi-Plasma Gun" id="hs-lr-ph-p4" type="selectionEntry" targetId="gear-combi-plasma" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p4-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Combi-Volkite Charger" id="hs-lr-ph-p5" type="selectionEntry" targetId="gear-combi-volkite" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hs-lr-ph-p5-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="5" />
                      </ns0:costs>
                    </ns0:entryLink>
                    <ns0:entryLink name="Heavy Bolter" id="hs-lr-ph-p6" type="selectionEntry" targetId="gear-heavy-bolter" hidden="false" import="true">

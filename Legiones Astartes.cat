></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="JORLUND HUNTER PACK" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack"><ns0:costs><ns0:cost name="Points" typeId="pts" value="100" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-vi-4-jorlund-hunter-pack-cat" name="Troops" hidden="false" targetId="cat-troops" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Jorlund Hunter" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Hunt-master" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-vi-4-jorlund-hunter-pack-source" hidden="false"><ns0:description>Jorlund Hunter | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 8 | 3+
Hunt-master | 4 | 4 | 4 | 4 | 1 | 4 | 3 | 9 | 3+
SCOURING TEMPEST Once per battle, before the Jorlund Hunter Pack shoots, the controlling player may declare a Scouring Tempest. Until the end of that Shooting phase, models in the pack may re-roll failed To Wound rolls made with Hand Flamers and Flamers.
Force Organisation:
• Troops
Unit Composition:
• 4 Jorlund Hunters
• 1 Hunt-master
Unit Type:
• Infantry
• The Hunt-master is a Character
Wargear:
• Power Armour
• Hand flamer
• Chainsword
• Frag grenades
Special Rules:
• Legiones Astartes (Space Wolves)
• Scouring Tempest
OPTIONS
• The pack may include up to five additional Jorlund Hunters for +18 points per model.
• For every five models in the pack, one Jorlund Hunter may
replace his Hand flamer with:
• Flamer ......................................... +5 points
• Volkite serpenta ............................... +5 points
• One model may carry:
• Legion Vexilla ............................... +10 points
• The entire pack may take:
• Krak grenades ........................... +2 points per model
HUNT-MASTER
The Hunt-master may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Space Wolves Armoury.
DEDICATED TRANSPORT
The pack may select a Rhino, Drop Pod or Dreadclaw Drop Pod.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-additional"><ns0:constraints><ns0:constraint id="r41-unit-vi-4-jorlund-hunter-pack-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="18" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-vi-4-jorlund-hunter-pack-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +18 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-opt-0-flamer"><ns0:constraints><ns0:constraint id="r41-unit-vi-4-jorlund-hunter-pack-opt-0-flamer-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-vi-4-jorlund-hunter-pack-opt-0-context" hidden="false"><ns0:description>replace his Hand flamer with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Volkite serpenta" hidden="false" id="r41-unit-vi-4-jorlund-hunter-pack-opt-1-volkite-serpenta"><ns0:constraints><ns0:constraint id="r41-unit-vi-4-jorlund-hunter-pack-opt-1-volkite-serpenta-m
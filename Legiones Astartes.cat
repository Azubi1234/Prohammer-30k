                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Twin-linked</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>

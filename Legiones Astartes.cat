        <ns0:selectionEntryGroup name="Weapon Replacements (max 100 Armoury pts; max 2 weapons)" id="hq-praetor-weapons" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hq-praetor-weapons-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="hq-praetor-weapons-pts-max" type="max" value="100" field="pts" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:rules>
            <ns0:rule name="Armoury Weapon Restrictions" id="hq-praetor-weap-rule" hidden="false">
              <ns0:description>These selections replace the model's Bolt Pistol and/or Chainsword. A model may carry no more than two weapons, only one of which may be two-handed. A Pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless specifically permitted. Equipment included in the unit entry does not count against the Armoury allowance.</ns0:description>
            </ns0:rule>
          </ns0:rules>
          <ns0:selectionEntryGroups>
            <ns0:selectionEntryGroup name="Single-handed Weapons" id="hq-praetor-single" hidden="false">
              <ns0:constraints>
                <ns0:constraint id="hq-praetor-single-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
              </ns0:constraints>

                      </ns0:selectionEntries>
                    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-spearhead" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntryGroup>
                  </ns0:selectionEntryGroups><ns0:modifiers>
            <ns0:modifier type="set" value="false" field="hidden">
              <ns0:conditions>
                <ns0:condition type="equalTo" value="9" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:constraints>
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-transport-max" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Rhino" hidden="false" id="tac-rhino" type="selectionEntry" targetId="transport-rhino">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-rhino-max" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Drop Pod" hidden="false" id="tac-drop-pod" type="selectionEntry" targetId="transport-drop-pod">
              <ns0:constraints>

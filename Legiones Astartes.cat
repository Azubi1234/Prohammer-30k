                <ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic>
                <ns0:characteristic name="Rear" typeId="vehicle-rear">10</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
          <ns0:rules>
            <ns0:rule name="Standard Wargear" id="hs-vind-wg" hidden="false">
              <ns0:description>Demolisher Cannon, Combi-bolter, Searchlight and Smoke Launchers.</ns0:description>
            </ns0:rule>
            <ns0:rule name="Power Capacitor" id="hs-vind-cap" hidden="false">
              <ns0:description>If a Vindicator armed with a Laser Destroyer Array remained stationary in its Movement phase, it may fire the weapon as Ordnance 2, Twin-linked. Alternatively it may fire an Overcharged Volley as Ordnance 3, Twin-linked; after firing an Overcharged Volley, on a D6 roll of 1 the Vindicator suffers an automatic Glancing Hit.</ns0:description>
            </ns0:rule>
          </ns0:rules>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Laser Destroyer Array (replaces Demolisher Cannon)" id="hs-vind-laser" hidden="false" import="true">

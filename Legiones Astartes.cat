              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="0" field="terminator-transport-max">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-terminator-terminator-additional" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-terminator-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-0">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r35-pride-terminator-da-wing-terminator-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-1">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r35-pride-terminator-da-wing-terminator-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-2">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r35-pride-terminator-da-wing-terminator-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-3">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r35-pride-terminator-da-wing-terminator-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-4">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r35-pride-terminator-da-wing-terminator-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-pride-terminator-da-wing-terminator-unit-5">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-da-wing-terminator-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r35-pride-terminator-da-wing-terminator-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-steel-transport-r35-pride-terminator-terminator-unit" name="Steel Fist — Armoured Assault Dedicated Transport" hidden="true" collective="false" import="true"><ns0:constraints><ns0:constraint id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-steel" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-terminator-da-wing-terminator-unit-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers><ns0:selectionEntries><ns0:selectionEntry type="model" name="Land Raider Phobos (10 models or fewer)" id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="250" />
                          </ns0:costs>
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Phobos" id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                                <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
                                <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        <ns0:rules><ns0:rule id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-rite-size" name="Armoured Assault" hidden="false"><ns0:description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry>
                        <ns0:selectionEntry type="model" name="Land Raider Proteus (10 models or fewer)" id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="r40-da-steel-transport-r35-pride-terminator-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="200" />
                          </ns0:costs>
                          <ns0:profiles>

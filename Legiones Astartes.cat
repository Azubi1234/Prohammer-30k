    <selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="veteran-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="veteran-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="veteran-standard" hidden="false">
          <description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="veteran-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Veteran Tactics" id="veteran-tactics-rule" hidden="false">
          <description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</description>
        </rule>
        <rule name="Dedicated Transport" id="veteran-transport-rule" hidden="false">
          <description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Veterans (included)" hidden="false" id="veteran-included" defaultAmount="4">
          <constraints>
            <constraint id="veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="veteran-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veterans (included)" id="veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="veteran-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Veteran Sergeant" id="veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Additional Legion Veteran" hidden="false" id="veteran-additional">
          <constraints>
            <constraint id="veteran-additional-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
          <profiles>
            <profile name="Additional Legion Veteran" id="veteran-additional-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">5</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="125" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Veteran Tactic (choose one)" id="veteran-tactics" hidden="false">
          <constraints>
            <constraint id="veteran-tactics-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="veteran-tactics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Resolve" hidden="false" id="veteran-tactic-resolve">
              <constraints>
                <constraint id="veteran-tactic-resolve-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Resolve" id="veteran-tactic-resolve-rule" hidden="false">
                  <description>The squad gains the Stubborn special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Assault Veterans" hidden="false" id="veteran-tactic-assault">
              <constraints>
                <constraint id="veteran-tactic-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Assault Veterans" id="veteran-tactic-assault-rule" hidden="false">
                  <description>The squad gains the Furious Charge special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Counter-Assault" hidden="false" id="veteran-tactic-counter">
              <constraints>
                <constraint id="veteran-tactic-counter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Counter-Assault" id="veteran-tactic-counter-rule" hidden="false">
                  <description>The squad gains the Counter-Attack special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Machine Killers" hidden="false" id="veteran-tactic-machine">
              <constraints>
                <constraint id="veteran-tactic-machine-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Machine Killers" id="veteran-tactic-machine-rule" hidden="false">
                  <description>The squad gains the Tank Hunters special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Recon Veterans" hidden="false" id="veteran-tactic-recon">
              <constraints>
                <constraint id="veteran-tactic-recon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Recon Veterans" id="veteran-tactic-recon-rule" hidden="false">
                  <description>The squad gains the Infiltrate special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Marksmen" hidden="false" id="veteran-tactic-marksmen">
              <constraints>
                <constraint id="veteran-tactic-marksmen-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Marksmen" id="veteran-tactic-marksmen-rule" hidden="false">
                  <description>Normal Bolters fired by models in the squad have Twin-linked. This does not apply to Combi-weapons, Foeblaster Boltguns or other bolt weapon variants.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Close Combat Weapon Replacements" id="veteran-melee" hidden="false">
          <constraints>
            <constraint id="veteran-melee-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="increment" value="1" field="veteran-melee-max">
              <repeats>
                <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="veteran-additional" shared="true" roundUp="false" includeChildSelections="false" />

              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Tartaros Terminator Armour" id="r35-pride-terminator-terminator-armour-tartaros-rule" hidden="false">
                  <ns0:description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-cataphractii">

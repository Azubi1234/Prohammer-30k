DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.
When using Last of the Serrated Sun, the squad follows the additional transport requirements of that Rite of War.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xvii-1-gal-vorbak-dark-brethren-additional"><ns0:constraints><ns0:constraint id="r41-unit-xvii-1-gal-vorbak-dark-brethren-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xvii-1-gal-vorbak-dark-brethren-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +30 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvii-1-gal-vorbak-dark-brethren-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r41-unit-xvii-1-gal-vorbak-dark-brethren-opt-0-flamer"><ns0:constraints><ns0:constraint id="r41-unit-xvii-1-gal-vorbak-dark-brethren-opt-0-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvii-1-gal-vorbak-dark-brethren-opt-0-context" hidden="false"><ns0:description>• For every five models in the squad, one Dark Brethren may replace his Bolter with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r41-
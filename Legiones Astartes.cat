                      <ns0:description>A Terminator Veteran with a Cyclone Missile Launcher retains his Combi-Bolter and close-combat weapon; other heavy weapon choices replace the Combi-Bolter.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntryGroup>
                <ns0:selectionEntryGroup name="Dedicated Transport" id="hq-centurion-ret-tc-transport" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-centurion-ret-tc-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </ns0:constraints>
                  <ns0:entryLinks>
                    <ns0:entryLink import="true" name="Legion Dreadclaw Drop Pod" id="hq-centurion-ret-tc-dreadclaw" type="selectionEntry" targetId="transport-dreadclaw" hidden="false">
                      <ns0:constraints>
                        <ns0:constraint id="hq-centurion-ret-tc-dreadclaw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                    </ns0:entryLink>
                  </ns0:entryLinks>
                  <ns0:selectionEntryGroups>
                    <ns0:selectionEntryGroup name="Land Raider Dedicated Transport" id="hq-centurion-ret-tc-land-lrgrp" hidden="false">
                      <ns0:constraints>
                        <ns0:constraint id="hq-centurion-ret-tc-land-lrgrp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                      </ns0:constraints>
                      <ns0:rules>
                        <ns0:rule name="Land Raider Dedicated Transport" id="hq-centurion-ret-tc-land-lrrule" hidden="false">
                          <ns0:description>Select a pattern with sufficient Transport Capacity. These entries use the profiles and standard wargear/rules of the corresponding Legion Land Raider Battle Squadron entry; use that entry for full vehicle upgrade options.</ns0:description>
                        </ns0:rule>
                      </ns0:rules>
                      <ns0:selectionEntries>
                        <ns0:selectionEntry type="model" name="Land Raider Phobos" id="hq-centurion-ret-tc-land-land-raider-phobos" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="hq-centurion-ret-tc-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="250" />
                          </ns0:costs>
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Phobos" id="hq-centurion-ret-tc-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                                <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
                                <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        </ns0:selectionEntry>
                        <ns0:selectionEntry type="model" name="Land Raider Proteus" id="hq-centurion-ret-tc-land-land-raider-proteus" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="hq-centurion-ret-tc-land-land-raider-proteus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="200" />
                          </ns0:costs>
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Proteus" id="hq-centurion-ret-tc-land-land-raider-proteus-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                                <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
                                <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        </ns0:selectionEntry>
                        <ns0:selectionEntry type="model" name="Land Raider Achilles" id="hq-centurion-ret-tc-land-land-raider-achilles" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="hq-centurion-ret-tc-land-land-raider-achilles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="275" />
                          </ns0:costs>
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Achilles" id="hq-centurion-ret-tc-land-land-raider-achilles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                                <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
                                <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        </ns0:selectionEntry>
                      </ns0:selectionEntries>
                    </ns0:selectionEntryGroup>
                  </ns0:selectionEntryGroups>
                </ns0:selectionEntryGroup>
              </ns0:selectionEntryGroups>
              <ns0:entryLinks>
                <ns0:entryLink import="true" name="Combi-Bolter" id="hq-centurion-ret-tc-cb" type="selectionEntry" targetId="gear-combi-bolter" hidden="false" defaultAmount="1">
                  <ns0:constraints>
                    <ns0:constraint id="hq-centurion-ret-tc-cb-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <ns0:constraint id="hq-centurion-ret-tc-cb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                </ns0:entryLink>
                <ns0:entryLink import="true" name="Power Weapon" id="hq-centurion-ret-tc-pw" type="selectionEntry" targetId="gear-power-weapon" hidden="false" defaultAmount="1">
                  <ns0:constraints>
                    <ns0:constraint id="hq-centurion-ret-tc-pw-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <ns0:constraint id="hq-centurion-ret-tc-pw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                </ns0:entryLink>
                <ns0:entryLink import="true" name="Grenade Harness" id="hq-centurion-ret-tc-gh" type="selectionEntry" targetId="gear-hq-grenade-harness" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-centurion-ret-tc-gh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="10" />
                  </ns0:costs>
                </ns0:entryLink>
              <ns0:entryLink id="r40-da-warblade-hq-centurion-ret-tc-pw" name="Calibanite Warblade" type="selectionEntry" targetId="da22-warblade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-warblade-hq-centurion-ret-tc-pw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r40-da-trans-hq-centurion-ret-termcommand" name="Teleportation Transponders" type="selectionEntry" targetId="da22-transponders" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-trans-hq-centurion-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
          <ns0:rules>
            <ns0:rule name="Command Retinue" id="hq-centurion-ret-rule" hidden="false">
              <ns0:description>A Centurion may select one Legion Command Squad. If equipped with any form of Terminator Armour, he may instead select one Legion Terminator Command Squad. The character and squad count as a single HQ selection but may deploy and operate separately.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hq-centurion" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-hq-centurion-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-hq-centurion-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-hq-centurion-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hq-centurion-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-hq-centurion-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hq-centurion-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-hq-centurion-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hq-centurion-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-hq-centurion-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hq-centurion-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-hq-centurion-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hq-centurion-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-hq-centurion-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hq-centurion-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-centurion-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-hq-centurion-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Damocles Command Rhino" id="hq-damocles" hidden="false" import="true">
      <ns0:constraints>
        <ns0:constraint id="hq-damocles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
        <ns0:constraint id="hq-damocles-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" />
      </ns0:constraints>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="100" />
      </ns0:costs>
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-hq" id="hq-damocles-cat" primary="true" name="HQ" hidden="false" />
      </ns0:categoryLinks>
      <ns0:profiles>
        <ns0:profile name="Damocles Command Rhino" id="hq-damocles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">11</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">11</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Focused Bombardment" id="hq-damocles-bomb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Unlimited</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Barrage, Lance, Twin-linked</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear &amp; Transport" id="hq-damocles-std" hidden="false">
          <ns0:description>Vehicle (Tank). Twin-linked Bolter, Searchlight and Smoke Launchers. Transport Capacity 6. No Fire Points. One Access Point on each side and one at the rear.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Geo-Locator Beacon" id="hq-damocles-geo" hidden="false">
          <ns0:description>Friendly units arriving by Deep Strike do not scatter if their first model is placed within 24" of the Damocles and otherwise has a legal deployment position.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Command Vox Relay" id="hq-damocles-relay" hidden="false">
          <ns0:description>While the Damocles is on the battlefield, its controlling player may apply either +1 or -1 to any of their Reserve rolls.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Command Vehicle" id="hq-damocles-command" hidden="false">
          <ns0:description>0–1 Damocles Command Rhino may be selected as a non-compulsory HQ choice in an army of at least 1,000 points. Alternatively, a Master of Signals may select one as a Dedicated Transport.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Focused Bombardment" id="hq-damocles-bombrule" hidden="false">
          <ns0:description>Once per battle, provided the Damocles did not move that turn, it may fire the Focused Bombardment profile.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Legion Vehicle Armoury" id="hq-damocles-upgrades" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hq-dam-vu-0" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Hunter-Killer Missile" id="hq-dam-vu-0-r" hidden="false">
                  <ns0:description>One Use missile, Unlimited range, Strength 8 AP3 Heavy 1.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="hq-dam-vu-1" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Dozer Blade" id="hq-dam-vu-1-r" hidden="false">
                  <ns0:description>Vehicle terrain upgrade as described in the Legion Vehicle Armoury.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Extra Armour" id="hq-dam-vu-2" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Extra Armour" id="hq-dam-vu-2-r" hidden="false">
                  <ns0:description>Vehicle damage mitigation as described in the Legion Vehicle Armoury.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="hq-dam-vu-3" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Auxiliary Drive" id="hq-dam-vu-3-r" hidden="false">
                  <ns0:description>If Immobilised at the start of the controlling player's Movement phase, roll a D6; on 4+ remove one Immobilised result and the vehicle may move normally that phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="hq-dam-vu-4" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Armoured Ceramite" id="hq-dam-vu-4-r" hidden="false">
                  <ns0:description>Melta weapons do not receive their additional Armour Penetration die against this vehicle.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Power of the Machine Spirit" id="hq-dam-vu-5" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-vu-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Power of the Machine Spirit" id="hq-dam-vu-5-r" hidden="false">
                  <ns0:description>Uses the Power of the Machine Spirit rule from the Legion Vehicle Armoury.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Pintle-mounted Weapon" id="hq-dam-pintle" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hq-dam-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Twin-linked Bolter" id="hq-dam-p-0" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Twin-linked Bolter" id="hq-dam-p-0-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Combi-weapon" id="hq-dam-p-1" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Combi-weapon" id="hq-dam-p-1-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Heavy Bolter" id="hq-dam-p-2" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Heavy Bolter" id="hq-dam-p-2-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Heavy Flamer" id="hq-dam-p-3" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Heavy Flamer" id="hq-dam-p-3-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Multi-Melta" id="hq-dam-p-4" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Multi-Melta" id="hq-dam-p-4-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Havoc Launcher" id="hq-dam-p-5" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-dam-p-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Havoc Launcher" id="hq-dam-p-5-r" hidden="false">
                  <ns0:description>Uses the corresponding Legion vehicle-mounted weapon profile and rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>

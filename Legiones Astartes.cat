    <selectionEntry type="upgrade" import="true" name="Combi-Flamer" hidden="false" id="gear-combi-flamer"><profiles><profile name="Combi-Flamer - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-flamer-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Flamer - Flamer" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-flamer-f"><characteristics><characteristic name="Range" typeId="ranged-range">Template</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-flamer" hidden="false"><description>The Bolter component may be fired normally. The secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combi-Grenade Launcher" hidden="false" id="gear-combi-grenade"><profiles><profile name="Combi-Grenade Launcher - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-gl-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Grenade Launcher - Frag" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-gl-f"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">3</characteristic><characteristic name="AP" typeId="ranged-ap">6</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, Blast, One Use</characteristic></characteristics></profile><profile name="Combi-Grenade Launcher - Krak" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-gl-k"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">6</characteristic><characteristic name="AP" typeId="ranged-ap">4</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-gl" hidden="false"><description>The Bolter component may be fired normally. Choose the Frag or Krak profile when firing the secondary Grenade Launcher component; that secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combi-Meltagun" hidden="false" id="gear-combi-melta"><profiles><profile name="Combi-Meltagun - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-melta-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Meltagun - Meltagun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-melta-m"><characteristics><characteristic name="Range" typeId="ranged-range">12&quot;</characteristic><characteristic name="S" typeId="ranged-s">8</characteristic><characteristic name="AP" typeId="ranged-ap">1</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, Melta, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-melta" hidden="false"><description>The Bolter component may be fired normally. The Meltagun component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combi-Plasma Gun" hidden="false" id="gear-combi-plasma"><profiles><profile name="Combi-Plasma Gun - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-plasma-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Plasma Gun - Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-plasma-p"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">7</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-plasma" hidden="false"><description>The Bolter component may be fired normally. The Plasma Gun component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combi-Volkite Charger" hidden="false" id="gear-combi-volkite"><profiles><profile name="Combi-Volkite Charger - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Volkite Charger - Volkite" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-v"><characteristics><characteristic name="Range" typeId="ranged-range">15&quot;</characteristic><characteristic name="S" typeId="ranged-s">5</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Assault 2, Rending, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-volkite" hidden="false"><description>The Bolter component may be fired normally. The Volkite Charger component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Lightning Claw" hidden="false" id="gear-lightning-claw"><rules><rule name="Lightning Claw" id="rule-lightning-claw" hidden="false"><description>Power Weapon; re-roll failed To Wound rolls; Specialist Weapon.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws" hidden="false" id="gear-pair-claws"><rules><rule name="Pair of Lightning Claws" id="rule-pair-claws" hidden="false"><description>Counts as two weapon choices. Power Weapon; re-roll failed To Wound rolls; Specialist Weapon; +1 Attack.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Power Fist" hidden="false" id="gear-power-fist"><rules><rule name="Power Fist" id="rule-power-fist" hidden="false"><description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Power Weapon" hidden="false" id="gear-power-weapon"><rules><rule name="Power Weapon" id="rule-power-weapon" hidden="false"><description>Ignores Armour Saves.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="gear-rending"><rules><rule name="Rending" id="rule-rending-melee" hidden="false"><description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Thunder Hammer" hidden="false" id="gear-thunder"><rules><rule name="Thunder Hammer" id="rule-thunder" hidden="false"><description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon, Concussive.</description></rule></rules></selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-combat-shield"><rules><rule name="Combat Shield" id="rule-combat-shield" hidden="false"><description>Grants a 6+ Invulnerable Save. It does not occupy a hand and does not prevent the bonus Attack for fighting with two weapons.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-auspex"><rules><rule name="Auspex" id="rule-auspex" hidden="false"><description>After enemy Infiltrators deploy, roll 4D6 for the unit. If an enemy Infiltrating unit is within that distance and line of sight, the bearer&apos;s unit may immediately fire at it once before the battle begins. A unit may only make one Auspex attack.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-bionics"><rules><rule name="Bionics" id="rule-bionics" hidden="false"><description>When the bearer loses its final Wound, leave it on the battlefield. At the beginning of its controlling player&apos;s next turn, roll a D6. On a 6 it returns with 1 Wound; otherwise remove it. Bionics cannot normally be used if the bearer&apos;s entire unit was destroyed at the same time.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="gear-melta-bombs"><rules><rule name="Melta Bombs" id="rule-melta-bombs" hidden="false"><description>Against a vehicle in close combat, exchange the bearer&apos;s normal attacks for one Melta Bomb attack. If it hits, resolve Armour Penetration at S8 + 2D6.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-purity"><rules><rule name="Purity Seals" id="rule-purity" hidden="false"><description>When the bearer&apos;s unit Falls Back, roll one additional D6 for Fall Back distance and discard one die of the controlling player&apos;s choice. This benefit is not cumulative.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-homer"><rules><rule name="Teleport Homer" id="rule-homer" hidden="false"><description>Friendly units arriving by teleportation do not scatter if the first model is placed within 6&quot; of an active Homer that was on the battlefield at the start of the turn.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Krak Grenades" hidden="false" id="gear-krak"><rules><rule name="Krak Grenades" id="rule-krak" hidden="false"><description>Against a vehicle in close combat, a model may exchange its normal attacks for one Krak Grenade attack. If it hits, resolve Armour Penetration at S6 + D6.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-vexilla"><rules><rule name="Legion Vexilla" id="rule-vexilla" hidden="false"><description>A unit containing a Legion Vexilla adds +1 to its combat-resolution score. This bonus is not cumulative. If the bearer is slain, the unit loses the bonus.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-nuncio"><rules><rule name="Nuncio Vox" id="rule-nuncio" hidden="false"><description>A friendly unit arriving by Deep Strike does not scatter if its centre model is initially placed within 6&quot; of the bearer. The bearer must have been on the battlefield at the beginning of the turn, must not be Pinned or Falling Back, and must not be embarked upon a Transport.</description></rule></rules></selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="gear-tl-bolter"><profiles><profile name="Twin-linked Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-tl-bolter"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</characteristic></characteristics></profile></profiles></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="gear-heavy-flamer"><profiles><profile name="Heavy Flamer" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-heavy-flamer"><characteristics><characteristic name="Range" typeId="ranged-range">Template</characteristic><characteristic name="S" typeId="ranged-s">5</characteristic><characteristic name="AP" typeId="ranged-ap">4</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1</characteristic></characteristics></profile></profiles></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="gear-hk"><profiles><profile name="Hunter-Killer Missile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-hk"><characteristics><characteristic name="Range" typeId="ranged-range">Unlimited</characteristic><characteristic name="S" typeId="ranged-s">8</characteristic><characteristic name="AP" typeId="ranged-ap">3</characteristic><characteristic name="Type" typeId="ranged-type">Heavy 1, One Use</characteristic></characteristics></profile></profiles></selectionEntry>

    <selectionEntry type="model" import="true" name="Legion Rhino Armoured Carrier" hidden="false" id="transport-rhino">
      <profiles><profile name="Legion Rhino Armoured Carrier" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-rhino"><characteristics><characteristic name="BS" typeId="vehicle-bs">4</characteristic><characteristic name="Front" typeId="vehicle-front">11</characteristic><characteristic name="Side" typeId="vehicle-side">11</characteristic><characteristic name="Rear" typeId="vehicle-rear">10</characteristic></characteristics></profile></profiles>
      <costs><cost name="Points" typeId="pts" value="50"/></costs>
      <entryLinks><entryLink import="true" name="Storm Bolter" hidden="false" id="rhino-sb" type="selectionEntry" targetId="gear-storm-bolter" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-max" includeChildSelections="false" automatic="true"/></constraints></entryLink></entryLinks>
      <rules>
        <rule name="Transport" id="rule-rhino-transport" hidden="false"><description>Transport Capacity: 10 models. Models in Terminator Armour, models equipped with Jump Packs, and models mounted on Bikes or Jetbikes may not embark. Access Points: one on each side and one at the rear. Fire Points: up to two transported models may fire through the top hatch.</description></rule>
        <rule name="Repair" id="rule-rhino-repair" hidden="false"><description>If the Rhino is Immobilised, during its controlling player&apos;s Shooting phase it may give up firing all weapons and roll a D6. On a 6, remove one Immobilised result; it may move normally from the beginning of its following Movement phase.</description></rule>
        <rule name="Smoke Launchers and Searchlight" id="rule-rhino-standard" hidden="false"><description>The Rhino includes Smoke Launchers and a Searchlight and uses their normal ProHammer rules.</description></rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Vehicle Upgrades" id="rhino-upgrades" hidden="false"><selectionEntries>
          <selectionEntry type="upgrade" import="true" name="Dozer Blade" hidden="false" id="rhino-dozer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-dozer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></selectionEntry>
          <selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="rhino-extra"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-extra-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></selectionEntry>
          <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="rhino-hk"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-hk-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs><entryLinks><entryLink import="true" name="Hunter-Killer Missile" hidden="false" id="rhino-hk-profile" type="selectionEntry" targetId="gear-hk" defaultAmount="1"/></entryLinks></selectionEntry>
          <selectionEntry type="upgrade" import="true" name="Auxiliary Drive" hidden="false" id="rhino-aux"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-aux-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs><rules><rule name="Auxiliary Drive" id="rule-rhino-aux" hidden="false"><description>At the start of the controlling player&apos;s Movement phase, if the Rhino is Immobilised, roll a D6. On a 4+, remove one Immobilised result and the vehicle may move normally during that Movement phase.</description></rule></rules></selectionEntry>
        </selectionEntries></selectionEntryGroup>
        <selectionEntryGroup name="Pintle-mounted Weapon" id="rhino-pintle" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-pintle-max" includeChildSelections="false"/></constraints><entryLinks>
          <entryLink import="true" name="Twin-linked Bolter" hidden="false" id="rhino-p-tlb" type="selectionEntry" targetId="gear-tl-bolter"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
          <entryLink import="true" name="Combi-Flamer" hidden="false" id="rhino-p-cf" type="selectionEntry" targetId="gear-combi-flamer"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
          <entryLink import="true" name="Combi-Meltagun" hidden="false" id="rhino-p-cm" type="selectionEntry" targetId="gear-combi-melta"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
          <entryLink import="true" name="Combi-Plasma Gun" hidden="false" id="rhino-p-cp" type="selectionEntry" targetId="gear-combi-plasma"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
          <entryLink import="true" name="Combi-Volkite Charger" hidden="false" id="rhino-p-cv" type="selectionEntry" targetId="gear-combi-volkite"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
          <entryLink import="true" name="Heavy Bolter" hidden="false" id="rhino-p-hb" type="selectionEntry" targetId="gear-heavy-bolter"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
          <entryLink import="true" name="Heavy Flamer" hidden="false" id="rhino-p-hf" type="selectionEntry" targetId="gear-heavy-flamer"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
          <entryLink import="true" name="Multi-Melta" hidden="false" id="rhino-p-mm" type="selectionEntry" targetId="gear-multimelta"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
          <entryLink import="true" name="Havoc Launcher" hidden="false" id="rhino-p-havoc" type="selectionEntry" targetId="gear-havoc"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
        </entryLinks></selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="gear-havoc"><rules><rule name="Havoc Launcher" id="rule-havoc" hidden="false"><description>Use the Havoc Launcher profile from the applicable ProHammer/Legion vehicle weapons rules; no profile is reproduced in the current Legiones Astartes Army List.</description></rule></rules></selectionEntry>

    <selectionEntry type="model" import="true" name="Legion Drop Pod" hidden="false" id="transport-drop-pod">
      <profiles><profile name="Legion Drop Pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-drop-pod"><characteristics><characteristic name="BS" typeId="vehicle-bs">4</characteristic><characteristic name="Front" typeId="vehicle-front">12</characteristic><characteristic name="Side" typeId="vehicle-side">12</characteristic><characteristic name="Rear" typeId="vehicle-rear">12</characteristic></characteristics></profile></profiles>
      <costs><cost name="Points" typeId="pts" value="50"/></costs>
      <entryLinks><entryLink import="true" name="Storm Bolter" hidden="false" id="dp-sb" type="selectionEntry" targetId="gear-storm-bolter" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="dp-sb-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-sb-max" includeChildSelections="false" automatic="true"/></constraints></entryLink></entryLinks>
      <rules>
        <rule name="Transport" id="dp-transport-rule" hidden="false"><description>Transport Capacity: 10 models. Models in Terminator Armour count as two models. Models equipped with Jump Packs, Bikes or Jetbikes may not embark.</description></rule>
        <rule name="Deep Strike" id="dp-deepstrike" hidden="false"><description>Uses the normal ProHammer Deep Strike rules except as modified below.</description></rule>
        <rule name="Drop Pod Assault" id="dp-assault" hidden="false"><description>The Drop Pod and its passengers begin in Reserve. At the beginning of the controlling player&apos;s first turn, choose half of all friendly vehicles with Drop Pod Assault, rounding up; those Drop Pods arrive automatically using Deep Strike. The remainder use normal Reserves. Passengers must immediately disembark when the Pod lands and may not charge that turn. No unit may embark on the Pod after its original passengers disembark.</description></rule>
        <rule name="Inertial Guidance System" id="dp-igs" hidden="false"><description>If the Drop Pod would scatter onto impassable terrain or another model, reduce the scatter distance by the minimum amount required to avoid the obstacle. If no legal position is possible, resolve the Deep Strike normally.</description></rule>
        <rule name="Immobile" id="dp-immobile" hidden="false"><description>After arriving, the Drop Pod may not move for the remainder of the battle. It counts as having suffered an Immobilised result but suffers no additional damage for doing so.</description></rule>
      </rules>
      <selectionEntryGroups><selectionEntryGroup name="Options" id="dp-options" hidden="false"><selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Deathwind Missile Launcher" hidden="false" id="dp-deathwind"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-deathwind-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="20"/></costs><profiles><profile name="Deathwind Missile Launcher" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-deathwind"><characteristics><characteristic name="Range" typeId="ranged-range">12&quot;</characteristic><characteristic name="S" typeId="ranged-s">5</characteristic><characteristic name="AP" typeId="ranged-ap">-</characteristic><characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast</characteristic></characteristics></profile></profiles></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Locator Beacon" hidden="false" id="dp-beacon"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-beacon-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs><rules><rule name="Locator Beacon" id="rule-dp-beacon" hidden="false"><description>Friendly units arriving by Deep Strike within 6&quot; of a Locator Beacon do not scatter.</description></rule></rules></selectionEntry>
      </selectionEntries></selectionEntryGroup></selectionEntryGroups>
    </selectionEntry>

    <selectionEntry type="model" import="true" name="Anvillus Pattern Dreadclaw Drop Pod" hidden="false" id="transport-dreadclaw">
      <profiles><profile name="Anvillus Pattern Dreadclaw Drop Pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-dreadclaw"><characteristics><characteristic name="BS" typeId="vehicle-bs">4</characteristic><characteristic name="Front" typeId="vehicle-front">12</characteristic><characteristic name="Side" typeId="vehicle-side">12</characteristic><characteristic name="Rear" typeId="vehicle-rear">12</characteristic></characteristics></profile></profiles>
      <costs><cost name="Points" typeId="pts" value="65"/></costs>
      <rules>
        <rule name="Transport" id="dc-transport-rule" hidden="false"><description>Transport Capacity: 10 models in Power Armour, or 5 models in Terminator Armour, or one Dreadnought where specifically permitted. Passengers may disembark from any point around the hull.</description></rule>
        <rule name="Deep Strike" id="dc-deepstrike" hidden="false"><description>Uses the normal ProHammer Deep Strike rules except as modified below.</description></rule>
        <rule name="Dreadclaw Assault" id="dc-assault" hidden="false"><description>The Dreadclaw and its passengers begin in Reserve. At the beginning of the controlling player&apos;s first turn, roll a D6; on a 4+, it becomes available. From the second turn onward use normal Reserve rules. When available it enters by Deep Strike. Passengers do not immediately disembark. A unit may not charge during the same turn in which the Dreadclaw arrived by Deep Strike.</description></rule>
        <rule name="Inertial Guidance System" id="dc-igs" hidden="false"><description>If the Dreadclaw would scatter onto impassable terrain or another model, reduce the scatter distance by the minimum amount required to avoid the obstacle.</description></rule>
        <rule name="Assault Pod" id="dc-assault-pod" hidden="false"><description>Units disembarking from a Dreadclaw may charge during the same turn in which they disembark. This does not allow a unit to charge during the same turn in which the Dreadclaw arrived by Deep Strike.</description></rule>
        <rule name="Hover Jets" id="dc-hover" hidden="false"><description>After landing, the Dreadclaw remains operational and moves as a Fast Skimmer. It may continue to transport its original passengers. Once those passengers have completely disembarked, the Dreadclaw may not embark another unit.</description></rule>
      </rules>
    </selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Hardened Power Armour" hidden="false" id="gear-hardened-power-armour">
      <rules><rule name="Hardened Armour" id="rule-hardened-armour" hidden="false"><description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. When the unit makes an Advance Move, reduce the additional distance rolled by 1&quot;. Reduce any Charge distance or Pursuit distance rolled by the unit by 1&quot;. In missions which use Void Hardened armour, models with Hardened Armour count as Void Hardened. These movement penalties also apply to a model wearing Artificer Armour if that model is part of a Breacher Squad.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Boarding Shield" hidden="false" id="gear-boarding-shield">
      <rules><rule name="Boarding Shield" id="rule-boarding-shield" hidden="false"><description>Grants a 5+ Invulnerable Save. A Boarding Shield occupies one of the bearer&apos;s hands in close combat; the bearer therefore only receives the +1 Attack bonus for fighting with two weapons if another rule specifically allows it.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Graviton Gun" hidden="false" id="gear-graviton-gun">
      <profiles><profile name="Graviton Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-graviton-gun"><characteristics><characteristic name="Range" typeId="ranged-range">18&quot;</characteristic><characteristic name="S" typeId="ranged-s">Special</characteristic><characteristic name="AP" typeId="ranged-ap">4</characteristic><characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Concussive, Graviton</characteristic></characteristics></profile></profiles>
      <rules><rule name="Graviton" id="rule-graviton-gun" hidden="false"><description>Against non-vehicle models, the number required To Wound is equal to the target&apos;s Armour Save: 2+ armour is wounded on a 2+, 3+ on a 3+, 4+ on a 4+, and so on. Against vehicles, do not make a normal Armour Penetration roll; roll a D6 for each hit and on a 6 the vehicle is Immobilised.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Lascutter" hidden="false" id="gear-lascutter">
      <profiles><profile name="Lascutter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-lascutter"><characteristics><characteristic name="Range" typeId="ranged-range">-</characteristic><characteristic name="S" typeId="ranged-s">9</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Melee, Unwieldy, Cumbersome</characteristic></characteristics></profile></profiles>
      <rules><rule name="Cumbersome" id="rule-cumbersome-lascutter" hidden="false"><description>A model attacking with a Cumbersome weapon may make only one attack with that weapon during the Assault phase, regardless of its Attacks characteristic or any bonuses. That attack is made at Weapon Skill 1.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Breaching Charge" hidden="false" id="gear-breaching-charge">
      <profiles><profile name="Breaching Charge" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-breaching-charge"><characteristics><characteristic name="Range" typeId="ranged-range">Special</characteristic><characteristic name="S" typeId="ranged-s">8</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Melee, Blast, One Use, Wrecker</characteristic></characteristics></profile></profiles>
      <rules><rule name="Breaching Charge" id="rule-breaching-charge" hidden="false"><description>May be used once per battle during an Assault phase instead of the bearer&apos;s normal close-combat attacks. The bearer makes a single attack against an enemy unit with which he is engaged. If it hits, place a Blast marker in base contact with the bearer so that it covers as many enemy models as possible without covering friendly models; models beneath the marker are struck using the Breaching Charge profile.</description></rule><rule name="Wrecker" id="rule-wrecker-breaching" hidden="false"><description>Against Fortifications, buildings, barricades or other immobile structures, a Wrecker attack may re-roll a failed Armour Penetration roll. Where a mission uses a Building Damage table, add +1 to any roll made on that table by a Wrecker attack.</description></rule></rules>
    </selectionEntry>


    <selectionEntry type="upgrade" import="true" name="Recon Armour" hidden="false" id="gear-recon-armour">
      <rules><rule name="Recon Armour" id="rule-recon-armour" hidden="false"><description>Recon Armour confers a 4+ Armour Save.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Astartes Shotgun" hidden="false" id="gear-astartes-shotgun">
      <profiles><profile name="Astartes Shotgun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-astartes-shotgun"><characteristics><characteristic name="Range" typeId="ranged-range">12&quot;</characteristic><characteristic name="S" typeId="ranged-s">3</characteristic><characteristic name="AP" typeId="ranged-ap">-</characteristic><characteristic name="Type" typeId="ranged-type">Assault 2</characteristic></characteristics></profile></profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sniper Rifle" hidden="false" id="gear-sniper-rifle">
      <profiles><profile name="Sniper Rifle" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-sniper-rifle"><characteristics><characteristic name="Range" typeId="ranged-range">36&quot;</characteristic><characteristic name="S" typeId="ranged-s">3</characteristic><characteristic name="AP" typeId="ranged-ap">6</characteristic><characteristic name="Type" typeId="ranged-type">Heavy 1, Sniper</characteristic></characteristics></profile></profiles>
      <rules><rule name="Sniper" id="rule-sniper-rifle" hidden="false"><description>Uses the normal Sniper weapon rules from ProHammer Classic.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Blade" hidden="false" id="gear-combat-blade">
      <rules><rule name="Combat Blade" id="rule-combat-blade" hidden="false"><description>Close Combat Weapon. Uses the bearer&apos; Strength and permits normal Armour Saves.</description></rule></rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cameleoline" hidden="false" id="gear-cameleoline">
      <rules><rule name="Cameleoline" id="rule-cameleoline" hidden="false"><description>A model equipped with Cameleoline gains the Stealth special rule.</description></rule></rules>
    </selectionEntry>

  </sharedSelectionEntries>

  <selectionEntries>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad" hidden="false" id="tactical-unit">
      <categoryLinks><categoryLink targetId="cat-troops" id="tactical-cat" primary="true" name="Troops" hidden="false"/></categoryLinks>
      <rules>
        <rule name="Power Armour" id="tactical-power-armour" hidden="false"><description>Models wearing Power Armour have a 3+ Armour Save.</description></rule>
        <rule name="Legiones Astartes" id="tactical-legiones" hidden="false"><description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description></rule>
        <rule name="Frag Grenades" id="tactical-frag" hidden="false"><description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description></rule>
        <rule name="Fury of the Legion" id="tactical-fury" hidden="false"><description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24&quot; or 4 shots up to 12&quot;, and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description></rule>
      </rules>

      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="tac-marine" defaultAmount="9">
          <constraints><constraint type="min" value="9" field="selections" scope="parent" shared="true" id="tac-marine-min" includeChildSelections="false"/><constraint type="max" value="19" field="selections" scope="parent" shared="true" id="tac-marine-max" includeChildSelections="false"/></constraints>
          <costs><cost name="Points" typeId="pts" value="15"/></costs>
          <profiles><profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-marine"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">1</characteristic><characteristic name="Ld" typeId="model-ld">8</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
        </selectionEntry>

        <selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="tac-sergeant" defaultAmount="1">
          <constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-max" includeChildSelections="false" automatic="true"/></constraints>
          <costs><cost name="Points" typeId="pts" value="15"/></costs>
          <profiles><profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-sergeant"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">2</characteristic><characteristic name="Ld" typeId="model-ld">9</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
          <rules><rule name="Sergeant Armoury" id="rule-sgt-armoury" hidden="false"><description>May select up to 50 points of permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as two weapon choices. His standard Bolter and Bolt Pistol are already included and are not repurchased.</description></rule></rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Armoury (max 50 pts)" id="sgt-armoury" hidden="false">
              <constraints><constraint type="max" value="50" field="pts" scope="parent" shared="true" id="sgt-armoury-pts-max" includeChildSelections="true"/></constraints>
              <selectionEntryGroups>
                <selectionEntryGroup name="Sergeant Armoury - Weapons" id="sgt-weapons" hidden="false">
                  <constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-weapons-max" includeChildSelections="true"/></constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup name="Single-Handed Weapons" id="sgt-single" hidden="false"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-single-max" includeChildSelections="false"/></constraints><entryLinks>
                      <entryLink import="true" name="Hand Flamer" hidden="false" id="sgt-handflamer" type="selectionEntry" targetId="gear-hand-flamer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-handflamer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>

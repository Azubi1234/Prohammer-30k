            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Techmarine II" hidden="false" id="techmarine-II">
          <constraints>
            <constraint id="techmarine-II-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <profiles>
            <profile name="Legion Techmarine" id="techmarine-II-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Standard Wargear" id="techmarine-II-std" hidden="false">
              <description>Power Armour, Bolt Pistol, Power Weapon, Servo-Arm and Frag Grenades.</description>
            </rule>
            <rule name="Legiones Astartes" id="techmarine-II-legiones" hidden="false">
              <description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</description>
            </rule>
            <rule name="Independent Character" id="techmarine-II-ic" hidden="false">
              <description>The Legion Techmarine is an Independent Character, subject to Field Team while accompanied by Servo-automata.</description>
            </rule>
            <rule name="Servo-Arm" id="techmarine-II-servoarm" hidden="false">
              <description>Grants an additional Power Fist-style close-combat attack rolled separately and provides +1 to Battlesmith repair rolls. The normal Battlesmith 5+ therefore succeeds on a 4+ while the Servo-Arm is retained.</description>
            </rule>
            <rule name="Battlesmith" id="techmarine-II-battlesmith" hidden="false">
              <description>Instead of firing in the Shooting phase, while in base contact with an eligible friendly Vehicle, Cybernetica Cortex model or Iron and Machine model, roll a D6. On a 5+, remove one Engine Damaged, restore one Weapon Destroyed, remove one Immobilised result, or restore one lost Wound to an eligible non-vehicle up to its starting Wounds. One attempt per turn; a model may benefit from only one successful repair per turn. Destroyed models cannot be returned. Daemons may not normally be repaired.</description>
            </rule>
            <rule name="Bolster Defences" id="techmarine-II-bolster" hidden="false">
              <description>Before either army deploys, nominate one ruin or similar defensive terrain feature wholly or partially within the army's deployment zone. Improve its Cover Save by 1 to a maximum of 3+. A terrain feature may only be Bolstered once.</description>
            </rule>
            <rule name="Field Team" id="techmarine-II-field" hidden="false">
              <description>If accompanied by one or more Servo-automata, the Techmarine and his Servo-automata form one Field Team. The Techmarine may not voluntarily leave while any Servo-automata remain alive. The whole Field Team may join and leave friendly units as though the Techmarine were an Independent Character. If he is slain, surviving Servo-automata form a unit and become subject to Cybernetica.</description>
            </rule>
            <rule name="Dedicated Transport" id="techmarine-II-transport-rule" hidden="false">
              <description>If not equipped with a Space Marine Bike, this Techmarine may select a Rhino. If accompanied by Servo-automata, the Rhino is purchased for the entire Field Team.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Wargear" id="techmarine-II-wargear" hidden="false">
              <entryLinks>
                <entryLink import="true" name="Auspex" hidden="false" id="techmarine-II-auspex" type="selectionEntry" targetId="gear-auspex">
                  <constraints>
                    <constraint id="techmarine-II-auspex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />

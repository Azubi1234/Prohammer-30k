JETBIKE WEAPONS
For every three models in the squadron, one Golden Keshig may
replace the Heavy Bolter with Hellfire Rounds mounted on his Jetbike with:
• Multi-Melta ..................................... +10 points
• Volkite Culverin ................................ +10 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-additional"><ns0:constraints><ns0:constraint id="r41-unit-v-0-golden-keshig-squadron-additional-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="55" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-v-0-golden-keshig-squadron-additional-rule" hidden="false"><ns0:description>May include up to 2 additional models at +55 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-v-0-golden-keshig-squadron-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="55" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-v-0-golden-keshig-squadron-opt-0-context" hidden="false"><ns0:description>• The squadron may include up to two additional Golden Keshig</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-opt-1-krak-grenades"><ns0:constraints><ns0:constraint 
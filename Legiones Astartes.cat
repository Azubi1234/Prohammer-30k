-Melta" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-opt-3-multi-melta"><ns0:constraints><ns0:constraint id="r41-unit-v-0-golden-keshig-squadron-opt-3-multi-melta-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-v-0-golden-keshig-squadron-opt-3-context" hidden="false"><ns0:description>replace the Heavy Bolter with Hellfire Rounds mounted on his Jetbike with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Volkite Culverin" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-opt-4-volkite-culverin"><ns0:constraints><ns0:constraint id="r41-unit-v-0-golden-keshig-squadron-opt-4-volkite-culverin-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-v-0-golden-keshig-squadron-opt-4-context" hidden="false"><ns0:description>replace the Heavy Bolter with Hellfire Rounds mounted on his Jetbike with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="EBON KESHIG" hidden="false" id="r41-unit-v-1-ebon-keshig"><ns0:costs><ns0:cost name="Points" typeId="pts" value="225" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-v-1-ebon-keshig-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Ebon Keshig" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-v-1-ebon-keshig-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-v-1-ebon-keshig-source" hidden="false"><ns0:description>Ebon Keshig | 5 | 4 | 4 | 4 | 1 | 5 | 3 | 9 | 2+/5+
DRAGON DAO A Dragon Dao is a Power Weapon. At the beginning of each Assault phase, its bearer may choose to wield the weapon with both hands. If wielded with both hands, the bearer gains +2 Strength but suffers -2 Initiative for that Assault phase. A model wielding a Dragon Dao with both hands receives no bonus Attack for fighting with two close-combat weapons.
Force Organisation:
• Elites
Unit Composition:
• 5 Ebon Keshig
Unit Type:
• Infantry
Wargear:
• Terminator Armour
• Dragon Dao
Special Rules:
• Legiones Astartes (White Scars)
• Fearless
OPTIONS
• The squad may include up to five additional Ebon Keshig for +45 points per model.
DEDICATED TRANSPORT
A squad of five models may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-v-1-ebon-keshig-additional"><ns0:constraints><ns0:constraint id="r41-unit-v-1-ebon-keshig-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="45" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-v-1-ebon-keshig-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +45 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="DARK SONS OF DEATH" hidden="false" id="r41-unit-v-2-dark-sons-of-death"><ns0:costs><ns0:cost name="Points" typeId="pts" value="200" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-v-2-dark-sons-of-death-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Dark Son" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-v-2-dark-sons-of-death-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Death Speaker" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-v-2-dark-sons-of-death-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-v-2-dark-sons-of-death-source" hidden="false"><ns0:description>Dark Son | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+
Death Speaker | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Elites
Unit Composition:
• 4 Dark Sons
• 1 Death Speaker
Unit Type:
• Infantry
• The Death Speaker is a Character
Wargear:
• Power Armour
• Two Bolt pistols
• Power Glaive
• Frag grenades
• Rad grenades
Special Rules:
• Legiones Astartes (White Scars)
• Counter-Attack
• Dual Pistols
• Destroyer Cadre
OPTIONS
• The squad may include up to five additional Dark Sons
for +35 points per model.
• The entire squad may take:
• Krak grenades ................................. +2 points per model
• Melta bombs .................................. +5 points per model
• Jump Packs ................................... +15 points per model
DESTROYER WEAPONS
For every five models in the squad, one Dark Son may replace one
Bolt pistol with:
• Volkite serpenta ................................ +5 points
• Hand flamer ..................................... +5 points
• Plasma pistol ................................... +15 points
• Missile launcher with Suspensor Web
and Rad Missiles ................................ +25 points
A Missile Launcher equipped with Rad Missiles may only fire
Rad Missiles.
DEATH SPEAKER
The Death Speaker may take:
• Artificer Armour ................................ +10 points
• Up to three Phosphex Bombs ..................... +10 points each
The Death Speaker may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
JUMP PACKS
If every model is equipped with a Jump Pack, the unit becomes Jump Infantry and follows the normal ProHammer rules for Jump Infantry. A unit equipped with Jump Packs may not select a Dedicated Transport.
DEDICATED TRANSPORT
A unit without Jump Packs may select a Rhino, Drop Pod, Dreadclaw,Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-v-2-dark-sons-of-death-additional"><ns0:constraints><ns0:constraint id="r41-unit-v-2-dark-sons-of-death-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-v-2-dark-sons-of-death-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +35 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-v-2-dark-sons-of-death-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-v-2-dark-sons-of-death-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-v-2-dark-sons-of-death-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-v-2-dark-sons-of-death-opt-0-context" hidden="false"><ns0:description>• The squad may include up to five additional Dark Sons</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-v-2-dark-sons-of-death-opt-1-krak-grenades"><ns0:const
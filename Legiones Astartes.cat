                  <ns0:constraints>
                    <ns0:constraint id="techmarine-III-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Signum" id="techmarine-III-signum-rule" hidden="false">
                      <ns0:description>Once during each friendly Shooting phase, a unit containing a Signum may re-roll one failed To Hit roll made with a shooting weapon. A unit may benefit from only one Signum each Shooting phase.</ns0:description>
                    </ns0:rule>

            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Vengeance Rounds" id="r40-da-serpent-seeker-fa-seeker-ammo-3" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">

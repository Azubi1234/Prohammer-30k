          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="hs-spartan-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="hs-spartan-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="hs-spartan-auxiliary-drive-rule" hidden="false">
              <ns0:description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Frag Assault Launchers" id="hs-spartan-frag-assault-launchers" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Frag Assault Launchers" id="hs-spartan-frag-assault-launchers-rule" hidden="false">
              <ns0:description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="hs-spartan-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="hs-spartan-armoured-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="45" />

"false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xiv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xiv-6-ignatius-grulgor-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Ignatius Grulgor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xiv-6-ignatius-grulgor-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xiv-6-ignatius-grulgor-source" hidden="false"><ns0:description>Ignatius Grulgor | 6 | 5 | 4 | 4 | 3 | 5 | 3 | 10 | 3+/5+
Force Organisation:
THE EATER OF LIVES The first time Grulgor is reduced to 0 Wounds, do not immediately remove him as a casualty. Roll a D6. On a 1–4, remove Grulgor normally. On a 5+, Grulgor remains in play with 1 Wound remaining and gains the following special rules for the remainder of the battle: • Daemon • Fearless • Feel No Pain (5+) This rule may only be used once per battle. COMMAND RETINUE Grulgor may select one Legion Command Squad as his retinue. The selected squad does not occupy a separate Force Organisation slot.

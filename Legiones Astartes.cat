            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-breacher-unit-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-breacher-unit-0">
              <constraints>
                <constraint id="da-wing-breacher-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-breacher-unit-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-breacher-unit-1">
              <constraints>
                <constraint id="da-wing-breacher-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-breacher-unit-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-breacher-unit-2">
              <constraints>
                <constraint id="da-wing-breacher-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-breacher-unit-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-breacher-unit-3">
              <constraints>
                <constraint id="da-wing-breacher-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-breacher-unit-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-breacher-unit-4">
              <constraints>
                <constraint id="da-wing-breacher-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-breacher-unit-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-breacher-unit-5">
              <constraints>
                <constraint id="da-wing-breacher-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-breacher-unit-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Reconnaissance Squad" hidden="false" id="recon-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="recon-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="recon-standard-wargear" hidden="false">
          <description>Every model is equipped with Recon Armour, a Bolter, a Bolt Pistol and Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes" id="recon-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Support Squad" id="recon-support-squad" hidden="false">
          <description>This unit may be selected as a Troops choice, but may not fulfil either of the army' two compulsory Troops selections unless a Legion-specific rule or Rite of War removes this restriction.</description>
        </rule>
        <rule name="Scout" id="recon-scout" hidden="false">
          <description>Uses the normal Scout rule from ProHammer Classic.</description>
        </rule>
        <rule name="Infiltrate" id="recon-infiltrate" hidden="false">
          <description>Uses the normal Infiltrate rule from ProHammer Classic.</description>
        </rule>
        <rule name="Move Through Cover" id="recon-mtc" hidden="false">
          <description>Uses the normal Move Through Cover rule from ProHammer Classic.</description>
        </rule>
        <rule name="Acute Senses" id="recon-acute-senses" hidden="false">
          <description>Uses the normal Acute Senses rule from ProHammer Classic.</description>
        </rule>
        <rule name="Frag Grenades" id="recon-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Recon Armour" hidden="false" id="recon-standard-armour" type="selectionEntry" targetId="gear-recon-armour" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolter" hidden="false" id="recon-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Bolt Pistol" hidden="false" id="recon-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-max" includeChildSelections="false" automatic="true" />
          </constraints>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Recon Marine" hidden="false" id="recon-marine" defaultAmount="4">
          <constraints>
            <constraint type="min" value="4" field="selections" scope="parent" shared="true" id="recon-marine-min" includeChildSelections="false" />
            <constraint type="max" value="9" field="selections" scope="parent" shared="true" id="recon-marine-max" includeChildSelections="false" />

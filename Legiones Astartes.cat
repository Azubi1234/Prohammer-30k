            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>

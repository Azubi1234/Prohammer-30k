        <selectionEntryGroup name="Special Weapons" id="tac-special-weapons" hidden="false">
          <constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="tac-special-max" includeChildSelections="true"/></constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="load-exchange" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="1" field="tac-special-max"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="4" field="tac-special-max"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/></conditions></modifier>
            <modifier type="set" value="3" field="tac-special-max"><conditionGroups><conditionGroup type="and"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/><condition type="equalTo" value="1" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier>
            <modifier type="set" value="2" field="tac-special-max"><conditionGroups><conditionGroup type="and"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/><condition type="atLeast" value="2" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier>
          </modifiers>
          <entryLinks>

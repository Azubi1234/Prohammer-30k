        <ns0:selectionEntryGroup name="Quad Launcher Additional Ammunition" id="rapier-ammo" hidden="true">
          <ns0:modifiers>
            <ns0:modifier type="set" value="false" field="hidden">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="rapier-arm-quad" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Incendiary Shells (+5 pts per Rapier)" hidden="false" id="rapier-ammo-inc">

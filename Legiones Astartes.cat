          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="r40-da-vow-terminator-terminator-tr-dc" type="selectionEntry" targetId="transport-dreadclaw">
              <ns0:constraints>
                <ns0:constraint id="r40-da-vow-terminator-terminator-tr-dc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          </ns0:entryLinks>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-vow-terminator-terminator-additional" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="0" field="r40-da-vow-terminator-terminator-transport-max">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-vow-terminator-terminator-additional" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-vow-terminator-da-wing-terminator-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-vow-terminator-da-wing-terminator-unit-r40-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r40-da-vow-terminator-da-wing-terminator-unit-r40-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-vow-terminator-da-wing-terminator-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r40-da-vow-terminator-da-wing-terminator-unit-1">
              <ns0:constraints>
                <ns0:constraint id="r40-da-vow-terminator-da-wing-terminator-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r40-da-vow-terminator-da-wing-terminator-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-vow" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers><ns0:entryLinks><ns0:entryLink id="r40-da-vow-terminator-r40-da-term-transponders" name="Teleportation Transponders" type="selectionEntry" targetId="da22-transponders" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-vow-terminator-r40-da-term-transponders-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks><ns0:categoryLinks><ns0:categoryLink id="r40-da-vow-terminator-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Destroyer Squad" hidden="true" id="r40-da-eskaton-destroyer">
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r40-da-eskaton-destroyer-destroyer-standard" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, two Bolt Pistols, a Chainsword, Frag Grenades and Rad Grenades unless replaced by an option below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-eskaton-destroyer-destroyer-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Counter-Attack" id="r40-da-eskaton-destroyer-destroyer-counter" hidden="false">
          <ns0:description>The squad has Counter-Attack using the normal ProHammer rules.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dual Pistols" id="r40-da-eskaton-destroyer-destroyer-dual" hidden="false">
          <ns0:description>A model with this rule may fire both of its Pistol weapons during the Shooting phase. Both pistols must be fired at the same target. If it fires both pistols, it may not fire another weapon during that Shooting phase.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Destroyer Cadre" id="r40-da-eskaton-destroyer-destroyer-cadre" hidden="false">
          <ns0:description>A Legion Destroyer Squad may only be joined by an Independent Character with the Legion Moritat Consul upgrade. No other Independent Character may join the squad.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Rad Grenades" id="r40-da-eskaton-destroyer-destroyer-rad" hidden="false">
          <ns0:description>During any player turn in which the unit charges or is itself charged, enemy non-vehicle models engaged with it suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r40-da-eskaton-destroyer-destroyer-transport-rule" hidden="false">
          <ns0:description>Without Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-eskaton-destroyer-rite-rule" name="Dread Legion" hidden="false"><ns0:description>Selected as a Troops choice by The Eskaton Imperative. This Rite-specific copy is fixed to the Dreadwing.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Destroyers (included)" hidden="false" id="r40-da-eskaton-destroyer-destroyer-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="r40-da-eskaton-destroyer-destroyer-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-eskaton-destroyer-destroyer-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Destroyers (included)" id="r40-da-eskaton-destroyer-destroyer-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>

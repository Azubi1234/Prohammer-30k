              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="r40-da-steel-transport-breacher-unit-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-breacher-unit-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />

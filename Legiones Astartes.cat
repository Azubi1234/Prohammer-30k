                      </ns0:selectionEntries>
                    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-spearhead" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntryGroup>
                  </ns0:selectionEntryGroups><ns0:entryLinks>
            <ns0:entryLink import="true" name="Rhino" hidden="false" id="r35-destroyer-troops-destroyer-tr-rhino" type="selectionEntry" targetId="transport-rhino">

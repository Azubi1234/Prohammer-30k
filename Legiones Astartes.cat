          </ns0:constraints>
          <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Land Raider Dedicated Transport (Armoured Spearhead)" id="r37-spear-veteran-transport" hidden="true">
                      <ns0:constraints>
                        <ns0:constraint id="r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-lrgrp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                      </ns0:constraints>
                      <ns0:rules>
                        <ns0:rule name="Land Raider Dedicated Transport" id="r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-lrrule" hidden="false">
                          <ns0:description>Select a pattern with sufficient Transport Capacity. These entries use the profiles and standard wargear/rules of the corresponding Legion Land Raider Battle Squadron entry; use that entry for full vehicle upgrade options.</ns0:description>
                        </ns0:rule>
                      </ns0:rules>
                      <ns0:selectionEntries>
                        <ns0:selectionEntry type="model" name="Land Raider Phobos" id="r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-phobos" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="250" />
                          </ns0:costs>
                          <ns0:profiles>
                            <ns0:profile name="Land Raider Phobos" id="r37-spear-veteran-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>

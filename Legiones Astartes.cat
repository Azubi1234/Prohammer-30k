ic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Ofanim Prefector" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-ix-3-ofanim-court-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-ix-3-ofanim-court-source" hidden="false"><ns0:description>Ofanim | 5 | 4 | 4 | 4 | 2 | 4 | 3 | 9 | 2+
Ofanim Prefector | 5 | 4 | 4 | 4 | 2 | 4 | 4 | 10 | 2+
Force Organisation:
BLADE OF JUDGEMENT A Blade of Judgement is a Two-Handed Power Weapon. Attacks made with it are resolved at +2 Strength. In addition, a natural To Wound roll of 6 inflicts a Massive Wound (D3) instead of a normal Wound.
• Elites
Unit Composition:
• 2 Ofanim
• 1 Ofanim Prefector
Unit Type:
• Infantry
• The Ofanim Prefector is a Character
Wargear:
• Artificer Armour
• Blade of Judgement
• Bolt pistol
• Combat Shield
• Frag grenades
Special Rules:
• Legiones Astartes (Blood Angels)
• Preferred Enemy (Characters)
OPTIONS
• The squad may include up to two additional Ofanim for +50 points per model.
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
• The entire squad may be equipped with Jump Packs for +15 points per model.
If equipped with Jump Packs, the unit becomes Jump Infantry.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-ix-3-ofanim-court-additional"><ns0:constraints><ns0:constraint id="r41-unit-ix-3-ofanim-court-additional-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-ix-3-ofanim-court-additional-rule" hidden="false"><ns0:description>May include up to 2 additional models at +50 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-ix-3-ofanim-court-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-ix-3-ofanim-court-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-ix-3-ofanim-court-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="6" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-3-ofanim-court-opt-0-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-ix-3-ofanim-court-opt-0-squadwide" hidden="false"><ns0:description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs (base unit; +5 pts/model)" hidden="false" id="r41-unit-ix-3-ofanim-court-opt-1-melta-bombs"><ns0:constraints><ns0:constraint id="r41-unit-ix-3-ofanim-court-opt-1-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-3-ofanim-court-opt-1-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-ix-3-ofanim-court-opt-1-squadwide" hidden="false"><ns0:description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="GRAV CHARIOT SQUADRON" hidden="false" id="r41-unit-ix-4-grav-chariot-squadron"><ns0:costs><ns0:cost name="Points" typeId="pts" value="65" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-ix-4-grav-chariot-squadron-cat" name="Fast Attack" hidden="false" targetId="cat-fast" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Grav Chariot" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-ix-4-grav-chariot-squadron-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-ix-4-grav-chariot-squadron-source" hidden="false"><ns0:description>Grav Chariot | 4 | 4 | 4 | 5 | 1 | 4 | 2 | 8 | 2+
Force Organisation:
GRAV ENGINES Grav Chariots follow all normal ProHammer rules for Jetbikes. A Grav Chariot may fire both its Twin-linked Bolters and its mounted Heavy Bolter, Multi-Melta or Assault Cannon during the same Shooting phase. The mounted weapon may be fired after the Grav Chariot moves.
• Fast Attack
Unit Composition:
• 1–3 Grav Chariots
Unit Type:
• Jetbike
Wargear:
• Twin-linked Bolters
• Heavy Bolter
• Bolt pistol
Special Rules:
• Legiones Astartes (Blood Angels)
• Grav Engines
OPTIONS
• Any Grav Chariot may replace its Heavy Bolter with:
• Multi-Melta ......................................... +15 points
• Assault Cannon ...................................... +20 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-ix-4-grav-chariot-squadron-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r41-unit-ix-4-grav-chariot-squadron-opt-0-multi-melta"><ns0:constraints><ns0:constraint id="r41-unit-ix-4-grav-chariot-squadron-opt-0-multi-melta-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-4-grav-chariot-squadron-opt-0-context" hidden="false"><ns0:description>• Any Grav Chariot may replace its Heavy Bolter with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Assault Cannon" hidden="false" id="r41-unit-ix-4-grav-chariot-squadron-opt-1-assault-cannon"><ns0:constraints><ns0:constraint id="r41-unit-ix-4-grav-chariot-squadron-opt-1-assault-cannon-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-4-grav-chariot-squadron-opt-1-context" hidden="false"><ns0:description>• Any Grav Chariot may replace its Heavy Bolter with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="SANGUINARY GUARD" hidden="false" id="r41-unit-ix-5-sanguinary-guard"><ns0:costs><ns0:cost name="Points" typeId="pts" value="175" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-ix-5-sanguinary-guard-cat" name="Retinue" hidden="false" targetId="cat-retinue" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Sanguinary Guard" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-ix-5-sanguinary-guard-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-ix-5-sanguinary-guard-source" hidden="false"><ns0:description>Sanguinary Guard | 5 | 5 | 4 | 4 | 2 | 4 | 3 | 10 | 2+/5+
Force Organisation:
SANGUINE-PATTERN JUMP PACK A Sanguine-pattern Jump Pack follows all normal ProHammer rules for Jump Packs. In addition, it grants its wearer a 5+ Invulnerable Save. ANGELUS BOLTGUN An Angelus Boltgun is a 12” Storm Bolter. PERDITION WEAPON A Perdition Weapon counts as a Power Weapon. A natural To Wound roll of 6 made with a Perdition Weapon inflicts a Massive Wound (D3) instead of a normal Wound. SERVANTS OF THE GREAT ANGEL A Sanguinary Guard Squad may only be selected as the retinue of one of the following: • A Blood Angels Praetor • Raldoron • Sanguinius The Sanguinary Guard does not occupy a separate Force Organisation slot. The character and Sanguinary Guard count as a single HQ selection. The character must begin the battle joined to the Sanguinary Guard, but may leave the unit normally during the battle.
• Retinue
Unit Composition:
• 3 Sanguinary Guard
Unit Type:
• Jump Infantry
Wargear:
• Artificer Armour
• Sanguine-pattern Jump Pack
• Death Mask
• Angelus Boltgun
• Perdition Weapon
• Frag grenades
Special Rules:
• Legiones Astartes (Blood Angels)
• Fearless
• Servants of the Great Angel
OPTIONS
• The squad may include up to three additional Sanguinary Guard for +55 points per model.
• Any model may replace his Angelus Boltgun with:
• Inferno Pistol ...................................... +10 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
• One Sanguinary Guard may be upgraded to:
• Azkaellon ........................................... +35 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-ix-5-sanguinary-guard-additional"><ns0:constraints><ns0:constraint id="r41-unit-ix-5-sanguinary-guard-additional-max" field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="55" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-ix-5-sanguinary-guard-additional-rule" hidden="false"><ns0:description>May include up to 3 additional models at +55 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-ix-5-sanguinary-guard-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Inferno Pistol" hidden="false" id="r41-unit-ix-5-sanguinary-guard-opt-0-inferno-pistol"><ns0:constraints><ns0:constraint id="r41-unit-ix-5-sanguinary-guard-opt-0-inferno-pistol-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-5-sanguinary-guard-opt-0-context" hidden="false"><ns0:description>• Any model may replace his Angelus Boltgun with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-ix-5-sanguinary-guard-opt-1-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-ix
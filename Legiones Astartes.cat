    <selectionEntry type="model" import="true" name="Legion Dreadnought Drop Pod" hidden="false" id="transport-dreadnought-pod">
      <profiles>
        <profile name="Dreadnought Drop Pod" id="prof-dreadnought-pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <characteristics>
            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
            <characteristic name="Front" typeId="vehicle-front">12</characteristic>
            <characteristic name="Side" typeId="vehicle-side">12</characteristic>
            <characteristic name="Rear" typeId="vehicle-rear">12</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Points" typeId="pts" value="65" />
      </costs>
      <rules>
        <rule name="Transport Capacity" id="dreadpod-cap" hidden="false">
          <description>One Legion Dreadnought or Legion Contemptor Dreadnought. The transported Dreadnought occupies the vehicle's entire Transport Capacity.</description>
        </rule>
        <rule name="Deep Strike" id="dreadpod-deep" hidden="false">
          <description>Uses the normal ProHammer Deep Strike rules together with Drop Pod Assault and Inertial Guidance System.</description>
        </rule>
        <rule name="Drop Pod Assault" id="dreadpod-assault" hidden="false">
          <description>Use the Drop Pod Assault rule given in the Legion Drop Pod entry.</description>
        </rule>
        <rule name="Inertial Guidance System" id="dreadpod-igs" hidden="false">
          <description>Use the Inertial Guidance System rule given in the Legion Drop Pod entry.</description>
        </rule>
        <rule name="Immobile" id="dreadpod-immobile" hidden="false">
          <description>After arriving, the Dreadnought Drop Pod may not move for the remainder of the battle.</description>
        </rule>
        <rule name="Burning Retros" id="dreadpod-retros" hidden="false">
          <description>From arrival by Deep Strike until the start of its controlling player's next turn, the Drop Pod has Shrouded. A Dreadnought disembarking during this period also has Shrouded until that time. In addition, during this period, a unit targeted by shooting gains Shrouded if the attacker's line of sight passes through or over the Dreadnought Drop Pod.</description>
        </rule>
        <rule name="Assault Vehicle" id="dreadpod-assaultveh" hidden="false">
          <description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" name="M.40 Targeter and Stalker Bolter" hidden="false" id="fa-gear-stalker" import="true">
      <profiles>

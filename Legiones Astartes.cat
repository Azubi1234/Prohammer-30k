              </constraints>
            </entryLink>
          </entryLinks>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="terminator-additional" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="0" field="terminator-transport-max">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="terminator-additional" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-terminator-unit" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-terminator-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-terminator-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-terminator-unit-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-terminator-unit-0">
              <constraints>
                <constraint id="da-wing-terminator-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-terminator-unit-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-terminator-unit-1">
              <constraints>
                <constraint id="da-wing-terminator-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-terminator-unit-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-terminator-unit-2">
              <constraints>
                <constraint id="da-wing-terminator-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-terminator-unit-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-terminator-unit-3">
              <constraints>
                <constraint id="da-wing-terminator-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-terminator-unit-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-terminator-unit-4">
              <constraints>
                <constraint id="da-wing-terminator-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-terminator-unit-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-terminator-unit-5">
              <constraints>
                <constraint id="da-wing-terminator-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-terminator-unit-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Destroyer Squad" hidden="false" id="destroyer-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="destroyer-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="destroyer-standard" hidden="false">
          <description>Every model is equipped with Power Armour, two Bolt Pistols, a Chainsword, Frag Grenades and Rad Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="destroyer-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Counter-Attack" id="destroyer-counter" hidden="false">
          <description>The squad has Counter-Attack using the normal ProHammer rules.</description>
        </rule>
        <rule name="Dual Pistols" id="destroyer-dual" hidden="false">
          <description>A model with this rule may fire both of its Pistol weapons during the Shooting phase. Both pistols must be fired at the same target. If it fires both pistols, it may not fire another weapon during that Shooting phase.</description>
        </rule>
        <rule name="Destroyer Cadre" id="destroyer-cadre" hidden="false">
          <description>A Legion Destroyer Squad may only be joined by an Independent Character with the Legion Moritat Consul upgrade. No other Independent Character may join the squad.</description>
        </rule>
        <rule name="Rad Grenades" id="destroyer-rad" hidden="false">
          <description>During any player turn in which the unit charges or is itself charged, enemy non-vehicle models engaged with it suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</description>
        </rule>
        <rule name="Dedicated Transport" id="destroyer-transport-rule" hidden="false">
          <description>Without Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Destroyers (included)" hidden="false" id="destroyer-included" defaultAmount="4">
          <constraints>
            <constraint id="destroyer-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="destroyer-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Destroyers (included)" id="destroyer-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Destroyer Sergeant" hidden="false" id="destroyer-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="destroyer-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="destroyer-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Destroyer Sergeant" id="destroyer-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Additional Legion Destroyer" hidden="false" id="destroyer-additional">
          <constraints>
            <constraint id="destroyer-additional-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="20" />
          </costs>
          <profiles>
            <profile name="Additional Legion Destroyer" id="destroyer-additional-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Points" typeId="pts" value="150" />
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Squad-wide Wargear" id="destroyer-squad-wargear" hidden="false">
          <entryLinks>
            <entryLink import="true" name="Melta Bombs (+5 pts/model)" hidden="false" id="destroyer-squad-melta" type="selectionEntry" targetId="gear-melta-bombs">
              <constraints>
                <constraint id="destroyer-squad-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <modifiers>
                <modifier type="increment" value="5" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="destroyer-additional" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
            </entryLink>
            <entryLink import="true" name="Krak Grenades (+2 pts/model)" hidden="false" id="destroyer-squad-krak" type="selectionEntry" targetId="gear-krak">
              <constraints>
                <constraint id="destroyer-squad-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="10" />
              </costs>
              <modifiers>
                <modifier type="increment" value="2" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="destroyer-additional" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
            </entryLink>
          </entryLinks>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Jump Packs (+15 pts/model)" hidden="false" id="destroyer-jump-packs">
              <constraints>
                <constraint id="destroyer-jump-packs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="75" />
              </costs>
              <modifiers>
                <modifier type="increment" value="15" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="destroyer-additional" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Jump Packs" id="destroyer-jump-rule" hidden="false">
                  <description>Every model gains a Jump Pack and the unit becomes Jump Infantry. A Destroyer Squad equipped with Jump Packs may not select a Dedicated Transport.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>

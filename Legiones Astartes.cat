                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sj" typeId="model-sv">4+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
          <ns0:rules>
            <ns0:rule name="Sergeant Armoury" id="recon-rule-sgt-armoury" hidden="false">
              <ns0:description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. No item may be selected more than once unless a unit entry specifically permits otherwise. Unit-specific replacement options are not repeated in the additional Armoury. Any additional Armoury weapon replaces one of the Sergeant' existing weapons so that he never carries more than two weapons; a pair of Lightning Claws replaces both.</ns0:description>
            </ns0:rule>
          </ns0:rules>
          <ns0:selectionEntryGroups>
            <ns0:selectionEntryGroup name="Sergeant Weapon Options" id="recon-sgt-weapons" hidden="false">
              <ns0:constraints>
                <ns0:constraint type="max" value="2" field="selections" scope="parent" shared="true" id="recon-sgt-weapons-max" includeChildSelections="true" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="1" field="recon-sgt-weapons-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="1" field="selections" scope="parent" childId="recon-sgt-pair-claws" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:selectionEntries>

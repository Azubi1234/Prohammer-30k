              <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />

              <rules>
                <rule name="Standard Wargear" id="techmarine-III-servo-1-std" hidden="false">
                  <description>Bolter and Chainsword.</description>
                </rule>
                <rule name="Cybernetica" id="techmarine-III-servo-1-cyber" hidden="false">
                  <description>At the beginning of each friendly Movement phase, Servo-automata not accompanied by a Legion Techmarine must take a Pinning test. If already engaged in close combat, they do not take this test and fight normally.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Bolter Replacement" id="techmarine-III-servo-1-ranged" hidden="false">

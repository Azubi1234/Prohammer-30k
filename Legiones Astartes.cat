            <entryLink import="true" name="Meltagun" hidden="false" id="sp-m" type="selectionEntry" targetId="gear-meltagun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-m-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Plasma Gun" hidden="false" id="sp-p" type="selectionEntry" targetId="gear-plasma-gun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-p-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
            <entryLink import="true" name="Volkite Charger" hidden="false" id="sp-vc" type="selectionEntry" targetId="gear-volkite-charger"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-vc-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Volkite Caliver" hidden="false" id="sp-vcal" type="selectionEntry" targetId="gear-volkite-caliver"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-vcal-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
            <entryLink import="true" name="Rotor Cannon" hidden="false" id="sp-r" type="selectionEntry" targetId="gear-rotor"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-r-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="4"/></costs></entryLink>
          </entryLinks>

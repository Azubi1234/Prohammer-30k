                <ns0:constraint id="hs-vind-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-vind-laser-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-vind-laser-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-vindicator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>

              <modifiers><modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="assault-sgt-pair-claws" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers>
              <entryLinks>
                <entryLink import="true" name="Volkite Serpenta" hidden="false" id="assault-sgt-pistol-vs" type="selectionEntry" targetId="gear-volkite-serpenta"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>

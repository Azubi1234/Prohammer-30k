            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 2, Rending</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Rending" id="rule-rending-vc" hidden="false">
          <description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</description>
        </rule>
      </rules>
    </selectionEntry>

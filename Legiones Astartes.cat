                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">5</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Shell Shock</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Graviton Cannon (+35 pts per Rapier)" hidden="false" id="rapier-arm-grav">
              <constraints>
                <constraint id="rapier-arm-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>

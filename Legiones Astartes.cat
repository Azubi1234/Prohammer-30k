              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" import="true" name="Rad Missiles (requires Missile Launcher and Techmarine Rad Grenades)" hidden="false" id="techmarine-I-servo-1-rad">
                  <ns0:constraints>
                    <ns0:constraint id="techmarine-I-servo-1-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="10" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Rad Missiles" id="techmarine-I-servo-1-rad-rule" hidden="false">
                      <ns0:description>Legal only if this Servo-automata has a Missile Launcher and its Legion Techmarine is equipped with Rad Grenades. Replace the Missile Launcher's Frag and Krak Missiles with Rad Missiles: 48", S4, AP3, Heavy 1, Blast, Fleshbane, Rad-phage. A surviving model that suffers an unsaved Wound from Rad-phage loses 1 Toughness for the rest of the battle, minimum 1; cumulative.</ns0:description>

            <ns0:entryLink import="true" name="Graviton Gun (replaces built-in Twin-linked Bolter)" hidden="false" id="r35-fury-contemptor-contemptor-secondary-grav" type="selectionEntry" targetId="gear-graviton-gun">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-contemptor-contemptor-secondary-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />

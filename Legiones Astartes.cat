        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Rending" id="rule-rending-vc" hidden="false">
          <ns0:description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>

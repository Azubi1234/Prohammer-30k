                </ns0:selectionEntry>
                <ns0:selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="terminator-sgt-mastercraft">
                  <ns0:constraints>
                    <ns0:constraint id="terminator-sgt-mastercraft-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Master-crafted Weapon" id="terminator-sgt-mastercraft-rule" hidden="false">
                      <ns0:description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
                <ns0:selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="terminator-sgt-signum">
                  <ns0:constraints>
                    <ns0:constraint id="terminator-sgt-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Signum" id="terminator-sgt-signum-rule" hidden="false">
                      <ns0:description>Once per friendly Shooting phase, the unit may re-roll one failed shooting To Hit roll. A unit may benefit from only one Signum per Shooting phase.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
              </ns0:selectionEntries>
              <ns0:rules>
                <ns0:rule name="Terminator Armoury Restrictions" id="terminator-sgt-arm-rule" hidden="false">
                  <ns0:description>Only equipment permitted for a model wearing Terminator Armour is shown. Unit-specific weapon replacements and the Grenade Harness are not duplicated here. No item may be selected more than once unless specifically permitted.</ns0:description>
                </ns0:rule>
              </ns0:rules>

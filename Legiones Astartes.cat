    <selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="gear-meltagun"><profiles><profile name="Meltagun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-meltagun"><characteristics><characteristic name="Range" typeId="ranged-range">12&quot;</characteristic><characteristic name="S" typeId="ranged-s">8</characteristic><characteristic name="AP" typeId="ranged-ap">1</characteristic><characteristic name="Type" typeId="ranged-type">Assault 1, Melta</characteristic></characteristics></profile></profiles><rules><rule name="Melta" id="rule-melta" hidden="false"><description>At half the weapon&apos;s maximum range or less, roll 2D6 for Armour Penetration instead of D6.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Gun" hidden="false" id="gear-plasma-gun"><profiles><profile name="Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-plasma-gun"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">7</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot</characteristic></characteristics></profile></profiles></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Volkite Charger" hidden="false" id="gear-volkite-charger"><profiles><profile name="Volkite Charger" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-volkite-charger"><characteristics><characteristic name="Range" typeId="ranged-range">15&quot;</characteristic><characteristic name="S" typeId="ranged-s">5</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Assault 2, Rending</characteristic></characteristics></profile></profiles><rules><rule name="Rending" id="rule-rending-vc" hidden="false"><description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</description></rule></rules></selectionEntry>

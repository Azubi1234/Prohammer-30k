      <rules>
        <rule name="Standard Wargear" id="fa-seeker-std" hidden="false">
          <description>Power Armour; Bolter; Bolt Pistol; Frag Grenades; Special Issue Ammunition.</description>
        </rule>
        <rule name="Legiones Astartes" id="fa-seeker-la" hidden="false">
          <description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</description>
        </rule>
        <rule name="Infiltrate &amp; Move Through Cover" id="fa-seeker-move" hidden="false">
          <description>The squad has Infiltrate and Move Through Cover as defined in ProHammer Classic.</description>
        </rule>
        <rule name="Marked for Death" id="fa-seeker-mark" hidden="false">
          <description>After deployment, nominate one enemy unit for each Legion Seeker Squad. Against its nominated target, the squad re-rolls To Hit rolls of 1 and To Wound rolls of 1; against vehicles it re-rolls Armour Penetration rolls of 1 instead of To Wound rolls. If the target is destroyed, no new target is selected.</description>
        </rule>
        <rule name="Special Issue Ammunition" id="fa-seeker-ammo-rule" hidden="false">
          <description>Whenever the squad fires Bolters, Foeblaster Boltguns or the bolter component of Combi-weapons, choose one ammunition type for all eligible models: Dragonfire, Hellfire, Kraken or Vengeance. Use the profiles shown below.</description>
        </rule>
      </rules>

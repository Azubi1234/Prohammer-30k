          </ns0:constraints>
          <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Land Raider Dedicated Transport (Armoured Spearhead)" id="r42-role-xiv-0-legion-heavy-support-squads-r37-spear-hs-hss-transport" hidden="true">
                      <ns0:constraints>

                        <ns0:selectionEntry type="model" name="Land Raider Proteus" id="r37-spear-r35-destroyer-troops-destroyer-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" hidden="false" import="true">
                          <ns0:constraints>

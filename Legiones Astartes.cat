Id="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Adherent Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xviii-3-adherent-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xviii-3-adherent-squad-source" hidden="false"><ns0:description>Adherent | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 8 | 3+
Adherent Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
GUIDED BY PROPHECY At the beginning of an Assault phase, the squad may take a Leadership test using Leadership 7 regardless of the Leadership of any model in the unit. If the test is passed, until the end of that Assault phase the squad has Weapon Skill 5 and Feel No Pain (6+). If the test is failed, there is no effect.
Force Organisation:
• Troops
Unit Composition:
• 4 Adherents
• 1 Adherent Sergeant
Unit Type:
• Infantry
• The Adherent Sergeant is a Character
Wargear:
• Power Armour
• Combi-flamer
• Bolt pistol
• Chainsword
• Frag grenades
Special Rules:
• Legiones Astartes (Salamanders)
• Support Squad
• Guided by Prophecy
OPTIONS
• The squad may include up to five additional Adherents for +22 points per model.
• For every five models in the squad, one Adherent may replace his Combi-flamer with:
• Heavy Flamer ................................. +10 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
ADHERENT SERGEANT
The Adherent Sergeant may replace his Chainsword with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Power fist .................................... +15 points
• Thunder hammer ............................... +20 points
The Sergeant may take:
• Artificer Armour ............................. +10 points
The Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Salamanders Armoury.
DEDICATED TRANSPORT
The squad may select a Rhino, Drop Pod or Dreadclaw Drop Pod.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xviii-3-adherent-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xviii-3-adherent-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="22" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xviii-3-adherent-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +22 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xviii-3-adherent-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r41-unit-xviii-3-adherent-squad-opt-0-heavy-flamer"><ns0:constraints><ns0:constraint id="r41-unit-xviii-3-adherent-squad-opt-0-heavy-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xviii-3-adherent-squad-opt-0-context" hidden="false"><ns0:description>• For every five models in the squad, one Adherent may replace his Combi-flamer with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-xviii-3-adherent-squad-opt-1-krak-grenades"><ns0:constraint
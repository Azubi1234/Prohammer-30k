            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-da-wing-hs-spartan-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-2" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile-" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Hunter-Killer Missile" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-hunter-killer-missile--2" hidden="false">
              <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
              <ns0:description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Frag Assault Launchers" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-2" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Frag Assault Launchers" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-frag-assault-launchers-3" hidden="false">
              <ns0:description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="45" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Flare Shield" id="r42-role-xiv-0-legion-heavy-support-squads-r40-da-steel-transport-hs-heavy-support-squad-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
              <ns0:description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>
    </ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xiv-0-legion-heavy-support-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xiv-0-the-reaping" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="SEKHMET TERMINATOR CABAL" hidden="true" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal"><ns0:costs><ns0:cost name="Points" typeId="pts" value="300" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xv-1-the-guard-of-the-crimson-king" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Sekhmet Terminator" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Sekhmet Inceptor" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-source" hidden="false"><ns0:description>Sekhmet Terminator | 5 | 4 | 4 | 4 | 2 | 3 | 2 | 9 | 2+/4+
Sekhmet Inceptor | 5 | 4 | 4 | 4 | 2 | 3 | 3 | 10 | 2+/4+
SCARAB OCCULT The Sekhmet Terminator Cabal is a Psychic Brotherhood. When the army is selected, assign the Cabal to one Prosperine Cult normally. The Cabal receives both the Cult Arcana and Cult Mastery benefits of its selected Prosperine Cult. The Cabal selects one psychic power from any of the normal ProHammer Psychic Disciplines available to Thousand Sons: • Biomancy • Divination • Pyromancy • Telekinesis • Telepathy Psychic Tests are taken using Leadership 9. While the Sekhmet Inceptor remains alive, the Cabal counts as Brotherhood of Psykers (Mastery Level 2), knows one additional psychic power from the disciplines above and takes Psychic Tests using Leadership 10. If the Inceptor is slain, the Cabal immediately returns to Mastery Level 1 and loses the second psychic power. PROSPERINE FORCE WEAPONS The Cabal uses the normal Prosperine Force Weapon rules from the Thousand Sons Armoury. A Psychic Brotherhood may attempt only one Force Weapon activation during each Assault phase. Activating the Cabal's Force Weapons counts as using one psychic power.
Force Organisation:
• Elites
• 0–1
Unit Composition:
• 5 Sekhmet Terminators
Unit Type:
• Infantry
• The Sekhmet Inceptor is a Character
Wargear:
• Cataphractii Terminator Armour
• Prosperine Force Weapon
• Foeblaster Boltgun
Special Rules:
• Legiones Astartes (Thousand Sons)
• Fearless
• Brotherhood of Psykers (Mastery Level 1\)
• Scarab Occult
OPTIONS
• The Cabal may include up to five additional Sekhmet Terminators for +60 points per model.
• Any model may replace its Prosperine Force Weapon with:
• Power fist ........................................ Free
• Chainfist ................................... +10 points
• Any model may replace its Foeblaster Boltgun with a Combi-weapon at the normal Space Marine Armoury cost.
• For every five models in the Cabal, up to two Sekhmet may replace their Foeblaster Boltgun with:
• Heavy Flamer ............................... +10 points
• Plasma Blaster ............................. +15 points
• Reaper Autocannon ......................... +20 points
• One Sekhmet Terminator may be upgraded to:
• Sekhmet Inceptor ........................... +20 points
• The Sekhmet Inceptor may take:
• Grenade Harness ............................ +10 points
• The entire Cabal may take:
• Teleportation Transponders ................. +15 points
DEDICATED TRANSPORT
The Cabal may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>When the most powerful formations of the XV Legion were committed to battle, the Sekhmet and the Legion's greatest sorcerers could be concentrated into a single overwhelming psychic spearhead.
EFFECTS
ASTRAL WARFARE
The first two psychic powers successfully invoked by Thousand Sons Psykers during each player turn are ignored when determining the penalties caused by Disturbance in the Warp.
All other ProHammer psychic rules apply normally.
WREATHED IN LIGHTNING, THEY REND THE VEIL
All Thousand Sons units composed entirely of models wearing Terminator Armour gain Teleportation Transponders at no additional points cost.
Thousand Sons Independent Characters may purchase Teleportation Transponders for +10 points regardless of the armour they wear.
Whenever a unit or Character using these Transponders arrives by Deep Strike, it gains the Fear special rule and may re-roll Invulnerable Save rolls of 1 until the beginning of the next Thousand Sons player turn.
INITIATES OF THE SCARAB
Sekhmet Terminator Cabals may be selected as Troops choices and must fulfil the Detachment's compulsory Troops selections.
THE BIDDING OF THE CRIMSON KING
Magnus the Red may fulfil a compulsory HQ selection when using this Rite and does not occupy a Lord of War selection.
LIMITATIONS
The army's Warlord must be Magnus the Red, Ahzek Ahriman or a Thousand Sons Praetor.
A Thousand Sons Praetor selected as the Warlord may be upgraded from Mastery Level 2 to Mastery Level 3 for +25 points.
The Detachment may not contain more Vehicle units than units with the Legiones Astartes (Thousand Sons) special rule.
The Detachment may not include an Allied Detachment or Fortification.</ns0:description></ns0:rule><ns0:rule id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-additional"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="60" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +60 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Power fist" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-0-power-fist"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-0-power-fist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-0-context" hidden="false"><ns0:description>• Any model may replace its Prosperine Force Weapon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-1-chainfist"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-1-chainfist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-1-context" hidden="false"><ns0:description>• Any model may replace its Prosperine Force Weapon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-2-heavy-flamer"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-2-heavy-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-2-context" hidden="false"><ns0:description>• For every five models in the Cabal, up to two Sekhmet may replace their Foeblaster Boltgun with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Plasma Blaster" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-3-plasma-blaster"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-3-plasma-blaster-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-3-context" hidden="false"><ns0:description>• For every five models in the Cabal, up to two Sekhmet may replace their Foeblaster Boltgun with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Reaper Autocannon" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-4-reaper-autocannon"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-4-reaper-autocannon-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-4-context" hidden="false"><ns0:description>• For every five models in the Cabal, up to two Sekhmet may replace their Foeblaster Boltgun with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Sekhmet Inceptor" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-5-sekhmet-inceptor"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-5-sekhmet-inceptor-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-5-context" hidden="false"><ns0:description>• One Sekhmet Terminator may be upgraded to:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-6-grenade-harness"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-6-grenade-harness-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-6-context" hidden="false"><ns0:description>• The Sekhmet Inceptor may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Teleportation Transponders" hidden="false" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-7-teleportation-transponders"><ns0:constraints><ns0:constraint id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-7-teleportation-transponders-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xv-1-initiates-of-the-scarab-sekhmet-terminator-cabals-r41-unit-xv-0-sekhmet-terminator-cabal-opt-7-context" hidden="false"><ns0:description>• The entire Cabal may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="XV — MAGNUS THE RED, THE CRIMSON KING" hidden="true" id="r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king"><ns0:costs><ns0:cost name="Points" typeId="pts" value="550" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-cat" name="HQ" hidden="false" targetId="cat-hq" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xv-crimson-magnus-hq-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xv-1-the-guard-of-the-crimson-king" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Magnus the Red" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">7</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">7</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">7</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">7</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">6</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">1+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xv-crimson-magnus-hq-r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-source" hidden="false"><ns0:description>Primarch of the Thousand Sons, the Crimson King, Lord of Prospero
Magnus the Red was the most psychically gifted of the Emperor’s sons, a towering scholar-warrior whose understanding of the immaterium exceeded that of all but the greatest minds of the Imperium. Upon Prospero he gathered philosophers, occultists and psykers into a civilisation devoted to knowledge, while the Thousand Sons themselves became masters of disciplines that other Legions regarded with suspicion and fear.
Upon the battlefield Magnus wielded sorcery as naturally as another warrior might wield a blade. He shattered armour with raw aetheric force, twisted the paths of fate, shielded his sons behind impossible barriers and reached into the minds of his enemies. Where lesser psykers risked being overwhelmed by the turbulence of the Warp, the presence of the Crimson King seemed instead to force that turbulence into obedience.
Magnus the Red | 7 | 7 | 7 | 7 | 7 | 6 | 4 | 10 | 1+
Force Organisation:
• Lord of War
Unit Composition:
• 1 Magnus the Red
Unit Type:
• Infantry (Character)
Wargear:
• Horned Raiment
• Blade of Ahn-Nunurta
• Arcane Litanies
Special Rules:
• Primarch
• Legiones Astartes (Thousand Sons)
• Psyker (Mastery Level 4\)
• Lord of the Ether
• The Crimson King
• The Warp Bends to Magnus
• Sorcerous Duellist
HORNED RAIMENT The war-plate of the Crimson King was as much an artefact of sorcery as of the artificer’s craft, surrounded by kine shields, illusions and shifting aetheric wards which distorted the form of Magnus and those who fought at his side. The Horned Raiment counts as Primarch Armour. When an enemy unit makes shooting attacks against Magnus or a unit he has joined, all To Hit rolls made as part of that attack suffer a -1 modifier. To Hit rolls made with Blast weapons suffer a -2 modifier instead. These modifiers have no effect in close combat. BLADE OF AHN-NUNURTA A weapon of ancient and esoteric provenance, the Blade of Ahn-Nunurta served as both a weapon of war and a focus through which Magnus could channel his immense psychic power. The Blade of Ahn-Nunurta is a Master-crafted, Two-Handed Force Weapon. It follows all normal ProHammer rules for Force Weapons. ARCANE LITANIES Inscribed upon the armour and wargear of the Crimson King were formulae, wards and occult geometries intended to protect their bearer against the dangers inherent in drawing upon the Warp. Once per battle, when Magnus suffers a Wound as a result of Perils of the Warp, he may ignore that Wound. The Psychic Test and psychic power are otherwise resolved normally. PSYKER — MASTERY LEVEL 4 Magnus the Red is a Psyker with Mastery Level 4. Before the battle, Magnus selects five psychic powers in total. These powers may be selected from the following disciplines: Biomancy, Divination, Pyromancy, Telekinesis and Telepathy. Magnus must select powers from at least two different psychic disciplines. He may not select all five powers from a single discipline. Infernal Phoenix and Strands of Fate are always known by Magnus and count towards his five psychic powers. Magnus otherwise follows all normal ProHammer rules for Psykers unless specifically stated otherwise. Magnus counts as belonging to all five Prosperine Cults for the purposes of army selection and other friendly abilities, but gains no Cult Arcana or Cult Mastery from them. PSYCHIC SUPREMACY Magnus may never have more than two Blessings affecting himself at the same time. If Magnus successfully invokes a Blessing upon himself while already affected by two Blessings, he must immediately choose one existing Blessing affecting him to end before the new power takes effect. This restriction does not limit Blessings affecting friendly units or Maledictions affecting enemy units. Magnus may never have more than two psychic powers with ongoing effects simultaneously affecting himself and/or the opposing Primarch. LORD OF THE ETHER Magnus may invoke up to four psychic powers during each player turn, overriding the normal ProHammer maximum of two. Magnus may invoke multiple Witchfire powers during the same Shooting phase, subject to his normal limit of four psychic powers. Magnus may not successfully invoke the same psychic power more than once during the same player turn. Activating the Blade of Ahn-Nunurta as a Force Weapon does not count against this limit. THE CRIMSON KING The psychic mastery of Magnus was such that even a faltering connection to the Warp could be seized and brought under control through sheer force of will. Magnus may re-roll one failed Psychic Test during each player turn. The second result must be accepted. Magnus may attempt to Deny the Witch against any psychic power if either the Psyker invoking the power or its target is within 24" of Magnus. Resolve the Deny the Witch attempt normally using Magnus' own Mastery Level. Each psychic power may still only be the subject of one Deny the Witch attempt, as normal. THE WARP BENDS TO MAGNUS Where lesser psykers struggled as the immaterium became increasingly disturbed, Magnus imposed his will upon the Warp with a power few beings could hope to equal. Magnus ignores all Leadership penalties caused by Disturbance in the Warp. In addition, psychic powers successfully invoked by Magnus are ignored when determining the penalties caused by Disturbance in the Warp for other friendly Psykers. Psychic powers successfully invoked by other friendly Psykers still contribute towards Disturbance in the Warp normally. Magnus may also attempt to deny the witch at 18” around him. INFERNAL PHOENIX Witchfire — Beam Magnus unleashes a torrent of incandescent aetheric fire, burning through flesh and armour as it tears across the battlefield. Range 24" | Strength 8 | AP1 | Melta Resolve Infernal Phoenix using the normal rules for Beam psychic powers. STRANDS OF FATE Malediction Magnus reaches into the skeins of possibility and twists them about his victim, turning every intended action into another path towards failure. Choose one enemy non-Vehicle unit within 18" and line of sight. Until the beginning of Magnus’ next turn, that unit must pass a Leadership Test each time it attempts to: • Move during the Movement phase; • Shoot during the Shooting phase; or • declare a Charge. If the test is failed, the attempted action is lost and the unit may not attempt that type of action again during that phase. A separate Leadership Test is required for each different action attempted. SORCEROUS DUELLIST Even when locked in single combat with one of his brother Primarchs, Magnus remained first and foremost a master of the immaterium. While Magnus is fighting a Primarch Duel, at the beginning of each Assault phase he may invoke one of the following: • a Blessing which targets only Magnus; or • a Malediction which targets only the opposing Primarch. This psychic power counts towards Magnus’ maximum allowance of four powers for that player turn. All normal Psychic Tests, Deny the Witch attempts and Perils of the Warp rules apply. PRIMARCH RETINUE Magnus the Red may select any one of the following as his Primarch Retinue: • Legion Honour Guard Squad • Legion Terminator Command Squad • Sekhmet Terminator Cabal A retinue selected in this manner does not occupy an additional Force Organisation selection and otherwise follows the normal Primarch Retinue rules. THE CRIMSON KING’S GUARD A Legion Honour Guard Squad or Legion Terminator Command Squad selected as Magnus’ Primarch Retinue may be upgraded to a Brotherhood of Psykers (Mastery Level 1\) for +25 points per squad. A squad upgraded in this manner is assigned to one Prosperine Cult and receives the normal Cult Arcana and Cult Mastery benefits of that Cult. The squad selects one psychic power from any of the normal psychic disciplines available to Thousand Sons Psykers and otherwise follows all normal rules for a Psychic Brotherhood.</ns0:description></ns0:rule><ns0:rule id="r42-role-xv-crimson-magnus-hq-note" name="The Bidding of the Crimson King" hidden="false"><ns0:description>Magnus the Red may fulfil a compulsory HQ selection when using this Rite and does not occupy a Lord of War selection.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="REAVER ATTACK SQUAD" hidden="true" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="110" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xvi-1-the-black-reaving" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Reaver" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Reaver Chieftain" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-source" hidden="false"><ns0:description>Reaver | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+
Reaver Chieftain | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Fast Attack
Unit Composition:
• 4 Reavers
• 1 Reaver Chieftain
Unit Type:
• Infantry
• The Reaver Chieftain is a Character
Wargear:
• Power Armour
• Bolt pistol
• Chainaxe
• Frag grenades
Special Rules:
• Legiones Astartes (Sons of Horus)
• Furious Charge
OPTIONS
• The squad may include up to five additional Reavers for +22 points per model.
• Up to two Reavers may replace their Bolt pistol with:
• Flamer .......................................... +5 points
• Meltagun ....................................... +10 points
• Plasma Gun ..................................... +15 points
• Plasma Pistol .................................. +15 points
• For every five models in the squad, one Reaver may:
• Replace his Chainaxe with a Power fist ......... +15 points
• Replace his Bolt pistol and Chainaxe with
a pair of Lightning Claws ....................... +15 points
• Every model other than the Reaver Chieftain may purchase:
• Terminator Honours ............................. +15 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
JUMP ASSAULT
The entire squad may purchase Jump Packs for +15 points per model.
If equipped with Jump Packs:
• the unit becomes Jump Infantry;
• it follows the normal ProHammer Jump Infantry rules;
• it may not select a Dedicated Transport.
REAVER CHIEFTAIN
The Reaver Chieftain may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Sons of Horus Armoury.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>The Black Reaving embodies the Cthonian heritage of the XVI Legion. Rather than engaging the enemy in a single ordered battle line, Reaver companies and supporting formations encircle their prey, isolate individual formations and fall upon them from several directions like the gangs of ancient Cthonia.
EFFECTS
REAVER ONSLAUGHT
Reaver Attack Squads may be selected as Troops choices and may fulfil compulsory Troops selections.
At least one of the Detachment's compulsory Troops choices must be a Reaver Attack Squad.
CTHONIAN ENCIRCLEMENT
After both armies have been selected, nominate up to two Sons of Horus Infantry units. These units gain the Outflank special rule.
Any Dedicated Transport purchased for one of these units also gains Outflank and enters play together with its passengers.
An Independent Character which begins the battle attached to one of these nominated units may Outflank with it.
When one of the two nominated units enters play, the Sons of Horus player may choose the side table edge from which that unit enters instead of rolling to determine the edge. The other nominated unit follows the normal ProHammer Outflank rules.
LODGE CEREMONY
Once per battle, at the beginning of a Sons of Horus player turn, the Warlord may declare a Lodge Ceremony.
Until the end of that player turn, all non-Vehicle Sons of Horus units gain the Fleet special rule.
CUT THEM APART
During the first round of a close combat, a Sons of Horus unit which charged an enemy unit that was already engaged with another friendly Sons of Horus unit may re-roll To Hit rolls of 1.
This benefit applies only during the player turn in which the unit charged.
LIMITATIONS
The Detachment must include a Legion Centurion upgraded to a Master of Signals Consul.
At least one compulsory Troops choice must be a Reaver Attack Squad.
The Detachment must include at least as many Fast Attack choices as Heavy Support choices.
The Detachment may not include a Fortification or an Allied Detachment.</ns0:description></ns0:rule><ns0:rule id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-additional"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="22" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +22 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-0-context" hidden="false"><ns0:description>• Up to two Reavers may replace their Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-1-meltagun"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-1-meltagun-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-1-context" hidden="false"><ns0:description>• Up to two Reavers may replace their Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Plasma Gun" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-2-plasma-gun"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-2-plasma-gun-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-2-context" hidden="false"><ns0:description>• Up to two Reavers may replace their Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Plasma Pistol" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-3-plasma-pistol"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-3-plasma-pistol-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-3-context" hidden="false"><ns0:description>• Up to two Reavers may replace their Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace his Chainaxe with a Power fist" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-4-replace-his-chainaxe-with-a-power-fist"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-4-replace-his-chainaxe-with-a-power-fist-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-4-context" hidden="false"><ns0:description>• For every five models in the squad, one Reaver may:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="a pair of Lightning Claws" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-5-a-pair-of-lightning-claws"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-5-a-pair-of-lightning-claws-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-5-context" hidden="false"><ns0:description>- Replace his Bolt pistol and Chainaxe with</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Terminator Honours" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-6-terminator-honours"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-6-terminator-honours-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-6-context" hidden="false"><ns0:description>• Every model other than the Reaver Chieftain may purchase:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-7-krak-grenades"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-7-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-7-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-7-squadwide" hidden="false"><ns0:description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs (base unit; +5 pts/model)" hidden="false" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-8-melta-bombs"><ns0:constraints><ns0:constraint id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-8-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-8-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r42-role-xvi-1-effects-reaver-onslaught-reaver-attack-squads-r41-unit-xvi-1-reaver-attack-squad-opt-8-squadwide" hidden="false"><ns0:description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="PYROCLAST SQUAD" hidden="true" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="190" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xviii-0-the-covenant-of-fire" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Pyroclast" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Pyroclast Warden" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-source" hidden="false"><ns0:description>Pyroclast | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 2+
Pyroclast Warden | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 10 | 2+
Force Organisation:
• Elites
Unit Composition:
• 4 Pyroclasts
• 1 Pyroclast Warden
Unit Type:
• Infantry
• The Pyroclast Warden is a Character
Wargear:
• Artificer Armour
• Pyroclast Flame Projector
• Bolt pistol
• Close-combat weapon
• Frag grenades
Special Rules:
• Legiones Astartes (Salamanders)
• Stubborn
OPTIONS
• The squad may include up to five additional Pyroclasts for +30 points per model.
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
PYROCLAST WARDEN
The Pyroclast Warden may replace his Close-combat weapon with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Power fist .................................... +15 points
• Thunder hammer ............................... +20 points
The Pyroclast Warden may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Salamanders Armoury.
DEDICATED TRANSPORT
The squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.
PYROCLAST FLAME PROJECTOR Each time a Pyroclast Flame Projector is fired, choose one of the following: • It may fire as a Salamanders Heavy Flamer. • It may fire as a Meltagun. The selected weapon uses all of its normal rules. For the purposes of Promethean Cult and Fire-based Warfare, the weapon counts as the weapon whose profile it is using.</ns0:description></ns0:rule><ns0:rule id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>The Covenant of Fire represents the characteristic method of war taught by Vulkan: an inexorable advance through the enemy's strongest resistance, protected by master-crafted armour and supported by overwhelming flame and melta weaponry.
EFFECTS
DISCIPLES OF THE FLAME
Pyroclast Squads and Salamanders Infernus Destroyer Squads may be selected as non-compulsory Troops choices.
They may not fulfil compulsory Troops selections.
WALK THROUGH FIRE
Salamanders Infantry units gain the Move Through Cover special rule.
VENERATION OF WRATH
When a Salamanders model makes an Armour Penetration roll with a Melta weapon, one individual Armour Penetration die which rolls a natural 1 may be re-rolled. The second result must be accepted.
This also applies to Melta Bombs.
OBSIDIAN FORGED
Each time a Salamanders Vehicle or Dreadnought suffers a Glancing or Penetrating Hit from an attack made with a Flame,
Melta, Plasma or Volkite weapon, roll a D6. On a 5+, the hit is ignored. Make this roll before rolling on the Vehicle Damage table.
This protection also applies against Glancing or Penetrating Hits caused by Melta Bombs.
LIMITATIONS
Units in the Detachment may not deploy using Deep Strike. Units which must deploy using Deep Strike may not be selected.
The combined number of Fast Attack and Heavy Support choices may not exceed the number of Troops choices in the Detachment.
The Detachment may not include a Fortification.</ns0:description></ns0:rule><ns0:rule id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-additional"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +30 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad
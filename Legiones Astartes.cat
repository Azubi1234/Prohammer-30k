              <ns0:constraints>
                <ns0:constraint id="techmarine-I-servo-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="12" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Servo-automata" id="techmarine-I-servo-1-prof" typeId="prof-model" typeName="Model" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="WS" typeId="model-ws">3</ns0:characteristic>
                    <ns0:characteristic name="BS" typeId="model-bs">3</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                    <ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic>
                    <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                    <ns0:characteristic name="I" typeId="model-i">1</ns0:characteristic>
                    <ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic>
                    <ns0:characteristic name="Ld" typeId="model-ld">6</ns0:characteristic>
                    <ns0:characteristic name="Sv" typeId="model-sv">5+</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Standard Wargear" id="techmarine-I-servo-1-std" hidden="false">
                  <ns0:description>Bolter and Chainsword.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Cybernetica" id="techmarine-I-servo-1-cyber" hidden="false">
                  <ns0:description>At the beginning of each friendly Movement phase, Servo-automata not accompanied by a Legion Techmarine must take a Pinning test. If already engaged in close combat, they do not take this test and fight normally.</ns0:description>
                </ns0:rule>
              </ns0:rules>

      <ns0:rule id="r43-ws-bike-troops-rule" name="Battlefield Role" hidden="false"><ns0:description>MOUNTED BROTHERHOODS: Legion Bike Squadrons may be selected as Troops choices and may fulfil compulsory Troops selections.</ns0:description></ns0:rule></ns0:rules>

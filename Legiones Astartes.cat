                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">Special</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Concussive, Graviton</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Graviton" id="rapier-grav-rule" hidden="false">
                  <ns0:description>Against non-vehicle models, the number required To Wound is equal to the target's Armour Save. Against vehicles, roll a D6 for each hit; on a 6 the vehicle is Immobilised instead of making a normal Armour Penetration roll.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>

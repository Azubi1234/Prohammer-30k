      <ns0:selectionEntry id="r37-tactical-fury" name="Fury of the Legion (Legion Tactical Company)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-tactical-fury-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Fury of the Legion (Legion Tactical Company)" id="r37-tactical-fury-rule" hidden="false"><ns0:description>Once per battle, when this Legion Tactical Squad remained stationary and is selected to shoot, every bolter fired by the squad fires one additional shot that Shooting phase. Weapons other than bolters receive no extra shots. A unit which uses this rule may not charge during the same turn.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-tactical" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>

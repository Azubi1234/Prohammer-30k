:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="r41-unit-vii-0-templar-brethren-squad-opt-3-legion-vexilla"><ns0:constraints><ns0:constraint id="r41-unit-vii-0-templar-brethren-squad-opt-3-legion-vexilla-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-vii-0-templar-brethren-squad-opt-3-context" hidden="false"><ns0:description>• One model may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="r41-unit-vii-0-templar-brethren-squad-opt-4-nuncio-vox"><ns0:constraints><ns0:constraint id="r41-unit-vii-0-templar-brethren-squad-opt-4-nuncio-vox-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-vii-0-templar-brethren-squad-opt-4-context" hidden="false"><ns0:description>• One other model may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="PHALANX WARDER SQUAD" hidden="false" id="r41-unit-vii-1-phalanx-warder-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-vii-1-phalanx-warder-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:
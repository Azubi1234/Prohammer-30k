        </ns0:rule>
        <ns0:rule name="Deep Strike &amp; Outflank" id="fa-javelin-deploy" hidden="false">
          <ns0:description>The squadron has Deep Strike and Outflank as defined in ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Strafing Run" id="fa-javelin-strafe" hidden="false">
          <ns0:description>When shooting Assault, Heavy, Rapid Fire or Salvo weapons at ground units that are not Flyers or Skimmers, the vehicle gains +1 Ballistic Skill and all such shots count as Pinning, as defined in ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Armoured Crew" id="fa-javelin-armoured" hidden="false">
          <ns0:description>A Javelin Attack Speeder does not count as Open-topped.</ns0:description>
        </ns0:rule>

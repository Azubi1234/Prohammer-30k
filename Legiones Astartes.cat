        <selectionEntry type="model" import="true" name="Legion Techmarine III" hidden="false" id="techmarine-III">
          <constraints>
            <constraint id="techmarine-III-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
          <profiles>
            <profile name="Legion Techmarine" id="techmarine-III-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Standard Wargear" id="techmarine-III-std" hidden="false">
              <description>Power Armour, Bolt Pistol, Power Weapon, Servo-Arm and Frag Grenades.</description>
            </rule>
            <rule name="Legiones Astartes" id="techmarine-III-legiones" hidden="false">
              <description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</description>
            </rule>
            <rule name="Independent Character" id="techmarine-III-ic" hidden="false">
              <description>The Legion Techmarine is an Independent Character, subject to Field Team while accompanied by Servo-automata.</description>
            </rule>
            <rule name="Servo-Arm" id="techmarine-III-servoarm" hidden="false">
              <description>Grants an additional Power Fist-style close-combat attack rolled separately and provides +1 to Battlesmith repair rolls. The normal Battlesmith 5+ therefore succeeds on a 4+ while the Servo-Arm is retained.</description>
            </rule>
            <rule name="Battlesmith" id="techmarine-III-battlesmith" hidden="false">
              <description>Instead of firing in the Shooting phase, while in base contact with an eligible friendly Vehicle, Cybernetica Cortex model or Iron and Machine model, roll a D6. On a 5+, remove one Engine Damaged, restore one Weapon Destroyed, remove one Immobilised result, or restore one lost Wound to an eligible non-vehicle up to its starting Wounds. One attempt per turn; a model may benefit from only one successful repair per turn. Destroyed models cannot be returned. Daemons may not normally be repaired.</description>
            </rule>
            <rule name="Bolster Defences" id="techmarine-III-bolster" hidden="false">
              <description>Before either army deploys, nominate one ruin or similar defensive terrain feature wholly or partially within the army's deployment zone. Improve its Cover Save by 1 to a maximum of 3+. A terrain feature may only be Bolstered once.</description>
            </rule>
            <rule name="Field Team" id="techmarine-III-field" hidden="false">
              <description>If accompanied by one or more Servo-automata, the Techmarine and his Servo-automata form one Field Team. The Techmarine may not voluntarily leave while any Servo-automata remain alive. The whole Field Team may join and leave friendly units as though the Techmarine were an Independent Character. If he is slain, surviving Servo-automata form a unit and become subject to Cybernetica.</description>
            </rule>
            <rule name="Dedicated Transport" id="techmarine-III-transport-rule" hidden="false">
              <description>If not equipped with a Space Marine Bike, this Techmarine may select a Rhino. If accompanied by Servo-automata, the Rhino is purchased for the entire Field Team.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Wargear" id="techmarine-III-wargear" hidden="false">
              <entryLinks>
                <entryLink import="true" name="Auspex" hidden="false" id="techmarine-III-auspex" type="selectionEntry" targetId="gear-auspex">
                  <constraints>
                    <constraint id="techmarine-III-auspex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="2" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Melta Bombs" hidden="false" id="techmarine-III-melta" type="selectionEntry" targetId="gear-melta-bombs">
                  <constraints>
                    <constraint id="techmarine-III-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Nuncio Vox" hidden="false" id="techmarine-III-nuncio" type="selectionEntry" targetId="gear-nuncio">
                  <constraints>
                    <constraint id="techmarine-III-nuncio-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Rad Grenades" hidden="false" id="techmarine-III-rad" type="selectionEntry" targetId="gear-rad-grenades">
                  <constraints>
                    <constraint id="techmarine-III-rad-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Krak Grenades" hidden="false" id="techmarine-III-krak" type="selectionEntry" targetId="gear-krak">
                  <constraints>
                    <constraint id="techmarine-III-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="2" />
                  </costs>
                </entryLink>
              </entryLinks>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="techmarine-III-signum">
                  <constraints>
                    <constraint id="techmarine-III-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="techmarine-III-signum-rule" hidden="false">
                      <description>Once during each friendly Shooting phase, a unit containing a Signum may re-roll one failed To Hit roll made with a shooting weapon. A unit may benefit from only one Signum each Shooting phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="techmarine-III-bike">
                  <constraints>
                    <constraint id="techmarine-III-bike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="35" />
                  </costs>
                  <rules>
                    <rule name="Space Marine Bike" id="techmarine-III-bike-rule" hidden="false">
                      <description>The model becomes Bike and the bike is armed with twin-linked bolters.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
            <selectionEntryGroup name="Bolt Pistol Replacement" id="techmarine-III-pistol" hidden="false">
              <constraints>
                <constraint id="techmarine-III-pistol-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />

            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 6, Rending</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Cyclone Missile Launcher" hidden="false" id="gear-cyclone">
      <ns0:profiles>
        <ns0:profile name="Cyclone Missile Launcher - Frag" id="gear-cyclone-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Blast</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Cyclone Missile Launcher - Krak" id="gear-cyclone-prof-1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 2</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Cyclone Missile Launcher" id="gear-cyclone-rule-0" hidden="false">
          <ns0:description>The bearer may fire the Cyclone Missile Launcher while retaining its combi-bolter and close-combat weapon.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="gear-grenade-harness">
      <ns0:profiles>
        <ns0:profile name="Grenade Harness" id="gear-grenade-harness-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">8"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">-</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 2, Blast, One Use</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Grenade Harness" id="gear-grenade-harness-rule-0" hidden="false">
          <ns0:description>May only be fired once per battle. If fired during the Shooting phase, the bearer and any unit it has joined count as equipped with Frag Grenades during the following Assault phase.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Rad Grenades" hidden="false" id="gear-rad-grenades">
      <ns0:rules>
        <ns0:rule name="Rad Grenades" id="gear-rad-grenades-rule-0" hidden="false">
          <ns0:description>Rad Grenades are neither Assault nor Defensive Grenades. During any player turn in which a unit equipped with Rad Grenades charges, or is itself charged, enemy non-vehicle models engaged with that unit suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Missile Launcher with Suspensor Web and Rad Missiles" hidden="false" id="gear-rad-missile">
      <ns0:profiles>
        <ns0:profile name="Rad Missile" id="gear-rad-missile-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Fleshbane, Rad-phage</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Rad-phage" id="gear-rad-missile-rule-0" hidden="false">
          <ns0:description>If a model suffers one or more unsaved Wounds from a weapon with Rad-phage and survives, reduce its Toughness by 1 for the remainder of the battle, to a minimum of 1. Multiple applications are cumulative.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Rad Missiles Only" id="gear-rad-missile-rule-1" hidden="false">
          <ns0:description>A Missile Launcher equipped with Rad Missiles may only fire Rad Missiles and may not use Frag or Krak Missiles.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Phosphex Bomb" hidden="false" id="gear-phosphex-bomb">
      <ns0:profiles>
        <ns0:profile name="Phosphex Bomb" id="gear-phosphex-bomb-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>

                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        <ns0:rules><ns0:rule id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-rite-size" name="Armoured Assault" hidden="false"><ns0:description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry>

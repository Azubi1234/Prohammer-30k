    <selectionEntry type="upgrade" import="true" name="Combi-Plasma Gun" hidden="false" id="gear-combi-plasma"><profiles><profile name="Combi-Plasma Gun - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-plasma-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Plasma Gun - Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-plasma-p"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">7</characteristic><characteristic name="AP" typeId="ranged-ap">2</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-plasma" hidden="false"><description>Choose one component to fire. The bolter may be fired normally; the secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combi-Volkite Charger" hidden="false" id="gear-combi-volkite"><profiles><profile name="Combi-Volkite Charger - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-b"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile><profile name="Combi-Volkite Charger - Volkite" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-v"><characteristics><characteristic name="Range" typeId="ranged-range">15&quot;</characteristic><characteristic name="S" typeId="ranged-s">5</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Assault 2, Deflagrate, One Use</characteristic></characteristics></profile></profiles><rules><rule name="Combi-Weapon" id="rule-combi-volkite" hidden="false"><description>Choose one component to fire. The bolter may be fired normally; the secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description></rule></rules></selectionEntry>

    <selectionEntry type="upgrade" import="true" name="Chainaxe" hidden="false" id="gear-chainaxe"><rules><rule name="Chainaxe" id="rule-chainaxe" hidden="false"><description>Armour Saves better than 4+ are reduced to 4+ against wounds caused by a Chainaxe. Armour Saves of 4+ or worse and Invulnerable Saves are unaffected.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Lightning Claw" hidden="false" id="gear-lightning-claw"><rules><rule name="Lightning Claw" id="rule-lightning-claw" hidden="false"><description>Power Weapon; re-roll failed To Wound rolls; Specialist Weapon.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws" hidden="false" id="gear-pair-claws"><rules><rule name="Pair of Lightning Claws" id="rule-pair-claws" hidden="false"><description>Counts as two weapon choices. Power Weapon; re-roll failed To Wound rolls; Specialist Weapon; +1 Attack.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Power Fist" hidden="false" id="gear-power-fist"><rules><rule name="Power Fist" id="rule-power-fist" hidden="false"><description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Power Weapon" hidden="false" id="gear-power-weapon"><rules><rule name="Power Weapon" id="rule-power-weapon" hidden="false"><description>Ignores Armour Saves.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="gear-rending"><rules><rule name="Rending" id="rule-rending" hidden="false"><description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Thunder Hammer" hidden="false" id="gear-thunder"><rules><rule name="Thunder Hammer" id="rule-thunder" hidden="false"><description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon, Concussive.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-combat-shield"><rules><rule name="Combat Shield" id="rule-combat-shield" hidden="false"><description>Provides a 6+ Invulnerable Save.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-auspex"><rules><rule name="Auspex" id="rule-auspex" hidden="false"><description>After enemy Infiltrators deploy, roll 4D6. If an enemy Infiltrating unit is within that distance and line of sight, the bearer&apos;s unit may immediately fire at it once before the battle begins. A unit may only make one Auspex attack.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-bionics"><rules><rule name="Bionics" id="rule-bionics" hidden="false"><description>When the bearer loses its final Wound, roll a D6 at the beginning of its next turn. On a 6 it returns with 1 Wound; otherwise remove it. Normally unavailable if the bearer&apos;s whole unit was destroyed simultaneously.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="gear-melta-bombs"><rules><rule name="Melta Bombs" id="rule-melta-bombs" hidden="false"><description>Against a vehicle in close combat, make one attack instead of normal attacks. If it hits, resolve at S8 + 2D6 Armour Penetration.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-purity"><rules><rule name="Purity Seals" id="rule-purity" hidden="false"><description>When the bearer&apos;s unit Falls Back, roll one additional D6 and discard one die of the controlling player&apos;s choice. Not cumulative.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-homer"><rules><rule name="Teleport Homer" id="rule-homer" hidden="false"><description>Friendly units arriving by teleportation do not scatter if the first model is placed within 6&quot; of an active Homer that was on the battlefield at the start of the turn.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Krak Grenades" hidden="false" id="gear-krak"><rules><rule name="Krak Grenades" id="rule-krak" hidden="false"><description>Against a vehicle in close combat, a model may make one grenade attack instead of its normal attacks. If it hits, resolve Armour Penetration at S6 + D6. Against a non-Immobilised Walker, grenade attacks hit only on a 6.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-vexilla"><rules><rule name="Legion Vexilla" id="rule-vexilla" hidden="false"><description>The unit adds +1 to its combat resolution.</description></rule></rules></selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-nuncio"><rules><rule name="Nuncio Vox" id="rule-nuncio" hidden="false"><description>A friendly unit arriving by Deep Strike does not scatter if its first model is placed within 6&quot; of the bearer and more than 1&quot; from every enemy model. The bearer must have been on the battlefield at the start of the turn and may not be Pinned, Falling Back or embarked in a Transport.</description></rule></rules></selectionEntry>

    <selectionEntry type="model" import="true" name="Rhino" hidden="false" id="transport-rhino">
      <profiles><profile name="Rhino" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-rhino"><characteristics><characteristic name="BS" typeId="vehicle-bs">4</characteristic><characteristic name="Front" typeId="vehicle-front">11</characteristic><characteristic name="Side" typeId="vehicle-side">11</characteristic><characteristic name="Rear" typeId="vehicle-rear">10</characteristic></characteristics></profile></profiles>
      <costs><cost name="Points" typeId="pts" value="50"/></costs>
      <entryLinks><entryLink import="true" name="Storm Bolter" hidden="false" id="rhino-sb" type="selectionEntry" targetId="gear-storm-bolter" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-max" includeChildSelections="false" automatic="true"/></constraints></entryLink></entryLinks>
      <rules><rule name="Transport" id="rule-rhino-transport" hidden="false"><description>Transport Capacity: 10 Space Marines. Uses the normal ProHammer Transport vehicle rules.</description></rule></rules>
      <selectionEntryGroups><selectionEntryGroup name="Vehicle Upgrades" id="rhino-upgrades" hidden="false"><selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Dozer Blade" hidden="false" id="rhino-dozer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-dozer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="rhino-extra"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-extra-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="rhino-hk"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-hk-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Pintle-mounted Storm Bolter" hidden="false" id="rhino-pintle"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-pintle-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Searchlight" hidden="false" id="rhino-search"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-search-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="1"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Smoke Launchers" hidden="false" id="rhino-smoke"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-smoke-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="3"/></costs></selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Havoc Missile Launcher" hidden="false" id="rhino-havoc"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-havoc-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="20"/></costs></selectionEntry>
      </selectionEntries></selectionEntryGroup></selectionEntryGroups>
    </selectionEntry>
  </sharedSelectionEntries>

  <selectionEntries>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad" hidden="false" id="tactical-unit">
      <categoryLinks><categoryLink targetId="cat-troops" id="tactical-cat" primary="true" name="Troops" hidden="false"/></categoryLinks>
      <rules>
        <rule name="Legiones Astartes" id="tactical-legiones" hidden="false"><description>The squad uses the Legiones Astartes rules, including And They Shall Know No Fear and the appropriate Legion-specific rules.</description></rule>
        <rule name="Frag Grenades" id="tactical-frag" hidden="false"><description>Frag Grenades are included in the squad&apos;s starting wargear. They provide the normal ProHammer assault benefit when charging enemies in cover. Against a vehicle in close combat, a model may make one grenade attack instead of its normal attacks; if it hits, resolve Armour Penetration at S4 + D6. Against a non-Immobilised Walker, grenade attacks hit only on a 6.</description></rule>
        <rule name="Fury of the Legion" id="tactical-fury" hidden="false"><description>The squad may declare Fury of the Legion in its Shooting phase if it did not move, arrive from Reserves or Deep Strike, or disembark that turn, and at least five models remain armed with Bolters or Bolt pistols. Models armed with Bolters or Bolt pistols fire those weapons twice: Bolters fire 2 shots up to 24&quot; or 4 shots up to 12&quot;; Bolt pistols fire 2 shots. After using Fury of the Legion, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description></rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="tac-marine" defaultAmount="9">
          <constraints><constraint type="min" value="9" field="selections" scope="parent" shared="true" id="tac-marine-min" includeChildSelections="false"/><constraint type="max" value="19" field="selections" scope="parent" shared="true" id="tac-marine-max" includeChildSelections="false"/></constraints>
          <costs><cost name="Points" typeId="pts" value="15"/></costs>
          <profiles><profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-marine"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">1</characteristic><characteristic name="Ld" typeId="model-ld">8</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="tac-sergeant" defaultAmount="1">
          <constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-max" includeChildSelections="false" automatic="true"/><constraint type="max" value="65" field="pts" scope="parent" shared="true" id="tac-sgt-armoury-cap" includeChildSelections="true"/></constraints>
          <costs><cost name="Points" typeId="pts" value="15"/></costs>
          <profiles><profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-sergeant"><characteristics><characteristic name="WS" typeId="model-ws">4</characteristic><characteristic name="BS" typeId="model-bs">4</characteristic><characteristic name="S" typeId="model-s">4</characteristic><characteristic name="T" typeId="model-t">4</characteristic><characteristic name="W" typeId="model-w">1</characteristic><characteristic name="I" typeId="model-i">4</characteristic><characteristic name="A" typeId="model-a">2</characteristic><characteristic name="Ld" typeId="model-ld">9</characteristic><characteristic name="Sv" typeId="model-sv">3+</characteristic></characteristics></profile></profiles>
          <rules><rule name="Sergeant Armoury" id="rule-sgt-armoury" hidden="false"><description>May select up to 50 points of permitted additional weapons and wargear. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as two weapon choices. Standard weapons are replaced as necessary. Master-crafted Weapons, Special Issue Ammunition, Boarding Shields, Iron Halos, Refractor Fields, Artificer Armour and officer/specialist-only equipment are not available here.</description></rule></rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Armoury - Weapons" id="sgt-weapons" hidden="false">
              <constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-weapons-max" includeChildSelections="true"/></constraints>
              <selectionEntryGroups>
                <selectionEntryGroup name="Single-Handed Weapons" id="sgt-single" hidden="false"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-single-max" includeChildSelections="false"/></constraints><entryLinks>
                  <entryLink import="true" name="Bolt Pistol" hidden="false" id="sgt-bp" type="selectionEntry" targetId="gear-bolt-pistol"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-bp-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="1"/></costs></entryLink>
                  <entryLink import="true" name="Chainaxe" hidden="false" id="sgt-chainaxe" type="selectionEntry" targetId="gear-chainaxe"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-chainaxe-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="4"/></costs></entryLink>
                  <entryLink import="true" name="Close Combat Weapon" hidden="false" id="sgt-ccw" type="selectionEntry" targetId="gear-ccw"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-ccw-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="1"/></costs></entryLink>
                  <entryLink import="true" name="Hand Flamer" hidden="false" id="sgt-handflamer" type="selectionEntry" targetId="gear-hand-flamer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-handflamer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                  <entryLink import="true" name="Lightning Claw" hidden="false" id="sgt-claw" type="selectionEntry" targetId="gear-lightning-claw"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-claw-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="25"/></costs></entryLink>
                  <entryLink import="true" name="Pair of Lightning Claws" hidden="false" id="sgt-pairclaw" type="selectionEntry" targetId="gear-pair-claws"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-pairclaw-max" includeChildSelections="false"/></constraints><modifiers><modifier type="set" value="1" field="sgt-weapons-max"/></modifiers><costs><cost name="Points" typeId="pts" value="30"/></costs></entryLink>
                  <entryLink import="true" name="Plasma Pistol" hidden="false" id="sgt-pp" type="selectionEntry" targetId="gear-plasma-pistol"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-pp-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
                  <entryLink import="true" name="Power Fist" hidden="false" id="sgt-fist" type="selectionEntry" targetId="gear-power-fist"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-fist-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="25"/></costs></entryLink>
                  <entryLink import="true" name="Power Weapon" hidden="false" id="sgt-pw" type="selectionEntry" targetId="gear-power-weapon"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-pw-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
                  <entryLink import="true" name="Rending Weapon" hidden="false" id="sgt-rending" type="selectionEntry" targetId="gear-rending"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-rending-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                  <entryLink import="true" name="Thunder Hammer" hidden="false" id="sgt-th" type="selectionEntry" targetId="gear-thunder"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-th-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="30"/></costs></entryLink>
                  <entryLink import="true" name="Volkite Serpenta" hidden="false" id="sgt-serpenta" type="selectionEntry" targetId="gear-volkite-serpenta"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-serpenta-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                </entryLinks></selectionEntryGroup>
                <selectionEntryGroup name="Two-Handed Weapons" id="sgt-twohand" hidden="false"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-twohand-max" includeChildSelections="false"/></constraints><entryLinks>
                  <entryLink import="true" name="Bolter" hidden="false" id="sgt-bolter" type="selectionEntry" targetId="gear-bolter"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-bolter-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="2"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Bolter" hidden="false" id="sgt-combib" type="selectionEntry" targetId="gear-combi-bolter"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combib-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Flamer" hidden="false" id="sgt-combif" type="selectionEntry" targetId="gear-combi-flamer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combif-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Grenade Launcher" hidden="false" id="sgt-combig" type="selectionEntry" targetId="gear-combi-grenade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combig-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Meltagun" hidden="false" id="sgt-combim" type="selectionEntry" targetId="gear-combi-melta"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combim-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Plasma Gun" hidden="false" id="sgt-combip" type="selectionEntry" targetId="gear-combi-plasma"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combip-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
                  <entryLink import="true" name="Combi-Volkite Charger" hidden="false" id="sgt-combiv" type="selectionEntry" targetId="gear-combi-volkite"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-combiv-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
                  <entryLink import="true" name="Storm Bolter" hidden="false" id="sgt-storm" type="selectionEntry" targetId="gear-storm-bolter"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-storm-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                  <entryLink import="true" name="Volkite Charger" hidden="false" id="sgt-vcharger" type="selectionEntry" targetId="gear-volkite-charger"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-vcharger-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
                </entryLinks></selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntryGroup>
            <selectionEntryGroup name="Sergeant Armoury - Wargear" id="sgt-wargear" hidden="false"><entryLinks>
              <entryLink import="true" name="Auspex" hidden="false" id="sgt-auspex" type="selectionEntry" targetId="gear-auspex"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-auspex-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="2"/></costs></entryLink>
              <entryLink import="true" name="Bionics" hidden="false" id="sgt-bionics" type="selectionEntry" targetId="gear-bionics"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-bionics-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
              <entryLink import="true" name="Combat Shield" hidden="false" id="sgt-cshield" type="selectionEntry" targetId="gear-combat-shield"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-cshield-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
              <entryLink import="true" name="Melta Bombs" hidden="false" id="sgt-mbombs" type="selectionEntry" targetId="gear-melta-bombs"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-mbombs-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
              <entryLink import="true" name="Purity Seals" hidden="false" id="sgt-purity" type="selectionEntry" targetId="gear-purity"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-purity-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
              <entryLink import="true" name="Teleport Homer" hidden="false" id="sgt-homer" type="selectionEntry" targetId="gear-homer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-homer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
            </entryLinks></selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>

      <selectionEntryGroups>
        <selectionEntryGroup name="Squad Weapons" id="tac-loadout" hidden="false" defaultSelectionEntryId="load-standard">
          <constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-max" includeChildSelections="false" automatic="true"/></constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bolters + Bolt Pistols" hidden="false" id="load-standard" defaultAmount="1"><entryLinks><entryLink import="true" name="Bolter" hidden="false" id="load-standard-b" type="selectionEntry" targetId="gear-bolter" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-standard-b-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-standard-b-max" includeChildSelections="false" automatic="true"/></constraints></entryLink><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-standard-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-max" includeChildSelections="false" automatic="true"/></constraints></entryLink></entryLinks></selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Bolters + Bolt Pistols + Chainswords (+2 pts/model)" hidden="false" id="load-add-chainswords"><entryLinks><entryLink import="true" name="Bolter" hidden="false" id="load-add-b" type="selectionEntry" targetId="gear-bolter" defaultAmount="1"/><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-add-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"/><entryLink import="true" name="Chainsword" hidden="false" id="load-add-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1"/></entryLinks><costs><cost name="Points" typeId="pts" value="2"/></costs><modifiers><modifier type="increment" value="2" field="pts"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="tac-marine" shared="true" roundUp="false" includeChildSelections="false"/></repeats></modifier></modifiers></selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Exchange Bolters for Chainswords (Free)" hidden="false" id="load-exchange"><entryLinks><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-ex-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"/><entryLink import="true" name="Chainsword" hidden="false" id="load-ex-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1"/></entryLinks></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>

        <selectionEntryGroup name="Squad Grenades" id="tac-grenades" hidden="false"><entryLinks><entryLink import="true" name="Krak Grenades (+2 pts/model)" hidden="false" id="tac-krak" type="selectionEntry" targetId="gear-krak"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-krak-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="2"/></costs><modifiers><modifier type="increment" value="2" field="pts"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="tac-marine" shared="true" roundUp="false" includeChildSelections="false"/></repeats></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup>

        <selectionEntryGroup name="Special Weapon 1" id="tac-special-1" hidden="false"><modifiers><modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="load-exchange" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-special-1-max" includeChildSelections="false"/></constraints><entryLinks>
          <entryLink import="true" name="Flamer" hidden="false" id="sp1-f" type="selectionEntry" targetId="gear-flamer"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink><entryLink import="true" name="Meltagun" hidden="false" id="sp1-m" type="selectionEntry" targetId="gear-meltagun"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Plasma Gun" hidden="false" id="sp1-p" type="selectionEntry" targetId="gear-plasma-gun"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink><entryLink import="true" name="Volkite Charger" hidden="false" id="sp1-vc" type="selectionEntry" targetId="gear-volkite-charger"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Volkite Caliver" hidden="false" id="sp1-vcal" type="selectionEntry" targetId="gear-volkite-caliver"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink><entryLink import="true" name="Rotor Cannon" hidden="false" id="sp1-r" type="selectionEntry" targetId="gear-rotor"><costs><cost name="Points" typeId="pts" value="4"/></costs></entryLink>
        </entryLinks></selectionEntryGroup>

        <selectionEntryGroup name="Heavy Weapon 1" id="tac-heavy-1" hidden="false"><modifiers><modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="load-exchange" shared="true" includeChildSelections="true"/></conditions></modifier></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-heavy-1-max" includeChildSelections="false"/></constraints><entryLinks>
          <entryLink import="true" name="Heavy Bolter" hidden="false" id="hv1-hb" type="selectionEntry" targetId="gear-heavy-bolter"><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink><entryLink import="true" name="Missile Launcher" hidden="false" id="hv1-ml" type="selectionEntry" targetId="gear-missile"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Autocannon" hidden="false" id="hv1-ac" type="selectionEntry" targetId="gear-autocannon"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Multi-Melta" hidden="false" id="hv1-mm" type="selectionEntry" targetId="gear-multimelta"><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Plasma Cannon" hidden="false" id="hv1-pc" type="selectionEntry" targetId="gear-plasma-cannon"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink><entryLink import="true" name="Lascannon" hidden="false" id="hv1-lc" type="selectionEntry" targetId="gear-lascannon"><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>

              <ns0:entryLink id="r39-phosphex-r35-sky-troops-fa-sky-sgt-armoury" name="Phosphex Bomb (Destroyer Company)" type="selectionEntry" targetId="gear-phosphex-bomb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r39-phosphex-r35-sky-troops-fa-sky-sgt-armoury-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-destroyer" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
              <ns0:rules>
                <ns0:rule name="Sergeant Armoury Restrictions" id="r35-sky-troops-fa-sky-sgt-arm-rule" hidden="false">
                  <ns0:description>Up to 50 points of permitted additional Space Marine Armoury equipment. Standard wargear and unit-specific options are not repeated here. No item may be selected more than once unless specifically permitted; normal Armoury weapon limits still apply.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntryGroup>
          </ns0:selectionEntryGroups>
          <ns0:entryLinks>
            <ns0:entryLink name="Melta Bombs" hidden="false" id="r35-sky-troops-fa-sky-sgt-melta" type="selectionEntry" targetId="gear-melta-bombs" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-fa-sky-sgt-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:modifiers>
                <ns0:modifier type="set" value="true" field="hidden">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-sky-troops-fa-sky-melta" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="0" field="fa-sky-sgt-melta-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-sky-troops-fa-sky-melta" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-fa-sky-hunter-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-0">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r35-sky-troops-da-wing-fa-sky-hunter-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-1">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r35-sky-troops-da-wing-fa-sky-hunter-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-2">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r35-sky-troops-da-wing-fa-sky-hunter-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-3">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r35-sky-troops-da-wing-fa-sky-hunter-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-4">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r35-sky-troops-da-wing-fa-sky-hunter-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-sky-troops-da-wing-fa-sky-hunter-5">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-da-wing-fa-sky-hunter-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r35-sky-troops-da-wing-fa-sky-hunter-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:entryLinks><ns0:entryLink id="r40-da-forward-r35-sky-troops-fa-sky-hunter" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-r35-sky-troops-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-sky-troops-da-wing-fa-sky-hunter-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Tactical Squad (Storm of War compulsory)" hidden="true" id="r40-da-storm-tactical">
      <ns0:rules>
        <ns0:rule name="Power Armour" id="r40-da-storm-tactical-tactical-power-armour" hidden="false">
          <ns0:description>Models wearing Power Armour have a 3+ Armour Save.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-storm-tactical-tactical-legiones" hidden="false">
          <ns0:description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="r40-da-storm-tactical-tactical-frag" hidden="false">
          <ns0:description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Fury of the Legion" id="r40-da-storm-tactical-tactical-fury" hidden="false">
          <ns0:description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Automatic Basic Wargear" id="r40-da-storm-tactical-rev23-tactical-wargear-auto" hidden="false">
          <ns0:description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-storm-tactical-rite-rule" name="Storm of War — Compulsory Formation" hidden="false"><ns0:description>This Rite-specific entry represents a compulsory 20-model Stormwing Tactical Squad. It may not select a Dedicated Transport.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="r40-da-storm-tactical-tac-marine" defaultAmount="9">
          <ns0:constraints>
            <ns0:constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-marine-min" includeChildSelections="false" />
            <ns0:constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-marine-max" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="15" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-tactical-prof-tac-marine">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="r40-da-storm-tactical-tac-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-sgt-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-tac-sgt-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="15" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-tactical-prof-tac-sergeant">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
          <ns0:rules>
            <ns0:rule name="Sergeant Armoury" id="r40-da-storm-tactical-rule-sgt-armoury" hidden="false">
              <ns0:description>May select up to 50 points of permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as two weapon choices. His standard Bolter and Bolt Pistol are already included and are not repurchased.</ns0:description>
            </ns0:rule>
          </ns0:rules>
          <ns0:selectionEntryGroups>
            <ns0:selectionEntryGroup name="Sergeant Armoury (max 50 pts)" id="r40-da-storm-tactical-sgt-armoury" hidden="false">
              <ns0:constraints>
                <ns0:constraint type="max" value="50" field="pts" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-armoury-pts-max" includeChildSelections="true" />
              </ns0:constraints>
              <ns0:selectionEntryGroups>
                <ns0:selectionEntryGroup name="Sergeant Armoury - Weapons" id="r40-da-storm-tactical-sgt-weapons" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint type="max" value="2" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-weapons-max" includeChildSelections="true" />
                  </ns0:constraints>
                  <ns0:selectionEntryGroups>
                    <ns0:selectionEntryGroup name="Single-Handed Weapons" id="r40-da-storm-tactical-sgt-single" hidden="false">
                      <ns0:constraints>
                        <ns0:constraint type="max" value="2" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-single-max" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:entryLinks>
                        <ns0:entryLink import="true" name="Hand Flamer" hidden="false" id="r40-da-storm-tactical-sgt-handflamer" type="selectionEntry" targetId="gear-hand-flamer">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-handflamer-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="5" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Lightning Claw" hidden="false" id="r40-da-storm-tactical-sgt-claw" type="selectionEntry" targetId="gear-lightning-claw">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-claw-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="25" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Plasma Pistol" hidden="false" id="r40-da-storm-tactical-sgt-pp" type="selectionEntry" targetId="gear-plasma-pistol">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-pp-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="15" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Power Fist" hidden="false" id="r40-da-storm-tactical-sgt-fist" type="selectionEntry" targetId="gear-power-fist">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-fist-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="25" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Power Weapon" hidden="false" id="r40-da-storm-tactical-sgt-pw" type="selectionEntry" targetId="gear-power-weapon">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-pw-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="15" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Rending Weapon" hidden="false" id="r40-da-storm-tactical-sgt-rending" type="selectionEntry" targetId="gear-rending">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-rending-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="5" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Thunder Hammer" hidden="false" id="r40-da-storm-tactical-sgt-th" type="selectionEntry" targetId="gear-thunder">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-th-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="30" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Volkite Serpenta" hidden="false" id="r40-da-storm-tactical-sgt-serpenta" type="selectionEntry" targetId="gear-volkite-serpenta">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-sgt-serpenta-max" includeChildSelections="false" />
                          </ns0:constraints>
                          <ns0:costs>
                            <ns0:cost name="Points" typeId="pts" value="5" />
                          </ns0:costs>
                        </ns0:entryLink>
                        <ns0:entryLink import="true" name="Calibanite Plasma Pistol" hidden="false" id="r40-da-storm-tactical-da22-alt-pp-0" type="selectionEntry" targetId="da22-plasma-pistol">
                          <ns0:constraints>
                            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-tactical-da22-alt-pp-0-2" includeChildSelections="false" />

    <selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="false" id="contemptor-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="contemptor-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="155" />
      </costs>
      <profiles>
        <profile name="Legion Contemptor Dreadnought" id="contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="walker-ws">5</characteristic>
            <characteristic name="BS" typeId="walker-bs">5</characteristic>
            <characteristic name="S" typeId="walker-s">7</characteristic>
            <characteristic name="Front" typeId="walker-front">13</characteristic>
            <characteristic name="Side" typeId="walker-side">12</characteristic>
            <characteristic name="Rear" typeId="walker-rear">10</characteristic>
            <characteristic name="I" typeId="walker-i">4</characteristic>
            <characteristic name="A" typeId="walker-a">2</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="contemptor-standard" hidden="false">
          <description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.</description>
        </rule>
        <rule name="Atomantic Shielding" id="contemptor-atomantic" hidden="false">
          <description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</description>
        </rule>
        <rule name="Fleet" id="contemptor-fleet" hidden="false">
          <description>Uses the normal ProHammer Fleet special rule.</description>
        </rule>
        <rule name="Paired Close-Combat Arms" id="contemptor-paired" hidden="false">
          <description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</description>
        </rule>
      </rules>

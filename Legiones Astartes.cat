          <constraints>
            <constraint id="hq-praetor-weapons-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="hq-praetor-weapons-pts-max" type="max" value="100" field="pts" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <rules>
            <rule name="Armoury Weapon Restrictions" id="hq-praetor-weap-rule" hidden="false">
              <description>These selections replace the model's Bolt Pistol and/or Chainsword. A model may carry no more than two weapons, only one of which may be two-handed. A Pair of Lightning Claws counts as both weapon choices. No item may be selected more than once unless specifically permitted. Equipment included in the unit entry does not count against the Armoury allowance.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Single-handed Weapons" id="hq-praetor-single" hidden="false">

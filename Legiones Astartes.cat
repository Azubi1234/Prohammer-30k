d="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xii-3-world-eaters-inductii-squad-source" hidden="false"><ns0:description>Inductii | 4 | 3 | 4 | 4 | 1 | 4 | 1 | 7 | 3+
Inductii Sergeant | 4 | 3 | 4 | 4 | 1 | 4 | 2 | 8 | 3+
NAILS-BROKEN If an Inductii Squad is able to declare a charge during the Assault phase, it must do so. If more than one enemy unit may legally be charged, the World Eaters player chooses the target normally.
Force Organisation:
• Troops
Unit Composition:
• 9 Inductii
• 1 Inductii Sergeant
Unit Type:
• Infantry
• The Inductii Sergeant is a Character
Wargear:
• Power Armour
• Bolt pistol
• Chainsword
Special Rules:
• Legiones Astartes (World Eaters)
• Nails-Broken
OPTIONS
• The squad may include up to ten additional Inductii for +13 points per model.
• For every ten models, one Inductii may replace his Bolt pistol with:
• Flamer ............................................ +5 points
• Meltagun ......................................... +10 points
• The entire squad may take:
• Frag grenades ............................... +1 point per model
• Krak grenades .............................. +2 points per model
INDUCTII SERGEANT
The Inductii Sergeant may replace his Chainaxe with:
• Rending Weapon .................................... +5 points
• Power weapon ..................................... +10 points
• Power fist ....................................... +15 points
DEDICATED TRANSPORT
A squad of ten models or fewer may select a Rhino, Drop Pod or Dreadclaw Drop Pod.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xii-3-world-eaters-inductii-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xii-3-world-eaters-inductii-squad-additional-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="13" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xii-3-world-eaters-inductii-squad-additional-rule" hidden="false"><ns0:description>May include up to 10 additional models at +13 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xii-3-world-eaters-inductii-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r41-unit-xii-3-world-eaters-inductii-squad-opt-0-flamer"><ns0:constraints><ns0:constraint id="r41-unit-xii-3-world-eaters-inductii-squad-opt-0-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xii-3-world-eaters-inductii-squad-opt-0-context" hidden="false"><ns0:description>• For every ten models, one Inductii may replace his Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r41-unit-xii-3-world-eaters-induc
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Kheres Assault Cannon" hidden="false" id="gear-kheres">
      <ns0:profiles>
        <ns0:profile name="Kheres Assault Cannon" id="gear-kheres-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>

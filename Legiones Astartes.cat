              </conditions>
            </modifier>
            <modifier type="set" value="0" field="terminator-transport-max">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="terminator-additional" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Destroyer Squad" hidden="false" id="destroyer-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="destroyer-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="destroyer-standard" hidden="false">
          <description>Every model is equipped with Power Armour, two Bolt Pistols, a Chainsword, Frag Grenades and Rad Grenades unless replaced by an option below.</description>
        </rule>
        <rule name="Legiones Astartes" id="destroyer-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Counter-Attack" id="destroyer-counter" hidden="false">
          <description>The squad has Counter-Attack using the normal ProHammer rules.</description>
        </rule>
        <rule name="Dual Pistols" id="destroyer-dual" hidden="false">
          <description>A model with this rule may fire both of its Pistol weapons during the Shooting phase. Both pistols must be fired at the same target. If it fires both pistols, it may not fire another weapon during that Shooting phase.</description>
        </rule>
        <rule name="Destroyer Cadre" id="destroyer-cadre" hidden="false">
          <description>A Legion Destroyer Squad may only be joined by an Independent Character with the Legion Moritat Consul upgrade. No other Independent Character may join the squad.</description>
        </rule>
        <rule name="Rad Grenades" id="destroyer-rad" hidden="false">
          <description>During any player turn in which the unit charges or is itself charged, enemy non-vehicle models engaged with it suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</description>
        </rule>
        <rule name="Dedicated Transport" id="destroyer-transport-rule" hidden="false">
          <description>Without Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Destroyers (included)" hidden="false" id="destroyer-included" defaultAmount="4">
          <constraints>
            <constraint id="destroyer-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="destroyer-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Destroyers (included)" id="destroyer-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>

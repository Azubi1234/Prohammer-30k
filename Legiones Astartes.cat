          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Legion Dreadnought Drop Pod" hidden="false" id="contemptor-dreadpod" type="selectionEntry" targetId="transport-dreadnought-pod">
              <ns0:constraints>
                <ns0:constraint id="contemptor-dreadpod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          <ns0:entryLink id="r37-orbital-contemptor-transport-pod" name="Legion Drop Pod (Orbital Assault)" type="selectionEntry" targetId="transport-drop-pod" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-orbital-contemptor-transport-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs /><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r37-orbital-contemptor-transport-dreadclaw" name="Anvillus Pattern Dreadclaw Drop Pod (Orbital Assault)" type="selectionEntry" targetId="transport-dreadclaw" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-orbital-contemptor-transport-dreadclaw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs /><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-contemptor-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-contemptor-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-contemptor-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-contemptor-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-contemptor-unit-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-contemptor-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-contemptor-unit-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-contemptor-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-contemptor-unit-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-contemptor-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-contemptor-unit-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-contemptor-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-contemptor-unit-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-contemptor-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-contemptor-unit-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-contemptor-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-contemptor-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Rapier Weapons Battery" hidden="false" id="rapier-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-elites" id="rapier-unit-cat" primary="true" name="Elites" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="0" />
      </ns0:costs>
      <ns0:rules>
        <ns0:rule name="Crew" id="rapier-crew-rule" hidden="false">
          <ns0:description>Each Rapier Carrier has two designated Legion Space Marine Crew equipped with Power Armour, Bolt Pistol and Frag Grenades. Crew have the Legiones Astartes special rule.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Rapier Battery" id="rapier-battery-rule" hidden="false">
          <ns0:description>Follows the normal ProHammer Artillery rules. A Rapier requires at least one of its designated crew within 2" to move or fire. One crew model operates the Rapier when it fires and may not fire another weapon that Shooting phase. Rapier Carriers may move normally while accompanied by crew, but may not fire in a turn in which they moved. Rapier Carriers cannot be transported unless another rule explicitly states otherwise.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Shell Shock" id="rapier-shellshock" hidden="false">
          <ns0:description>Any Pinning test caused by a weapon with Shell Shock suffers a -1 Leadership modifier.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:profiles>
        <ns0:profile name="Legion Space Marine Crew" id="rapier-crew-prof" typeId="prof-model" typeName="Model" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>

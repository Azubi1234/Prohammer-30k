            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 6, Twin-linked, Rending, Rapid Tracking</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>

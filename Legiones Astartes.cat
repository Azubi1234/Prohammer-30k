                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r40-da-eskaton-destroyer-destroyer-additional" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>

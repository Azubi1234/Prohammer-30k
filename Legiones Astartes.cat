                  </ns0:modifiers>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="10" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Auxiliary Drive" id="hs-lr-ac-up-auxiliary-drive-rule" hidden="false">
                      <ns0:description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
                <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="hs-lr-ac-up-armoured-ceramite" hidden="false" import="true">
                  <ns0:constraints>

lse" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-opt-11-context" hidden="false"><ns0:description>The Infernus Sergeant may replace his Chainsword with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Inferno Pistol" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-opt-12-inferno-pistol"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-opt-12-inferno-pistol-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-opt-12-context" hidden="false"><ns0:description>The Infernus Sergeant may replace either Hand Flamer with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="HEADHUNTER KILL TEAM" hidden="true" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team"><ns0:costs><ns0:cost name="Points" typeId="pts" value="160" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xx" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xx-1-headhunter-leviathal" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Headhunter" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Headhunter Prime" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-source" hidden="false"><ns0:description>Headhunter | 4 | 5 | 4 | 4 | 1 | 4 | 1 | 8 | 3+
Headhunter Prime | 4 | 5 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Elites
• 0–1
Unit Composition:
• 4 Headhunters
• 1 Headhunter Prime
Unit Type:
• Infantry
• Headhunter Prime is a Character
Wargear:
• Power Armour
• Bolter
• Banestrike Ammunition
• Kraken Bolts
• Close-combat weapon
• Frag grenades
• Melta bombs
Special Rules:
• Legiones Astartes (Alpha Legion)
• Infiltrate
• Move Through Cover
• All as Planned
OPTIONS
• The squad may include up to five additional Headhunters for +32 points per model.
• Up to two Headhunters may replace their Bolter with:
• Heavy flamer ................................ +10 points
• Meltagun ..................................... +10 points
• Plasma Gun ................................... +15 points
• Multi-melta .................................. +25 points
• Heavy Bolter with Suspensor and
Hellfire Rounds .............................. +15 points
• Any model may take:
• Power Dagger ................................. +5 points
• The Headhunter Prime may take:
• Artificer Armour ............................ +10 points
• Venom Spheres ................................ +5 points
• The Headhunter Prime may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
ALL AS PLANNED After both armies have deployed but before the first turn begins, the Headhunter Kill Team may make one Pre-emptive Strike using the rules presented under the Legion Saboteur entry.</ns0:description></ns0:rule><ns0:rule id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>The elite Headhunter cadres of the XX Legion were employed to remove commanders, communications officers and other strategically vital individuals before the enemy understood that a battle had even begun.
EFFECTS
HEADHUNTER ELITE
Headhunter Kill Teams may be selected as Troops choices and must be used to fulfil the Detachment's compulsory Troops selections.
Additional Headhunter Kill Teams may also be selected as Troops choices.
SUDDEN STRIKE
The Alpha Legion player may re-roll the dice used to determine which player takes the first turn.
The entire result must be re-rolled and the second result must be accepted.
FALSE FLAGS
During the first Game Turn, an enemy unit which declares a shooting attack against an Alpha Legion unit must first pass a Leadership test unless that enemy unit has already been fired upon by an Alpha Legion unit during the current player turn.
If the test is passed, the shooting attack is resolved normally. If the test is failed, the unit may not make that shooting attack.
False Flags does not affect Overwatch, Return Fire or Stand &amp; Shoot attacks.
LEAVE NO HEAD UPON THE SERPENT
The Alpha Legion must destroy the enemy Warlord before the end of the battle.
If the enemy Warlord survives, the opposing player gains an additional D3 × 50 Victory Points.
This rule has no effect in missions which do not use Victory Points.
LIMITATIONS
Every Alpha Legion Vehicle must begin the battle in Reserve unless a mission specifically prohibits it from doing so.
The Detachment may not include an Allied Detachment.</ns0:description></ns0:rule><ns0:rule id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-additional"><ns0:constraints><ns0:constraint id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="32" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +32 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Heavy flamer" hidden="false" id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-opt-0-heavy-flamer"><ns0:constraints><ns0:constraint id="r42-role-xx-1-effects-headhunter-elite-headhunter-kill-teams-r41-unit-xx-1-headhunter-kill-team-opt-0-heavy-flamer-max" field="selecti
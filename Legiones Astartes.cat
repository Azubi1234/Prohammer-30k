      </ns0:costs>
      <ns0:entryLinks><ns0:entryLink id="r39-phosphex-hq-da22-corswain" name="Phosphex Bomb (Destroyer Company)" type="selectionEntry" targetId="gear-phosphex-bomb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r39-phosphex-hq-da22-corswain-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-destroyer" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks><ns0:modifiers>

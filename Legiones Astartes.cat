                <ns0:entryLink import="true" name="Teleport Homer" hidden="false" id="r35-pride-terminator-terminator-sgt-homer" type="selectionEntry" targetId="gear-homer">
                  <ns0:constraints>
                    <ns0:constraint id="r35-pride-terminator-terminator-sgt-homer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>

              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-p8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Havoc Launcher" id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-p9" type="selectionEntry" targetId="gear-havoc" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-tactical-unit-hs-spartan-hs-spartan-p9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />

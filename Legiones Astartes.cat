he Pyroclast Warden may replace his Close-combat weapon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power fist" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-4-power-fist"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-4-power-fist-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-4-context" hidden="false"><ns0:description>The Pyroclast Warden may replace his Close-combat weapon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Thunder hammer" hidden="false" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-5-thunder-hammer"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-5-thunder-hammer-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-xviii-0-effects-disciples-of-the-flame-pyroclast-squads-r41-unit-xviii-1-pyroclast-squad-opt-5-context" hidden="false"><ns0:description>The Pyroclast Warden may replace his Close-combat weapon with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="SALAMANDERS INFERNUS DESTROYER SQUAD" hidden="true" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xviii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-xviii-0-the-covenant-of-fire" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Infernus Destroyer" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Infernus Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-source" hidden="false"><ns0:description>Infernus Destroyer | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Infernus Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 3 | 9 | 3+
Force Organisation
DUAL PISTOLS The unit uses the normal Dual Pistols rule from the Legiones Astartes Army List. DESTROYER CADRE An Infernus Destroyer Squad may only be joined by a Legion Moritat or another Character specifically stated to be permitted to join Destroyer units.
• Elites
Unit Composition:
• 4 Infernus Destroyers
• 1 Infernus Sergeant
Unit Type:
• Infantry
• The Infernus Sergeant is a Character
Wargear:
• Hardened Power Armour
• Two Hand Flamers
• Chainsword
• Frag grenades
Special Rules:
• Legiones Astartes (Salamanders)
• Counter-Attack
• Hardened Armour
• Dual Pistols
• Destroyer Cadre
OPTIONS
• The squad may include up to five additional Infernus Destroyers for +25 points per model.
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
• Jump Packs .............................. +15 points per model
• For every five models in the squad, one Infernus Destroyer may replace one Hand Flamer with:
• Heavy Flamer with Suspensor Web .............. +10 points
• Multi-Melta with Suspensor Web ............... +15 points
• Any model may replace either Hand Flamer with:
• Volkite Serpenta ............................... +5 points
• Plasma pistol ................................ +15 points
INFERNUS SERGEANT
The Infernus Sergeant may replace his Chainsword with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Lightning claw ............................... +15 points
• Power fist .................................... +15 points
• Thunder hammer ............................... +20 points
The Infernus Sergeant may replace either Hand Flamer with:
• Inferno Pistol ............................... +10 points
The Infernus Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Salamanders Armoury.
JUMP PACKS
If every model is equipped with a Jump Pack, the unit becomes Jump Infantry and may not select a Dedicated Transport.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>The Covenant of Fire represents the characteristic method of war taught by Vulkan: an inexorable advance through the enemy's strongest resistance, protected by master-crafted armour and supported by overwhelming flame and melta weaponry.
EFFECTS
DISCIPLES OF THE FLAME
Pyroclast Squads and Salamanders Infernus Destroyer Squads may be selected as non-compulsory Troops choices.
They may not fulfil compulsory Troops selections.
WALK THROUGH FIRE
Salamanders Infantry units gain the Move Through Cover special rule.
VENERATION OF WRATH
When a Salamanders model makes an Armour Penetration roll with a Melta weapon, one individual Armour Penetration die which rolls a natural 1 may be re-rolled. The second result must be accepted.
This also applies to Melta Bombs.
OBSIDIAN FORGED
Each time a Salamanders Vehicle or Dreadnought suffers a Glancing or Penetrating Hit from an attack made with a Flame,
Melta, Plasma or Volkite weapon, roll a D6. On a 5+, the hit is ignored. Make this roll before rolling on the Vehicle Damage table.
This protection also applies against Glancing or Penetrating Hits caused by Melta Bombs.
LIMITATIONS
Units in the Detachment may not deploy using Deep Strike. Units which must deploy using Deep Strike may not be selected.
The combined number of Fast Attack and Heavy Support choices may not exceed the number of Troops choices in the Detachment.
The Detachment may not include a Fortification.</ns0:description></ns0:rule><ns0:rule id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-additional"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +25 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r42-role-xviii-0-salamanders-infernus-destroyer-squads-r41-unit-xviii-2-salamanders-infernus-destroyer-squad-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r42-role-xviii-0-salamanders-infernus-destroyer-squa
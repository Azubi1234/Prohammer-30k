        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-0">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-1">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-2">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-3">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-4">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-5">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-da-wing-hs-spartan-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-r40-da-ammo-hs-spartan" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Hunter-Killer Missile" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-hunter-killer-missile-rule" hidden="false">
              <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
              <ns0:description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Frag Assault Launchers" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Frag Assault Launchers" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
              <ns0:description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="45" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Flare Shield" id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
              <ns0:description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>
    </ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-pride" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:entryLinks><ns0:entryLink id="r40-da-forward-r35-pride-veteran-veteran-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-r35-pride-veteran-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-veteran-da-wing-veteran-unit-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Terminator Squad" hidden="true" id="r35-pride-terminator-terminator-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="r35-pride-terminator-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r35-pride-terminator-terminator-standard" hidden="false">
          <ns0:description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r35-pride-terminator-terminator-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Implacable Advance" id="r35-pride-terminator-terminator-implacable" hidden="false">
          <ns0:description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r35-pride-terminator-terminator-transport-rule" hidden="false">
          <ns0:description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Rite of War Selection" id="r35-pride-terminator-note" hidden="false"><ns0:description>This Troops entry is available while Pride of the Legion is selected.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Terminators (included)" hidden="false" id="r35-pride-terminator-terminator-included" defaultAmount="4">

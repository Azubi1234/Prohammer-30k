            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
      <ns0:selectionEntry id="r37-rapid-r35-sky-troops-fa-sky-hunter" name="Rapid Encirclement (Sky Hunter Phalanx)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-rapid-r35-sky-troops-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Rapid Encirclement" id="r37-rapid-r35-sky-troops-fa-sky-hunter-rule" hidden="false"><ns0:description>Once per battle, during its Movement phase, if every model in this unit can move completely off a table edge, remove the unit and place it into Ongoing Reserves. It returns during the controlling player’s following turn using the normal Outflank rules.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r35-sky-troops-fa-sky-std" hidden="false">
          <ns0:description>Power Armour; Legion Scimitar Jetbike with Heavy Bolter; Bolt Pistol; Chainsword; Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes &amp; Deep Strike" id="r35-sky-troops-fa-sky-la" hidden="false">
          <ns0:description>Legiones Astartes and Deep Strike. The unit also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Rite of War Selection" id="r35-sky-troops-note" hidden="false"><ns0:description>This Troops entry is available while Sky Hunter Phalanx is selected.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Squad-wide Equipment" id="r35-sky-troops-fa-sky-squad" hidden="false">
          <ns0:entryLinks>
            <ns0:entryLink name="Krak Grenades (+2 pts/model)" hidden="false" id="r35-sky-troops-fa-sky-krak" type="selectionEntry" targetId="gear-krak" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-fa-sky-krak-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="6" />
              </ns0:costs>
              <ns0:modifiers>
                <ns0:modifier type="increment" value="2" field="pts">
                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-sky-troops-fa-sky-add" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>
            <ns0:entryLink name="Melta Bombs (+5 pts/model)" hidden="false" id="r35-sky-troops-fa-sky-melta" type="selectionEntry" targetId="gear-melta-bombs" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-sky-troops-fa-sky-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
              <ns0:modifiers>
                <ns0:modifier type="increment" value="5" field="pts">
                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r35-sky-troops-fa-sky-add" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>

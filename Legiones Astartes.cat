      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Squad-wide Wargear" id="r40-da-eskaton-destroyer-destroyer-squad-wargear" hidden="false">
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Melta Bombs (+5 pts/model)" hidden="false" id="r40-da-eskaton-destroyer-destroyer-squad-melta" type="selectionEntry" targetId="gear-melta-bombs">
              <ns0:constraints>
                <ns0:constraint id="r40-da-eskaton-destroyer-destroyer-squad-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>

• Independent Character
• Master of the First Grand Battalion
• Siege Commander</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="KROEGER, THE BLOODY-HANDED" hidden="false" id="r41-unit-iv-8-kroeger-the-bloody-handed"><ns0:costs><ns0:cost name="Points" typeId="pts" value="140" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-8-kroeger-the-bloody-handed-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-iv-8-kroeger-the-bloody-handed-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Kroeger" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-8-kroeger-the-bloody-handed-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-8-kroeger-the-bloody-handed-source" hidden="false"><ns0:description>Kroeger | 6 | 5 | 4 | 4 | 2 | 5 | 4 | 10 | 2+/5+
Unit Composition:
• 1 Kroeger
THE BLOODY-HANDED Kroeger has the Furious Charge special rule. Any Iron Warriors unit Kroeger has joined also gains Furious Charge while he remains part of the unit. NO SURRENDER Whenever Kroeger and his unit win a close combat and one or more defeated enemy units Retreat, Kroeger's unit must Pursue if it is legally permitted to do so. It may not choose to Consolidate instead. If no enemy unit Retreats, or if Kroeger's unit is not permitted to Pursue, it may Consolidate normally. COMMAND RETINUE Kroeger may select one Legion Command Squad as his retinue. The Command Squad does not occupy a separate Force Organisation slot and Kroeger and the squad count as a single HQ selection.
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Refractor Field
• Power Weapon
• Bolt pistol
• Frag grenades
Special Rules:
• Legiones Astartes (Iron Warriors)
• Independent Character
• The Bloody-Handed
• No Surrender
OPTIONS
• Kroeger may take:
• Krak grenades ................................. +2 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-iv-8-kroeger-the-bloody-handed-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-iv-8-kroeger-the-bloody-handed-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-iv-8-kroeger-the-bloody-handed-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-8-kroeger-the-bloody-handed-opt-0-context" hidden="false"><ns0:description>• Kroeger may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="IV — PERTURABO, THE LORD OF IRON" hidden="false" id="r41-unit-iv-9-iv-perturabo-the-lord-of-iron"><ns0:costs><ns0:cost name="Points" typeId="pts" value="500" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-9-iv-perturabo-the-lord-of-iron-cat" name="Lords of War" hidden="false" targetId="cat-low" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-iv-9-iv-perturabo-the-lord-of-iron-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Perturabo" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-9-iv-perturabo-the-lord-of-iron-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">7</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">6</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">6</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">6</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">1+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-9-iv-perturabo-the-lord-of-iron-source" hidden="false"><ns0:description>Primarch of the Iron Warriors, the Lord of Iron, Hammer of Olympia
Perturabo was a master of calculation, engineering and the remorseless mathematics of war. Where others saw impregnable walls, impossible approaches or wars of attrition without end, the Primarch of the IV Legion saw only equations awaiting their solution. His campaigns were characterised by overwhelming firepower, meticulously prepared assaults and the systematic reduction of every obstacle placed before him.
Encased within the formidable Logos and surrounded by an architecture of targeting systems, surveyors and command auguries, Perturabo could direct a battlefield with machine-like precision even as he personally brought ruin to the enemy. Against fortifications, engines of war and seemingly unassailable positions, few commanders in the Imperium could equal the Lord of Iron.
Perturabo | 7 | 7 | 6 | 6 | 6 | 5 | 4 | 10 | 1+
Force Organisation:
• Lord of War
Unit Composition:
• 1 Perturabo
Unit Type:
• Infantry (Character)
Wargear:
• The Logos
• Forgebreaker
• Logos Array
• Siege Bombardments
Special Rules:
• Primarch
• Legiones Astartes (Iron Warriors)
• Lord of Iron
• Calculated Destruction
• Battlefield Calculation
THE LOGOS One of the most sophisticated suits of war-plate fashioned during the Great Crusade, the Logos combined formidable protection with a vast network of targeting systems, battlefield auguries and communications equipment. The Logos counts as Primarch Armour and incorporates a Nuncio Vox. In addition, once during each friendly Shooting phase, one friendly Iron Warriors Heavy Support unit with at least one model within 12" of Perturabo may re-roll one failed To Hit roll made with a shooting attack. FORGEBREAKER Fashioned by Ferrus Manus and later borne by the Lord of Iron, Forgebreaker was an immense weapon whose blows could sunder armoured vehicles and fortified structures alike. Forgebreaker is a Master-crafted Thunder Hammer with the Armourbane special rule. LOGOS ARRAY The Logos incorporated an array of powerful wrist-mounted weapons linked directly to Perturabo’s armour and targeting systems. Weapon Range S AP Type Logos Array 30" 6 3 Assault 6, Twin-linked, Shred, Pinning SIEGE BOMBARDMENTS Few commanders possessed Perturabo’s ability to coordinate artillery, orbital assets and battlefield telemetry. Before an assault began, firing solutions would already have been calculated for positions deemed essential to the enemy’s defence. After deployment zones have been determined, but before either army deploys, nominate two terrain features as Perturabo’s plotted bombardment targets. For each target, select one of the following bombardments: Bombardment Range S AP Type Lance Strike Unlimited 10 1 Ordnance 1, Blast Melta Torpedo Unlimited 8 3 Ordnance 1, Blast, Armourbane Barrage Bomb Unlimited 6 4 Ordnance 1, Blast The two bombardments may use the same or different profiles. Perturabo’s Siege Bombardments begin the battle in Reserve and are treated as a single Reserve entry. The controlling player may choose not to make the Reserve roll. Once the Siege Bombardments become available, one of the two plotted bombardments may be resolved during each subsequent friendly Shooting phase. Place the Blast marker anywhere within the terrain feature nominated for the chosen bombardment. Resolve scatter normally. If an arrow is rolled, double the distance scattered. If a Hit is rolled, the marker still scatters the distance rolled in the direction indicated by the small arrow on the Hit symbol. A Siege Bombardment counts as an Ordnance Barrage attack and causes Pinning. LORD OF IRON Perturabo understood the weaknesses of armour, fortifications and engines of war with a depth few others could equal, directing every attack towards the precise point at which destruction was inevitable. Perturabo has the Tank Hunters and Siege Specialists special rules. Any unit Perturabo has joined gains Tank Hunters while he remains part of that unit. CALCULATED DESTRUCTION The Lord of Iron approached the destruction of an enemy war machine with the same methodical certainty with which he approached the reduction of a fortress. Before deployment, nominate one enemy Vehicle, Fortification or Lord of War. Perturabo may re-roll failed Armour Penetration rolls made against the nominated model for the duration of the battle. BATTLEFIELD CALCULATION To Perturabo, deployment was merely the first stage of a greater equation, and forces were shifted without hesitation whenever his calculations revealed a superior position. After both armies have deployed but before the first turn begins, nominate one friendly Iron Warriors unit. That unit may immediately be repositioned up to 6". Every model in the unit must remain entirely within its normal deployment zone, and this move may not be used to embark upon or disembark from a Transport. PRIMARCH RETINUE Perturabo may select any one of the following as his Primarch Retinue: • Legion Honour Guard Squad • Legion Terminator Command Squad • Dominator Cohort A retinue selected in this manner does not occupy an additional Force Organisation selection and otherwise follows the normal Primarch Retinue rules.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="GOLDEN KESHIG SQUADRON" hidden="false" id="r41-unit-v-0-golden-keshig-squadron"><ns0:costs><ns0:cost name="Points" typeId="pts" value="180" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-v-0-golden-keshig-squadron-cat" name="Fast Attack" hidden="false" targetId="cat-fast" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Golden Keshig" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Golden Keshig Champion" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-v-0-golden-keshig-squadron-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-v-0-golden-keshig-squadron-source" hidden="false"><ns0:description>Golden Keshig | 5 | 4 | 4 | 5 | 1 | 4 | 2 | 9 | 2+
Golden Keshig Champion | 5 | 4 | 4 | 5 | 1 | 4 | 3 | 10 | 2+
Force Organisation:
• Fast Attack
Unit Composition:

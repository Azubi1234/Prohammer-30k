    <selectionEntry type="unit" import="true" name="Legion Rapier Weapons Battery" hidden="false" id="rapier-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="rapier-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <costs>
        <cost name="Points" typeId="pts" value="0" />
      </costs>
      <rules>
        <rule name="Crew" id="rapier-crew-rule" hidden="false">
          <description>Each Rapier Carrier has two designated Legion Space Marine Crew equipped with Power Armour, Bolt Pistol and Frag Grenades. Crew have the Legiones Astartes special rule.</description>
        </rule>
        <rule name="Rapier Battery" id="rapier-battery-rule" hidden="false">
          <description>Follows the normal ProHammer Artillery rules. A Rapier requires at least one of its designated crew within 2" to move or fire. One crew model operates the Rapier when it fires and may not fire another weapon that Shooting phase. Rapier Carriers may move normally while accompanied by crew, but may not fire in a turn in which they moved. Rapier Carriers cannot be transported unless another rule explicitly states otherwise.</description>
        </rule>
        <rule name="Shell Shock" id="rapier-shellshock" hidden="false">
          <description>Any Pinning test caused by a weapon with Shell Shock suffers a -1 Leadership modifier.</description>
        </rule>
      </rules>
      <profiles>
        <profile name="Legion Space Marine Crew" id="rapier-crew-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">4</characteristic>
            <characteristic name="BS" typeId="model-bs">4</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">1</characteristic>
            <characteristic name="I" typeId="model-i">4</characteristic>
            <characteristic name="A" typeId="model-a">1</characteristic>
            <characteristic name="Ld" typeId="model-ld">8</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Rapier Carrier" id="rapier-carrier-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">-</characteristic>
            <characteristic name="BS" typeId="model-bs">-</characteristic>
            <characteristic name="S" typeId="model-s">-</characteristic>
            <characteristic name="T" typeId="model-t">7</characteristic>
            <characteristic name="W" typeId="model-w">2</characteristic>
            <characteristic name="I" typeId="model-i">-</characteristic>
            <characteristic name="A" typeId="model-a">-</characteristic>
            <characteristic name="Ld" typeId="model-ld">-</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Rapier Carrier" hidden="false" id="rapier-carrier" defaultAmount="1">
          <constraints>
            <constraint id="rapier-carrier-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="rapier-carrier-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="50" />
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Battery Weapon (all Rapiers use the same weapon)" id="rapier-armament" hidden="false">
          <constraints>
            <constraint id="rapier-armament-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <constraint id="rapier-armament-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Quad Heavy Bolter" hidden="false" id="rapier-arm-qhb" defaultAmount="1">

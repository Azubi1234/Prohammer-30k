                  <constraints>
                    <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-min" includeChildSelections="false" automatic="true" />
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-max" includeChildSelections="false" automatic="true" />
                  </constraints>
                </entryLink>
              </entryLinks>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Bolters + Bolt Pistols + Chainswords (+2 pts/model)" hidden="false" id="load-add-chainswords">
              <entryLinks>
                <entryLink import="true" name="Bolter" hidden="false" id="load-add-b" type="selectionEntry" targetId="gear-bolter" defaultAmount="1" />
                <entryLink import="true" name="Bolt Pistol" hidden="false" id="load-add-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1" />
                <entryLink import="true" name="Chainsword" hidden="false" id="load-add-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1" />
              </entryLinks>
              <costs>
                <cost name="Points" typeId="pts" value="2" />
              </costs>
              <modifiers>
                <modifier type="increment" value="2" field="pts">
                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="tac-marine" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Exchange Bolters for Chainswords (Free)" hidden="false" id="load-exchange">

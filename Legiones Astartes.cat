            <ns0:selectionEntry type="upgrade" name="Legion Moritat Consul" id="hq-consul-moritat" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-moritat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="45" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Moritat Consul" id="hq-consul-moritat-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Moritat Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Scout" id="r29-mor-scout" hidden="false"><ns0:description>Uses the normal ProHammer Scout special rule.</ns0:description></ns0:rule><ns0:rule name="Counter-Attack" id="r29-mor-counter" hidden="false"><ns0:description>Uses the normal ProHammer Counter-Attack special rule.</ns0:description></ns0:rule><ns0:rule name="Dual Pistols" id="r29-mor-dual" hidden="false"><ns0:description>The Moritat may fire both pistols during the Shooting phase. If he does so, he may not fire any other weapon that phase.</ns0:description></ns0:rule><ns0:rule name="Lone Killer" id="r29-mor-lone" hidden="false"><ns0:description>The Moritat may not fulfil a compulsory HQ choice and may never be the Warlord. He may only join a Legion Destroyer Squad and may not benefit from beneficial psychic powers used by another model or another model’s Leadership/re-rolls.</ns0:description></ns0:rule><ns0:rule name="Chain Fire" id="r29-mor-chain" hidden="false"><ns0:description>When firing his pistols, each successful To Hit roll immediately generates another shot with that pistol against the same target, continuing until it misses. Maximum 12 successful hits in total. Gets Hot on a natural 1 ends the attack. After Chain Fire, the Moritat may not charge that turn and may not shoot in his following Shooting phase.</ns0:description></ns0:rule></ns0:rules>
            <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Pistol Pair" id="r29-mor-pair-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-mor-pair-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-mor-pair-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Two Bolt Pistols" id="r29-mor-bolt" hidden="false" import="true" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-mor-bolt-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-mor-bolt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Two Bolt Pistols" id="r29-mor-bolt-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Pistol</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Two Bolt Pistols" id="r29-mor-bolt-rule" hidden="false"><ns0:description>The Moritat carries two Bolt Pistols.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Two Hand Flamers" id="r29-mor-hand" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-mor-hand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Two Hand Flamers" id="r29-mor-hand-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Pistol</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Two Hand Flamers" id="r29-mor-hand-rule" hidden="false"><ns0:description>Both Bolt Pistols are replaced by Hand Flamers.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Two Plasma Pistols" id="r29-mor-plasma" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-mor-plasma-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:profiles><ns0:profile name="Two Plasma Pistols" id="r29-mor-plasma-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Pistol, Gets Hot</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Two Plasma Pistols" id="r29-mor-plasma-rule" hidden="false"><ns0:description>Both Bolt Pistols are replaced by Plasma Pistols.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Two Calibanite Plasma Pistols" id="r29-mor-calibanite" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-mor-calibanite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:profiles><ns0:profile name="Calibanite Plasma Pistol (x2)" id="r29-mor-calibanite-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Pistol</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Ancient Plasma Weaponry" id="r29-mor-calibanite-rule" hidden="false"><ns0:description>Both Bolt Pistols are replaced by Calibanite Plasma Pistols. Calibanite Plasma weapons do not have Gets Hot.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Delegatus Consul" id="hq-consul-delegatus" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-delegatus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Delegatus Consul" id="hq-consul-delegatus-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Delegatus Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Master of the Legion" id="r29-delegatus-master" hidden="false"><ns0:description>The Delegatus has Master of the Legion and may enable one Rite of War, subject to the normal limits on that rule.</ns0:description></ns0:rule><ns0:rule name="Delegated Authority" id="r29-delegatus-authority" hidden="false"><ns0:description>A Delegatus may possess Master of the Legion in an army of fewer than 1,000 points. Unless the army contains its Primarch, a Delegatus with Master of the Legion must be the Warlord. A Detachment containing a Delegatus may not also contain a Legion Praetor.</ns0:description></ns0:rule></ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Esoterist Consul" id="hq-consul-esoterist" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-esoterist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Esoterist Consul" id="hq-consul-esoterist-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Esoterist Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Psyker (Mastery Level 1)" id="r29-eso-psyker" hidden="false"><ns0:description>The Esoterist is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</ns0:description></ns0:rule><ns0:rule name="Legion Support Officer" id="r29-eso-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Forbidden Lore" id="r29-eso-lore" hidden="false"><ns0:description>Select powers from Sanctic Daemonology or Malefic Daemonology regardless of Legion or Allegiance. Possession is not selectable because ProHammer restricts it to Mastery Level 2 or greater.</ns0:description></ns0:rule></ns0:rules>
            <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Psychic Discipline(s)" id="r29-eso-discipline-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-eso-discipline-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-eso-discipline-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Sanctic Daemonology" id="r29-eso-discipline-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-discipline-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Sanctic Daemonology" id="r29-eso-discipline-0-rule" hidden="false"><ns0:description>This Psyker may select powers from the Sanctic Daemonology discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Malefic Daemonology" id="r29-eso-discipline-1" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-discipline-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Malefic Daemonology" id="r29-eso-discipline-1-rule" hidden="false"><ns0:description>This Psyker may select powers from the Malefic Daemonology discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Psychic Powers" id="r29-eso-power-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-eso-power-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-eso-power-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Banishment" id="r29-eso-power-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Banishment" id="r29-eso-power-0-rule" hidden="false"><ns0:description>Malediction — enemy Daemon unit within 24”. All models in target unit suffer -1 to their Invulnerable Saves.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Gate of Infinity" id="r29-eso-power-1" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Gate of Infinity" id="r29-eso-power-1-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Remove Psyker and joined unit and immediately redeploy using Deep Strike.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Hammerhand" id="r29-eso-power-2" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Hammerhand" id="r29-eso-power-2-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit gain +2 Strength.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Sanctuary" id="r29-eso-power-3" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Sanctuary" id="r29-eso-power-3-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit receive +1 to Invulnerable Saves, or gain a 6+ Invulnerable Save; Daemons treat all terrain within 12” as Dangerous Terrain.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Purge Soul" id="r29-eso-power-4" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Purge Soul" id="r29-eso-power-4-rule" hidden="false"><ns0:description>Focused Witchfire — range 24”. Psyker and target roll D6 + Leadership; if Psyker is equal or higher, target suffers one automatic Wound with no Armour or Cover Save.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Cleansing Flame" id="r29-eso-power-5" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Cleansing Flame" id="r29-eso-power-5-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">9”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2D6, Ignores Cover, Soul Blaze</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Cleansing Flame" id="r29-eso-power-5-rule" hidden="false"><ns0:description>Nova. Range 9”, S5 AP4 Assault 2D6, Ignores Cover, Soul Blaze.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Vortex of Doom" id="r29-eso-power-6" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Vortex of Doom" id="r29-eso-power-6-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Blast, Vortex</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Vortex of Doom" id="r29-eso-power-6-rule" hidden="false"><ns0:description>Witchfire. Range 12”, S10 AP1 Assault 1, Blast, Vortex.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Summoning" id="r29-eso-power-7" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Summoning" id="r29-eso-power-7-rule" hidden="false"><ns0:description>Conjuration — range 12”. Summons the Daemon unit choices listed in ProHammer.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Cursed Earth" id="r29-eso-power-8" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Cursed Earth" id="r29-eso-power-8-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Daemons within 12” gain +1 to Invulnerable Saves; Deep Striking Daemons do not scatter when their centre model is placed within 12”.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Dark Flame" id="r29-eso-power-9" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Dark Flame" id="r29-eso-power-9-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Soul Blaze, Torrent</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Dark Flame" id="r29-eso-power-9-rule" hidden="false"><ns0:description>Witchfire. Template, S4 AP5 Assault 1, Soul Blaze, Torrent.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Sacrifice" id="r29-eso-power-10" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-10-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Sacrifice" id="r29-eso-power-10-rule" hidden="false"><ns0:description>Conjuration — range 6”. Summons a Herald with up to 30 points of wargear; one friendly model within 6” suffers one Wound with no save.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Incursion" id="r29-eso-power-11" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-11-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Incursion" id="r29-eso-power-11-rule" hidden="false"><ns0:description>Conjuration — range 12”. Summons the Daemon cavalry/beast choices listed in ProHammer.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Infernal Gaze" id="r29-eso-power-12" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-eso-power-12-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Infernal Gaze" id="r29-eso-power-12-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Armourbane, Fleshbane</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Infernal Gaze" id="r29-eso-power-12-rule" hidden="false"><ns0:description>Beam. Range 18”, S3 AP4 Assault 1, Armourbane, Fleshbane.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-eso-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:entryLinks><ns0:entryLink import="true" name="Force Weapon" id="r29-eso-force" type="selectionEntry" targetId="gear-hq-force" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-eso-force-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-eso-force-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Forge Lord Consul" id="hq-consul-forge" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-forge-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="70" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Forge Lord Consul" id="hq-consul-forge-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Forge Lord Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Battlesmith" id="r29-forge-battlesmith" hidden="false"><ns0:description>During the Shooting phase, instead of firing a weapon, a Forge Lord in base contact with or embarked upon a friendly damaged Vehicle may attempt a repair. On 5+, remove one Engine Damaged, Weapon Destroyed or Immobilised result. His Servo-Arm grants +1, so he normally succeeds on 4+.</ns0:description></ns0:rule><ns0:rule name="Lord of the Armoury" id="r29-forge-armoury" hidden="false"><ns0:description>May select equipment restricted to Techmarines from the Space Marine Armoury in addition to equipment normally available to a Centurion.</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" name="Cortex Controller" id="hq-consul-forge-cortex" hidden="false" import="true">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-forge-cortex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="15" />
                  </ns0:costs>
                </ns0:selectionEntry>
              <ns0:selectionEntry type="upgrade" import="true" name="Iron Father" hidden="false" id="r25-consul-x-iron-father"><ns0:constraints><ns0:constraint id="r25-consul-x-iron-father-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:rules><ns0:rule name="Iron Father" id="r25-consul-x-iron-father-rule" hidden="false"><ns0:description>Any Iron Hands Forge Lord Consul may be further upgraded to an Iron Father for +25 points.
Wargear:
• Iron Halo
• Bionics
Special Rules:
• Rites of Battle
The Iron Father retains all rules, wargear and options of a normalForge Lord Consul.
RITES OF BATTLE
The Iron Father and any Iron Hands unit he has joined may re-roll failed Morale tests. The second result must be accepted.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries>
            <ns0:entryLinks><ns0:entryLink import="true" name="Artificer Armour" id="r29-forge-artificer" type="selectionEntry" targetId="gear-hq-artificer" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-forge-artificer-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-forge-artificer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Servo-Arm" id="r29-forge-servo" type="selectionEntry" targetId="r29-gear-servo-arm" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-forge-servo-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-forge-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Herald Consul" id="hq-consul-herald" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-herald-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="40" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Herald Consul" id="hq-consul-herald-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Herald Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Legion Support Officer" id="r29-herald-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Banner of Allegiance" id="r29-herald-banner" hidden="false"><ns0:description>Use the selected Banner of the Aquila or Banner of the Eye rule shown by the Herald upgrade.</ns0:description></ns0:rule><ns0:rule name="Fallen Honour" id="r29-herald-fallen" hidden="false"><ns0:description>If the Herald is slain, the opposing player gains +1 Victory Point in missions using Victory Points.</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntryGroups>
                <ns0:selectionEntryGroup name="Banner of Allegiance" id="hq-consul-herald-banner" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-herald-banner-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <ns0:constraint id="hq-consul-herald-banner-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </ns0:constraints>
                  <ns0:selectionEntries>
                    <ns0:selectionEntry type="upgrade" name="Banner of the Aquila — Loyalist" id="hq-consul-herald-aquila" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-herald-aquila-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="0" />
                      </ns0:costs>
                      <ns0:rules>
                        <ns0:rule name="Banner of the Aquila" id="hq-consul-herald-aquila-rule" hidden="false">
                          <ns0:description>The Herald and friendly Loyalist models with Legiones Astartes within 12" receive +1 Weapon Skill, to a maximum of WS5.</ns0:description>
                        </ns0:rule>
                      </ns0:rules>
                    </ns0:selectionEntry>
                    <ns0:selectionEntry type="upgrade" name="Banner of the Eye — Traitor" id="hq-consul-herald-eye" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-herald-eye-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="0" />
                      </ns0:costs>
                      <ns0:rules>
                        <ns0:rule name="Banner of the Eye" id="hq-consul-herald-eye-rule" hidden="false">
                          <ns0:description>The Herald and friendly Traitor models with Legiones Astartes within 12" add +1" to Advance and Charge moves. On a turn in which such a unit successfully charges, it may re-roll To Hit rolls of 1 in close combat.</ns0:description>
                        </ns0:rule>
                      </ns0:rules>
                    </ns0:selectionEntry>
                  </ns0:selectionEntries>
                </ns0:selectionEntryGroup>
              </ns0:selectionEntryGroups>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Master of Signals Consul" id="hq-consul-signals" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-signals-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="45" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Master of Signals Consul" id="hq-consul-signals-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Master of Signals Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Targeting Matrix" id="hq-consul-signals-matrix-rule" hidden="false">
                  <ns0:description>A Cognis Signum with Targeting Matrix also provides the normal benefits of a Signum to the unit the Master of Signals has joined.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Legion Support Officer" id="r29-signals-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Cognis Signum" id="r29-signals-cognis-rule" hidden="false"><ns0:description>The Master of Signals’ Nuncio Vox no-scatter range is 12” instead of 6”. The optional Targeting Matrix also grants the normal Signum benefit to his joined unit.</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" name="Targeting Matrix" id="hq-consul-signals-matrix" hidden="false" import="true">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-signals-matrix-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="10" />
                  </ns0:costs>
                </ns0:selectionEntry>
              </ns0:selectionEntries>
              <ns0:selectionEntryGroups>
                <ns0:selectionEntryGroup name="Orbital Bombardment (choose at most one)" id="hq-consul-signals-orbital" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-signals-orbital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </ns0:constraints>
                  <ns0:selectionEntries>
                    <ns0:selectionEntry type="upgrade" name="Lance Strike" id="hq-consul-signals-orb-lance" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-signals-orb-lance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="40" />
                      </ns0:costs>
                      <ns0:profiles>
                        <ns0:profile name="Lance Strike" id="hq-consul-signals-orb-lance-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <ns0:characteristics>
                            <ns0:characteristic name="Range" typeId="ranged-range">Special</ns0:characteristic>
                            <ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic>
                            <ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic>
                            <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast</ns0:characteristic>
                          </ns0:characteristics>
                        </ns0:profile>
                      </ns0:profiles>
                    </ns0:selectionEntry>
                    <ns0:selectionEntry type="upgrade" name="Melta Torpedo" id="hq-consul-signals-orb-melta" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-signals-orb-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="45" />
                      </ns0:costs>
                      <ns0:profiles>
                        <ns0:profile name="Melta Torpedo" id="hq-consul-signals-orb-melta-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <ns0:characteristics>
                            <ns0:characteristic name="Range" typeId="ranged-range">Special</ns0:characteristic>
                            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
                            <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast, Armourbane</ns0:characteristic>
                          </ns0:characteristics>
                        </ns0:profile>
                      </ns0:profiles>
                    </ns0:selectionEntry>
                    <ns0:selectionEntry type="upgrade" name="Barrage Bomb" id="hq-consul-signals-orb-barrage" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-signals-orb-barrage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="30" />
                      </ns0:costs>
                      <ns0:profiles>
                        <ns0:profile name="Barrage Bomb" id="hq-consul-signals-orb-barrage-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <ns0:characteristics>
                            <ns0:characteristic name="Range" typeId="ranged-range">Special</ns0:characteristic>
                            <ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic>
                            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                            <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast</ns0:characteristic>
                          </ns0:characteristics>
                        </ns0:profile>
                      </ns0:profiles>
                    </ns0:selectionEntry>
                  </ns0:selectionEntries>
                  <ns0:rules>
                    <ns0:rule name="Orbital Bombardment" id="hq-consul-signals-orb-rule" hidden="false">
                      <ns0:description>After deployment zones are determined but before either army deploys, nominate one terrain feature. The bombardment begins in Reserve and its controlling player may choose not to roll for it. Once available, it strikes in every subsequent friendly Shooting phase. Place the Blast marker anywhere within the nominated terrain. Scatter normally; an arrow doubles the distance, while a Hit still scatters the rolled distance along the small arrow. The attack counts as Ordnance Barrage and causes Pinning.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntryGroup>
                <ns0:selectionEntryGroup name="Dedicated Transport" id="hq-consul-signals-dt" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-signals-dt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </ns0:constraints>
                  <ns0:selectionEntries>
                    <ns0:selectionEntry type="unit" name="Damocles Command Rhino" id="hq-consul-signals-damocles" hidden="false" import="true">
                      <ns0:constraints>
                        <ns0:constraint id="hq-consul-signals-damocles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </ns0:constraints>
                      <ns0:costs>
                        <ns0:cost name="Points" typeId="pts" value="100" />
                      </ns0:costs>
                      <ns0:profiles>
                        <ns0:profile name="Damocles Command Rhino" id="hq-consul-signals-damocles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                          <ns0:characteristics>
                            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                            <ns0:characteristic name="Front" typeId="vehicle-front">11</ns0:characteristic>
                            <ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic>
                            <ns0:characteristic name="Rear" typeId="vehicle-rear">11</ns0:characteristic>
                          </ns0:characteristics>
                        </ns0:profile>
                        <ns0:profile name="Focused Bombardment" id="hq-consul-signals-damocles-bomb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <ns0:characteristics>
                            <ns0:characteristic name="Range" typeId="ranged-range">Unlimited</ns0:characteristic>
                            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
                            <ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Barrage, Lance, Twin-linked</ns0:characteristic>
                          </ns0:characteristics>
                        </ns0:profile>
                      </ns0:profiles>
                      <ns0:rules>
                        <ns0:rule name="Standard Wargear &amp; Transport" id="hq-consul-signals-damocles-std" hidden="false">
                          <ns0:description>Vehicle (Tank). Twin-linked Bolter, Searchlight and Smoke Launchers. Transport Capacity 6. No Fire Points. One Access Point on each side and one at the rear.</ns0:description>
                        </ns0:rule>
                        <ns0:rule name="Geo-Locator Beacon" id="hq-consul-signals-damocles-geo" hidden="false">
                          <ns0:description>Friendly units arriving by Deep Strike do not scatter if their first model is placed within 24" of the Damocles and otherwise has a legal deployment position.</ns0:description>
                        </ns0:rule>
                        <ns0:rule name="Command Vox Relay" id="hq-consul-signals-damocles-relay" hidden="false">
                          <ns0:description>While the Damocles is on the battlefield, its controlling player may apply either +1 or -1 to any of their Reserve rolls.</ns0:description>
                        </ns0:rule>
                        <ns0:rule name="Command Vehicle" id="hq-consul-signals-damocles-command" hidden="false">
                          <ns0:description>0–1 Damocles Command Rhino may be selected as a non-compulsory HQ choice in an army of at least 1,000 points. Alternatively, a Master of Signals may select one as a Dedicated Transport.</ns0:description>
                        </ns0:rule>
                        <ns0:rule name="Focused Bombardment" id="hq-consul-signals-damocles-bombrule" hidden="false">
                          <ns0:description>Once per battle, provided the Damocles did not move that turn, it may fire the Focused Bombardment profile.</ns0:description>
                        </ns0:rule>
                      </ns0:rules>
                      <ns0:selectionEntryGroups>
                        <ns0:selectionEntryGroup name="Legion Vehicle Armoury" id="hq-consul-signals-damocles-upgrades" hidden="false">
                          <ns0:selectionEntries>
                            <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hq-consul-signals-dam-vu-0" hidden="false" import="true">
                              <ns0:constraints>
                                <ns0:constraint id="hq-consul-signals-dam-vu-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </ns0:constraints>
                              <ns0:costs>

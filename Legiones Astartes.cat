targetId="cat-fast" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Reaver" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Reaver Chieftain" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvi-1-reaver-attack-squad-source" hidden="false"><ns0:description>Reaver | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+
Reaver Chieftain | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Fast Attack
Unit Composition:
• 4 Reavers
• 1 Reaver Chieftain
Unit Type:
• Infantry
• The Reaver Chieftain is a Character
Wargear:
• Power Armour
• Bolt pistol
• Chainaxe
• Frag grenades
Special Rules:
• Legiones Astartes (Sons of Horus)
• Furious Charge
OPTIONS
• The squad may include up to five additional Reavers for +22 points per model.
• Up to two Reavers may replace their Bolt pistol with:
• Flamer .......................................... +5 points
• Meltagun ....................................... +10 points
• Plasma Gun ..................................... +15 points
• Plasma Pistol .................................. +15 points
• For every five models in the squad, one Reaver may:
• Replace his Chainaxe with a Power fist ......... +15 points
• Replace his Bolt pistol and Chainaxe with
a pair of Lightning Claws ....................... +15 points
• Every model other than the Reaver Chieftain may purchase:
• Terminator Honours ............................. +15 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Melta bombs .............................. +5 points per model
JUMP ASSAULT
The entire squad may purchase Jump Packs for +15 points per model.
If equipped with Jump Packs:
• the unit becomes Jump Infantry;
• it follows the normal ProHammer Jump Infantry rules;
• it may not select a Dedicated Transport.
REAVER CHIEFTAIN
The Reaver Chieftain may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Sons of Horus Armoury.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xvi-1-reaver-attack-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="22" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xvi-1-reaver-attack-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +22 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer"><ns0:constraints><ns0:constraint id="r41-unit-xvi-1-reaver-attack-squad-opt-0-flamer-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvi-1-reaver-attack-squad-opt-0-context" hidden="false"><ns0:description>• Up to two Reavers may replace their Bolt pistol with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Meltagun" hidden="false" id="r41-unit-xvi-1-reaver-attack-squad-opt-1-meltagun"><ns0:constrai
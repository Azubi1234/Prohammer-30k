        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rad Grenades" hidden="false" id="gear-rad-grenades">
      <rules>
        <rule name="Rad Grenades" id="gear-rad-grenades-rule-0" hidden="false">
          <description>Rad Grenades are neither Assault nor Defensive Grenades. During any player turn in which a unit equipped with Rad Grenades charges, or is itself charged, enemy non-vehicle models engaged with that unit suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Missile Launcher with Suspensor Web and Rad Missiles" hidden="false" id="gear-rad-missile">
      <profiles>
        <profile name="Rad Missile" id="gear-rad-missile-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Fleshbane, Rad-phage</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Rad-phage" id="gear-rad-missile-rule-0" hidden="false">
          <description>If a model suffers one or more unsaved Wounds from a weapon with Rad-phage and survives, reduce its Toughness by 1 for the remainder of the battle, to a minimum of 1. Multiple applications are cumulative.</description>
        </rule>
        <rule name="Rad Missiles Only" id="gear-rad-missile-rule-1" hidden="false">
          <description>A Missile Launcher equipped with Rad Missiles may only fire Rad Missiles and may not use Frag or Krak Missiles.</description>
        </rule>
      </rules>
    </selectionEntry>

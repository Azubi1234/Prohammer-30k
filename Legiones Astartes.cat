        </ns0:selectionEntry>
      <ns0:selectionEntry id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter" name="Rapid Encirclement (Sky Hunter Phalanx)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Rapid Encirclement" id="r40-da-arrow-sky-r37-rapid-fa-sky-hunter-rule" hidden="false"><ns0:description>Once per battle, during its Movement phase, if every model in this unit can move completely off a table edge, remove the unit and place it into Ongoing Reserves. It returns during the controlling player’s following turn using the normal Outflank rules.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>
      <ns0:rules>

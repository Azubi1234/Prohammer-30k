"r41-unit-xii-0-rampager-squad-opt-3-squadwide" hidden="false"><ns0:description>The source prices this option at +1 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-xii-0-rampager-squad-opt-4-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xii-0-rampager-squad-opt-4-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xii-0-rampager-squad-opt-4-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-xii-0-rampager-squad-opt-4-squadwide" hidden="false"><ns0:description>The source prices this option at +2 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Jump Packs (base unit; +15 pts/model)" hidden="false" id="r41-unit-xii-0-rampager-squad-opt-5-jump-packs"><ns0:constraints><ns0:constraint id="r41-unit-xii-0-rampager-squad-opt-5-jump-packs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="75" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xii-0-rampager-squad-opt-5-context" hidden="false"><ns0:description>• The en
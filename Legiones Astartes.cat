              </ns0:modifiers>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Plasma Burner" hidden="false" id="da22-alt-pb-1" type="selectionEntry" targetId="da22-plasma-burner">
              <ns0:constraints>
                <ns0:constraint type="max" value="4" field="selections" scope="parent" shared="true" id="da22-alt-pb-1-2" includeChildSelections="false" />
              </ns0:constraints>

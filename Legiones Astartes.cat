                          </profiles>
                        </selectionEntry>
                        <selectionEntry type="model" name="Land Raider Achilles" id="hq-praetor-ret-tc-land-land-raider-achilles" hidden="false" import="true">
                          <constraints>
                            <constraint id="hq-praetor-ret-tc-land-land-raider-achilles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </constraints>
                          <costs>
                            <cost name="Points" typeId="pts" value="275" />
                          </costs>
                          <profiles>
                            <profile name="Land Raider Achilles" id="hq-praetor-ret-tc-land-land-raider-achilles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <characteristics>
                                <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                                <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                                <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                                <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                      </selectionEntries>
                    </selectionEntryGroup>
                  </selectionEntryGroups>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <entryLinks>
                <entryLink import="true" name="Combi-Bolter" id="hq-praetor-ret-tc-cb" type="selectionEntry" targetId="gear-combi-bolter" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="hq-praetor-ret-tc-cb-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-tc-cb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Power Weapon" id="hq-praetor-ret-tc-pw" type="selectionEntry" targetId="gear-power-weapon" hidden="false" defaultAmount="1">
                  <constraints>
                    <constraint id="hq-praetor-ret-tc-pw-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-tc-pw-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                </entryLink>
                <entryLink import="true" name="Grenade Harness" id="hq-praetor-ret-tc-gh" type="selectionEntry" targetId="gear-hq-grenade-harness" hidden="false">
                  <constraints>
                    <constraint id="hq-praetor-ret-tc-gh-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </entryLink>
              </entryLinks>
            </selectionEntry>
          </selectionEntries>
          <rules>
            <rule name="Retinue Restriction" id="hq-praetor-ret-rule" hidden="false">
              <description>A Praetor may select one Honour Guard Squad. If equipped with any form of Terminator Armour, he may instead select a Legion Terminator Command Squad where permitted.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hq-praetor" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-hq-praetor-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-hq-praetor-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-hq-praetor-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hq-praetor-0">
              <constraints>
                <constraint id="da-wing-hq-praetor-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-hq-praetor-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hq-praetor-1">
              <constraints>
                <constraint id="da-wing-hq-praetor-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-hq-praetor-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hq-praetor-2">
              <constraints>
                <constraint id="da-wing-hq-praetor-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-hq-praetor-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hq-praetor-3">
              <constraints>
                <constraint id="da-wing-hq-praetor-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-hq-praetor-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hq-praetor-4">
              <constraints>
                <constraint id="da-wing-hq-praetor-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-hq-praetor-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hq-praetor-5">
              <constraints>
                <constraint id="da-wing-hq-praetor-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-hq-praetor-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" name="Legion Centurion" id="hq-centurion" hidden="false" import="true">
      <constraints>
        <constraint id="hq-centurion-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="50" />
      </costs>
      <categoryLinks>
        <categoryLink targetId="cat-hq" id="hq-centurion-foc-cat" primary="true" name="HQ" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile name="Legion Centurion" id="hq-centurion-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">5</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">2</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">9</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hq-centurion-std" hidden="false">
          <description>Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</description>
        </rule>
        <rule name="Legiones Astartes" id="hq-centurion-la" hidden="false">
          <description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.</description>
        </rule>
        <rule name="Independent Character" id="hq-centurion-ic" hidden="false">
          <description>Follows the Independent Character rules in ProHammer Classic.</description>
        </rule>
        <rule name="Frag Grenades" id="hq-centurion-frag" hidden="false">
          <description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Legion Consuls" id="hq-centurion-consulrule" hidden="false">
          <description>A Legion Centurion may be upgraded to no more than one Consul type. A Consul retains the Centurion profile, wargear, special rules and Armoury access unless stated otherwise. Wargear granted by a Consul is included in its upgrade cost and does not count toward the Armoury allowance. Consul restrictions override normal Centurion options.</description>
        </rule>
        <rule name="Space Marine Armoury" id="hq-centurion-armoury-rule" hidden="false">
          <description>The Centurion may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply. Consul-granted wargear is included in the Consul cost and does not count against this allowance.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" id="hq-centurion-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
          <constraints>
            <constraint id="hq-centurion-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="hq-centurion-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Chainsword" id="hq-centurion-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">
          <constraints>
            <constraint id="hq-centurion-cs-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="hq-centurion-cs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
        </entryLink>
      </entryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Legion Consul Upgrade" id="hq-centurion-consuls" hidden="false">
          <constraints>
            <constraint id="hq-centurion-consuls-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" name="Legion Chaplain Consul" id="hq-consul-chaplain" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-chaplain-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="35" />
              </costs>
              <rules>
                <rule name="Legion Chaplain Consul" id="hq-consul-chaplain-rule" hidden="false">
                  <description>Replace the Centurion's Chainsword with a Crozius Arcanum and equip him with a Rosarius. The Crozius counts as a Power Weapon. Honour of the Legion: the Chaplain and any unit he joins are Fearless. Liturgies of Battle: in a player turn in which the Chaplain and a joined unit successfully charge, the Chaplain and all models in that unit may re-roll failed To Hit rolls in close combat for that Assault phase.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Librarian Consul" id="hq-consul-librarian" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-librarian-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Legion Librarian Consul" id="hq-consul-librarian-rule" hidden="false">
                  <description>Replace the Chainsword with a Force Weapon. Psyker (Mastery Level 1) and Legion Support Officer. Select psychic powers from the Psychic Power list except any form of Demonology, using ProHammer psychic rules. A Psychic Hood may be purchased from the Armoury normally.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Epistolary — Mastery Level 2" id="hq-consul-librarian-epistolary" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-consul-librarian-epistolary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Moritat Consul" id="hq-consul-moritat" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-moritat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="45" />
              </costs>
              <rules>
                <rule name="Legion Moritat Consul" id="hq-consul-moritat-rule" hidden="false">
                  <description>Gains a second Bolt Pistol. Scout, Counter-Attack, Dual Pistols, Lone Killer and Chain Fire. Dual Pistols: may fire both pistols in the Shooting phase and no other weapon. Lone Killer: may not fulfil compulsory HQ, may never be Warlord, may join only a Legion Destroyer Squad, may not benefit from beneficial psychic powers used by another model, and may not use another friendly model's Leadership or Leadership re-rolls. Chain Fire: when firing pistols, each successful To Hit roll immediately generates another shot from that pistol against the same target until it misses; maximum 12 successful hits total. A Gets Hot! result of 1 ends Chain Fire immediately. After Chain Fire the Moritat may not charge that player turn and may not shoot in his following Shooting phase. Restrictions: no Bolter, Combi-weapon, Boarding Shield, Power Fist, Thunder Hammer, Lightning Claws, Bike, Jetbike or Terminator Armour. A Jump Pack is permitted.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Delegatus Consul" id="hq-consul-delegatus" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-delegatus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <rules>
                <rule name="Legion Delegatus Consul" id="hq-consul-delegatus-rule" hidden="false">
                  <description>One weapon carried by the Delegatus may be Master-crafted at no additional cost. Gains Master of the Legion. Delegated Authority: may possess Master of the Legion in an army of fewer than 1,000 points; unless the army contains its Primarch, the Delegatus must be Warlord. A Detachment containing a Delegatus may not also contain a Legion Praetor.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Esoterist Consul" id="hq-consul-esoterist" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-esoterist-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="25" />
              </costs>
              <rules>
                <rule name="Legion Esoterist Consul" id="hq-consul-esoterist-rule" hidden="false">
                  <description>Replace the Chainsword with a Force Weapon. Psyker (Mastery Level 1) and Legion Support Officer. Forbidden Lore: psychic powers must be selected from Sanctic Daemonology or Malefic Daemonology; Malefic may be selected regardless of Legion or Allegiance.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Forge Lord Consul" id="hq-consul-forge" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-forge-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="70" />
              </costs>
              <rules>
                <rule name="Legion Forge Lord Consul" id="hq-consul-forge-rule" hidden="false">
                  <description>Equipped with Artificer Armour and a Servo-Arm; gains Battlesmith. Battlesmith: in the Shooting phase instead of firing, if in base contact with or embarked upon a friendly damaged vehicle, roll a D6; on 5+ remove one Engine Damaged, Weapon Destroyed or Immobilised result. The Servo-Arm grants the normal +1 bonus, so a Forge Lord with it normally succeeds on 4+. Lord of the Armoury: may select Techmarine-restricted equipment in addition to normal Centurion equipment. A Forge Lord equipped with a Servo-Arm may not take a Jump Pack.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Cortex Controller" id="hq-consul-forge-cortex" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-consul-forge-cortex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Herald Consul" id="hq-consul-herald" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-herald-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="40" />
              </costs>
              <rules>
                <rule name="Legion Herald Consul" id="hq-consul-herald-rule" hidden="false">
                  <description>Carries a Legion Heraldic Banner and has Legion Support Officer, Banner of Allegiance and Fallen Honour. Fallen Honour: if slain, the opposing player gains +1 Victory Point in missions using Victory Points. Restrictions: no Jump Pack, Bike, Jetbike or Terminator Armour; no two-handed weapon; may never claim +1 Attack for fighting with two close-combat weapons.</description>
                </rule>
              </rules>
              <selectionEntryGroups>
                <selectionEntryGroup name="Banner of Allegiance" id="hq-consul-herald-banner" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-herald-banner-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                    <constraint id="hq-consul-herald-banner-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Banner of the Aquila — Loyalist" id="hq-consul-herald-aquila" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-aquila-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Aquila" id="hq-consul-herald-aquila-rule" hidden="false">
                          <description>The Herald and friendly Loyalist models with Legiones Astartes within 12" receive +1 Weapon Skill, to a maximum of WS5.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Banner of the Eye — Traitor" id="hq-consul-herald-eye" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-herald-eye-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="0" />
                      </costs>
                      <rules>
                        <rule name="Banner of the Eye" id="hq-consul-herald-eye-rule" hidden="false">
                          <description>The Herald and friendly Traitor models with Legiones Astartes within 12" add +1" to Advance and Charge moves. On a turn in which such a unit successfully charges, it may re-roll To Hit rolls of 1 in close combat.</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Legion Master of Signals Consul" id="hq-consul-signals" hidden="false" import="true">
              <constraints>
                <constraint id="hq-consul-signals-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="45" />
              </costs>
              <rules>
                <rule name="Legion Master of Signals Consul" id="hq-consul-signals-rule" hidden="false">
                  <description>Equipped with Nuncio Vox and Cognis Signum; Legion Support Officer. Cognis Signum increases the no-scatter deployment range of the Nuncio Vox from 6" to 12". Restrictions: may not take Terminator Armour, a Bike or Jetbike.</description>
                </rule>
                <rule name="Targeting Matrix" id="hq-consul-signals-matrix-rule" hidden="false">
                  <description>A Cognis Signum with Targeting Matrix also provides the normal benefits of a Signum to the unit the Master of Signals has joined.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Targeting Matrix" id="hq-consul-signals-matrix" hidden="false" import="true">
                  <constraints>
                    <constraint id="hq-consul-signals-matrix-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="10" />
                  </costs>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
                <selectionEntryGroup name="Orbital Bombardment (choose at most one)" id="hq-consul-signals-orbital" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-signals-orbital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="upgrade" name="Lance Strike" id="hq-consul-signals-orb-lance" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-orb-lance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="40" />
                      </costs>
                      <profiles>
                        <profile name="Lance Strike" id="hq-consul-signals-orb-lance-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Special</characteristic>
                            <characteristic name="S" typeId="ranged-s">10</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">1</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Melta Torpedo" id="hq-consul-signals-orb-melta" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-orb-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="45" />
                      </costs>
                      <profiles>
                        <profile name="Melta Torpedo" id="hq-consul-signals-orb-melta-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Special</characteristic>
                            <characteristic name="S" typeId="ranged-s">8</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast, Armourbane</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry type="upgrade" name="Barrage Bomb" id="hq-consul-signals-orb-barrage" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-orb-barrage-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="30" />
                      </costs>
                      <profiles>
                        <profile name="Barrage Bomb" id="hq-consul-signals-orb-barrage-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Special</characteristic>
                            <characteristic name="S" typeId="ranged-s">6</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                  <rules>
                    <rule name="Orbital Bombardment" id="hq-consul-signals-orb-rule" hidden="false">
                      <description>After deployment zones are determined but before either army deploys, nominate one terrain feature. The bombardment begins in Reserve and its controlling player may choose not to roll for it. Once available, it strikes in every subsequent friendly Shooting phase. Place the Blast marker anywhere within the nominated terrain. Scatter normally; an arrow doubles the distance, while a Hit still scatters the rolled distance along the small arrow. The attack counts as Ordnance Barrage and causes Pinning.</description>
                    </rule>
                  </rules>
                </selectionEntryGroup>
                <selectionEntryGroup name="Dedicated Transport" id="hq-consul-signals-dt" hidden="false">
                  <constraints>
                    <constraint id="hq-consul-signals-dt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                  </constraints>
                  <selectionEntries>
                    <selectionEntry type="unit" name="Damocles Command Rhino" id="hq-consul-signals-damocles" hidden="false" import="true">
                      <constraints>
                        <constraint id="hq-consul-signals-damocles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                      </constraints>
                      <costs>
                        <cost name="Points" typeId="pts" value="100" />
                      </costs>
                      <profiles>
                        <profile name="Damocles Command Rhino" id="hq-consul-signals-damocles-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                          <characteristics>
                            <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                            <characteristic name="Front" typeId="vehicle-front">11</characteristic>
                            <characteristic name="Side" typeId="vehicle-side">11</characteristic>
                            <characteristic name="Rear" typeId="vehicle-rear">11</characteristic>
                          </characteristics>
                        </profile>
                        <profile name="Focused Bombardment" id="hq-consul-signals-damocles-bomb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                          <characteristics>
                            <characteristic name="Range" typeId="ranged-range">Unlimited</characteristic>
                            <characteristic name="S" typeId="ranged-s">8</characteristic>
                            <characteristic name="AP" typeId="ranged-ap">3</characteristic>
                            <characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Barrage, Lance, Twin-linked</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <rules>
                        <rule name="Standard Wargear &amp; Transport" id="hq-consul-signals-damocles-std" hidden="false">
                          <description>Vehicle (Tank). Twin-linked Bolter, Searchlight and Smoke Launchers. Transport Capacity 6. No Fire Points. One Access Point on each side and one at the rear.</description>
                        </rule>
                        <rule name="Geo-Locator Beacon" id="hq-consul-signals-damocles-geo" hidden="false">
                          <description>Friendly units arriving by Deep Strike do not scatter if their first model is placed within 24" of the Damocles and otherwise has a legal deployment position.</description>
                        </rule>
                        <rule name="Command Vox Relay" id="hq-consul-signals-damocles-relay" hidden="false">
                          <description>While the Damocles is on the battlefield, its controlling player may apply either +1 or -1 to any of their Reserve rolls.</description>
                        </rule>
                        <rule name="Command Vehicle" id="hq-consul-signals-damocles-command" hidden="false">
                          <description>0–1 Damocles Command Rhino may be selected as a non-compulsory HQ choice in an army of at least 1,000 points. Alternatively, a Master of Signals may select one as a Dedicated Transport.</description>
                        </rule>
                        <rule name="Focused Bombardment" id="hq-consul-signals-damocles-bombrule" hidden="false">
                          <description>Once per battle, provided the Damocles did not move that turn, it may fire the Focused Bombardment profile.</description>
                        </rule>
                      </rules>
                      <selectionEntryGroups>
                        <selectionEntryGroup name="Legion Vehicle Armoury" id="hq-consul-signals-damocles-upgrades" hidden="false">
                          <selectionEntries>
                            <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hq-consul-signals-dam-vu-0" hidden="false" import="true">
                              <constraints>
                                <constraint id="hq-consul-signals-dam-vu-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </constraints>
                              <costs>

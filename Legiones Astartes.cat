      </ns0:selectionEntries>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="fa-attack-bike-std" hidden="false">
          <ns0:description>Power Armour; Legion Attack Bike with Twin-linked Bolters; Heavy Bolter; Bolt Pistol; Chainsword; Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="fa-attack-bike-la" hidden="false">
          <ns0:description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Heavy Bolter Replacements" id="fa-attack-bike-weapons" hidden="false">
          <ns0:constraints>

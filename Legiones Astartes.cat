                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Iron Halo" id="terminator-sgt-halo-rule" hidden="false">
                      <ns0:description>4+ Invulnerable Save; normally no more than one Iron Halo may be selected in an army.</ns0:description>
                    </ns0:rule>

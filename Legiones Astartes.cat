      <ns0:selectionEntry id="r37-orbital-teleport-r35-pride-terminator-terminator-unit" name="Teleport Assault (Orbital Assault)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-orbital-teleport-r35-pride-terminator-terminator-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Teleport Assault" id="r37-orbital-teleport-r35-pride-terminator-terminator-unit-rule" hidden="false"><ns0:description>A unit composed entirely of models wearing Terminator Armour or Cataphractii Terminator Armour may deploy using Deep Strike even if the mission would not normally permit Deep Strike.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-orbital" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="175" />
      </ns0:costs>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Terminator Armour Pattern (entire squad)" id="r35-pride-terminator-terminator-armour-pattern" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-terminator-terminator-armour-pattern-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="r35-pride-terminator-terminator-armour-pattern-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-normal" defaultAmount="1">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-terminator-terminator-armour-normal-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Terminator Armour" id="r35-pride-terminator-terminator-armour-normal-rule" hidden="false">
                  <ns0:description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-recon" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="r35-pride-terminator-terminator-armour-tartaros">

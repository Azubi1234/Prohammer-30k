                <ns0:profile name="Quad Launcher — Shatter" id="hs-lr-ach-shatter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Sunder</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
                <ns0:profile name="Twin-linked Multi-Melta" id="hs-lr-ach-mm" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta, Twin-linked</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Standard Wargear" id="hs-lr-achilles-wg" hidden="false">
                  <ns0:description>Quad Launcher with Frag and Shatter Shells; two Twin-linked Multi-Meltas; Extra Armour; Armoured Ceramite; Searchlight and Smoke Launchers. Power of the Machine Spirit; Transport Capacity 6.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Ferromantic Invulnerability" id="hs-lr-achilles-ferromantic-invulnerability" hidden="false">
                  <ns0:description>Weapons with Melta do not roll an additional Armour Penetration die against the Achilles. Weapons with Lance do not reduce its Armour Value.</ns0:description>
                </ns0:rule>
              </ns0:rules>
              <ns0:selectionEntries>

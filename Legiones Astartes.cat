                  </costs>
                </entryLink>
              </entryLinks>
            </selectionEntryGroup>
            <selectionEntryGroup name="Sergeant Wargear" id="assault-sgt-unit-wargear" hidden="false">
              <entryLinks>
                <entryLink import="true" name="Combat Shield" hidden="false" id="assault-sgt-shield" type="selectionEntry" targetId="gear-combat-shield">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-shield-max" includeChildSelections="false" />
                  </constraints>
                  <modifiers>
                    <modifier type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="assault-squad-shields" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="0" field="assault-sgt-shield-max">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="assault-squad-shields" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
                <entryLink import="true" name="Melta Bombs" hidden="false" id="assault-sgt-melta-bombs" type="selectionEntry" targetId="gear-melta-bombs">
                  <constraints>
                    <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="assault-sgt-melta-bombs-max" includeChildSelections="false" />
                  </constraints>
                  <modifiers>
                    <modifier type="set" value="true" field="hidden">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="assault-squad-melta-bombs" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="0" field="assault-sgt-melta-bombs-max">
                      <conditions>
                        <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="assault-squad-melta-bombs" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                  </modifiers>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
              </entryLinks>
            </selectionEntryGroup>
            <selectionEntryGroup name="Additional Sergeant Armoury (max 50 pts)" id="assault-sgt-armoury" hidden="false">
              <constraints>

            <ns0:constraint id="da22-cen-orders-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Augurs of Weakness" hidden="false" id="da22-order-augurs">
              <ns0:constraints>
                <ns0:constraint id="da22-order-augurs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Augurs of Weakness" id="da22-order-augurs-rule" hidden="false">
                  <ns0:description>+1 Strength when making Armour Penetration rolls against vehicles with AV11+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Icons of Resolve" hidden="false" id="da22-order-icons">
              <ns0:constraints>
                <ns0:constraint id="da22-order-icons-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Icons of Resolve" id="da22-order-icons-rule" hidden="false">
                  <ns0:description>If charged, each model gains +1 Attack during that Assault phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Guardians of Sanctity" hidden="false" id="da22-order-guardians">
              <ns0:constraints>
                <ns0:constraint id="da22-order-guardians-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Guardians of Sanctity" id="da22-order-guardians-rule" hidden="false">
                  <ns0:description>When making Deny the Witch, roll 2D6 and use the highest before modifiers.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Slayers of Kings" hidden="false" id="da22-order-slayers">
              <ns0:constraints>
                <ns0:constraint id="da22-order-slayers-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Slayers of Kings" id="da22-order-slayers-rule" hidden="false">
                  <ns0:description>Against enemy units whose majority WS is 5+, re-roll To Hit rolls of 1 in close combat.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Hunters of Beasts" hidden="false" id="da22-order-hunters">
              <ns0:constraints>
                <ns0:constraint id="da22-order-hunters-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Hunters of Beasts" id="da22-order-hunters-rule" hidden="false">
                  <ns0:description>Against T5 re-roll To Wound rolls of 1; against T6+ re-roll all failed To Wound rolls.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Reapers of Hosts" hidden="false" id="da22-order-reapers">
              <ns0:constraints>
                <ns0:constraint id="da22-order-reapers-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Reapers of Hosts" id="da22-order-reapers-rule" hidden="false">
                  <ns0:description>A model beginning its Initiative step in base contact with more than one enemy gains +1 Attack for that Assault phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Breakers of Witches" hidden="false" id="da22-order-breakers">

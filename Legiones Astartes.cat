            <ns0:entryLinks><ns0:entryLink import="true" name="Nuncio Vox" id="r29-signals-nuncio" type="selectionEntry" targetId="gear-nuncio" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-signals-nuncio-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-signals-nuncio-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Cognis Signum" id="r29-signals-cognis" type="selectionEntry" targetId="r29-gear-cognis-signum" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-signals-cognis-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-signals-cognis-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Primus Medicae Consul" id="hq-consul-medicae" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-medicae-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="35" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Primus Medicae Consul" id="hq-consul-medicae-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Primus Medicae Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Legion Support Officer" id="r29-med-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Sacred Trust" id="r29-med-sacred" hidden="false"><ns0:description>In a mission using Victory Points, whenever a friendly Legiones Astartes Infantry or Jump Infantry unit with a model within 6” is completely destroyed by the enemy, roll a D6. On 5+, gain 50 Victory Points. A unit for which Victory Points are recovered through the Primus Medicae’s Reductor may not also generate Victory Points through Sacred Trust.</ns0:description></ns0:rule></ns0:rules>
              <ns0:entryLinks>
                <ns0:entryLink import="true" name="Narthecium" id="hq-consul-medicae-n" type="selectionEntry" targetId="gear-hq-narthecium" hidden="false" defaultAmount="1">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-medicae-n-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <ns0:constraint id="hq-consul-medicae-n-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                </ns0:entryLink>
                <ns0:entryLink import="true" name="Reductor" id="hq-consul-medicae-r" type="selectionEntry" targetId="gear-hq-reductor" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-medicae-r-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="5" />
                  </ns0:costs>
                </ns0:entryLink>
              </ns0:entryLinks>
            <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Primus Nullificator Consul" id="hq-consul-null" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-null-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Primus Nullificator Consul" id="hq-consul-null-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Primus Nullificator Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Psyker (Mastery Level 1)" id="r29-null-psyker" hidden="false"><ns0:description>The Nullificator is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</ns0:description></ns0:rule><ns0:rule name="Legion Support Officer" id="r29-null-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Adamantium Will" id="r29-null-will" hidden="false"><ns0:description>Uses the normal ProHammer Adamantium Will special rule.</ns0:description></ns0:rule><ns0:rule name="Hexagrammic Wards" id="r29-null-wards" hidden="false"><ns0:description>An enemy Psyker using a psychic power which directly targets the Nullificator or a unit he has joined suffers -1 Leadership for that Psychic Test.</ns0:description></ns0:rule><ns0:rule name="Credo Annihilato" id="r29-null-credo" hidden="false"><ns0:description>The Nullificator and any unit he has joined have Preferred Enemy (Daemons).</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Psychic Discipline(s)" id="r29-null-discipline-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-null-discipline-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-null-discipline-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Sanctic Daemonology" id="r29-null-discipline-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-discipline-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Sanctic Daemonology" id="r29-null-discipline-0-rule" hidden="false"><ns0:description>This Psyker may select powers from the Sanctic Daemonology discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Psychic Powers" id="r29-null-power-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-null-power-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-null-power-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Banishment" id="r29-null-power-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Banishment" id="r29-null-power-0-rule" hidden="false"><ns0:description>Malediction — enemy Daemon unit within 24”. All models in target unit suffer -1 to their Invulnerable Saves.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Gate of Infinity" id="r29-null-power-1" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Gate of Infinity" id="r29-null-power-1-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Remove Psyker and joined unit and immediately redeploy using Deep Strike.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Hammerhand" id="r29-null-power-2" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Hammerhand" id="r29-null-power-2-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit gain +2 Strength.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Sanctuary" id="r29-null-power-3" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Sanctuary" id="r29-null-power-3-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit receive +1 to Invulnerable Saves, or gain a 6+ Invulnerable Save; Daemons treat all terrain within 12” as Dangerous Terrain.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Purge Soul" id="r29-null-power-4" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Purge Soul" id="r29-null-power-4-rule" hidden="false"><ns0:description>Focused Witchfire — range 24”. Psyker and target roll D6 + Leadership; if Psyker is equal or higher, target suffers one automatic Wound with no Armour or Cover Save.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Cleansing Flame" id="r29-null-power-5" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Cleansing Flame" id="r29-null-power-5-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">9”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2D6, Ignores Cover, Soul Blaze</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Cleansing Flame" id="r29-null-power-5-rule" hidden="false"><ns0:description>Nova. Range 9”, S5 AP4 Assault 2D6, Ignores Cover, Soul Blaze.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Vortex of Doom" id="r29-null-power-6" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-null-power-6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Vortex of Doom" id="r29-null-power-6-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Blast, Vortex</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Vortex of Doom" id="r29-null-power-6-rule" hidden="false"><ns0:description>Witchfire. Range 12”, S10 AP1 Assault 1, Blast, Vortex.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-null-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:entryLinks>
                <ns0:entryLink import="true" name="Mandatory Cataphractii Terminator Armour" id="hq-consul-null-cat" type="selectionEntry" targetId="gear-hq-cataphractii" hidden="false" defaultAmount="1">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-null-cat-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <ns0:constraint id="hq-consul-null-cat-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="25" />
                  </ns0:costs>
                </ns0:entryLink>
              <ns0:entryLink import="true" name="Aether-shock Maul" id="r29-null-maul" type="selectionEntry" targetId="r29-gear-aether-shock-maul" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-null-maul-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-null-maul-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Vigilator Consul" id="hq-consul-vigilator" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-vigilator-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="35" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Vigilator Consul" id="hq-consul-vigilator-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Vigilator Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Scout" id="r29-vig-scout" hidden="false"><ns0:description>Uses the normal ProHammer Scout special rule.</ns0:description></ns0:rule><ns0:rule name="Stealth" id="r29-vig-stealth" hidden="false"><ns0:description>Uses the normal ProHammer Stealth special rule. Cameleoline is displayed as granted wargear.</ns0:description></ns0:rule><ns0:rule name="Sabotage" id="r29-vig-sabotage" hidden="false"><ns0:description>After both armies deploy but before the first turn, nominate one enemy unit, Vehicle or Fortification on the battlefield; an Independent Character may only be selected if part of another unit. The target suffers D6 Strength 5 AP6 hits; against Vehicles or Fortifications use the lowest Armour Value. Casualties do not cause Morale or Pinning tests.</ns0:description></ns0:rule><ns0:rule name="Special Issue Ammunition" id="r29-vig-ammo-rule" hidden="false"><ns0:description>The Vigilator may use Dragonfire, Hellfire, Kraken or Vengeance ammunition with his Bolter, overriding the normal Seeker-only restriction. All four profiles are displayed under his Special Issue Ammunition wargear.</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" name="Scout Armour (replaces Power Armour)" id="hq-consul-vigilator-scoutarmour" hidden="false" import="true">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-vigilator-scoutarmour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="0" />
                  </ns0:costs>
                  <ns0:rules>
                    <ns0:rule name="Scout Armour" id="hq-consul-vigilator-scout-rule" hidden="false">
                      <ns0:description>Replacing Power Armour with Scout Armour at no cost additionally grants Infiltrate and Move Through Cover.</ns0:description>
                    </ns0:rule>
                  </ns0:rules>
                </ns0:selectionEntry>
              </ns0:selectionEntries>
            <ns0:entryLinks><ns0:entryLink import="true" name="Bolter" id="r29-vig-bolter" type="selectionEntry" targetId="gear-bolter" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-vig-bolter-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-vig-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Cameleoline" id="r29-vig-camo" type="selectionEntry" targetId="gear-cameleoline" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-vig-camo-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-vig-camo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Special Issue Ammunition" id="r29-vig-ammo" type="selectionEntry" targetId="r29-gear-special-issue-ammunition" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-vig-ammo-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-vig-ammo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Praevian Consul" id="hq-consul-praevian" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-praevian-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="35" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Praevian Consul" id="hq-consul-praevian-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Praevian Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Legion Support Officer" id="r29-prae-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Master of Cybernetica" id="r29-prae-cybernetica" hidden="false"><ns0:description>The Praevian must be accompanied by either a Castellax Class Battle-Automata Maniple or a Vorax Class Battle-Automata Maniple purchased here from the Mechanicum source profiles. The Maniple occupies no additional Force Organisation slot; the Praevian and Maniple count as one HQ choice. The Praevian must begin attached and may not voluntarily leave while any Battle-Automata remain alive. The Praevian may join them despite their Monstrous Creature unit type, and his Cortex Controller controls the Maniple normally. The accompanying Maniple may not purchase Paragon of Metal.</ns0:description></ns0:rule><ns0:rule name="Legion Inductees" id="r29-prae-inductees" hidden="false"><ns0:description>Before deployment choose the Praevian’s Legiones Astartes rule, Furious Charge, Tank Hunters or Scout for the accompanying Battle-Automata Maniple. If Scout is chosen the Praevian also gains Scout while attached.</ns0:description></ns0:rule></ns0:rules>
            <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Praevian Battle-Automata Maniple" id="r30-prae-automata-group" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r30-prae-automata-group-min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" /><ns0:constraint id="r30-prae-automata-group-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="unit" import="true" name="Castellax Class Battle-Automata Maniple" hidden="false" id="r30-prae-castellax"><ns0:constraints><ns0:constraint id="r30-prae-castellax-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="105" /></ns0:costs><ns0:profiles><ns0:profile name="Castellax" id="r30-prae-castellax-profile" typeId="prof-model" typeName="Model" hidden="false"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">3</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">6</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">7</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">4</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">7</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Mauler Bolt Cannon" id="r30-prae-castellax-mauler" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Bolter" id="r30-prae-castellax-bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r30-prae-castellax-type" hidden="false"><ns0:description>Monstrous Creature.</ns0:description></ns0:rule><ns0:rule name="Standard Wargear" id="r30-prae-castellax-wargear" hidden="false"><ns0:description>Mauler Bolt Cannon; two Bolters; Shock Chargers; Atomantic Shielding.</ns0:description></ns0:rule><ns0:rule name="Shock Chargers" id="r30-prae-castellax-shock" hidden="false"><ns0:description>Melee weapon: Strength User +1, AP -, Melee, Concussive.</ns0:description></ns0:rule><ns0:rule name="Atomantic Shielding" id="r30-prae-castellax-atomantic" hidden="false"><ns0:description>A Castellax has a 5+ Invulnerable Save against shooting attacks and a 6+ Invulnerable Save in close combat.</ns0:description></ns0:rule><ns0:rule name="Cybernetica Cortex" id="r30-prae-castellax-cortex" hidden="false"><ns0:description>Fearless; Poisoned and Fleshbane attacks only wound on a 6+; subject to Programmed Behaviour unless controlled by a Cortex Controller.</ns0:description></ns0:rule><ns0:rule name="Reactor Blast" id="r30-prae-castellax-reactor" hidden="false"><ns0:description>When the model loses its final Wound, roll a D6. On a 6, centre a Large Blast over it; every model touched suffers a hit at Strength equal to the destroyed model’s unmodified Toughness, to a maximum of 8, AP4. Then remove the destroyed model.</ns0:description></ns0:rule><ns0:rule name="Rage" id="r30-prae-castellax-rage" hidden="false"><ns0:description>Uses the normal ProHammer Rage special rule.</ns0:description></ns0:rule><ns0:rule name="Support Unit" id="r30-prae-castellax-support" hidden="false"><ns0:description>Normally a Troops choice that cannot fulfil compulsory Troops; when purchased for a Praevian it instead forms part of the Praevian’s single HQ selection.</ns0:description></ns0:rule><ns0:rule name="Praevian Restriction" id="r30-prae-castellax-no-paragon" hidden="false"><ns0:description>This accompanying Maniple may not purchase Paragon of Metal.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Additional Castellax Battle-Automata" hidden="false" id="r30-prae-castellax-extra"><ns0:constraints><ns0:constraint id="r30-prae-castellax-extra-max" field="selections" scope="parent" value="4" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="105" /></ns0:costs><ns0:rules><ns0:rule name="Additional Castellax" id="r30-prae-castellax-extra-rule" hidden="false"><ns0:description>The Maniple may include up to four additional Castellax, for a maximum of five models.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Maniple-wide Upgrades (select once per model)" id="r30-prae-castellax-maniple-upgrades" hidden="false" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Searchlights" hidden="false" id="r30-prae-castellax-searchlight"><ns0:constraints><ns0:constraint id="r30-prae-castellax-searchlight-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="1" /></ns0:costs><ns0:rules><ns0:rule name="Searchlights" id="r30-prae-castellax-searchlight-rule" hidden="false"><ns0:description>The entire Maniple may take Searchlights for +1 point per model; select this once for each Castellax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Frag Grenades" hidden="false" id="r30-prae-castellax-frag"><ns0:constraints><ns0:constraint id="r30-prae-castellax-frag-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Frag Grenades" id="r30-prae-castellax-frag-rule" hidden="false"><ns0:description>The entire Maniple may take Frag Grenades for +5 points per model; select this once for each Castellax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Infravisors" hidden="false" id="r30-prae-castellax-infravisor"><ns0:constraints><ns0:constraint id="r30-prae-castellax-infravisor-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Infravisors" id="r30-prae-castellax-infravisor-rule" hidden="false"><ns0:description>The entire Maniple may take Infravisors for +5 points per model; select this once for each Castellax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Enhanced Targeting Arrays" hidden="false" id="r30-prae-castellax-eta"><ns0:constraints><ns0:constraint id="r30-prae-castellax-eta-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Enhanced Targeting Arrays" id="r30-prae-castellax-eta-rule" hidden="false"><ns0:description>The entire Maniple may take Enhanced Targeting Arrays for +15 points per model; select this once for each Castellax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Mauler Bolt Cannon Replacements" id="r30-prae-castellax-mauler-replacements" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r30-prae-castellax-mauler-replacements-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r30-prae-castellax-multimelta"><ns0:constraints><ns0:constraint id="r30-prae-castellax-multimelta-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r30-prae-castellax-multimelta-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Multi-Melta" id="r30-prae-castellax-multimelta-rule" hidden="false"><ns0:description>Replaces one Castellax model’s Mauler Bolt Cannon.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Darkfire Cannon" hidden="false" id="r30-prae-castellax-darkfire"><ns0:constraints><ns0:constraint id="r30-prae-castellax-darkfire-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Darkfire Cannon" id="r30-prae-castellax-darkfire-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">60”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Lance, Blind, Gets Hot</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Darkfire Cannon" id="r30-prae-castellax-darkfire-rule" hidden="false"><ns0:description>Replaces one Castellax model’s Mauler Bolt Cannon.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Bolter Replacements" id="r30-prae-castellax-bolter-replacements" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r30-prae-castellax-bolter-replacements-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r30-prae-castellax-flamer"><ns0:constraints><ns0:constraint id="r30-prae-castellax-flamer-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Flamer" id="r30-prae-castellax-flamer-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Flamer" id="r30-prae-castellax-flamer-rule" hidden="false"><ns0:description>Replaces one Bolter. Each Castellax may replace either or both Bolters.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Shock Charger Replacements" id="r30-prae-castellax-melee-replacements" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r30-prae-castellax-melee-replacements-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Two Battle-Automata Power Blades" hidden="false" id="r30-prae-castellax-blades"><ns0:constraints><ns0:constraint id="r30-prae-castellax-blades-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Two Battle-Automata Power Blades" id="r30-prae-castellax-blades-rule" hidden="false"><ns0:description>Replaces one Castellax model’s Shock Chargers. Melee, Strength User, AP -, Specialist Weapon.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Siege Wrecker" hidden="false" id="r30-prae-castellax-wrecker"><ns0:constraints><ns0:constraint id="r30-prae-castellax-wrecker-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Siege Wrecker" id="r30-prae-castellax-wrecker-rule" hidden="false"><ns0:description>Replaces one Castellax model’s Shock Chargers. Melee, Strength 10, AP -, Unwieldy, Armourbane.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Vorax Class Battle-Automata Maniple" hidden="false" id="r30-prae-vorax"><ns0:constraints><ns0:constraint id="r30-prae-vorax-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="65" /></ns0:costs><ns0:profiles><ns0:profile name="Vorax" id="r30-prae-vorax-profile" typeId="prof-model" typeName="Model" hidden="false"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">6</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">6</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2(3)</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">7</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">4+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Lightning Gun" id="r30-prae-vorax-lightning" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Rotor Cannon" id="r30-prae-vorax-rotor" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">30”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Salvo 3/4</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r30-prae-vorax-type" hidden="false"><ns0:description>Monstrous Creature.</ns0:description></ns0:rule><ns0:rule name="Standard Wargear" id="r30-prae-vorax-wargear" hidden="false"><ns0:description>Lightning Gun; two Rotor Cannons; Battle-Automata Power Blades; Infravisor.</ns0:description></ns0:rule><ns0:rule name="Battle-Automata Power Blades" id="r30-prae-vorax-blades" hidden="false"><ns0:description>Melee weapon: Strength User, AP -, Melee, Rending, Paired. The extra Attack from Paired is already shown in the profile as 2(3).</ns0:description></ns0:rule><ns0:rule name="Cybernetica Cortex" id="r30-prae-vorax-cortex" hidden="false"><ns0:description>Fearless; Poisoned and Fleshbane attacks only wound on a 6+; subject to Programmed Behaviour unless controlled by a Cortex Controller.</ns0:description></ns0:rule><ns0:rule name="Fleet" id="r30-prae-vorax-fleet" hidden="false"><ns0:description>Uses the normal ProHammer Fleet special rule.</ns0:description></ns0:rule><ns0:rule name="Scout" id="r30-prae-vorax-scout" hidden="false"><ns0:description>Uses the normal ProHammer Scout special rule.</ns0:description></ns0:rule><ns0:rule name="Praevian Restriction" id="r30-prae-vorax-no-paragon" hidden="false"><ns0:description>The accompanying Maniple is purchased as part of the Praevian’s single HQ selection. Paragon of Metal is not available to the Praevian’s accompanying Maniple.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Additional Vorax Battle-Automata" hidden="false" id="r30-prae-vorax-extra"><ns0:constraints><ns0:constraint id="r30-prae-vorax-extra-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="65" /></ns0:costs><ns0:rules><ns0:rule name="Additional Vorax" id="r30-prae-vorax-extra-rule" hidden="false"><ns0:description>The Maniple may include up to five additional Vorax, for a maximum of six models.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Bio-corrosive Ammunition (select once per model)" hidden="false" id="r30-prae-vorax-biocorrosive"><ns0:constraints><ns0:constraint id="r30-prae-vorax-biocorrosive-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Bio-corrosive Rotor Cannon" id="r30-prae-vorax-biocorrosive-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">15”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Salvo 3/4, Poisoned (4+)</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Bio-corrosive Ammunition" id="r30-prae-vorax-biocorrosive-rule" hidden="false"><ns0:description>The entire Maniple may equip its Rotor Cannons with Bio-corrosive Ammunition for +10 points per model; select this once for each Vorax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Maniple-wide Upgrades (select once per model)" id="r30-prae-vorax-maniple-upgrades" hidden="false" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Searchlights" hidden="false" id="r30-prae-vorax-searchlight"><ns0:constraints><ns0:constraint id="r30-prae-vorax-searchlight-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="1" /></ns0:costs><ns0:rules><ns0:rule name="Searchlights" id="r30-prae-vorax-searchlight-rule" hidden="false"><ns0:description>The entire Maniple may take Searchlights for +1 point per model; select this once for each Vorax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Frag Grenades" hidden="false" id="r30-prae-vorax-frag"><ns0:constraints><ns0:constraint id="r30-prae-vorax-frag-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Frag Grenades" id="r30-prae-vorax-frag-rule" hidden="false"><ns0:description>The entire Maniple may take Frag Grenades for +5 points per model; select this once for each Vorax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Enhanced Targeting Arrays" hidden="false" id="r30-prae-vorax-eta"><ns0:constraints><ns0:constraint id="r30-prae-vorax-eta-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Enhanced Targeting Arrays" id="r30-prae-vorax-eta-rule" hidden="false"><ns0:description>The entire Maniple may take Enhanced Targeting Arrays for +15 points per model; select this once for each Vorax in the Maniple.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Lightning Gun Replacements" id="r30-prae-vorax-lightning-replacements" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r30-prae-vorax-lightning-replacements-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Irad Cleanser" hidden="false" id="r30-prae-vorax-irad"><ns0:constraints><ns0:constraint id="r30-prae-vorax-irad-max" field="selections" scope="parent" value="6" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Irad Cleanser" id="r30-prae-vorax-irad-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">2</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Fleshbane, Rad-phage</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Irad Cleanser" id="r30-prae-vorax-irad-rule" hidden="false"><ns0:description>Replaces one Vorax model’s Lightning Gun.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:entryLinks><ns0:entryLink import="true" name="Cortex Controller" id="r29-prae-controller" type="selectionEntry" targetId="r29-gear-cortex-controller" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-prae-controller-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-prae-controller-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Cortex Designator" id="r29-prae-designator" type="selectionEntry" targetId="r29-gear-cortex-designator" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-prae-designator-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-prae-designator-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
          <ns0:selectionEntry type="upgrade" import="true" name="Stormseer Consul" hidden="false" id="r25-consul-v-stormseer-consul"><ns0:constraints><ns0:constraint id="r25-consul-v-stormseer-consul-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:rules><ns0:rule name="Stormseer Consul" id="r25-consul-v-stormseer-consul-rule" hidden="false"><ns0:description>A White Scars Legion Centurion may be upgraded to a Stormseer Consul for +35 points. A White Scars army may not select the normal Legion Librarian Consul upgrade. It uses the Stormseer Consul instead.
Wargear:
• Replace the Centurion's Chainsword with a Force Weapon
Special Rules:
• Psyker (Mastery Level 1\)
• Adamantium Will
• Legion Support Officer
PSYCHIC POWERS
A Stormseer knows the Unseen Bolt psychic power.
Unseen Bolt | 36" | 6 | 4 | Assault 1, Blast, Pinning
UNSEEN BOLT
Unseen Bolt is a psychic shooting power. It is used during the Stormseer's Shooting phase instead of firing another weapon.
Take a Psychic test using the normal ProHammer psychic rules. If successful, resolve the attack using the profile above. Unseen Bolt may not be invoked during Return Fire, Overwatch or Stand &amp; Shoot.
Epistolary
A Stormseer may be upgraded to Mastery Level 2 for a further +25 points.
If upgraded to Mastery Level 2, he may select one additional psychic power from the normal Legion Librarian Psychic Powers list.
OPTIONS
• A Stormseer may purchase:
• Psychic Hood .................................. +25 points
All other equipment is selected normally from the Space Marine Armoury.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Wolf Priest Consul" hidden="false" id="r25-consul-vi-wolf-priest-consul"><ns0:constraints><ns0:constraint id="r25-consul-vi-wolf-priest-consul-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:rules><ns0:rule name="Wolf Priest Consul" id="r25-consul-vi-wolf-priest-consul-rule" hidden="false"><ns0:description>A Legion Centurion with the Legiones Astartes (Space Wolves) special rule may be upgraded to a Wolf Priest for +35 points. A Space Wolves army may not select a Legion Chaplain Consul.
Wargear:
• Replace the Wolf Priest's Chainsword with a Fang of Morkai.
• Rosarius.
Special Rules:
• Rites of Battle
• Oath of the Slayer
FANG OF MORKAI
The Fang of Morkai counts as a Power Weapon.
RITES OF BATTLE
The Wolf Priest and any Space Wolves unit he has joined may re-roll failed Morale checks.
OATH OF THE SLAYER
Before deployment, nominate one enemy unit. The Wolf Priest and any Space Wolves unit he has joined may re-roll failed To Hit rolls in close combat against the nominated enemy unit. The oath lasts for the duration of the battle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Rune Priest Consul" hidden="false" id="r25-consul-vi-rune-priest-consul"><ns0:constraints><ns0:constraint id="r25-consul-vi-rune-priest-consul-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:rules><ns0:rule name="Rune Priest Consul" id="r25-consul-vi-rune-priest-consul-rule" hidden="false"><ns0:description>A Legion Centurion with the Legiones Astartes (Space Wolves) special rule may be upgraded to a Rune Priest for +25 points. A Space Wolves army may not select a Legion Librarian Consul.
Wargear:
• Replace the Rune Priest's Chainsword with a Runic Force Weapon.
• Wolf Tail Talisman.
Special Rules:
• Psyker (Mastery Level 1\)
• Legion Support Officer
Psychic Powers:
• Mystic Winds of Fenris
OPTIONS
• The Rune Priest may be upgraded to a Master of Runes
for +25 points.
A Master of Runes has Psychic Mastery Level 2 and may select one additional psychic power from the disciplines normally available to a Legion Librarian.
• The Rune Priest may purchase a Psychic Hood from the
Space Marine Armoury as normal.
RUNIC FORCE WEAPON
A Runic Force Weapon counts as a Force Weapon.
MYSTIC WINDS OF FENRIS
Blessing — Friendly Space Wolves unit within 6". If the Psychic Test is passed, nominate the Rune Priest or one friendly Space Wolves unit with at least one model within 6". Until the beginning of the next Space Wolves turn, the nominated unit receives a 5+ Cover Save. If the unit already has a Cover Save, improve that save by 1, to a maximum of 4+.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Sanguinary High Priest Consul" hidden="false" id="r25-consul-ix-sanguinary-high-priest-consul"><ns0:constraints><ns0:constraint id="r25-consul-ix-sanguinary-high-priest-consul-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="45" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-ix" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:rules><ns0:rule name="Sanguinary High Priest Consul" id="r25-consul-ix-sanguinary-high-priest-consul-rule" hidden="false"><ns0:description>A Blood Angels Legion Centurion may be upgraded to a Sanguinary High Priest for +45 points.
Wargear:
• Narthecium
• Reductor
Special Rules:
• Legion Support Officer
• Sanguinius' Chosen
APOTHECARION
A Sanguinary High Priest counts as an Apothecary for all rules and wargear restrictions.
SANGUINIUS' CHOSEN
The Sanguinary High Priest and any Blood Angels unit he has joined have the Furious Charge special rule.
OPTIONS
A Sanguinary High Priest retains the normal weapon and wargear options available to a Legion Centurion.
He may therefore take a Jump Pack for the normal points cost.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries>

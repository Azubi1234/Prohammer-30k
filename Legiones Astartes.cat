                            <ns0:profile name="Land Raider Phobos" id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
                              <ns0:characteristics>
                                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
                                <ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic>
                                <ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic>
                                <ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic>
                              </ns0:characteristics>
                            </ns0:profile>
                          </ns0:profiles>
                        <ns0:rules><ns0:rule id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-phobos-rite-size" name="Armoured Assault" hidden="false"><ns0:description>Select Phobos/Proteus only for an Ironwing Infantry unit of 10 models or fewer; select the Spartan only for an Ironwing Infantry unit of 11–20 models. Normal Transport Capacity restrictions apply.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry>
                        <ns0:selectionEntry type="model" name="Land Raider Proteus (10 models or fewer)" id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus" hidden="false" import="true">
                          <ns0:constraints>
                            <ns0:constraint id="r40-da-steel-transport-terminator-unit-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-r37-spear-tac-transport-src-hq-praetor-ret-honour-land-land-raider-proteus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                          </ns0:constraints>

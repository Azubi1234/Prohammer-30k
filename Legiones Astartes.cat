• The Chem-master may select up to 50 points of permitted Terminator weapons and wargear from the Space Marine Armoury.
DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod orSpartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xiv-1-grave-warden-terminator-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xiv-1-grave-warden-terminator-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xiv-1-grave-warden-terminator-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +50 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xiv-1-grave-warden-terminator-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="r41-unit-xiv-1-grave-warden-terminator-squad-opt-0-chainfist"><ns0:constraints><ns0:constraint id="r41-unit-xiv-1-grave-warden-terminator-squad-opt-0-chainfist-max" field="selections" scope="parent" value="16" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xiv-1-grave-warden-terminator-squad-opt-0-context" hidden="false"><ns0:description>• Any model may replace his Power fist with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="r
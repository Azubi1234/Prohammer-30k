                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Krak Grenades (+2 pts/model)" hidden="false" id="r40-da-storm-assault-assault-squad-krak" type="selectionEntry" targetId="gear-krak">
              <ns0:constraints>

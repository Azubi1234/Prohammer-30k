              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-contemptor-unit-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-contemptor-unit-5">
              <constraints>

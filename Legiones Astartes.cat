        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-assault-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-assault-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-assault-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-assault-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-assault-unit-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-assault-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-assault-unit-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-assault-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-assault-unit-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-assault-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-assault-unit-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-assault-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-assault-unit-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-assault-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-assault-unit-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-assault-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-assault-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Breacher Siege Squad" hidden="false" id="breacher-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="breacher-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="breacher-standard-wargear" hidden="false">
          <ns0:description>Every model is equipped with Hardened Power Armour, a Bolter, a Bolt Pistol, a Boarding Shield and Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="breacher-legiones" hidden="false">
          <ns0:description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="breacher-frag" hidden="false">
          <ns0:description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="breacher-transport-rule" hidden="false">
          <ns0:description>A Legion Breacher Siege Squad containing ten models or fewer may select a Land Raider, Land Raider Proteus or Land Raider Phobos as a Dedicated Transport where permitted by the relevant vehicle entry. A Legion Breacher Siege Squad may not select a Rhino or Drop Pod unless specifically permitted by a Rite of War or Legion-specific rule.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Hardened Power Armour" hidden="false" id="breacher-standard-armour" type="selectionEntry" targetId="gear-hardened-power-armour" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-armour-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-armour-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Bolter" hidden="false" id="breacher-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Bolt Pistol" hidden="false" id="breacher-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-bp-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-bp-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Boarding Shield" hidden="false" id="breacher-standard-shield" type="selectionEntry" targetId="gear-boarding-shield" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-shield-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="breacher-standard-shield-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
      <ns0:entryLink id="r40-da-forward-breacher-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-breacher-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="da-wing-breacher-unit-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-breacher-unit-iw-shrapnel" name="Shrapnel Bolts" type="selectionEntry" targetId="r43-iw-shrapnel-bolts" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-breacher-unit-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Breacher Marine" hidden="false" id="breacher-marine" defaultAmount="9">
          <ns0:constraints>
            <ns0:constraint type="min" value="9" field="selections" scope="parent" shared="true" id="breacher-marine-min" includeChildSelections="false" />
            <ns0:constraint type="max" value="19" field="selections" scope="parent" shared="true" id="breacher-marine-max" includeChildSelections="false" />

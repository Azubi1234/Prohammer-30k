    <ns0:categoryLinks><ns0:categoryLink id="r40-da-storm-assault-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-storm" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="true" id="r40-da-vow-veteran">
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r40-da-vow-veteran-veteran-standard" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-vow-veteran-veteran-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Veteran Tactics" id="r40-da-vow-veteran-veteran-tactics-rule" hidden="false">
          <ns0:description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r40-da-vow-veteran-veteran-transport-rule" hidden="false">
          <ns0:description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-vow-veteran-rite-rule" name="The Hammer of Caliban" hidden="false"><ns0:description>Selected as a Troops choice by The Unbroken Vow. This Rite-specific copy is fixed to the Deathwing.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Veterans (included)" hidden="false" id="r40-da-vow-veteran-veteran-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="r40-da-vow-veteran-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-vow-veteran-veteran-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veterans (included)" id="r40-da-vow-veteran-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="r40-da-vow-veteran-veteran-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r40-da-vow-veteran-veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-vow-veteran-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veteran Sergeant" id="r40-da-vow-veteran-veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>

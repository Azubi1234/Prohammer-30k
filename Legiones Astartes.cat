ii-0-terror-formations-night-raptor-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-viii-0-terror-assault" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Night Raptor" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Raptor Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Headtaker" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-profile-2"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-source" hidden="false"><ns0:description>Night Raptor | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 8 | 3+
Raptor Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Headtaker | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Fast Attack
Unit Composition:
• 4 Night Raptors
• 1 Raptor Sergeant
Unit Type:
• Jump Infantry
• The Raptor Sergeant is a Character
Wargear:
• Power Armour
• Jump Pack
• Bolt pistol
• Chainsword
• Frag grenades
• Trophies of Judgement
Special Rules:
• Legiones Astartes (Night Lords)
• Hit &amp; Run
OPTIONS
• The squad may include up to ten additional Night Raptors
for +28 points per model.
• Up to five models may replace their Chainsword with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Up to two Night Raptors may replace their Bolt pistol with:
• Volkite Serpenta .............................. +5 points
• Hand Flamer ................................... +5 points
• Plasma Pistol ................................ +15 points
• Up to two models may take:
• Melta bombs .................................... +5 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Stealth Adept ............................ +1 point per model
HEADTAKER
The Raptor Sergeant may be upgraded to a Headtaker for +15 points. A Headtaker has Weapon Skill 5.
The Headtaker may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Night Lords Armoury</ns0:description></ns0:rule><ns0:rule id="r42-role-viii-0-terror-formations-night-raptor-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>The Terror Assault is the favoured method of war of the VIII Legion: a sudden offensive conducted beneath artificial darkness, with enemy communications disrupted and rapid assault formations descending upon isolated positions before a coherent defence can be organised.
EFFECTS
COVER OF DARKNESS
The first Battle Round is fought using the Night Fighting rules. At the beginning of the second Battle Round, roll a D6. On a 3+, Night Fighting remains in effect for the second Battle Round. If Night Fighting remained in effect during the second Battle Round,
roll again at the beginning of the third Battle Round. On a 6, Night Fighting remains in effect for the third Battle Round.
Night Fighting automatically ends at the beginning of the fourth Battle Round. Night Lords units benefit from their normal Night Vision special rule
during these turns.
TERROR FORMATIONS
Night Raptor Squads may be selected as Troops choices. Terror Squads may also be selected as Troops choices once their unit entry is included in the Night Lords army list. Both units may fulfil compulsory Troops selections. At least one of the Detachment's compulsory Troops selections must be a Night Raptor Squad or Terror Squad.
TERROR ATTACK
Whenever the opposing player makes Reserve rolls, after all of those rolls have been made, the Night Lords player may force one successful Reserve roll to be re-rolled. The second result must be accepted. A die may never be re-rolled more than once.
RAPID STRIKE FORCE
The Detachment modifies the Standard Force Organisation Chart as follows:
Fast Attack: 0–4
Heavy Support: 0–1
All other Force Organisation limits remain unchanged.
LIMITATIONS
The Detachment must include at least one Night Raptor Squad or Terror Squad.
The Detachment may include no more than one Heavy Support choice.
The Detachment may not include a Fortification.</ns0:description></ns0:rule><ns0:rule id="r42-role-viii-0-terror-formations-night-raptor-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-additional"><ns0:constraints><ns0:constraint id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-additional-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="28" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-additional-rule" hidden="false"><ns0:description>May include up to 10 additional models at +28 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-0-for"><ns0:constraints><ns0:constraint id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="28" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-0-context" hidden="false"><ns0:description>• The squad may include up to ten additional Night Raptors</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-1-rending-weapon"><ns0:constraints><ns0:constraint id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-1-rending-weapon-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-1-context" hidden="false"><ns0:description>• Up to five models may replace their Chainsword with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-2-power-weapon"><ns0:constraints><ns0:constraint id="r42-role-viii-0-terror-formations-night-raptor-squads-r41-unit-viii-1-night-raptor-squad-opt-2-power-weapon-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-viii
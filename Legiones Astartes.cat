              </entryLinks>
            </selectionEntryGroup>
            <selectionEntryGroup name="Additional Sergeant Armoury (max 50 pts)" id="assault-sgt-armoury" hidden="false">
              <constraints>
                <constraint type="max" value="50" field="pts" scope="parent" shared="true" id="assault-sgt-armoury-pts-max" includeChildSelections="true" />

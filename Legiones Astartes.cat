                  <modifiers>
                    <modifier type="set" value="2" field="hs-lr-ac-up-auxiliary-drive-max">
                      <conditions>
                        <condition type="atLeast" value="2" field="selections" scope="root-entry" childId="hs-lr-achilles" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>
                    <modifier type="set" value="3" field="hs-lr-ac-up-auxiliary-drive-max">
                      <conditions>
                        <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-lr-achilles" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>

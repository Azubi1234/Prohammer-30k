            <ns0:rule name="Flare Shield" id="r40-da-steel-transport-breacher-unit-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
              <ns0:description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>

name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">4+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Ammitara Fate" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-source" hidden="false"><ns0:description>Ammitara Intercessor | 4 | 5 | 4 | 4 | 1 | 4 | 1 | 8 | 4+
Ammitara Fate | 4 | 5 | 4 | 4 | 1 | 4 | 2 | 9 | 4+
Force Organisation:
• Fast Attack
PSYCHIC BROTHERHOOD When the army is selected, assign the Cabal to one Prosperine Cult. The Cabal receives both the Cult Arcana and Cult Mastery benefits of that Cult. The Cabal selects one psychic power from: • Divination • Telepathy The Cabal follows all normal ProHammer rules for a Brotherhood of Psykers (Mastery Level 1).
• 0–1
Unit Composition:
• 4 Ammitara Intercessors
• 1 Ammitara Fate
Unit Type:
• Infantry
• The Ammitara Fate is a Character
Wargear:
• Recon Armour
• Sniper Rifle
• Bolt pistol
• Combat Blade
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Brotherhood of Psykers (Mastery Level 1\)
• Scout
• Infiltrate
• Move Through Cover
• Stealth
OPTIONS
• The Cabal may include up to five additional Ammitara Intercessors for +20 points per model.
• Any model may replace his Sniper Rifle with:
• Combi-flamer ................................. +10 points
• Combi-volkite charger ....................... +10 points
• Combi-meltagun .............................. +15 points
• Combi-plasma gun ............................ +15 points
• Up to two models may instead replace their Sniper Rifle with:
• Meltagun ..................................... +10 points
• Plasma Gun ................................... +15 points
• One model may carry:
• Nuncio Vox ................................... +10 points
• The entire Cabal may take:
• Krak grenades .......................... +2 points per model
• Melta bombs ............................ +5 points per model
AMMITARA FATE
The Ammitara Fate may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-additional"><ns0:constraints><ns0:constraint id="r41-unit-xv-2-ammitara-occult-intercession-cabal-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +20 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Combi-flamer" hidden="false" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-opt-0-combi-flamer"><ns0:constraints><ns0:constraint id="r41-unit-xv-2-ammitara-occult-intercession-cabal-opt-0-combi-flamer-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-2-ammitara-occult-intercession-cabal-opt-0-context" hidden="false"><ns0:description>• Any model may replace his Sniper Rifle with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="
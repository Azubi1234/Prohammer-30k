      <ns0:selectionEntry id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Death from Above (Legion Assault Company)" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-r37-assault-dfa-veteran-unit-rule" hidden="false"><ns0:description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="125" />
      </ns0:costs>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Veteran Tactic (choose one)" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactics" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactics-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Resolve" hidden="false" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-resolve">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-resolve-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Resolve" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-resolve-rule" hidden="false">
                  <ns0:description>The squad gains the Stubborn special rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Assault Veterans" hidden="false" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-assault">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Assault Veterans" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-assault-rule" hidden="false">
                  <ns0:description>The squad gains the Furious Charge special rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Counter-Assault" hidden="false" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-counter">
              <ns0:constraints>
                <ns0:constraint id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-counter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Counter-Assault" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tactic-counter-rule" hidden="false">
                  <ns0:description>The squad gains the Counter-Attack special rule.</ns0:description>
                </ns0:rule>

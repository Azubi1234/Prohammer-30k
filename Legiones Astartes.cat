      <ns0:selectionEntry id="r40-da-storm-assault-r37-assault-dfa-assault-unit" name="Death from Above (Legion Assault Company)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-storm-assault-r37-assault-dfa-assault-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Death from Above (Legion Assault Company)" id="r40-da-storm-assault-r37-assault-dfa-assault-unit-rule" hidden="false"><ns0:description>Any unit composed entirely of models equipped with Jump Packs may deploy using Deep Strike even if the mission would not normally permit Deep Strike. Resolve arrival using the normal ProHammer Deep Strike rules.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-assault" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Squad-wide Wargear" id="r40-da-storm-assault-assault-squad-wargear" hidden="false">

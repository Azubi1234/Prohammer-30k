    <selectionEntry type="upgrade" name="Flamestorm Cannon" hidden="false" id="hsgear-flamestorm" import="true">
      <rules>
        <rule name="Flamestorm Cannon" id="hsgear-flamestorm-rule" hidden="false">
          <description>The profile is not reproduced in this army list; use the applicable ProHammer/Legion Flamestorm Cannon profile.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" name="Demolisher Cannon" hidden="false" id="hsgear-demolisher" import="true">
      <rules>
        <rule name="Demolisher Cannon" id="hsgear-demolisher-rule" hidden="false">
          <description>The profile is not reproduced in this army list; use the applicable ProHammer Demolisher Cannon profile.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Close Combat Weapon" hidden="false" id="gear-hq-ccw">
      <rules>
        <rule name="Close Combat Weapon" id="gear-hq-ccw-rule" hidden="false">
          <description>Close Combat Weapon. Uses the bearer's Strength and permits normal Armour Saves.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chainaxe" hidden="false" id="gear-hq-chainaxe">
      <rules>
        <rule name="Chainaxe" id="gear-hq-chainaxe-rule" hidden="false">
          <description>An Armour Save better than 4+ is reduced to 4+ against wounds caused by a Chainaxe. Armour Saves of 4+ or worse and Invulnerable Saves are unaffected.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Force Weapon" hidden="false" id="gear-hq-force">
      <rules>
        <rule name="Force Weapon" id="gear-hq-force-rule" hidden="false">
          <description>Power Weapon, Force. After a Psyker inflicts one or more unsaved wounds, it may take a Psychic Test; if passed, each unsaved wound becomes a Massive Wound and inflicts D3 Wounds. No additional effect against vehicles.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Relic Blade" hidden="false" id="gear-hq-relic">
      <rules>
        <rule name="Relic Blade" id="gear-hq-relic-rule" hidden="false">
          <description>Strength 6; Power Weapon; Two-Handed. Independent Characters only.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Artificer Armour" hidden="false" id="gear-hq-artificer">
      <rules>
        <rule name="Artificer Armour" id="gear-hq-artificer-rule" hidden="false">
          <description>Artificer Armour grants a 2+ Armour Save and does not count as Terminator Armour.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="gear-hq-terminator">
      <rules>
        <rule name="Terminator Armour" id="gear-hq-terminator-rule" hidden="false">
          <description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not make Pursuit moves and may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="gear-hq-tartaros">
      <rules>
        <rule name="Tartaros Terminator Armour" id="gear-hq-tartaros-rule" hidden="false">
          <description>2+ Armour Save, 5+ Invulnerable Save, Relentless, Bulky and Deep Strike; may make Pursuit moves; may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cataphractii Terminator Armour" hidden="false" id="gear-hq-cataphractii">
      <rules>
        <rule name="Cataphractii Terminator Armour" id="gear-hq-cataphractii-rule" hidden="false">
          <description>2+ Armour Save, 4+ Invulnerable Save, Relentless, Bulky and Deep Strike; may not Advance, make Pursuit moves or fire Overwatch; may not embark upon Rhinos or Drop Pods.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="gear-hq-refractor">
      <rules>
        <rule name="Refractor Field" id="gear-hq-refractor-rule" hidden="false">
          <description>A Refractor Field grants a 5+ Invulnerable Save. A Sergeant may only purchase a Refractor Field if his squad is purchased at its maximum starting strength. A model that already has a 5+ or better Invulnerable Save may not purchase a Refractor Field.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="gear-hq-iron-halo">
      <rules>
        <rule name="Iron Halo" id="gear-hq-iron-halo-rule" hidden="false">
          <description>Grants a 4+ Invulnerable Save. An army may normally contain no more than one Iron Halo unless specifically stated otherwise.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Boarding Shield" hidden="false" id="gear-hq-boarding">
      <rules>
        <rule name="Boarding Shield" id="gear-hq-boarding-rule" hidden="false">
          <description>Grants a 5+ Invulnerable Save, occupies one hand and prevents the bonus Attack for fighting with two weapons.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-hq-combat-shield">
      <rules>
        <rule name="Combat Shield" id="gear-hq-combat-shield-rule" hidden="false">
          <description>Grants a 6+ Invulnerable Save; does not occupy a hand and does not prevent the two-weapon bonus Attack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Jump Pack" hidden="false" id="gear-hq-jump">
      <rules>
        <rule name="Jump Pack" id="gear-hq-jump-rule" hidden="false">
          <description>The bearer becomes Jump Infantry and follows the normal ProHammer Jump Infantry rules. It may not be combined with a Bike, Jetbike or Terminator Armour.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Space Marine Bike" hidden="false" id="gear-hq-bike">
      <rules>
        <rule name="Space Marine Bike" id="gear-hq-bike-rule" hidden="false">
          <description>The bearer becomes Bike unit type and follows the normal ProHammer Bike rules. The bike is armed with twin-linked bolters. It may not be combined with a Jump Pack, Jetbike or Terminator Armour.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-hq-auspex">
      <rules>
        <rule name="Auspex" id="gear-hq-auspex-rule" hidden="false">
          <description>Detects Infiltrators and permits the pre-game anti-Infiltrator fire described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-hq-bionics">
      <rules>
        <rule name="Bionics" id="gear-hq-bionics-rule" hidden="false">
          <description>When the bearer loses its final Wound, it may recover as described by the Space Marine Armoury on a roll of 6.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Digital Weapons" hidden="false" id="gear-hq-digital">
      <rules>
        <rule name="Digital Weapons" id="gear-hq-digital-rule" hidden="false">
          <description>Independent Character only; re-roll one failed To Wound roll per Assault phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="gear-hq-mastercraft">
      <rules>
        <rule name="Master-crafted Weapon" id="gear-hq-mastercraft-rule" hidden="false">
          <description>Apply to one weapon; re-roll one failed To Hit roll per player turn with that weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-hq-nuncio">
      <rules>
        <rule name="Nuncio Vox" id="gear-hq-nuncio-rule" hidden="false">
          <description>Assists friendly Deep Striking units as described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Psychic Hood" hidden="false" id="gear-hq-hood">
      <rules>
        <rule name="Psychic Hood" id="gear-hq-hood-rule" hidden="false">
          <description>Psykers only. May attempt to nullify enemy psychic powers using the ProHammer Psychic Hood rules.</description>
        </rule>
      </rules>
      <modifiers>
        <modifier type="set" value="true" field="hidden">
          <conditions>
            <condition type="lessThan" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian" shared="true" includeChildSelections="true" includeChildForces="false" />
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-hq-purity">
      <rules>
        <rule name="Purity Seals" id="gear-hq-purity-rule" hidden="false">
          <description>Improves control of Fall Back distance as described in the Space Marine Armoury.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="gear-hq-signum">
      <rules>
        <rule name="Signum" id="gear-hq-signum-rule" hidden="false">
          <description>The bearer's unit may re-roll one failed shooting To Hit roll per Shooting phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-hq-homer">
      <rules>
        <rule name="Teleport Homer" id="gear-hq-homer-rule" hidden="false">
          <description>Friendly units arriving by teleportation do not scatter when deployed within the permitted range of the active Homer.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terminator Honours" hidden="false" id="gear-hq-honours">
      <rules>
        <rule name="Terminator Honours" id="gear-hq-honours-rule" hidden="false">
          <description>The bearer gains +1 Attack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="gear-hq-melta-bombs">
      <rules>
        <rule name="Melta Bombs" id="gear-hq-melta-bombs-rule" hidden="false">
          <description>Against a vehicle in close combat, the bearer may exchange normal attacks for one Melta Bomb attack at Strength 8 + 2D6 Armour Penetration.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Narthecium" hidden="false" id="gear-hq-narthecium">
      <rules>
        <rule name="Narthecium" id="gear-hq-narthecium-rule" hidden="false">
          <description>A unit containing an Apothecary with a Narthecium may ignore the first eligible failed saving throw it suffers during each player turn, subject to the restrictions in the army list.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Reductor" hidden="false" id="gear-hq-reductor">
      <rules>
        <rule name="Reductor" id="gear-hq-reductor-rule" hidden="false">
          <description>If Victory Points are used and the Apothecary survives, recover 1 Victory Point for each slain friendly Legiones Astartes model that belonged to his unit, including attached Independent Characters.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-hq-vexilla">
      <rules>
        <rule name="Legion Vexilla" id="gear-hq-vexilla-rule" hidden="false">
          <description>The bearer's unit adds +1 to its combat-resolution score. This bonus is not cumulative.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sacred Standard" hidden="false" id="gear-hq-sacred">
      <rules>
        <rule name="Sacred Standard" id="gear-hq-sacred-rule" hidden="false">
          <description>Friendly Legiones Astartes units add +1 to combat-resolution in any close combat within 6". Not cumulative with another Sacred Standard or Legion Standard.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Legion Standard" hidden="false" id="gear-hq-legion-standard">
      <rules>
        <rule name="Legion Standard" id="gear-hq-legion-standard-rule" hidden="false">
          <description>Combines the effects of a Sacred Standard and a Crusade Relic. Only an army of 2,000 points or more may include one; it normally counts as the army's Crusade Relic.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="gear-hq-grenade-harness">
      <rules>
        <rule name="Grenade Harness" id="gear-hq-grenade-harness-rule" hidden="false">
          <description>One-use 8" S3 AP– Assault 2, Blast grenade weapon; grants the Frag Grenade benefit where applicable.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Calibanite Warblade" hidden="false" id="da22-warblade">
      <rules>
        <rule name="Calibanite Warblade" id="rule-da22-warblade" hidden="false">
          <description>Strength User +1; Power Weapon. Counts as a sword-type weapon for Mastery of the Blade and Deathwing rules.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Terranic Greatsword" hidden="false" id="da22-greatsword">
      <rules>
        <rule name="Terranic Greatsword" id="rule-da22-greatsword" hidden="false">
          <description>Strength User +2; Power Weapon, Two-Handed, Murderous Strike. Natural To Wound roll of 6 causes Instant Death. Counts as a sword-type weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Calibanite Plasma Pistol" hidden="false" id="da22-plasma-pistol">
      <profiles>
        <profile name="Calibanite Plasma Pistol" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-pistol">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Pistol</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Calibanite Plasma Gun" hidden="false" id="da22-plasma-gun">
      <profiles>
        <profile name="Calibanite Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-gun">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Calibanite Plasma Cannon" hidden="false" id="da22-plasma-cannon">
      <profiles>
        <profile name="Calibanite Plasma Cannon" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-cannon">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Blast</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Repeater" hidden="false" id="da22-plasma-repeater">
      <profiles>
        <profile name="Plasma Repeater" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-repeater">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">6</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Salvo 2/3, Twin-linked, Gets Hot</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Burner" hidden="false" id="da22-plasma-burner">
      <profiles>
        <profile name="Plasma Burner" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-burner">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault D3+1, Ignores Cover, Plasma Flame</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Plasma Burner" id="rule-da22-plasma-burner" hidden="false">
          <description>Plasma Flame: may re-roll failed To Hit rolls when making Overwatch; roll once for number of generated shots each time it fires.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stasis Shell — Missile" hidden="false" id="da22-stasis-missile">
      <profiles>
        <profile name="Stasis Shell — Missile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-stasis-missile">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">48"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">6</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Stasis Anomaly</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Stasis Shell — Missile" id="rule-da22-stasis-missile" hidden="false">
          <description>Stasis Anomaly: if a unit is hit, all models in it have Initiative 1 until end of current player turn; multiple anomalies do not stack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stasis Shell — Grenade" hidden="false" id="da22-stasis-grenade">
      <profiles>
        <profile name="Stasis Shell — Grenade" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-stasis-grenade">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">24"</characteristic>
            <characteristic name="S" typeId="ranged-s">2</characteristic>
            <characteristic name="AP" typeId="ranged-ap">-</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 1, Blast, Stasis Anomaly</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Stasis Shell — Grenade" id="rule-da22-stasis-grenade" hidden="false">
          <description>Stasis Anomaly: if a unit is hit, all models in it have Initiative 1 until end of current player turn; multiple anomalies do not stack.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Molecular Acid Heavy Bolter" hidden="false" id="da22-acid-hb">
      <profiles>
        <profile name="Molecular Acid Heavy Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-acid-hb">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">36"</characteristic>
            <characteristic name="S" typeId="ranged-s">5</characteristic>
            <characteristic name="AP" typeId="ranged-ap">4</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy 3, Fleshbane</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Molecular Acid Heavy Bolter" id="rule-da22-acid-hb" hidden="false">
          <description>Fleshbane. A Twin-linked Heavy Bolter using Molecular Acid Shells remains Twin-linked.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Teleportation Transponders" hidden="false" id="da22-transponders">
      <rules>
        <rule name="Teleportation Transponders" id="rule-da22-transponders" hidden="false">
          <description>A model/unit equipped with these may deploy using Deep Strike even if the mission normally forbids it. Terminator unit +15 points; Terminator Independent Character +10 points; an IC intending to Deep Strike with a unit buys separately.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma-caster" hidden="false" id="da22-plasma-caster">
      <profiles>
        <profile name="Plasma-caster" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-caster">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Assault 2, Ignores Cover, Plasma Flame</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Plasma-caster" id="rule-da22-plasma-caster" hidden="false">
          <description>Plasma Flame: failed To Hit rolls may be re-rolled when firing Overwatch.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Plasma Incinerator with Suspensor Web" hidden="false" id="da22-plasma-incinerator">
      <profiles>
        <profile name="Plasma Incinerator with Suspensor Web" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-plasma-incinerator">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">18"</characteristic>
            <characteristic name="S" typeId="ranged-s">4</characteristic>
            <characteristic name="AP" typeId="ranged-ap">2</characteristic>
            <characteristic name="Type" typeId="ranged-type">Heavy D3+4, Ignores Cover, Plasma Flame</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Plasma Incinerator with Suspensor Web" id="rule-da22-plasma-incinerator" hidden="false">
          <description>When several identical Plasma Burners/Incinerators fire, roll once for shots and use it for every weapon of that type. Plasma Flame permits re-rolling failed Overwatch To Hit rolls.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Needle Pistol" hidden="false" id="da22-needle-pistol">
      <profiles>
        <profile name="Needle Pistol" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-da22-needle-pistol">
          <characteristics>
            <characteristic name="Range" typeId="ranged-range">12"</characteristic>
            <characteristic name="S" typeId="ranged-s">2</characteristic>
            <characteristic name="AP" typeId="ranged-ap">5</characteristic>
            <characteristic name="Type" typeId="ranged-type">Pistol, Poisoned, Rending</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Calibanite Charge-blade" hidden="false" id="da22-charge-blade">
      <rules>
        <rule name="Calibanite Charge-blade" id="rule-da22-charge-blade" hidden="false">
          <description>Grants +1 Strength and Rending. Supercharged Blades: at start of an Assault phase while engaged, the Cabal may make all Charge-blades also Power Weapons until phase end; each Enigmatus rolling one or more natural 1s To Hit suffers one S4 hit after its attacks, normal saves allowed.</description>
        </rule>
      </rules>
    </selectionEntry>
  </sharedSelectionEntries>
  <selectionEntries>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad" hidden="false" id="tactical-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="tactical-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Power Armour" id="tactical-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="tactical-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="tactical-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Fury of the Legion" id="tactical-fury" hidden="false">
          <description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description>
        </rule>
        <rule name="Automatic Basic Wargear" id="rev23-tactical-wargear-auto" hidden="false">
          <description>A Legion Tactical Squad begins with its listed basic wargear automatically. Squad-wide Chainsword purchases, Bolter-for-Chainsword exchanges and Krak Grenade purchases are selected once for the squad and their points scale with squad size; they are not selected model-by-model.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="tac-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="tac-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="tac-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="tac-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="rule-sgt-armoury" hidden="false">
              <description>May select up to 50 points of permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as two weapon choices. His standard Bolter and Bolt Pistol are already included and are not repurchased.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Armoury (max 50 pts)" id="sgt-armoury" hidden="false">
              <constraints>
                <constraint type="max" value="50" field="pts" scope="parent" shared="true" id="sgt-armoury-pts-max" includeChildSelections="true" />
              </constraints>
              <selectionEntryGroups>
                <selectionEntryGroup name="Sergeant Armoury - Weapons" id="sgt-weapons" hidden="false">
                  <constraints>
                    <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-weapons-max" includeChildSelections="true" />
                  </constraints>
                  <selectionEntryGroups>
                    <selectionEntryGroup name="Single-Handed Weapons" id="sgt-single" hidden="false">
                      <constraints>
                        <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="sgt-single-max" includeChildSelections="false" />
                      </constraints>
                      <entryLinks>

ons" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Shadrak Meduson" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-4-shadrak-meduson-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-x-4-shadrak-meduson-source" hidden="false"><ns0:description>Shadrak Meduson | 5 | 5 | 4 | 5 | 2 | 4 | 3 | 10 | 3+/4+
Force Organisation:
FURY OF THE SURVIVORS Meduson and any Iron Hands unit he has joined have Counter-Attack. In addition, when attacking a Traitor unit, Meduson and his unit may re-roll To Hit rolls of 1 in both the Shooting and Assault phases. COMMAND RETINUE Meduson may select one Legion Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Power Armour
• Iron Halo
• Master-crafted Bolter
• Power weapon
• Bionics
• Mechadendrites
• Frag grenades
Special Rules:
• Legiones Astartes (Iron Hands)
• Independent Character
• Master of the Legion
• Fury of the Survivors
OPTIONS
• Meduson may take:
• Krak grenades ................................... +2 points
• Melta bombs .................................... +5 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-x-4-shadrak-meduson-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-x-4-shadrak-meduson-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-x-4-shadrak-meduson-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-x-4-shadrak-meduson-opt-0-context" hidden="false"><ns0:description>• Meduson may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Melta bombs" hidden="false" id="r41-unit-x-4-shadrak-meduson-opt-1-melta-bombs"><ns0:constraints><ns0:constraint id="r41-unit-x-4-shadrak-meduson-opt-1-melta-bombs-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-x-4-shadrak-meduson-opt-1-context" hidden="false"><ns0:description>• Meduson may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="AUTEK MOR" hidden="false" id="r41-unit-x-5-autek-mor"><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-x-5-autek-mor-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-x-5-autek-mor-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Autek Mor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-5-autek-mor-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-x-5-autek-mor-source" hidden="false"><ns0:description>Autek Mor | 6 | 5 | 4 | 5 | 3 | 5 | 4 | 10 | 2+/4+
Force Organisation:
BATTLESMITH Autek Mor uses the normal Battlesmith rule from the Legiones Astartes Army List. His Servo-Arm provides the normal +1 bonus to his repair roll, so he normally repairs a damaged Vehicle on a 4+. COMMAND RETINUE Autek Mor may select one Legion Terminator Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Cataphractii Terminator Armor
• Relic Blade
• Volkite Charger
• Servo-Arm
• Bionics
Special Rules:
• Legiones Astartes (Iron Hands)
• Independent Character
• Master of the Legion
• Battlesmith
• Furious Charge
CASTRMEN ORTH — 50 POINTS + VEHICLE
Force Organisation:
• HQ
Castrmen Orth may be purchased as an upgrade for one Iron Hands Vehicle (Tank) in the army for +50 points.
Orth and his Vehicle together occupy the Vehicle's normal Force Organisation selection and one HQ selection.
Orth may not command:
• A Walker
• A Vehicle without a Ballistic Skill characteristic
• A Vehicle already commanded by another named character
Special Rules:
• Spearhead Centurion
• Tank Hunters
SPEARHEAD CENTURION
The Vehicle commanded by Castrmen Orth has Ballistic Skill 5. This replaces its normal Ballistic Skill.
TANK HUNTERS
Orth's Vehicle has the normal ProHammer Tank Hunters special rule. If the Vehicle is destroyed, Castrmen Orth is also considered slain for all Victory Point and mission purposes. Orth is not represented by a separate model and may not leave his Vehicle during the battle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="GABRIEL SANTAR" hidden="false" id="r41-unit-x-6-gabriel-santar"><ns0:costs><ns0:cost name="Points" typeId="pts" value="220" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-x-6-gabriel-santar-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-x-6-gabriel-santar-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Gabriel Santar" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-6-gabriel-santar-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">5</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-x-6-gabriel-santar-source" hidden="false"><ns0:description>Gabriel Santar | 6 | 5 | 4 | 5 | 3 | 4 | 4 | 10 | 2+/4+
THE IRON AEGIS The Iron Aegis is a unique suit of Terminator Armour. It grants Santar a 2+ Armour Save and 4+ Invulnerable Save and follows all other normal rules for Terminator Armour. The Iron Aegis also incorporates Bionics and a matched pair of master-crafted power claws. The power claws are Power Weapons with the Rending special rule. The +1 Attack for fighting with two close-combat weapons is already included in Santar's profile. The claws count as a single Master-crafted weapon for the purpose of re-rolling one failed To Hit roll. MASTER OF THE MORLOCKS Santar may select one Morlock Terminator Squad as his retinue. The Morlocks do not occupy a separate Elites choice. Santar and the Morlocks count as a single HQ selection.
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• The Iron Aegis
• Nuncio Vox
• Mechadendrites
• Servo-Arm
Special Rules:
• Legiones Astartes (Iron Hands)
• Independent Character
• Master of the Legion
• Master of the Morlocks
RESTRICTION
Gabriel Santar may only be included in an army of 1,500 points or more.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="X — FERRUS MANUS, THE GORGON" hidden="false" id="r41-unit-x-7-x-ferrus-manus-the-gorgon"><ns0:costs><ns0:cost name="Points" typeId="pts" value="505" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-x-7-x-ferrus-manus-the-gorgon-cat" name="Lords of War" hidden="false" targetId="cat-low" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-x" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-x-7-x-ferrus-manus-the-gorgon-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Ferrus Manus" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-x-7-x-ferrus-manus-the-gorgon-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">7</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">7</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">7</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">6</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">1+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-x-7-x-ferrus-manus-the-gorgon-source" hidden="false"><ns0:description>Primarch of the Iron Hands, the Gorgon of Medusa, Lord of the X Legion
Ferrus Manus was among the strongest and most relentless of the Emperor’s sons, a warrior shaped by the brutal world of Medusa and possessed of an uncompromising belief in strength through adversity. His hands, sheathed in mysterious living metal, were capable of crushing armour and reshaping metal with equal ease, while his mastery of the forge rivalled his prowess upon the battlefield.
At the head of the Iron Hands, Ferrus waged war as an exercise in overwhelming strength and technological superiority. Encased within the formidable Medusan Carapace and surrounded by the engines of the X Legion, the Gorgon advanced through enemy fire with implacable certainty, repairing damaged war machines even as he tore apart those foolish enough to stand before him.
Ferrus Manus | 7 | 7 | 7 | 7 | 6 | 5 | 4 | 10 | 1+
Force Organisation:
• Lord of War
Unit Composition:
• 1 Ferrus Manus
Unit Type:
• Infantry (Character)
Wargear:
• Medusan Carapace
• Forgebreaker
• Living Metal Hands
• Frag Grenades
Special Rules:
• Primarch
• Legiones Astartes (Iron Hands)
• The Gorgon
• Master of the Forge
• Forged for War
MEDUSAN CARAPACE A towering suit of artificer-wrought armour constructed to withstand the punishment of the fiercest battlefields, the Medusan Carapace incorporated an arsenal of weapons and command systems befitting the master of the X Legion. The Medusan Carapace counts as Primarch Armour. It incorporates the following: • Twin-linked Meltagun • Twin-linked Plasma Gun • Heavy Flamer • Cortex Controller • Nuncio Vox Ferrus Manus may fire up to two of the weapons incorporated into the Medusan Carapace during each Shooting phase. The Cortex Controller and Nuncio Vox use their normal rules. MEDUSAN CARAPACE WEAPONS Weapon Range S AP Type Twin-linked Meltagun 12" 8 1 Assault 1, Melta, Twin-linked Twin-linked Plasma Gun 24" 7 2 Rapid Fire, Gets Hot, Twin-linked Heavy Flamer Template 5 4 Assault 1 FORGEBREAKER Forged by Ferrus Manus himself, Forgebreaker was a weapon of immense destructive power, capable of crushing the strongest armour beneath the blows of a Primarch. Forgebreaker is a Master-crafted Thunder Hammer with the Armourbane special rule. LIVING METAL HANDS The hands of Ferrus Manus were sheathed in an unknown metallic substance of extraordinary strength, capable of tearing through armour or reshaping metal beneath his grasp. Ferrus Manus may choose to fight with his Living Metal Hands instead of Forgebreaker. Attacks made with his Living Metal Hands count as Power Weapon attacks and are resolved at Strength 8. THE GORGON Ferrus Manus possessed a constitution exceptional even amongst the Primarchs, enduring wounds that would have destroyed lesser beings without breaking stride. Ferrus Manus has Feel No Pain (5+). MASTER OF THE FORGE Few living beings possessed Ferrus Manus’ understanding of metallurgy, machinery and the engines of war. Ferrus Manus has Battlesmith and succeeds on a roll of 3+. He may use this ability to repair friendly Vehicles, Dreadnoughts and Battle-Automata as appropriate. FORGED FOR WAR Under the personal supervision of the Gorgon, the war machines of the Iron Hands were reinforced and modified far beyond their standard specifications. After both armies have been selected but before deployment, nominate one friendly Iron Hands Vehicle or Dreadnought which is not a Lord of War. That model gains +1 Structure Point for the duration of the battle. If the selected model does not normally use Structure Points, determine its normal Structure Point value using the standard ProHammer rules before applying this bonus. PRIMARCH RETINUE Ferrus Manus may select any one of the following as his Primarch Retinue: • Legion Honour Guard Squad • Legion Terminator Command Squad • Morlock Terminator Squad A retinue selected in this manner does not occupy an additional Force Organisation selection and otherwise follows the normal Primarch Retinue rules.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="RAMPAGER SQUAD" hidden="false" id="r41-unit-xii-0-rampager-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="110" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xii-0-rampager-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Rampager" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xii-0-rampager-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Rampager Champion" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xii-0-rampager-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xii-0-rampager-squad-source" hidden="false"><ns0:description>Rampager | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Rampager Champion | 4 | 4 | 4 | 4 | 1 | 4 | 3 | 9 | 3+
Force Organisation:
• Elites
CAEDERE WEAPONS Caedere Weapons represent the many gladiatorial blades, axes, hooks and other fighting weapons employed by the XII Legion. For the purposes of these rules, a Caedere Weapon counts as a Rending Weapon.
Unit Composition:
• 4 Rampagers
• 1 Rampager Champion
Unit Type:
• Infantry
• The Rampager Champion is a Character
Wargear:
• Power Armour
• Bolt pistol
• Chainaxe
Special Rules:
• Legiones Astartes (World Eaters)
OPTIONS
• The squad may include up to five additional Rampagers for +22 points per model.
• Up to three Rampagers may replace their Chainaxe with:
• Caedere Weapon ................................. +3 points
• Power weapon ................................... +7 points
• If the squad numbers ten models, up to six Rampagers may make one of the above exchanges.
• Up to three Rampagers may replace their Bolt pistol with:
• Plasma pistol ................................. +10 points
• If the squad numbers ten models, up to six Rampagers may make this exchange.
• The entire squad may take:
• Frag grenades ............................ +1 point per model
• Krak grenades ........................... +2 points per model
• Jump Packs .............................. +15 points per model
If equipped with Jump Packs, the unit becomes Jump Infantry and may not select a Dedicated Transport.
RAMPAGER CHAMPION
The Rampager Champion may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xii-0-rampager-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xii-0-rampager-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="22" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xii-0-rampager-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +22 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xii-0-rampager-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Caedere Weapon" hidden="false" id="r41-unit-xii-0-rampager-squad-opt-0-caedere-weapon"><ns0:constraints><ns0:constraint id="r41-unit-xii-0-rampager-squad-opt-0-caedere-weapon-max" field="selections" scope="parent" value="3" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="3" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xii-0-rampager-squad-opt-0-context" hidden="false"><ns0:description>• Up to three Rampagers may replace their Chainaxe with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r41-unit-xii-0-rampager-squad-opt-1-power-weapon"><ns0:constraints><ns
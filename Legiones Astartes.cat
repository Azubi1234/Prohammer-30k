    <ns0:selectionEntry type="unit" import="true" name="Legion Reconnaissance Squad" hidden="false" id="recon-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="recon-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="recon-standard-wargear" hidden="false">
          <ns0:description>Every model is equipped with Recon Armour, a Bolter, a Bolt Pistol and Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="recon-legiones" hidden="false">
          <ns0:description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Support Squad" id="recon-support-squad" hidden="false">
          <ns0:description>This unit may be selected as a Troops choice, but may not fulfil either of the army' two compulsory Troops selections unless a Legion-specific rule or Rite of War removes this restriction.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Scout" id="recon-scout" hidden="false">
          <ns0:description>Uses the normal Scout rule from ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Infiltrate" id="recon-infiltrate" hidden="false">
          <ns0:description>Uses the normal Infiltrate rule from ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Move Through Cover" id="recon-mtc" hidden="false">
          <ns0:description>Uses the normal Move Through Cover rule from ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Acute Senses" id="recon-acute-senses" hidden="false">
          <ns0:description>Uses the normal Acute Senses rule from ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="recon-frag" hidden="false">
          <ns0:description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Recon Armour" hidden="false" id="recon-standard-armour" type="selectionEntry" targetId="gear-recon-armour" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-armour-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Bolter" hidden="false" id="recon-standard-bolter" type="selectionEntry" targetId="gear-bolter" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bolter-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Bolt Pistol" hidden="false" id="recon-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="recon-standard-bp-min" includeChildSelections="false" automatic="true" />

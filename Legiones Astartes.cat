          <ns0:rules>
            <ns0:rule name="Hunter-Killer Missile" id="hs-venator-hunter-killer-missile-rule" hidden="false">
              <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="hs-venator-dozer-blade" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="hs-venator-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>

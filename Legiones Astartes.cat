            <ns0:entryLink import="true" name="Hand Flamer (replaces Bolt Pistol)" hidden="false" id="r40-da-storm-assault-assault-ex-handflamer" type="selectionEntry" targetId="gear-hand-flamer">
              <ns0:constraints>
                <ns0:constraint type="max" value="4" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-ex-handflamer-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>

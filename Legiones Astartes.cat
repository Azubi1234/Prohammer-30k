            <entryLink import="true" name="Power Weapon (replaces Chainsword)" hidden="false" id="assault-ex-power" type="selectionEntry" targetId="gear-power-weapon"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="assault-ex-power-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>

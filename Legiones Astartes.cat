          <ns0:constraints>
            <ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-tactical-da-wing-hq-centurion-r40-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-tactical-da-wing-hq-centurion-r40-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints>

                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher - Shatter" id="rapier-shatter-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Sunder</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Sunder" id="rapier-sunder-rule" hidden="false">
                  <ns0:description>May re-roll failed Armour Penetration rolls against vehicles.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Splinter Shells (+10 pts per Rapier)" hidden="false" id="rapier-ammo-splinter">
              <ns0:constraints>
                <ns0:constraint id="rapier-ammo-splinter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="increment" value="10" field="pts">
                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher - Splinter" id="rapier-splinter-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12-36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">2</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Rending</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Phosphex Canister Shot (+20 pts per Rapier) — requires Siege Breaker/permission" hidden="false" id="rapier-ammo-phosphex">
              <ns0:constraints>
                <ns0:constraint id="rapier-ammo-phosphex-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="increment" value="20" field="pts">
                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="rapier-carrier" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:profiles>
                <ns0:profile name="Quad Launcher - Phosphex" id="rapier-phosphex-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12-36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Poisoned (3+), Crawling Fire, Lingering Death</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
              <ns0:rules>
                <ns0:rule name="Restriction" id="rapier-phosphex-restrict" hidden="false">
                  <ns0:description>May only be selected if the Detachment includes a Siege Breaker or another model whose rules specifically permit access to Phosphex ammunition. This requirement must be satisfied elsewhere in the roster.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Lingering Death" id="rapier-phosphex-linger" hidden="false">
                  <ns0:description>After resolving the attack, leave the Blast marker in place. For the remainder of the battle, the area beneath the marker counts as Dangerous Terrain for non-vehicle models and Open-topped vehicles.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-rapier-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-rapier-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-rapier-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-rapier-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-rapier-unit-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-rapier-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-rapier-unit-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-rapier-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-rapier-unit-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-rapier-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-rapier-unit-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-rapier-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-rapier-unit-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-rapier-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-rapier-unit-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-rapier-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-rapier-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Legion Seeker Squad" hidden="false" id="fa-seeker" import="true">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-fast" id="fa-seeker-cat" primary="true" name="Fast Attack" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="155" />
      </ns0:costs>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" name="Legion Seekers (included)" hidden="false" id="fa-seeker-included" import="true" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="fa-seeker-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="fa-seeker-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Seekers (included)" id="fa-seeker-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic>

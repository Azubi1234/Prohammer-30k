issident" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-2-contekar-terminator-elite-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-viii-2-contekar-terminator-elite-source" hidden="false"><ns0:description>Contekar | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 2+/5+
Contekar Dissident | 5 | 4 | 4 | 4 | 1 | 4 | 3 | 9 | 2+/5+
NOSTRAMAN CHAINBLADE A Nostraman Chainblade is a Two-Handed Rending Weapon which grants +1 Strength. ESCATON POWER CLAW An Escaton Power Claw counts as a Power Fist. In addition, the wielder may re-roll failed To Wound rolls made with the Escaton Power Claw.
Force Organisation:
• Elites
Unit Composition:
• 4 Contekar
• 1 Contekar Dissident
Unit Type:
• Infantry
• The Contekar Dissident is a Character
Wargear:
• Tartaros Terminator Armour
• Heavy Flamer
• Nostraman Chainblade
Special Rules:
• Legiones Astartes (Night Lords)
• Stubborn
OPTIONS
• The squad may include up to five additional Contekar for +50 points per model.
• Every model may replace their Heavy Flamer with:
• Volkite Culverin ........................... +10 points
• Up to two models may replace their Nostraman Chainblade with:
• Escaton Power Claw ........................... +10 points
• The Contekar Dissident may take:
• Grenade Harness .............................. +10 points
DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod or
Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-viii-2-contekar-terminator-elite-additional"><ns0:constraints><ns0:constraint id="r41-unit-viii-2-contekar-terminator-elite-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-viii-2-contekar-terminator-elite-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +50 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-viii-2-contekar-terminator-elite-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Volkite Culverin" hidden="false" id="r41-unit-viii-2-contekar-terminator-elite-opt-0-volkite-culverin"><ns0:constraints><ns0:constraint id="r41-unit-viii-2-contekar-terminator-elite-opt-0-volkite-culverin-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-viii-2-contekar-terminator-elite-opt-0-context" hidden="false"><ns0:description>• Every model may replace their Heavy Flamer with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Escaton Power Claw" hidden="false" id="r41-unit-viii-2-contekar-terminator-elite-opt-1-e
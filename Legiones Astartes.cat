            </ns0:entryLink>
            <ns0:entryLink name="Heavy Flamer" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p7" type="selectionEntry" targetId="gear-heavy-flamer" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Multi-Melta" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p8" type="selectionEntry" targetId="gear-multimelta" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink name="Havoc Launcher" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p9" type="selectionEntry" targetId="gear-havoc" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-0">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-1">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-2">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-3">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-4">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-5">
              <ns0:constraints>
                <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r40-da-steel-transport-recon-unit-hs-spartan-da-wing-hs-spartan-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-steel-transport-recon-unit-hs-spartan-r40-da-ammo-hs-spartan" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-steel-transport-recon-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-r40-da-ammo-hs-spartan-hs-spartan-p6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-p6" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="upgrade" name="Hunter-Killer Missile" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-hunter-killer-missile" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Hunter-Killer Missile" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-hunter-killer-missile-rule" hidden="false">
              <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-dozer-blade" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="5" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Dozer Blade" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-dozer-blade-rule" hidden="false">
              <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-auxiliary-drive" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
              <ns0:description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Frag Assault Launchers" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Frag Assault Launchers" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
              <ns0:description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Armoured Ceramite" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-armoured-ceramite-rule" hidden="false">
              <ns0:description>Melta weapons do not gain an additional Armour Penetration die against this vehicle.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Flare Shield" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-flare-shield" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="45" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Flare Shield" id="r40-da-steel-transport-recon-unit-hs-spartan-hs-spartan-flare-shield-rule" hidden="false">
              <ns0:description>Against shooting attacks striking the Front Armour, reduce the Strength of Blast and Template weapons by 2 and all other ranged attacks by 1. No effect in close combat.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
    </ns0:selectionEntry>
    </ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="false" id="veteran-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-elites" id="veteran-unit-cat" primary="true" name="Elites" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="veteran-standard" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="veteran-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Veteran Tactics" id="veteran-tactics-rule" hidden="false">
          <ns0:description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="veteran-transport-rule" hidden="false">
          <ns0:description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Veterans (included)" hidden="false" id="veteran-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="veteran-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veterans (included)" id="veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="veteran-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veteran Sergeant" id="veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Additional Legion Veteran" hidden="false" id="veteran-additional">
          <ns0:constraints>
            <ns0:constraint id="veteran-additional-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Additional Legion Veteran" id="veteran-additional-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>

          <ns0:description>Power Armour; Legion Scimitar Jetbike with Heavy Bolter; Bolt Pistol; Chainsword; Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes &amp; Deep Strike" id="fa-sky-la" hidden="false">
          <ns0:description>Legiones Astartes and Deep Strike. The unit also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</ns0:description>
        </ns0:rule>
      </ns0:rules>

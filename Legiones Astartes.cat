              <ns0:entryLink id="r39-phosphex-r35-destroyer-troops-destroyer-sgt-armoury" name="Phosphex Bomb (Destroyer Company)" type="selectionEntry" targetId="gear-phosphex-bomb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r39-phosphex-r35-destroyer-troops-destroyer-sgt-armoury-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-destroyer" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
              <ns0:rules>
                <ns0:rule name="Sergeant Armoury Restrictions" id="r35-destroyer-troops-destroyer-sgt-arm-rule" hidden="false">
                  <ns0:description>Unit-specific Chainsword replacements and standard equipment are not duplicated here. No item may be selected more than once unless specifically permitted. A Pair of Lightning Claws counts as two weapon choices. Artificer Armour is not present in the current Destroyer Sergeant entry and is therefore not offered.</ns0:description>
                </ns0:rule>

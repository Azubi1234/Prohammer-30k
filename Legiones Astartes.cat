    <selectionEntry type="unit" name="Legion Praetor" id="hq-praetor" hidden="false" import="true">
      <constraints>
        <constraint id="hq-praetor-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
      </constraints>
      <costs>
        <cost name="Points" typeId="pts" value="125" />
      </costs>
      <categoryLinks>
        <categoryLink targetId="cat-hq" id="hq-praetor-foc-cat" primary="true" name="HQ" hidden="false" />
      </categoryLinks>
      <profiles>
        <profile name="Legion Praetor" id="hq-praetor-prof" typeId="prof-model" typeName="Model" hidden="false">
          <characteristics>
            <characteristic name="WS" typeId="model-ws">6</characteristic>
            <characteristic name="BS" typeId="model-bs">5</characteristic>
            <characteristic name="S" typeId="model-s">4</characteristic>
            <characteristic name="T" typeId="model-t">4</characteristic>
            <characteristic name="W" typeId="model-w">3</characteristic>
            <characteristic name="I" typeId="model-i">5</characteristic>
            <characteristic name="A" typeId="model-a">3</characteristic>
            <characteristic name="Ld" typeId="model-ld">10</characteristic>
            <characteristic name="Sv" typeId="model-sv">3+ / 4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Standard Wargear" id="hq-praetor-std" hidden="false">
          <description>Power Armour, Bolt Pistol, Chainsword, Frag Grenades and Iron Halo. The Iron Halo grants a 4+ Invulnerable Save and is already included in the 125-point cost.</description>
        </rule>
        <rule name="Legiones Astartes" id="hq-praetor-la" hidden="false">
          <description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.</description>
        </rule>
        <rule name="Independent Character" id="hq-praetor-ic" hidden="false">
          <description>Follows the Independent Character rules in ProHammer Classic.</description>
        </rule>
        <rule name="Frag Grenades" id="hq-praetor-frag" hidden="false">
          <description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Master of the Legion" id="hq-praetor-motl" hidden="false">
          <description>A Detachment containing a model with this rule may select one Rite of War for which it qualifies. An army may include no more than one model with Master of the Legion for every full 1,000 points. A model with this rule may select an eligible retinue as described by its entry.</description>
        </rule>
        <rule name="Space Marine Armoury" id="hq-praetor-armoury-rule" hidden="false">
          <description>The Praetor may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply.</description>
        </rule>
      </rules>
      <entryLinks>
        <entryLink import="true" name="Bolt Pistol" id="hq-praetor-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
          <constraints>
            <constraint id="hq-praetor-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="hq-praetor-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </constraints>
        </entryLink>
        <entryLink import="true" name="Chainsword" id="hq-praetor-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">

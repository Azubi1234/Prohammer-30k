          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Auxiliary Drive" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-auxiliary-drive-rule" hidden="false">
              <ns0:description>At the start of the controlling player's Movement phase, if Immobilised, on a 4+ remove one Immobilised result.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Frag Assault Launchers" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-frag-assault-launchers" hidden="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-frag-assault-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="10" />
          </ns0:costs>
          <ns0:rules>
            <ns0:rule name="Frag Assault Launchers" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-frag-assault-launchers-rule" hidden="false">
              <ns0:description>Passengers charging during the same turn they disembark count as equipped with Frag Grenades for that Assault phase.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="r40-da-steel-transport-fa-seeker-hs-spartan-hs-spartan-armoured-ceramite" hidden="false" import="true">
          <ns0:constraints>

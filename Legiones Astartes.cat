                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-hunter-killer-missile-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-hunter-killer-missile-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-hunter-killer-missile-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Hunter-Killer Missile" id="r35-breakthrough-predator-hs-pred-up-hunter-killer-missile-rule" hidden="false">
                  <ns0:description>Unlimited range, S8 AP3, Heavy 1, One Use.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Dozer Blade" id="r35-breakthrough-predator-hs-pred-up-dozer-blade" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-dozer-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-dozer-blade-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-dozer-blade-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Dozer Blade" id="r35-breakthrough-predator-hs-pred-up-dozer-blade-rule" hidden="false">
                  <ns0:description>Use the normal ProHammer Dozer Blade rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Extra Armour" id="r35-breakthrough-predator-hs-pred-up-extra-armour" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-extra-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-extra-armour-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-extra-armour-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Extra Armour" id="r35-breakthrough-predator-hs-pred-up-extra-armour-rule" hidden="false">
                  <ns0:description>Use the normal ProHammer Extra Armour rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Auxiliary Drive" id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-auxiliary-drive-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-auxiliary-drive-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Auxiliary Drive" id="r35-breakthrough-predator-hs-pred-up-auxiliary-drive-rule" hidden="false">
                  <ns0:description>At the start of the controlling player's Movement phase, if the vehicle is Immobilised, roll a D6. On a 4+, remove one Immobilised result; it may move normally that phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Armoured Ceramite" id="r35-breakthrough-predator-hs-pred-up-armoured-ceramite" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-armoured-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-armoured-ceramite-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-armoured-ceramite-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Armoured Ceramite" id="r35-breakthrough-predator-hs-pred-up-armoured-ceramite-rule" hidden="false">
                  <ns0:description>Melta weapons do not receive their additional Armour Penetration die against this vehicle, regardless of range.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Power of the Machine Spirit" id="r35-breakthrough-predator-hs-pred-up-power-of-the-machine-spirit" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-hs-pred-up-power-of-the-machine-spirit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>
                <ns0:modifier type="set" value="2" field="hs-pred-up-power-of-the-machine-spirit-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="2" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
                <ns0:modifier type="set" value="3" field="hs-pred-up-power-of-the-machine-spirit-max">
                  <ns0:conditions>
                    <ns0:condition type="atLeast" value="3" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-predator-model" shared="true" includeChildSelections="true" />
                  </ns0:conditions>
                </ns0:modifier>
              </ns0:modifiers>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Power of the Machine Spirit" id="r35-breakthrough-predator-hs-pred-up-power-of-the-machine-spirit-rule" hidden="false">
                  <ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-hs-predator-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-0">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r35-breakthrough-predator-da-wing-hs-predator-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-1">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r35-breakthrough-predator-da-wing-hs-predator-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-2">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r35-breakthrough-predator-da-wing-hs-predator-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-3">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r35-breakthrough-predator-da-wing-hs-predator-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-4">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r35-breakthrough-predator-da-wing-hs-predator-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-breakthrough-predator-da-wing-hs-predator-5">
              <ns0:constraints>
                <ns0:constraint id="r35-breakthrough-predator-da-wing-hs-predator-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r35-breakthrough-predator-da-wing-hs-predator-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-ammo-r35-breakthrough-predator-hs-predator" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-ammo-r35-breakthrough-predator-hs-predator-r35-breakthrough-predator-hs-pred-sp-0" name="Molecular Acid Shells (for Heavy Bolter Sponsons)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-r35-breakthrough-predator-hs-predator-r35-breakthrough-predator-hs-pred-sp-0-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-pred-sp-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r40-da-ammo-r35-breakthrough-predator-hs-predator-r35-breakthrough-predator-hs-pred-p6" name="Molecular Acid Shells (for Heavy Bolter)" type="selectionEntry" targetId="da22-acid-hb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-r35-breakthrough-predator-hs-predator-r35-breakthrough-predator-hs-pred-p6-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="7" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-breakthrough-predator-hs-pred-p6" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-breakthrough" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:entryLinks><ns0:entryLink id="r40-da-forward-r35-breakthrough-predator-hs-predator" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-r35-breakthrough-predator-hs-predator-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-breakthrough-predator-da-wing-hs-predator-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Destroyer Squad" hidden="true" id="r35-destroyer-troops-destroyer-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="r35-destroyer-troops-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r35-destroyer-troops-destroyer-standard" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, two Bolt Pistols, a Chainsword, Frag Grenades and Rad Grenades unless replaced by an option below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r35-destroyer-troops-destroyer-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Counter-Attack" id="r35-destroyer-troops-destroyer-counter" hidden="false">
          <ns0:description>The squad has Counter-Attack using the normal ProHammer rules.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dual Pistols" id="r35-destroyer-troops-destroyer-dual" hidden="false">
          <ns0:description>A model with this rule may fire both of its Pistol weapons during the Shooting phase. Both pistols must be fired at the same target. If it fires both pistols, it may not fire another weapon during that Shooting phase.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Destroyer Cadre" id="r35-destroyer-troops-destroyer-cadre" hidden="false">
          <ns0:description>A Legion Destroyer Squad may only be joined by an Independent Character with the Legion Moritat Consul upgrade. No other Independent Character may join the squad.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Rad Grenades" id="r35-destroyer-troops-destroyer-rad" hidden="false">
          <ns0:description>During any player turn in which the unit charges or is itself charged, enemy non-vehicle models engaged with it suffer -1 Toughness until the end of the Assault phase. This affects Instant Death and is not cumulative.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r35-destroyer-troops-destroyer-transport-rule" hidden="false">
          <ns0:description>Without Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Rite of War Selection" id="r35-destroyer-troops-note" hidden="false"><ns0:description>This Troops entry is available while Legion Destroyer Company is selected.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Destroyers (included)" hidden="false" id="r35-destroyer-troops-destroyer-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="r35-destroyer-troops-destroyer-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />

                  <repeats>
                    <repeat value="1" repeats="1" field="selections" scope="root-entry" childId="breacher-marine" shared="true" roundUp="false" includeChildSelections="false" />
                  </repeats>
                </modifier>
              </modifiers>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Specialist Weapons (1 per 5 models)" id="breacher-specialists" hidden="false">
          <constraints>
            <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="breacher-specialists-max" includeChildSelections="true" />
          </constraints>
          <modifiers>
            <modifier type="set" value="3" field="breacher-specialists-max">

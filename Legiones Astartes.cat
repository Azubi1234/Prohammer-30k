              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-hs-heavy-support-squad-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>

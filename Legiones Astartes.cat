                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="5" />
                  </costs>
                </entryLink>
              </entryLinks>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Refractor Field" hidden="false" id="terminator-sgt-refractor">
                  <constraints>
                    <constraint id="terminator-sgt-refractor-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Refractor Field" id="terminator-sgt-refractor-rule" hidden="false">
                      <description>5+ Invulnerable Save. The bearer chooses which available save to use against each attack.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Iron Halo" hidden="false" id="terminator-sgt-halo">
                  <constraints>
                    <constraint id="terminator-sgt-halo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="25" />
                  </costs>
                  <rules>
                    <rule name="Iron Halo" id="terminator-sgt-halo-rule" hidden="false">
                      <description>4+ Invulnerable Save; normally no more than one Iron Halo may be selected in an army.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Master-crafted Weapon" hidden="false" id="terminator-sgt-mastercraft">
                  <constraints>
                    <constraint id="terminator-sgt-mastercraft-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Master-crafted Weapon" id="terminator-sgt-mastercraft-rule" hidden="false">
                      <description>Apply to one specific weapon; re-roll one failed To Hit roll with that weapon per player turn. Grenades and expendable equipment may not be Master-crafted.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Signum" hidden="false" id="terminator-sgt-signum">
                  <constraints>
                    <constraint id="terminator-sgt-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="terminator-sgt-signum-rule" hidden="false">
                      <description>Once per friendly Shooting phase, the unit may re-roll one failed shooting To Hit roll. A unit may benefit from only one Signum per Shooting phase.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
              <rules>
                <rule name="Terminator Armoury Restrictions" id="terminator-sgt-arm-rule" hidden="false">
                  <description>Only equipment permitted for a model wearing Terminator Armour is shown. Unit-specific weapon replacements and the Grenade Harness are not duplicated here. No item may be selected more than once unless specifically permitted.</description>
                </rule>
              </rules>
            </selectionEntryGroup>
          </selectionEntryGroups>

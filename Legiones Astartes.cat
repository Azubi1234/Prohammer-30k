          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-vow-veteran-da-wing-veteran-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r40-da-vow-veteran-da-wing-veteran-unit-1">
              <ns0:constraints>
                <ns0:constraint id="r40-da-vow-veteran-da-wing-veteran-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r40-da-vow-veteran-da-wing-veteran-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-vow-veteran-r40-da-ammo-veteran-unit" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-vow-veteran-r40-da-ammo-veteran-unit-veteran-sp-ml" name="Stasis Shells — Missile (for Missile Launcher with Suspensor Web (replaces Bolter))" type="selectionEntry" targetId="da22-stasis-missile" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-vow-veteran-r40-da-ammo-veteran-unit-veteran-sp-ml-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-vow-veteran-veteran-sp-ml" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup></ns0:selectionEntryGroups>
    <ns0:categoryLinks><ns0:categoryLink id="r40-da-vow-veteran-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-vow" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Terminator Squad" hidden="true" id="r40-da-vow-terminator">
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r40-da-vow-terminator-terminator-standard" hidden="false">
          <ns0:description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-vow-terminator-terminator-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Implacable Advance" id="r40-da-vow-terminator-terminator-implacable" hidden="false">
          <ns0:description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r40-da-vow-terminator-terminator-transport-rule" hidden="false">
          <ns0:description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-vow-terminator-rite-rule" name="The Hammer of Caliban" hidden="false"><ns0:description>Selected as a Troops choice by The Unbroken Vow. This Rite-specific copy is fixed to the Deathwing.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Terminators (included)" hidden="false" id="r40-da-vow-terminator-terminator-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="r40-da-vow-terminator-terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-vow-terminator-terminator-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Terminators (included)" id="r40-da-vow-terminator-terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="r40-da-vow-terminator-terminator-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r40-da-vow-terminator-terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-vow-terminator-terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />

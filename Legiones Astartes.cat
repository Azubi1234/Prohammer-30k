                    <ns0:cost name="Points" typeId="pts" value="30" />
                  </ns0:costs>
                </ns0:entryLink>
                <ns0:entryLink import="true" name="Close Combat Weapon" id="hq-praetor-sw-2" type="selectionEntry" targetId="gear-hq-ccw" hidden="false">
                  <ns0:constraints>
                    <ns0:constraint id="hq-praetor-sw-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />

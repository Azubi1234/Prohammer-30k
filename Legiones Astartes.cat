          </ns0:costs>
          <ns0:constraints>
            <ns0:constraint id="da22-int-krak-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
        </ns0:selectionEntry>

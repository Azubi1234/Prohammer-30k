                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Destroyer Sergeant" hidden="false" id="r40-da-eskaton-destroyer-destroyer-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r40-da-eskaton-destroyer-destroyer-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-eskaton-destroyer-destroyer-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>

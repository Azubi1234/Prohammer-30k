      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="fa-seeker-std" hidden="false">
          <ns0:description>Power Armour; Bolter; Bolt Pistol; Frag Grenades; Special Issue Ammunition.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="fa-seeker-la" hidden="false">
          <ns0:description>Legiones Astartes; also has And They Shall Know No Fear as presented in ProHammer Classic and is not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Infiltrate &amp; Move Through Cover" id="fa-seeker-move" hidden="false">
          <ns0:description>The squad has Infiltrate and Move Through Cover as defined in ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Marked for Death" id="fa-seeker-mark" hidden="false">
          <ns0:description>After deployment, nominate one enemy unit for each Legion Seeker Squad. Against its nominated target, the squad re-rolls To Hit rolls of 1 and To Wound rolls of 1; against vehicles it re-rolls Armour Penetration rolls of 1 instead of To Wound rolls. If the target is destroyed, no new target is selected.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Special Issue Ammunition" id="fa-seeker-ammo-rule" hidden="false">
          <ns0:description>Whenever the squad fires Bolters, Foeblaster Boltguns or the bolter component of Combi-weapons, choose one ammunition type for all eligible models: Dragonfire, Hellfire, Kraken or Vengeance. Use the profiles shown below.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:profiles>
        <ns0:profile name="Dragonfire Bolts" id="fa-seeker-ammo-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Ignores Cover</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Hellfire Bolts" id="fa-seeker-ammo-1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">X</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Poisoned (2+)</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Kraken Bolts" id="fa-seeker-ammo-2" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">30"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Vengeance Rounds" id="fa-seeker-ammo-3" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>

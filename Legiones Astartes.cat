        </ns0:rule>
        <ns0:rule name="Special Rules" id="da22-redloss-base" hidden="false">
          <ns0:description>Legiones Astartes (Dark Angels); Independent Character; Master of the Legion; Stubborn; Dreadwing.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Voted-Lieutenant of the Dreadwing" id="da22-redloss-voted" hidden="false">
          <ns0:description>Always Dreadwing. May select one Dreadwing Interemptor Squad as retinue; it occupies no separate Elites choice and Redloss may join it despite Bitter Duty. They count as one HQ selection.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Extermination Protocol" id="da22-redloss-exterm" hidden="false">
          <ns0:description>Once per battle at beginning of Dark Angels Shooting phase choose Redloss own unit or one friendly Dreadwing unit with a model within 12". Until phase end models in it re-roll To Wound rolls of 1 and Armour Penetration rolls of 1 with Flame, Plasma or Volkite weapons; second result accepted.</ns0:description>
        </ns0:rule>
      </ns0:rules>

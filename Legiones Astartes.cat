              </ns0:constraints>
              <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Land Raider Dedicated Transport (Armoured Spearhead)" id="r37-spear-techmarine-III-transport" hidden="true">
                      <ns0:constraints>
                        <ns0:constraint id="r37-spear-techmarine-III-transport-src-hq-praetor-ret-honour-land-lrgrp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
                      </ns0:constraints>

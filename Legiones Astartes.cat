 name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-5-numerologist-cabal-opt-9-context" hidden="false"><ns0:description>• For every five models in the Cabal, one Life Ward may replace</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="r41-unit-xv-5-numerologist-cabal-opt-10-legion-vexilla"><ns0:constraints><ns0:constraint id="r41-unit-xv-5-numerologist-cabal-opt-10-legion-vexilla-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-5-numerologist-cabal-opt-10-context" hidden="false"><ns0:description>• One Life Ward may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="r41-unit-xv-5-numerologist-cabal-opt-11-nuncio-vox"><ns0:constraints><ns0:constraint id="r41-unit-xv-5-numerologist-cabal-opt-11-nuncio-vox-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-5-numerologist-cabal-opt-11-context" hidden="false"><ns0:description>• One other Life Ward may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-5-numerologist-cabal-opt-12-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-5-numerologist-cabal-opt-12-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-5-numerologist-cabal-opt-12-context" hidden="false"><ns0:description>• The entire Cabal may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="AHZEK AHRIMAN" hidden="false" id="r41-unit-xv-6-ahzek-ahriman"><ns0:costs><ns0:cost name="Points" typeId="pts" value="210" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-6-ahzek-ahriman-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-6-ahzek-ahriman-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Ahzek Ahriman" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-6-ahzek-ahriman-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-6-ahzek-ahriman-source" hidden="false"><ns0:description>Ahzek Ahriman | 5 | 5 | 4 | 4 | 3 | 5 | 3 | 10 | 2+/4+
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Iron Halo
• Black Staff of Ahriman
• Bolt pistol
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Master of the Legion
• Psyker (Mastery Level 3\)
• Corvidae
• Chief Librarian
• Ahriman's Cabal
RESTRICTION
Ahriman may only be included in a Thousand Sons army of 1,500 points or more.
OPTIONS
• Ahriman may take:
• Krak grenades .................................. +2 points
CORVIDAE Ahriman always belongs to the Corvidae and may not select another Prosperine Cult. He receives both the Corvidae Cult Arcana and Cult Mastery benefits. CHIEF LIBRARIAN Ahriman knows every psychic power in the ProHammer Divination discipline. He does not randomly select or choose a limited number of Divination powers before the battle. Ahriman still follows the normal ProHammer restrictions governing how many psychic powers a Psyker may successfully invoke during a player turn. BLACK STAFF OF AHRIMAN The Black Staff is a Master-crafted Prosperine Force Weapon. Once during each player turn, Ahriman may re-roll one failed Psychic Test. The second result must be accepted. If the re-rolled Psychic Test also fails, Ahriman suffers Perils of the Warp in addition to any other normal consequences. Activating the Black Staff as a Force Weapon does not count as invoking a psychic power. AHRIMAN'S CABAL Ahriman may select one Legion Command Squad as his personal retinue. The squad does not occupy a separate Force Organisation slot. A Command Squad selected in this manner may purchase Ahriman's Cabal for +50 points. AHRIMAN'S CABAL A unit upgraded to Ahriman's Cabal: • becomes a Brotherhood of Psykers (Mastery Level 2); • is assigned to the Corvidae; • receives both the Corvidae Cult Arcana and Cult Mastery; • selects two psychic powers from the ProHammer Divination discipline. The Cabal remains a separate Psyker from Ahriman. Ahriman's Mastery Level, Leadership and psychic powers are not combined with those of the Brotherhood. Any model in Ahriman's Cabal permitted to purchase a Power Weapon may upgrade that Power Weapon to a Prosperine Force Weapon for +5 points. The Cabal follows the normal Psychic Brotherhood rules for activating Force Weapons.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-6-ahzek-ahriman-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-6-ahzek-ahriman-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-6-ahzek-ahriman-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-6-ahzek-ahriman-opt-0-context" hidden="false"><ns0:description>• Ahriman may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="PHOSIS T'KAR" hidden="false" id="r41-unit-xv-7-phosis-t-kar"><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-7-phosis-t-kar-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-7-phosis-t-kar-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Phosis T'Kar" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-7-phosis-t-kar-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-7-phosis-t-kar-source" hidden="false"><ns0:description>Phosis T'Kar | 5 | 5 | 4 | 4 | 2 | 5 | 3 | 10 | 3+/4+
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Power Armour
• Eldritch Force Field
• Prosperine Force Weapon
• Bolter
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Master of the Legion
• Psyker (Mastery Level 2\)
• Raptora
• Magister of the Raptora
OPTIONS
• Phosis may take:
• Krak grenades .................................. +2 points
RAPTORA Phosis always belongs to the Raptora and may not select another Prosperine Cult. He receives both the Raptora Cult Arcana and Cult Mastery benefits. MAGISTER OF THE RAPTORA Phosis selects both of his psychic powers from the ProHammer Telekinesis discipline. He otherwise follows all normal ProHammer rules for a Mastery Level 2 Psyker. ELDRITCH FORCE FIELD Phosis has a 4+ Invulnerable Save. Against shooting attacks, this is improved to a 3+ Invulnerable Save. While Phosis is joined to a friendly Thousand Sons Infantry unit, models in that unit receive a 5+ Invulnerable Save against both shooting and close-combat attacks. If a model already possesses an Invulnerable Save, improve it by one instead. An Invulnerable Save improved by this rule may never become better than: • 3+ against shooting attacks; • 4+ against close-combat attacks. This rule may combine with the normal Raptora Cult benefits, but the limits above may never be exceeded. COMMAND RETINUE Phosis may select one Legion Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-7-phosis-t-kar-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-7-phosis-t-kar-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-7-phosis-t-kar-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-7-phosis-t-kar-opt-0-context" hidden="false"><ns0:description>• Phosis may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="MAGISTUS AMON, THE HIDDEN" hidden="false" id="r41-unit-xv-8-magistus-amon-the-hidden"><ns0:costs><ns0:cost name="Points" typeId="pts" value="185" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-8-magistus-amon-the-hidden-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-8-magistus-amon-the-hidden-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Magistus Amon" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-8-magistus-amon-the-hidden-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-8-magistus-amon-the-hidden-source" hidden="false"><ns0:description>Magistus Amon | 5 | 5 | 4 | 4 | 2 | 5 | 3 | 10 | 2+
Force Organisation:
• HQUnit Type:
• Infantry (Character)
Wargear:
• Armour of Shades
• Prosperine Force Weapon
• Bolt pistol
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Master of the Legion
• Psyker (Mastery Level 2\)
• Athanaeans
• The Hidden One
RESTRICTION
Amon may only be included in a Thousand Sons army of 1,500 points or more.
OPTIONS
• Amon may take:
• Krak grenades .................................. +2 points
ATHANAEANS Amon always belongs to the Athanaeans and may not select another Prosperine Cult. He receives both the Athanaean Cult Arcana and Cult Mastery benefits. PSYCHIC POWERS Amon selects both of his psychic powers from the ProHammer Telepathy discipline. ARMOUR OF SHADES The Armour of Shades grants Amon a 2+ Armour Save. Amon receives a 5+ Cover Save even while in open ground. If Amon would normally receive a Cover Save from terrain or another rule, improve that Cover Save by two steps, to a maximum of 3+. THE HIDDEN ONE While Amon is joined to a friendly Thousand Sons Infantry unit, that unit receives the same protection as his Armour of Shades: • it receives a 5+ Cover Save while in open ground; • any existing Cover Save is improved by two steps, to a maximum of 3+. Amon and any Infantry unit he has joined also gain Infiltrate. This rule may not be conferred to: • models wearing any form of Terminator Armour; • Bikes; • Jetbikes; • Jump Infantry. MASTER OF THE HIDDEN ORDERS Instead of selecting a normal Legion Command Squad, Amon may select one of the following as his personal retinue: • Ammitara Occult Intercession Cabal • Legion Seeker Squad The selected unit does not occupy a separate Force Organisation slot. Amon and the selected unit count as a single HQ selection.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-8-magistus-amon-the-hidden-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-8-magistus-amon-the-hidden-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-8-magistus-amon-the-hidden-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-8-magistus-amon-the-hidden-opt-0-context" hidden="false"><ns0:description>• Amon may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="HATHOR MAAT" hidden="false" id="r41-unit-xv-9-hathor-maat"><ns0:costs><ns0:cost name="Points" typeId="pts" value="190" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-9-hathor-maat-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-9-hathor-maat-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Hathor Maat" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-9-hathor-maat-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-9-hathor-maat-source" hidden="false"><ns0:description>Hathor Maat | 5 | 5 | 4 | 4 | 3 | 5 | 3 | 10 | 2+/5+
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Aetheric Refractor Field
• Prosperine Force Weapon
• Bolt pistol
• Narthecium
• Reductor
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Master of the Legion
• Psyker (Mastery Level 2\)
• Pavoni
• Magister Templi of the Pavoni
• Pavoni Vitalist
OPTIONS
• Hathor Maat may take:
• Krak grenades .................................. +2 points
PAVONI Hathor Maat always belongs to the Pavoni and may not select another Prosperine Cult. He receives both the Pavoni Cult Arcana and Cult Mastery benefits. MAGISTER TEMPLI OF THE PAVONI Hathor Maat selects both of his psychic powers from the ProHammer Biomancy discipline. He otherwise follows all normal ProHammer rules for a Mastery Level 2 Psyker. AETHERIC REFRACTOR FIELD Hathor Maat has a 4+ Invulnerable Save. This is already included in his profile. PAVONI VITALIST Hathor Maat has Feel No Pain (5+). While Hathor Maat is joined to a friendly Thousand Sons Infantry unit, that unit also gains Feel No Pain (5+). If a model already has Feel No Pain, improve its existing roll by one step instead, to a maximum of 4+. The unit loses this benefit immediately if Hathor leaves the unit or is slain. NARTHECIUM Hathor Maat additionally uses the normal Narthecium rules from the Legiones Astartes Army List. COMMAND RETINUE Hathor Maat may select one Legion Command Squad as his retinue. The squad does not occupy a separate Force Organisation slot.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-9-hathor-maat-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-9-hathor-maat-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-9-hathor-maat-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-9-hathor-maat-opt-0-context" hidden="false"><ns0:description>• Hathor Maat may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="SANAKHT" hidden="false" id="r41-unit-xv-10-sanakht"><ns0:costs><ns0:cost name="Points" typeId="pts" value="195" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-10-sanakht-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-10-sanakht-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Sanakht" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-10-sanakht-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">6</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-10-sanakht-source" hidden="false"><ns0:description>Sanakht | 7 | 5 | 4 | 4 | 3 | 6 | 4 | 10 | 2+/5+
Force Organisation:
• HQ
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Refractor Field
• Paired Prosperine Force Blades
• Frag grenades
Special Rules:
• Legiones Astartes (Thousand Sons)
• Independent Character
• Psyker (Mastery Level 1\)
• Athanaeans
• Blademaster of Prospero
• Mindsong of Blades
OPTIONS
• Sanakht may take:
• Krak grenades .................................. +2 points
ATHANAEANS Sanakht always belongs to the Athanaeans and may not select another Prosperine Cult. He receives both the Athanaean Cult Arcana and Cult Mastery benefits. PSYCHIC POWERS Sanakht knows only Mindsong of Blades. He does not select a psychic power from the normal ProHammer Psychic Disciplines. MINDSong OF BLADES Mindsong of Blades is a Blessing invoked at the beginning of an Assault phase. If successfully invoked, until the end of that Assault phase: • models in Sanakht's unit gain +1 Initiative; • models in the unit may re-roll close-combat To Hit rolls of 1. PAIRED PROSPERINE FORCE BLADES Sanakht's blades count as a pair of Prosperine Force Weapons. The bonus Attack for fighting with two close-combat weapons is already included in his profile. Activating his Force Weapons does not count as invoking a psychic power. BLADEMASTER OF PROSPERO Sanakht may re-roll one failed To Hit roll and one failed To Wound roll during each Assault phase. A dice may never be re-rolled more than once. KHENETAI RETINUE Sanakht may select one Khenetai Occult Blade Cabal as his personal retinue. The Cabal does not occupy a separate Force Organisation slot. Sanakht and the Cabal count as a single HQ selection.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xv-10-sanakht-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xv-10-sanakht-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xv-10-sanakht-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xv-10-sanakht-opt-0-context" hidden="false"><ns0:description>• Sanakht may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="XV — MAGNUS THE RED, THE CRIMSON KING" hidden="false" id="r41-unit-xv-11-xv-magnus-the-red-the-crimson-king"><ns0:costs><ns0:cost name="Points" typeId="pts" value="550" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-cat" name="Lords of War" hidden="false" targetId="cat-low" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Magnus the Red" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">7</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">7</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">7</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">7</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">6</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">1+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-11-xv-magnus-the-red-the-crimson-king-source" hidden="false"><ns0:description>Primarch of the Thousand Sons, the Crimson King, Lord of Prospero
Magnus the Red was the most psychically gifted of the Emperor’s sons, a towering scholar-warrior whose understanding of the immaterium exceeded that of all but the greatest minds of the Imperium. Upon Prospero he gathered philosophers, occultists and psykers into a civilisation devoted to knowledge, while the Thousand Sons themselves became masters of disciplines that other Legions regarded with suspicion and fear.
Upon the battlefield Magnus wielded sorcery as naturally as another warrior might wield a blade. He shattered armour with raw aetheric force, twisted the paths of fate, shielded his sons behind impossible barriers and reached into the minds of his enemies. Where lesser psykers risked being overwhelmed by the turbulence of the Warp, the presence of the Crimson King seemed instead to force that turbulence into obedience.
Magnus the Red | 7 | 7 | 7 | 7 | 7 | 6 | 4 | 10 | 1+
Force Organisation:
• Lord of War
Unit Composition:
• 1 Magnus the Red
Unit Type:
• Infantry (Character)
Wargear:
• Horned Raiment
• Blade of Ahn-Nunurta
• Arcane Litanies
Special Rules:
• Primarch
• Legiones Astartes (Thousand Sons)
• Psyker (Mastery Level 4\)
• Lord of the Ether
• The Crimson King
• The Warp Bends to Magnus
• Sorcerous Duellist
HORNED RAIMENT The war-plate of the Crimson King was as much an artefact of sorcery as of the artificer’s craft, surrounded by kine shields, illusions and shifting aetheric wards which distorted the form of Magnus and those who fought at his side. The Horned Raiment counts as Primarch Armour. When an enemy unit makes shooting attacks against Magnus or a unit he has joined, all To Hit rolls made as part of that attack suffer a -1 modifier. To Hit rolls made with Blast weapons suffer a -2 modifier instead. These modifiers have no effect in close combat. BLADE OF AHN-NUNURTA A weapon of ancient and esoteric provenance, the Blade of Ahn-Nunurta served as both a weapon of war and a focus through which Magnus could channel his immense psychic power. The Blade of Ahn-Nunurta is a Master-crafted, Two-Handed Force Weapon. It follows all normal ProHammer rules for Force Weapons. ARCANE LITANIES Inscribed upon the armour and wargear of the Crimson King were formulae, wards and occult geometries intended to protect their bearer against the dangers inherent in drawing upon the Warp. Once per battle, when Magnus suffers a Wound as a result of Perils of the Warp, he may ignore that Wound. The Psychic Test and psychic power are otherwise resolved normally. PSYKER — MASTERY LEVEL 4 Magnus the Red is a Psyker with Mastery Level 4. Before the battle, Magnus selects five psychic powers in total. These powers may be selected from the following disciplines: Biomancy, Divination, Pyromancy, Telekinesis and Telepathy. Magnus must select powers from at least two different psychic disciplines. He may not select all five powers from a single discipline. Infernal Phoenix and Strands of Fate are always known by Magnus and count towards his five psychic powers. Magnus otherwise follows all normal ProHammer rules for Psykers unless specifically stated otherwise. Magnus counts as belonging to all five Prosperine Cults for the purposes of army selection and other friendly abilities, but gains no Cult Arcana or Cult Mastery from them. PSYCHIC SUPREMACY Magnus may never have more than two Blessings affecting himself at the same time. If Magnus successfully invokes a Blessing upon himself while already affected by two Blessings, he must immediately choose one existing Blessing affecting him to end before the new power takes effect. This restriction does not limit Blessings affecting friendly units or Maledictions affecting enemy units. Magnus may never have more than two psychic powers with ongoing effects simultaneously affecting himself and/or the opposing Primarch. LORD OF THE ETHER Magnus may invoke up to four psychic powers during each player turn, overriding the normal ProHammer maximum of two. Magnus may invoke multiple Witchfire powers during the same Shooting phase, subject to his normal limit of four psychic powers. Magnus may not successfully invoke the same psychic power more than once during the same player turn. Activating the Blade of Ahn-Nunurta as a Force Weapon does not count against this limit. THE CRIMSON KING The psychic mastery of Magnus was such that even a faltering connection to the Warp could be seized and brought under control through sheer force of will. Magnus may re-roll one failed Psychic Test during each player turn. The second result must be accepted. Magnus may attempt to Deny the Witch against any psychic power if either the Psyker invoking the power or its target is within 24" of Magnus. Resolve the Deny the Witch attempt normally using Magnus' own Mastery Level. Each psychic power may still only be the subject of one Deny the Witch attempt, as normal. THE WARP BENDS TO MAGNUS Where lesser psykers struggled as the immaterium became increasingly disturbed, Magnus imposed his will upon the Warp with a power few beings could hope to equal. Magnus ignores all Leadership penalties caused by Disturbance in the Warp. In addition, psychic powers successfully invoked by Magnus are ignored when determining the penalties caused by Disturbance in the Warp for other friendly Psykers. Psychic powers successfully invoked by other friendly Psykers still contribute towards Disturbance in the Warp normally. Magnus may also attempt to deny the witch at 18” around him. INFERNAL PHOENIX Witchfire — Beam Magnus unleashes a torrent of incandescent aetheric fire, burning through flesh and armour as it tears across the battlefield. Range 24" | Strength 8 | AP1 | Melta Resolve Infernal Phoenix using the normal rules for Beam psychic powers. STRANDS OF FATE Malediction Magnus reaches into the skeins of possibility and twists them about his victim, turning every intended action into another path towards failure. Choose one enemy non-Vehicle unit within 18" and line of sight. Until the beginning of Magnus’ next turn, that unit must pass a Leadership Test each time it attempts to: • Move during the Movement phase; • Shoot during the Shooting phase; or • declare a Charge. If the test is failed, the attempted action is lost and the unit may not attempt that type of action again during that phase. A separate Leadership Test is required for each different action attempted. SORCEROUS DUELLIST Even when locked in single combat with one of his brother Primarchs, Magnus remained first and foremost a master of the immaterium. While Magnus is fighting a Primarch Duel, at the beginning of each Assault phase he may invoke one of the following: • a Blessing which targets only Magnus; or • a Malediction which targets only the opposing Primarch. This psychic power counts towards Magnus’ maximum allowance of four powers for that player turn. All normal Psychic Tests, Deny the Witch attempts and Perils of the Warp rules apply. PRIMARCH RETINUE Magnus the Red may select any one of the following as his Primarch Retinue: • Legion Honour Guard Squad • Legion Terminator Command Squad • Sekhmet Terminator Cabal A retinue selected in this manner does not occupy an additional Force Organisation selection and otherwise follows the normal Primarch Retinue rules. THE CRIMSON KING’S GUARD A Legion Honour Guard Squad or Legion Terminator Command Squad selected as Magnus’ Primarch Retinue may be upgraded to a Brotherhood of Psykers (Mastery Level 1\) for +25 points per squad. A squad upgraded in this manner is assigned to one Prosperine Cult and receives the normal Cult Arcana and Cult Mastery benefits of that Cult. The squad selects one psychic power from any of the normal psychic disciplines available to Thousand Sons Psykers and otherwise follows all normal rules for a Psychic Brotherhood.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="MAGNUS, SHARD OF THE CRIMSON KING" hidden="false" id="r41-unit-xv-12-magnus-shard-of-the-crimson-king"><ns0:costs><ns0:cost name="Points" typeId="pts" value="675" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xv-12-magnus-shard-of-the-crimson-king-cat" name="Lords of War" hidden="false" targetId="cat-low" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xv-12-magnus-shard-of-the-crimson-king-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Magnus, Shard of the Crimson King" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xv-12-magnus-shard-of-the-crimson-king-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">7</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">7</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">7</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">\</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">7\</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">6</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">5</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">–</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xv-12-magnus-shard-of-the-crimson-king-source" hidden="false"><ns0:description>A Fragment of the Crimson King
Magnus was shattered long before his final damnation was complete. Fragments of his soul were scattered throughout the Warp and across the material realm, each possessing only a portion of the Crimson King’s impossible power. Such a shard is less a creature than a psychic apparition — a thought given form, flickering between reality and unreality. Bullets pass through it, shells are cast aside by distortions in space and only weapons touched by the Warp can reliably harm it. Yet the manifestation is unstable, and the same psychic energies which empower it may at any moment tear it from reality entirely.
Magnus, Shard of the Crimson King | 7 | 7 | 7 | \ | 7\ | 6 | 5 | 10 | –
Force Organisation:
• Lord of War
Unit Composition:
• 1 Magnus, Shard of the Crimson King
Unit Type:
• Monstrous Creature (Character)
Wargear:
• Aetheric Blade
Special Rules:
• Fear
• Fearless
• Master of the Legion
• Psyker (Mastery Level 5\)
• Ethereal
• Incorporeal Will
• The Crimson King Unbound
• Beyond the Prosperine Cults
• Nothing to Bless
• Master of the Great Ocean
• Beyond the Perils of the Warp
• The Warp Breathes
• The Crimson King Shattered
RESTRICTIONS
Magnus, Shard of the Crimson King may only be selected for a Thousand Sons army. An army may not include both Magnus, Shard of the Crimson King and Magnus in his mortal form.
AETHERIC BLADE The Aetheric Blade is a Master-crafted Force Weapon. Magnus resolves attacks made with it at Strength 7. ETHEREAL Magnus is not truly a physical creature, but a fragment of psychic consciousness temporarily given form. Magnus possesses seven Wounds, but has no conventional Toughness characteristic and receives no Armour or Invulnerable Save. Shooting Non-psychic shooting attacks may only hit Magnus on an unmodified roll of 6. A successful hit may only wound Magnus on an unmodified roll of 6. Weapons which normally hit automatically still require a 6 to wound Magnus. Magnus receives no save against successful Wounds. Blast Weapons Non-psychic Blast weapons cannot directly strike Magnus. If Magnus would be beneath the template after scatter has been resolved, move the template directly away from Magnus by the minimum distance required for him to no longer be beneath it. Other models may still be hit normally. Close Combat Attack Type To Wound Normal close-combat weapon 6+ Power Weapon, Power Fist, Thunder Hammer or equivalent 5+ Force Weapon 2+ Magnus receives no save against successful Wounds. If a Force Weapon inflicts one or more Wounds upon Magnus, its wielder may attempt to activate the weapon normally. If successful, each Wound inflicted by that Force Weapon becomes a Massive Wound and inflicts D3 Wounds. Psychic Attacks Psychic shooting attacks and Wounds caused directly by psychic powers ignore the normal shooting restrictions of Ethereal. Whenever such an effect requires Magnus to possess a Toughness characteristic, treat him as Toughness 7 for that effect only. Magnus receives no save against resulting Wounds. Instant Death and Massive Wounds Magnus is immune to Instant Death. Massive Wounds affect Magnus normally only when caused by an activated Force Weapon or by a psychic effect which specifically inflicts Massive Wounds. Otherwise, an attack which would cause Instant Death or a Massive Wound simply inflicts one Wound. INCORPOREAL WILL Magnus may never declare a charge or make a Pursuit move. He may fight normally if charged and may Consolidate normally after combat. Magnus may never join another unit and no model may join him. THE CRIMSON KING UNBOUND Magnus is a Mastery Level 5 Psyker. Before deployment, choose six psychic powers for Magnus from any combination of the following disciplines: • Biomancy
• Divination
• Pyromancy
• Telekinesis
• Telepathy Magnus also always knows the following two unique powers: • Infernal Phoenix
• Strands of Fate These two powers do not count towards his six selected powers. Magnus may attempt to invoke up to five psychic powers during each player turn, specifically overriding the normal ProHammer maximum for Psykers.Magnus may successfully manifest each individual psychic power no more than once during the same player turn. Magnus may invoke up to two Witchfire powers during the same Shooting phase. INFERNAL PHOENIX Type: Witchfire, Beam Range S AP Special 24" 8 1 Melta Resolve Infernal Phoenix using the normal rules for a Beam psychic power. STRANDS OF FATE Type: Malediction
Range: 18" Choose one enemy non-Vehicle unit within range and line of sight. Until the beginning of Magnus’ next turn, the affected unit must pass a Leadership Test each time it wishes to: • Move
• Shoot
• Charge If the test is failed, that action is lost for that phase. BEYOND THE PROSPERINE CULTS Magnus is not assigned to a Prosperine Cult and gains no Cult Arcana or Cult Mastery benefit. He counts as belonging to the Thousand Sons for army selection and rules which refer to friendly Thousand Sons models. NOTHING TO BLESS Magnus may never be the target of a Blessing, whether manifested by himself or another Psyker. Any Blessing manifested by Magnus must target another eligible friendly unit. MASTER OF THE GREAT OCEAN Magnus ignores all Leadership penalties caused by Disturbance in the Warp. In addition, psychic powers successfully invoked by Magnus do not count when determining Disturbance in the Warp penalties for other Psykers. Magnus remains subject to all other rules concerning Psychic Tests and Perils of the Warp. Magnus may attempt to Deny the Witch against any psychic power if either the Psyker invoking the power or its target is within 24" of Magnus. Resolve the Deny the Witch attempt normally using Magnus' own Mastery Level. Each psychic power may still only be the subject of one Deny the Witch attempt, as normal. BEYOND THE PERILS OF THE WARP Whenever Magnus would suffer Perils of the Warp, ignore the normal Perils result. Magnus suffers no Wound or other effect. Instead, place one Instability Counter beside him. Each Instability Counter imposes a cumulative –1 modifier on Magnus’ next Warp Breath roll. After that Warp Breath roll has been resolved, remove all Instability Counters. There is no maximum number of Instability Counters. THE WARP BREATHES At the beginning of each Thousand Sons turn in which Magnus is on the battlefield, roll a D6 and apply any modifiers from Instability Counters. Modified Result Effect 1 or less The Crimson King Fades 2–5 Reality Holds 6+ The Warp Ascendant THE CRIMSON KING FADES Magnus immediately disappears from the battlefield and is placed in Reserve. He is not destroyed. Beginning on the following Thousand Sons turn, roll normally for Magnus to return from Reserve. When Magnus returns, he enters play using Deep Strike and scatters normally. Magnus may use psychic powers during the turn in which he returns. If Magnus remains in Reserve when the battle ends, he counts as destroyed for Victory Point purposes. This does not trigger The Crimson King Shattered. REALITY HOLDS No additional effect occurs. THE WARP ASCENDANT Until the beginning of the next Thousand Sons turn, every Psyker on the battlefield, friendly or enemy, may re-roll failed Psychic Tests. However, any Psychic Test containing a double causes Perils of the Warp, even if the Psychic Test succeeds. A double which is subsequently re-rolled still causes Perils. Magnus converts any Perils he suffers into Instability Counters as normal. THE CRIMSON KING SHATTERED If Magnus loses his final Wound and is actually destroyed, the psychic backlash tears through the minds of his sons. Immediately, every friendly non-Vehicle unit with Legiones Astartes (Thousand Sons) suffers: D3 Strength 4 AP– hits. Then every friendly Thousand Sons Psyker or Brotherhood of Psykers suffers Perils of the Warp. A Thousand Sons Independent Character with the Psyker rule suffers Perils twice instead, resolving each result separately. These effects ignore range and line of sight. For the purposes of Signs and Portents, all Perils caused by The Crimson King Shattered count as one single triggering event. Apply Signs and Portents once after all resulting Perils and casualties have been resolved. |</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="JUSTAERIN TERMINATOR SQUAD" hidden="false" id="r41-unit-xvi-0-justaerin-terminator-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="285" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xvi-0-justaerin-terminator-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xvi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Justaerin Terminator" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-xvi-0-justaerin-terminator-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xvi-0-justaerin-terminator-squad-source" hidden="false"><ns0:description>Justaerin Terminator | 5 | 4 | 4 | 4 | 2 | 3 | 2 | 9 | 2+/4+
Force Organisation:
CHOSEN OF THE WARMASTER A Sons of Horus Praetor, Ezekyle Abaddon or Horus Lupercal may select one Justaerin Terminator Squad as a retinue. If selected as a retinue, the squad does not occupy a separate Elites choice.
• Elites
• 0–1
Unit Composition:
• 5 Justaerin Terminators
Unit Type:
• Infantry
Wargear:
• Cataphractii Terminator Armour
• Foeblaster Boltgun
• Power weapon or Power fist
Special Rules:
• Legiones Astartes (Sons of Horus)
• Chosen of the Warmaster
OPTIONS
• The squad may include up to five additional Justaerin Terminators for +57 points per model.
• Any model equipped with a Power fist may replace it with:
• Chainfist ....................................... +5 points
• Any model may replace his Foeblaster Boltgun with:
• Combi-flamer .................................. +10 points
• Combi-volkite charger ........................ +10 points
• Combi-meltagun ............................... +15 points
• Combi-plasma gun ............................. +15 points
• Any model may replace both of his weapons with:
• Pair of Lightning Claws ....................... Free
• For every five models, up to two Justaerin may replace their Foeblaster Boltgun with:
• Heavy Flamer .................................. +10 points
• Reaper Autocannon ............................ +20 points
• Multi-Melta ................................... +25 points
• The squad may purchase:
• Banestrike Ammunition .................... +2 points per
eligible model
• Teleportation Transponders ................... +15 points
• One Justaerin may be upgraded to Falkus Kibre as described in his entry.
DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod or Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xvi-0-justaerin-terminator-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xvi-0-justaerin-terminator-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="57" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xvi-0-justaerin-terminator-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +57 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xvi-0-justaerin-terminator-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="r41-unit-xvi-0-justaerin-terminator-squad-opt-0-chainfist"><ns0:constraints><ns0:constraint id="r41-unit-xvi-0-justaerin-terminator-squad-opt-0-chainfist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xvi-0-justaerin-terminator-squad-opt-0-context" hidden="false"><ns0:description>• Any model equipped with a Power fist may replace it with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-flamer" hidden="false" id="r41-unit-
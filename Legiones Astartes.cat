            </ns0:entryLink>
            <ns0:entryLink import="true" name="Drop Pod" hidden="false" id="r35-destroyer-troops-destroyer-tr-pod" type="selectionEntry" targetId="transport-drop-pod">
              <ns0:constraints>
                <ns0:constraint id="r35-destroyer-troops-destroyer-tr-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>

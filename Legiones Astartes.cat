      <ns0:selectionEntry id="r37-breacher-shieldwall" name="Shield Wall (Legion Breacher Company)" type="upgrade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r37-breacher-shieldwall-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Shield Wall (Legion Breacher Company)" id="r37-breacher-shieldwall-rule" hidden="false"><ns0:description>Models equipped with Boarding Shields may re-roll results of 1 when making an Invulnerable Save granted by their Boarding Shield.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-breacher" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries>

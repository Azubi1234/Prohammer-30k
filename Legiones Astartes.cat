              </ns0:constraints>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Drop Pod" hidden="false" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-tr-pod" type="selectionEntry" targetId="transport-drop-pod">
              <ns0:constraints>

                  <constraints>
                    <constraint id="techmarine-I-signum-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <rules>
                    <rule name="Signum" id="techmarine-I-signum-rule" hidden="false">
                      <description>Once during each friendly Shooting phase, a unit containing a Signum may re-roll one failed To Hit roll made with a shooting weapon. A unit may benefit from only one Signum each Shooting phase.</description>
                    </rule>

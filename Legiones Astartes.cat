            <ns0:entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="terminator-tr-dc" type="selectionEntry" targetId="transport-dreadclaw">
              <ns0:constraints>
                <ns0:constraint id="terminator-tr-dc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          </ns0:entryLinks>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>

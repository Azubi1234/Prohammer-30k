            <ns0:entryLink import="true" name="Legion Vexilla" hidden="false" id="r40-da-storm-assault-assault-vexilla" type="selectionEntry" targetId="gear-vexilla">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-vexilla-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Nuncio Vox" hidden="false" id="r40-da-storm-assault-assault-nuncio" type="selectionEntry" targetId="gear-nuncio">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-nuncio-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>

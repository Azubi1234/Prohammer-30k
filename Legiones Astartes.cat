              </ns0:modifiers>
            </ns0:entryLink>
          <ns0:entryLink id="r40-da-storm-assault-r40-da-warblade-assault-ex-power" name="Calibanite Warblade" type="selectionEntry" targetId="da22-warblade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-storm-assault-r40-da-warblade-assault-ex-power-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Squad Equipment" id="r40-da-storm-assault-assault-equipment" hidden="false">

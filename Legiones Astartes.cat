      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hs-hss-wargear" hidden="false">
          <ns0:description>4 Legion Space Marines and 1 Legion Sergeant. Power Armour, Bolter, Bolt pistol and Frag grenades. The unit has Legiones Astartes; the Sergeant is a Character.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Sergeant Armoury" id="hs-hss-armoury-rule" hidden="false">
          <ns0:description>The Sergeant may select up to 50 points of additional permitted weapons and wargear from the Space Marine Armoury. Normal Sergeant weapon limits apply. Unit-specific replacements take precedence over duplicate Armoury purchases.</ns0:description>
        </ns0:rule>
      </ns0:rules>

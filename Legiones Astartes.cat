              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:modifiers>
                <ns0:modifier type="increment" value="2" field="pts">
                  <ns0:repeats>
                    <ns0:repeat value="1" repeats="1" field="selections" scope="root-entry" childId="r40-da-eskaton-destroyer-destroyer-additional" shared="true" roundUp="false" includeChildSelections="false" />
                  </ns0:repeats>
                </ns0:modifier>
              </ns0:modifiers>
            </ns0:entryLink>

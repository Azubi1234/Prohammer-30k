tic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-xx-2-lernaean-terminator-squad-source" hidden="false"><ns0:description>Lernaean Terminator | 5 | 5 | 4 | 4 | 1 | 3 | 2 | 9 | 2+/4+
Force Organisation:
• Elites
• 0–1
Unit Composition:
• 5 Lernaean Terminators
Unit Type:
• Infantry
Wargear:
• Cataphractii Terminator Armour
• Storm bolter or Foeblaster boltgun
• Power weapon or Power fist
Special Rules:
• Legiones Astartes (Alpha Legion)
OPTIONS
• The squad may include up to five additional Lernaean Terminators for +48 points per model.
• Any model equipped with a Power fist may replace it with:
• Chainfist ..................................... +5 points
• Any model may replace his Storm bolter or Foeblaster boltgun with a Combi-weapon at the normal Armoury cost.
• Up to two models may replace their ranged weapon with:
• Plasma Gun ................................... +15 points
• Plasma Cannon ................................ +20 points
• Conversion Beamer ......................... +35 points
• One Lernaean Terminator may be replaced by Sheed Ranko for +62 points.
DEDICATED TRANSPORT
The squad may select a Land Raider, Dreadclaw Drop Pod or
Spartan Assault Tank where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-xx-2-lernaean-terminator-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-xx-2-lernaean-terminator-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="48" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-xx-2-lernaean-terminator-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +48 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xx-2-lernaean-terminator-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Chainfist" hidden="false" id="r41-unit-xx-2-lernaean-terminator-squad-opt-0-chainfist"><ns0:constraints><ns0:constraint id="r41-unit-xx-2-lernaean-terminator-squad-opt-0-chainfist-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xx-2-lernaean-terminator-squad-opt-0-context" hidden="false"><ns0:description>• Any model equipped with a Power fist may replace it with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Plasma Gun" hidden="false" id="r41-unit-xx-2-lernaean-terminator-squad-opt-1-plasma-gun"><ns0:constraints><ns0:con
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r40-da-storm-assault-da-wing-assault-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r40-da-storm-assault-da-wing-assault-unit-r40-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r40-da-storm-assault-da-wing-assault-unit-r40-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="r40-da-storm-assault-da-wing-assault-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r40-da-storm-assault-da-wing-assault-unit-0">
              <ns0:constraints>
                <ns0:constraint id="r40-da-storm-assault-da-wing-assault-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r40-da-storm-assault-da-wing-assault-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-storm-centurion-group-r40-da-storm-assault" name="Storm of War — Embedded Legion Centurion (20-model squad only)" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="unit" name="Legion Centurion" id="r40-da-storm-centurion-group-r40-da-storm-assault-centurion" hidden="false" import="true">
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="50" />
      </ns0:costs>
      <ns0:profiles>
        <ns0:profile name="Legion Centurion" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-prof" typeId="prof-model" typeName="Model" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
            <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
            <ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic>
            <ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic>
            <ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic>
            <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
            <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
          </ns0:characteristics>
        <ns0:modifiers><ns0:modifier type="set" field="model-sv" value="2+" id="r40-da-storm-centurion-group-r40-da-storm-assault-r29-cent-sv-forge"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-storm-centurion-group-r40-da-storm-assault-hq-consul-forge" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" field="model-sv" value="2+/4+" id="r40-da-storm-centurion-group-r40-da-storm-assault-r29-cent-sv-null"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r40-da-storm-centurion-group-r40-da-storm-assault-hq-consul-null" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-std" hidden="false">
          <ns0:description>Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-la" hidden="false">
          <ns0:description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-frag" hidden="false">
          <ns0:description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Space Marine Armoury" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-armoury-rule" hidden="false">
          <ns0:description>The Centurion may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply. Consul-granted wargear is included in the Consul cost and does not count against this allowance.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-storm-centurion-group-r40-da-storm-assault-rule" name="Masters of the Storm of War" hidden="false"><ns0:description>Purchased at its normal points cost as part of this 20-model squad. It occupies no HQ slot, is part of the squad and may not voluntarily leave, may not take a Consul upgrade, may not be the Warlord and must belong to the Stormwing.</ns0:description></ns0:rule></ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Bolt Pistol" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Chainsword" id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-cs-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r40-da-storm-centurion-group-r40-da-storm-assault-hq-centurion-cs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
      </ns0:entryLinks>
      <ns0:selectionEntryGroups>

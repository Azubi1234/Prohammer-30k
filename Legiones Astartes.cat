                  <characteristics>
                    <characteristic name="BS" typeId="vehicle-bs">4</characteristic>
                    <characteristic name="Front" typeId="vehicle-front">14</characteristic>
                    <characteristic name="Side" typeId="vehicle-side">14</characteristic>
                    <characteristic name="Rear" typeId="vehicle-rear">14</characteristic>
                  </characteristics>
                </profile>
                <profile name="Twin-linked Lascannon" id="hs-lr-phobos-las" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">48"</characteristic>
                    <characteristic name="S" typeId="ranged-s">9</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">2</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</characteristic>
                  </characteristics>
                </profile>
                <profile name="Twin-linked Heavy Bolter" id="hs-lr-phobos-hb" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <characteristics>
                    <characteristic name="Range" typeId="ranged-range">36"</characteristic>
                    <characteristic name="S" typeId="ranged-s">5</characteristic>
                    <characteristic name="AP" typeId="ranged-ap">4</characteristic>
                    <characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Standard Wargear" id="hs-lr-phobos-wg" hidden="false">
                  <description>Two Twin-linked Lascannons, Twin-linked Heavy Bolter, Searchlight and Smoke Launchers. Power of the Machine Spirit; Assault Vehicle; Transport Capacity 10.</description>
                </rule>
                <rule name="Assault Vehicle" id="hs-lr-phobos-assault-vehicle" hidden="false">
                  <description>Units may charge after disembarking as allowed by ProHammer.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="upgrade" name="Hunter-Killer Missile" id="hs-lr-ph-up-hunter-killer-missile" hidden="false" import="true">

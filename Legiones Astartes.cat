            <ns0:entryLink import="true" name="Plasma Pistol (replaces Bolt Pistol)" hidden="false" id="r40-da-storm-assault-assault-ex-plasma" type="selectionEntry" targetId="gear-plasma-pistol">
              <ns0:constraints>

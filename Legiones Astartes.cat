                  <entryLink import="true" name="Teleport Homer" hidden="false" id="sgt-homer" type="selectionEntry" targetId="gear-homer"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="sgt-homer-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
                </entryLinks></selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>

      <selectionEntryGroups>
        <selectionEntryGroup name="Squad Weapons" id="tac-loadout" hidden="false" defaultSelectionEntryId="load-standard">
          <constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-max" includeChildSelections="false" automatic="true"/></constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bolters + Bolt Pistols" hidden="false" id="load-standard" defaultAmount="1"><entryLinks><entryLink import="true" name="Bolter" hidden="false" id="load-standard-b" type="selectionEntry" targetId="gear-bolter" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-standard-b-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-standard-b-max" includeChildSelections="false" automatic="true"/></constraints></entryLink><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-standard-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-min" includeChildSelections="false" automatic="true"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="load-standard-p-max" includeChildSelections="false" automatic="true"/></constraints></entryLink></entryLinks></selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Bolters + Bolt Pistols + Chainswords (+2 pts/model)" hidden="false" id="load-add-chainswords"><entryLinks><entryLink import="true" name="Bolter" hidden="false" id="load-add-b" type="selectionEntry" targetId="gear-bolter" defaultAmount="1"/><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-add-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"/><entryLink import="true" name="Chainsword" hidden="false" id="load-add-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1"/></entryLinks><costs><cost name="Points" typeId="pts" value="2"/></costs><modifiers><modifier type="increment" value="2" field="pts"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="tac-marine" shared="true" roundUp="false" includeChildSelections="false"/></repeats></modifier></modifiers></selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Exchange Bolters for Chainswords (Free)" hidden="false" id="load-exchange"><entryLinks><entryLink import="true" name="Bolt Pistol" hidden="false" id="load-ex-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1"/><entryLink import="true" name="Chainsword" hidden="false" id="load-ex-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1"/></entryLinks></selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>

        <selectionEntryGroup name="Squad Grenades" id="tac-grenades" hidden="false"><entryLinks><entryLink import="true" name="Krak Grenades (+2 pts/model)" hidden="false" id="tac-krak" type="selectionEntry" targetId="gear-krak"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-krak-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="2"/></costs><modifiers><modifier type="increment" value="2" field="pts"><repeats><repeat value="1" repeats="1" field="selections" scope="root-entry" childId="tac-marine" shared="true" roundUp="false" includeChildSelections="false"/></repeats></modifier></modifiers></entryLink></entryLinks></selectionEntryGroup>

        <selectionEntryGroup name="Heavy Weapons" id="tac-heavy-weapons" hidden="false">
          <constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-heavy-max" includeChildSelections="true"/></constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="load-exchange" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="2" field="tac-heavy-max"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/></conditions></modifier>
          </modifiers>
          <entryLinks>
            <entryLink import="true" name="Heavy Bolter" hidden="false" id="hv-hb" type="selectionEntry" targetId="gear-heavy-bolter"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-hb-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
            <entryLink import="true" name="Missile Launcher" hidden="false" id="hv-ml" type="selectionEntry" targetId="gear-missile"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-ml-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Autocannon" hidden="false" id="hv-ac" type="selectionEntry" targetId="gear-autocannon"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-ac-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Multi-Melta" hidden="false" id="hv-mm" type="selectionEntry" targetId="gear-multimelta"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-mm-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Plasma Cannon" hidden="false" id="hv-pc" type="selectionEntry" targetId="gear-plasma-cannon"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-pc-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
            <entryLink import="true" name="Lascannon" hidden="false" id="hv-lc" type="selectionEntry" targetId="gear-lascannon"><constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="hv-lc-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
          </entryLinks>
        </selectionEntryGroup>

        <selectionEntryGroup name="Special Weapons" id="tac-special-weapons" hidden="false">
          <constraints><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="tac-special-max" includeChildSelections="true"/></constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="load-exchange" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="1" field="tac-special-max"><conditions><condition type="atLeast" value="1" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></modifier>
            <modifier type="set" value="4" field="tac-special-max"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/></conditions></modifier>
            <modifier type="set" value="3" field="tac-special-max"><conditionGroups><conditionGroup type="and"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/><condition type="equalTo" value="1" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier>
            <modifier type="set" value="2" field="tac-special-max"><conditionGroups><conditionGroup type="and"><conditions><condition type="equalTo" value="19" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/><condition type="atLeast" value="2" field="selections" scope="parent" childId="tac-heavy-weapons" shared="true" includeChildSelections="true"/></conditions></conditionGroup></conditionGroups></modifier>
          </modifiers>
          <entryLinks>
            <entryLink import="true" name="Flamer" hidden="false" id="sp-f" type="selectionEntry" targetId="gear-flamer"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-f-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="5"/></costs></entryLink>
            <entryLink import="true" name="Meltagun" hidden="false" id="sp-m" type="selectionEntry" targetId="gear-meltagun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-m-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Plasma Gun" hidden="false" id="sp-p" type="selectionEntry" targetId="gear-plasma-gun"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-p-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
            <entryLink import="true" name="Volkite Charger" hidden="false" id="sp-vc" type="selectionEntry" targetId="gear-volkite-charger"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-vc-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink>
            <entryLink import="true" name="Volkite Caliver" hidden="false" id="sp-vcal" type="selectionEntry" targetId="gear-volkite-caliver"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-vcal-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="15"/></costs></entryLink>
            <entryLink import="true" name="Rotor Cannon" hidden="false" id="sp-r" type="selectionEntry" targetId="gear-rotor"><constraints><constraint type="max" value="4" field="selections" scope="parent" shared="true" id="sp-r-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="4"/></costs></entryLink>
          </entryLinks>
        </selectionEntryGroup>

        <selectionEntryGroup name="Squad Equipment" id="tac-equipment" hidden="false"><entryLinks><entryLink import="true" name="Legion Vexilla" hidden="false" id="tac-vexilla" type="selectionEntry" targetId="gear-vexilla"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-vexilla-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink><entryLink import="true" name="Nuncio Vox" hidden="false" id="tac-nuncio" type="selectionEntry" targetId="gear-nuncio"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-nuncio-max" includeChildSelections="false"/></constraints><costs><cost name="Points" typeId="pts" value="10"/></costs></entryLink></entryLinks></selectionEntryGroup>

        <selectionEntryGroup name="Dedicated Transport" id="tac-transport" hidden="true"><modifiers><modifier type="set" value="false" field="hidden"><conditions><condition type="equalTo" value="9" field="selections" scope="root-entry" childId="tac-marine" shared="true" includeChildSelections="false"/></conditions></modifier></modifiers><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-transport-max" includeChildSelections="false"/></constraints><entryLinks>
          <entryLink import="true" name="Rhino" hidden="false" id="tac-rhino" type="selectionEntry" targetId="transport-rhino"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-rhino-max" includeChildSelections="false"/></constraints></entryLink>
          <entryLink import="true" name="Drop Pod" hidden="false" id="tac-drop-pod" type="selectionEntry" targetId="transport-drop-pod"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-drop-pod-max" includeChildSelections="false"/></constraints></entryLink>
          <entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="tac-dreadclaw" type="selectionEntry" targetId="transport-dreadclaw"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-dreadclaw-max" includeChildSelections="false"/></constraints></entryLink>
        </entryLinks></selectionEntryGroup>

    <ns0:selectionEntry type="model" import="true" name="Legion Dreadnought Drop Pod" hidden="false" id="transport-dreadnought-pod">
      <ns0:profiles>
        <ns0:profile name="Dreadnought Drop Pod" id="prof-dreadnought-pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="65" />
      </ns0:costs>
      <ns0:rules>
        <ns0:rule name="Transport Capacity" id="dreadpod-cap" hidden="false">
          <ns0:description>One Legion Dreadnought or Legion Contemptor Dreadnought. The transported Dreadnought occupies the vehicle's entire Transport Capacity.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Deep Strike" id="dreadpod-deep" hidden="false">
          <ns0:description>Uses the normal ProHammer Deep Strike rules together with Drop Pod Assault and Inertial Guidance System.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Drop Pod Assault" id="dreadpod-assault" hidden="false">
          <ns0:description>Use the Drop Pod Assault rule given in the Legion Drop Pod entry.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Inertial Guidance System" id="dreadpod-igs" hidden="false">
          <ns0:description>Use the Inertial Guidance System rule given in the Legion Drop Pod entry.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Immobile" id="dreadpod-immobile" hidden="false">
          <ns0:description>After arriving, the Dreadnought Drop Pod may not move for the remainder of the battle.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Burning Retros" id="dreadpod-retros" hidden="false">
          <ns0:description>From arrival by Deep Strike until the start of its controlling player's next turn, the Drop Pod has Shrouded. A Dreadnought disembarking during this period also has Shrouded until that time. In addition, during this period, a unit targeted by shooting gains Shrouded if the attacker's line of sight passes through or over the Dreadnought Drop Pod.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Assault Vehicle" id="dreadpod-assaultveh" hidden="false">
          <ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>

    <ns0:selectionEntry type="unit" name="0–1 Legion Artillery Tank Squadron" id="hs-artillery" hidden="false" import="true">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-heavy" id="hs-artillery-cat" primary="true" name="Heavy Support" hidden="false" />
      </ns0:categoryLinks>
      <ns0:constraints>
        <ns0:constraint id="hs-artillery-roster-max" type="max" value="1" field="selections" scope="roster" shared="true" includeChildSelections="false" />
      </ns0:constraints>
      <ns0:rules>
        <ns0:rule name="Squadron Composition" id="hs-artillery-comp" hidden="false">
          <ns0:description>1–3 vehicles. Every vehicle in the squadron must be of the same type.</ns0:description>
        </ns0:rule>
        <ns0:rule name="New Recruit note" id="hs-art-note" hidden="false">
          <ns0:description>For a two- or three-vehicle squadron, select the appropriate number of Additional vehicles. Vehicle upgrades and pintle weapons may be selected in matching quantities up to the number of vehicles in the squadron; do not assign more than one copy of a given upgrade to the same vehicle.</ns0:description>
        </ns0:rule>
      </ns0:rules>

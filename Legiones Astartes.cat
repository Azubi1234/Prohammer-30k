              <ns0:entryLink id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-r39-phosphex-fa-sky-sgt-armoury" name="Phosphex Bomb (Destroyer Company)" type="selectionEntry" targetId="gear-phosphex-bomb" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-r39-phosphex-fa-sky-sgt-armoury-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-destroyer" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
              <ns0:rules>
                <ns0:rule name="Sergeant Armoury Restrictions" id="r42-role-v-0-effects-ride-like-the-wind-legion-sky-hunter-jetbike-squadrons-fa-sky-sgt-arm-rule" hidden="false">
                  <ns0:description>Up to 50 points of permitted additional Space Marine Armoury equipment. Standard wargear and unit-specific options are not repeated here. No item may be selected more than once unless specifically permitted; normal Armoury weapon limits still apply.</ns0:description>

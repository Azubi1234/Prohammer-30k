                                </rule>
                              </rules>
                            </selectionEntry>
                            <selectionEntry type="upgrade" name="Auxiliary Drive" id="hq-consul-signals-dam-vu-3" hidden="false" import="true">
                              <constraints>
                                <constraint id="hq-consul-signals-dam-vu-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </constraints>
                              <costs>
                                <cost name="Points" typeId="pts" value="10" />
                              </costs>
                              <rules>
                                <rule name="Auxiliary Drive" id="hq-consul-signals-dam-vu-3-r" hidden="false">
                                  <description>If Immobilised at the start of the controlling player's Movement phase, roll a D6; on 4+ remove one Immobilised result and the vehicle may move normally that phase.</description>
                                </rule>
                              </rules>
                            </selectionEntry>
                            <selectionEntry type="upgrade" name="Armoured Ceramite" id="hq-consul-signals-dam-vu-4" hidden="false" import="true">
                              <constraints>
                                <constraint id="hq-consul-signals-dam-vu-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </constraints>
                              <costs>
                                <cost name="Points" typeId="pts" value="20" />
                              </costs>
                              <rules>
                                <rule name="Armoured Ceramite" id="hq-consul-signals-dam-vu-4-r" hidden="false">
                                  <description>Melta weapons do not receive their additional Armour Penetration die against this vehicle.</description>
                                </rule>
                              </rules>
                            </selectionEntry>
                            <selectionEntry type="upgrade" name="Power of the Machine Spirit" id="hq-consul-signals-dam-vu-5" hidden="false" import="true">
                              <constraints>
                                <constraint id="hq-consul-signals-dam-vu-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                              </constraints>
                              <costs>
                                <cost name="Points" typeId="pts" value="25" />
                              </costs>
                              <rules>
                                <rule name="Power of the Machine Spirit" id="hq-consul-signals-dam-vu-5-r" hidden="false">

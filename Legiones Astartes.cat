            <ns0:entryLink import="true" name="Calibanite Plasma Pistol" hidden="false" id="r40-da-storm-assault-da22-alt-pp-2" type="selectionEntry" targetId="da22-plasma-pistol">
              <ns0:constraints>
                <ns0:constraint type="max" value="4" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-da22-alt-pp-2-2" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>

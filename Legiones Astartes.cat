                      </conditions>
                    </modifier>
                    <modifier type="set" value="3" field="hs-lr-ac-up-armoured-ceramite-max">
                      <conditions>
                        <condition type="atLeast" value="3" field="selections" scope="root-entry" childId="hs-lr-achilles" shared="true" includeChildSelections="true" />
                      </conditions>
                    </modifier>

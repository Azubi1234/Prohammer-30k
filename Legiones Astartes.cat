="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Deathsworn" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-vi-3-deathsworn-pack-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-vi-3-deathsworn-pack-source" hidden="false"><ns0:description>Deathsworn | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 2+
Force Organisation:
DREAMS OF DEATH If a Deathsworn model is slain during an Assault phase before it has made its close-combat attacks, do not remove it immediately. At Initiative 1, that model may make its normal close-combat attacks as though it were still alive, provided at least one other model from its Deathsworn Pack is still alive. After these attacks have been resolved, remove the slain model. YIMIRA STASIS BOMBS A Deathsworn Pack counts as being equipped with Defensive Grenades. In addition, when an enemy unit Retreats from a close combat involving a Deathsworn Pack, roll two dice for the D6 portion of its Retreat distance and use the lower result. During the Shooting phase, one Deathsworn may throw a Yimira Stasis Bomb instead of firing another weapon. Yimira Stasis Bombs have no effect against Vehicles.
• Elites
Unit Composition:
• 5 Deathsworn
Unit Type:
• Infantry
Wargear:
• Artificer Armour
• Bolt pistol
• Power weapon
• Yimira Stasis Bombs
• Frag grenades
Special Rules:
• Legiones Astartes (Space Wolves)
• Dreams of Death
OPTIONS
• The pack may include up to five additional Deathsworn
for +30 points per model.
• For every five models in the pack, one Deathsworn may
replace his Power weapon with:
• Power fist ..................................... +5 points
• Great Frost Blade ............................ +10 points
• Thunder hammer ............................... +10 points
• The entire pack may take:
• Krak grenades ........................... +2 points per model
• Melta bombs ............................. +5 points per model
DEDICATED TRANSPORT
The pack may select a Rhino, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-vi-3-deathsworn-pack-additional"><ns0:constraints><ns0:constraint id="r41-unit-vi-3-deathsworn-pack-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-vi-3-deathsworn-pack-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +30 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-vi-3-deathsworn-pack-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-vi-3-deathsworn-pack-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-vi-3-deathsworn-pack-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-vi-3-deathsworn-pack-opt-0-context" hidden="false"><ns0:description>• The pack may include up to five additional Deathsworn</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power fist" hidden="false" id="r41-unit-vi-3-deathsworn-pack-opt-1-power-fist"><ns0:constraints><ns0:constraint id="r41-unit-vi-3-deathsworn-pack-opt-1-power-fist-m
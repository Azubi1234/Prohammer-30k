                <ns0:constraint id="r35-pride-veteran-veteran-tr-rhino-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Drop Pod" hidden="false" id="r35-pride-veteran-veteran-tr-pod" type="selectionEntry" targetId="transport-drop-pod">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-veteran-tr-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="r35-pride-veteran-veteran-tr-dc" type="selectionEntry" targetId="transport-dreadclaw">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-veteran-tr-dc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          </ns0:entryLinks>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-veteran-veteran-jump-packs" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="0" field="veteran-transport-max">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-veteran-veteran-jump-packs" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-veteran-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-0">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r35-pride-veteran-da-wing-veteran-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-1">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r35-pride-veteran-da-wing-veteran-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-2">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r35-pride-veteran-da-wing-veteran-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-3">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r35-pride-veteran-da-wing-veteran-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-4">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r35-pride-veteran-da-wing-veteran-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-pride-veteran-da-wing-veteran-unit-5">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-da-wing-veteran-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r35-pride-veteran-da-wing-veteran-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      <ns0:selectionEntryGroup id="r40-da-ammo-r35-pride-veteran-veteran-unit" name="Dark Angels Armoury — Ammunition" hidden="false" collective="false" import="true"><ns0:entryLinks><ns0:entryLink id="r40-da-ammo-r35-pride-veteran-veteran-unit-r35-pride-veteran-veteran-sp-ml" name="Stasis Shells — Missile (for Missile Launcher with Suspensor Web (replaces Bolter))" type="selectionEntry" targetId="da22-stasis-missile" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-ammo-r35-pride-veteran-veteran-unit-r35-pride-veteran-veteran-sp-ml-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-pride-veteran-veteran-sp-ml" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntryGroup><ns0:selectionEntryGroup id="r40-da-steel-transport-r35-pride-veteran-veteran-unit" name="Steel Fist — Armoured Assault Dedicated Transport" hidden="true" collective="false" import="true"><ns0:constraints><ns0:constraint id="r40-da-steel-transport-r35-pride-veteran-veteran-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" in
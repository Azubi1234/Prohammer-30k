    <ns0:categoryLinks><ns0:categoryLink id="r40-da-storm-tactical-cat" targetId="cat-troops" name="Troops" hidden="false" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-storm" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Assault Squad (Storm of War compulsory)" hidden="true" id="r40-da-storm-assault">
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r40-da-storm-assault-assault-standard-wargear" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, a Bolt Pistol, a Chainsword, Frag Grenades and a Jump Pack.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Power Armour" id="r40-da-storm-assault-assault-power-armour" hidden="false">
          <ns0:description>Models wearing Power Armour have a 3+ Armour Save.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r40-da-storm-assault-assault-legiones" hidden="false">
          <ns0:description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="r40-da-storm-assault-assault-frag" hidden="false">
          <ns0:description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Jump Packs" id="r40-da-storm-assault-assault-jump-packs" hidden="false">
          <ns0:description>The squad is equipped with Jump Packs and is treated as Jump Infantry. It follows all normal ProHammer rules for Jump Infantry, including movement, terrain, Deep Strike, Fall Back movement and transport restrictions.</ns0:description>
        </ns0:rule>
      <ns0:rule id="r40-da-storm-assault-rite-rule" name="Storm of War — Compulsory Formation" hidden="false"><ns0:description>This Rite-specific entry represents a compulsory 20-model Stormwing Assault Squad. It may not select a Dedicated Transport.</ns0:description></ns0:rule></ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Bolt Pistol" hidden="false" id="r40-da-storm-assault-assault-standard-bp" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-bp-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-bp-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Chainsword" hidden="false" id="r40-da-storm-assault-assault-standard-cs" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-cs-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-standard-cs-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
      </ns0:entryLinks>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Assault Marine" hidden="false" id="r40-da-storm-assault-assault-marine" defaultAmount="9">
          <ns0:constraints>
            <ns0:constraint type="min" value="9" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-marine-min" includeChildSelections="false" />
            <ns0:constraint type="max" value="19" field="selections" scope="parent" shared="true" id="r40-da-storm-assault-assault-marine-max" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="18" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Legion Assault Marine" typeId="prof-model" typeName="Model" hidden="false" id="r40-da-storm-assault-prof-assault-marine">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>

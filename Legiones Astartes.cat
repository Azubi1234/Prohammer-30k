            <entryLink import="true" name="Refractor Field" hidden="false" id="rev24-veteran-unit-sgt-refractor" type="selectionEntry" targetId="gear-hq-refractor">
              <constraints>
                <constraint id="rev24-veteran-unit-sgt-refractor-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="15" />
              </costs>
              <modifiers>
                <modifier id="rev24-rf-max-veteran-unit" type="set" value="true" field="hidden">
                  <conditions>
                    <condition type="lessThan" value="5" field="selections" scope="root-entry" childId="veteran-additional" shared="true" includeChildSelections="false" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
            </entryLink>
          </entryLinks>
          <rules>
            <rule name="Sergeant Armoury Restrictions" id="veteran-sgt-arm-rule" hidden="false">
              <description>The Sergeant may select up to 50 points of permitted Space Marine Armoury equipment. Unit-specific options and equipment already carried are not repeated here. No item may be selected more than once unless specifically permitted. A Pair of Lightning Claws counts as two weapon choices.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Dedicated Transport" id="veteran-transport" hidden="false">
          <constraints>
            <constraint id="veteran-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Rhino" hidden="false" id="veteran-tr-rhino" type="selectionEntry" targetId="transport-rhino">
              <constraints>
                <constraint id="veteran-tr-rhino-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Drop Pod" hidden="false" id="veteran-tr-pod" type="selectionEntry" targetId="transport-drop-pod">
              <constraints>
                <constraint id="veteran-tr-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="veteran-tr-dc" type="selectionEntry" targetId="transport-dreadclaw">
              <constraints>
                <constraint id="veteran-tr-dc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
          </entryLinks>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="veteran-jump-packs" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
            <modifier type="set" value="0" field="veteran-transport-max">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="root-entry" childId="veteran-jump-packs" shared="true" includeChildSelections="true" />
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntryGroup>
        <selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-veteran-unit" collective="false" import="true">
          <constraints>
            <constraint id="da-wing-veteran-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <constraint id="da-wing-veteran-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </constraints>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
            <modifier type="set" value="1" field="da-wing-veteran-unit-min">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-veteran-unit-0">
              <constraints>
                <constraint id="da-wing-veteran-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Stormwing" id="da-wing-veteran-unit-0-rule" hidden="false">
                  <description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-veteran-unit-1">
              <constraints>
                <constraint id="da-wing-veteran-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Deathwing" id="da-wing-veteran-unit-1-rule" hidden="false">
                  <description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-veteran-unit-2">
              <constraints>
                <constraint id="da-wing-veteran-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Dreadwing" id="da-wing-veteran-unit-2-rule" hidden="false">
                  <description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-veteran-unit-3">
              <constraints>
                <constraint id="da-wing-veteran-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ironwing" id="da-wing-veteran-unit-3-rule" hidden="false">
                  <description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-veteran-unit-4">
              <constraints>
                <constraint id="da-wing-veteran-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Firewing" id="da-wing-veteran-unit-4-rule" hidden="false">
                  <description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-veteran-unit-5">
              <constraints>
                <constraint id="da-wing-veteran-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </constraints>
              <rules>
                <rule name="Ravenwing" id="da-wing-veteran-unit-5-rule" hidden="false">
                  <description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Legion Terminator Squad" hidden="false" id="terminator-unit">
      <categoryLinks>
        <categoryLink targetId="cat-elites" id="terminator-unit-cat" primary="true" name="Elites" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Standard Wargear" id="terminator-standard" hidden="false">
          <description>Every model is equipped with the selected Terminator Armour pattern, a Combi-bolter and a Power Weapon unless replaced below.</description>
        </rule>
        <rule name="Legiones Astartes" id="terminator-legiones" hidden="false">
          <description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</description>
        </rule>
        <rule name="Implacable Advance" id="terminator-implacable" hidden="false">
          <description>In any mission which distinguishes between Scoring and non-Scoring units, a Legion Terminator Squad counts as a Scoring Unit whenever Troops choices normally count as Scoring Units.</description>
        </rule>
        <rule name="Dedicated Transport" id="terminator-transport-rule" hidden="false">
          <description>The squad may select a Land Raider, a Land Raider variant with sufficient Transport Capacity, a Dreadclaw Drop Pod or a Spartan Assault Tank where permitted. A Dreadclaw can carry only five models in Terminator Armour, so it is selectable here only for a five-model squad. Land Raider and Spartan choices will become selectable when their vehicle entries are added.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Terminators (included)" hidden="false" id="terminator-included" defaultAmount="4">
          <constraints>
            <constraint id="terminator-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="terminator-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminators (included)" id="terminator-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Terminator Sergeant" hidden="false" id="terminator-sergeant" defaultAmount="1">
          <constraints>
            <constraint id="terminator-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <constraint id="terminator-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </constraints>
          <profiles>
            <profile name="Legion Terminator Sergeant" id="terminator-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">2+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Additional Legion Terminator" hidden="false" id="terminator-additional">

            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-dreadnought-unit-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-dreadnought-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-dreadnought-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-dreadnought-unit-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-dreadnought-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-dreadnought-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-dreadnought-unit-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-dreadnought-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-dreadnought-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-dreadnought-unit-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-dreadnought-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-dreadnought-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-dreadnought-unit-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-dreadnought-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-dreadnought-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-skyhunter" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="false" id="contemptor-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-elites" id="contemptor-unit-cat" primary="true" name="Elites" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="155" />
      </ns0:costs>
      <ns0:profiles>
        <ns0:profile name="Legion Contemptor Dreadnought" id="contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="walker-ws">5</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="walker-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="walker-s">7</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="walker-front">13</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="walker-side">12</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="walker-rear">10</ns0:characteristic>
            <ns0:characteristic name="I" typeId="walker-i">4</ns0:characteristic>
            <ns0:characteristic name="A" typeId="walker-a">2</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="contemptor-standard" hidden="false">
          <ns0:description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Atomantic Shielding" id="contemptor-atomantic" hidden="false">
          <ns0:description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Fleet" id="contemptor-fleet" hidden="false">
          <ns0:description>Uses the normal ProHammer Fleet special rule.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Paired Close-Combat Arms" id="contemptor-paired" hidden="false">
          <ns0:description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</ns0:description>
        </ns0:rule>
      </ns0:rules>

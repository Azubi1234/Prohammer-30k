  <selectionEntries>
    <selectionEntry type="unit" import="true" name="Legion Tactical Squad" hidden="false" id="tactical-unit">
      <categoryLinks>
        <categoryLink targetId="cat-troops" id="tactical-cat" primary="true" name="Troops" hidden="false" />
      </categoryLinks>
      <rules>
        <rule name="Power Armour" id="tactical-power-armour" hidden="false">
          <description>Models wearing Power Armour have a 3+ Armour Save.</description>
        </rule>
        <rule name="Legiones Astartes" id="tactical-legiones" hidden="false">
          <description>All models have And They Shall Know No Fear as presented in ProHammer Classic and gain the named Legiones Astartes rule of their chosen Legion. They are not Fearless.</description>
        </rule>
        <rule name="Frag Grenades" id="tactical-frag" hidden="false">
          <description>Frag Grenades use the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</description>
        </rule>
        <rule name="Fury of the Legion" id="tactical-fury" hidden="false">
          <description>The squad may declare Fury of the Legion in its Shooting phase if it did not move in the preceding Movement phase, did not arrive from Reserves or Deep Strike or disembark that turn, and at least five models remain armed with Bolters or Bolt Pistols. Models armed with Bolters or Bolt Pistols may fire those weapons twice: a Bolter fires 2 shots up to 24" or 4 shots up to 12", and a Bolt Pistol fires 2 shots. All Fury attacks are directed at the same target unless another rule permits otherwise. After using Fury, the squad may not enter Overwatch, make Return Fire or Stand &amp; Shoot reactions, or fire during its next friendly Shooting phase.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry type="model" import="true" name="Legion Tactical Marine" hidden="false" id="tac-marine" defaultAmount="9">
          <constraints>
            <constraint type="min" value="9" field="selections" scope="parent" shared="true" id="tac-marine-min" includeChildSelections="false" />
            <constraint type="max" value="19" field="selections" scope="parent" shared="true" id="tac-marine-max" includeChildSelections="false" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Marine" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-marine">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">1</characteristic>
                <characteristic name="Ld" typeId="model-ld">8</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Legion Tactical Sergeant" hidden="false" id="tac-sergeant" defaultAmount="1">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-min" includeChildSelections="false" automatic="true" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="tac-sgt-max" includeChildSelections="false" automatic="true" />
          </constraints>
          <costs>
            <cost name="Points" typeId="pts" value="15" />
          </costs>
          <profiles>
            <profile name="Legion Tactical Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="prof-tac-sergeant">
              <characteristics>
                <characteristic name="WS" typeId="model-ws">4</characteristic>
                <characteristic name="BS" typeId="model-bs">4</characteristic>
                <characteristic name="S" typeId="model-s">4</characteristic>
                <characteristic name="T" typeId="model-t">4</characteristic>
                <characteristic name="W" typeId="model-w">1</characteristic>
                <characteristic name="I" typeId="model-i">4</characteristic>
                <characteristic name="A" typeId="model-a">2</characteristic>
                <characteristic name="Ld" typeId="model-ld">9</characteristic>
                <characteristic name="Sv" typeId="model-sv">3+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Sergeant Armoury" id="rule-sgt-armoury" hidden="false">
              <description>May select up to 50 points of permitted weapons and wargear from the Space Marine Armoury. Only items marked for Squad Sergeants are available. The Sergeant may carry no more than two weapons, only one of which may be two-handed. A pair of Lightning Claws counts as two weapon choices. His standard Bolter and Bolt Pistol are already included and are not repurchased.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Sergeant Armoury (max 50 pts)" id="sgt-armoury" hidden="false">

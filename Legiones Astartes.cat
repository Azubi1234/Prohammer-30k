<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="cat-30a0-30b0-30c0-0001" name="Legiones Astartes" revision="9" battleScribeVersion="2.03" library="false" gameSystemId="sys-a1d2-5ede-e74f-7479" gameSystemRevision="4" type="catalogue">
  <comment>Revision 9: Tactical Squad weapon allowances are now stackable in combined Special and Heavy Weapon groups; paired Lightning Claws are treated as a two-handed/two-weapon choice.</comment>
  <readme>The Tactical Sergeant uses only Armoury items marked for squad Sergeants, with a 50 point Armoury allowance. His standard Bolter and Bolt Pistol are already included and are not repurchased. Artificer Armour is a separate +10 point Tactical Sergeant option and does not count toward the 50 point Armoury allowance. Special and Heavy Weapon allowances scale at 10 and 20 models. A 10-19 model squad may take one Heavy and one Special Weapon, or two Special Weapons if no Heavy is selected. A 20 model squad may take two Heavy and two Special Weapons, with each unused Heavy allowance becoming one additional Special Weapon.</readme>

  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Bolter" hidden="false" id="gear-bolter">
      <profiles><profile name="Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-bolter"><characteristics><characteristic name="Range" typeId="ranged-range">24&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Rapid Fire</characteristic></characteristics></profile></profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bolt Pistol" hidden="false" id="gear-bolt-pistol">
      <profiles><profile name="Bolt Pistol" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-bolt-pistol"><characteristics><characteristic name="Range" typeId="ranged-range">12&quot;</characteristic><characteristic name="S" typeId="ranged-s">4</characteristic><characteristic name="AP" typeId="ranged-ap">5</characteristic><characteristic name="Type" typeId="ranged-type">Pistol</characteristic></characteristics></profile></profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chainsword" hidden="false" id="gear-chainsword"><rules><rule name="Chainsword" id="rule-chainsword" hidden="false"><description>Close Combat Weapon. Uses the bearer&apos;s Strength and permits normal Armour Saves.</description></rule></rules></selectionEntry>


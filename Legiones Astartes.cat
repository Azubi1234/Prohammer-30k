                    <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Barrage, Blast, Ignores Cover</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Shatter Shells (+10 pts per Rapier)" hidden="false" id="rapier-ammo-shatter">
              <ns0:constraints>
                <ns0:constraint id="rapier-ammo-shatter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:modifiers>

            <entryLink import="true" name="Teleport Homer" hidden="false" id="veteran-sgt-homer" type="selectionEntry" targetId="gear-homer">
              <constraints>
                <constraint id="veteran-sgt-homer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="5" />
              </costs>
            </entryLink>
          </entryLinks>
          <rules>
            <rule name="Sergeant Armoury Restrictions" id="veteran-sgt-arm-rule" hidden="false">
              <description>The Sergeant may select up to 50 points of permitted Space Marine Armoury equipment. Unit-specific options and equipment already carried are not repeated here. No item may be selected more than once unless specifically permitted. A Pair of Lightning Claws counts as two weapon choices.</description>
            </rule>
          </rules>
        </selectionEntryGroup>
        <selectionEntryGroup name="Dedicated Transport" id="veteran-transport" hidden="false">
          <constraints>
            <constraint id="veteran-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </constraints>
          <entryLinks>
            <entryLink import="true" name="Rhino" hidden="false" id="veteran-tr-rhino" type="selectionEntry" targetId="transport-rhino">
              <constraints>
                <constraint id="veteran-tr-rhino-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Drop Pod" hidden="false" id="veteran-tr-pod" type="selectionEntry" targetId="transport-drop-pod">
              <constraints>
                <constraint id="veteran-tr-pod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
            </entryLink>
            <entryLink import="true" name="Dreadclaw Drop Pod" hidden="false" id="veteran-tr-dc" type="selectionEntry" targetId="transport-dreadclaw">
              <constraints>

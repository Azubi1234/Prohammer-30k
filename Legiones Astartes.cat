              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Graviton Gun (replaces built-in Twin-linked Bolter)" hidden="false" id="r35-fury-dread-dreadnought-secondary-grav" type="selectionEntry" targetId="gear-graviton-gun">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-secondary-grav-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Plasma Blaster (replaces built-in Twin-linked Bolter)" hidden="false" id="r35-fury-dread-dreadnought-secondary-pb" type="selectionEntry" targetId="gear-plasma-blaster">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-secondary-pb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
          <ns0:modifiers>
            <ns0:modifier type="set" value="false" field="hidden">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-fury-dread-dreadnought-s-dccw" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="false" field="hidden">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-fury-dread-dreadnought-s-chainfist" shared="true" includeChildSelections="true" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Vehicle Upgrades" id="r35-fury-dread-dreadnought-vehicle" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="r35-fury-dread-dreadnought-extra">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-extra-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Extra Armour" id="r35-fury-dread-dreadnought-extra-rule" hidden="false">
                  <ns0:description>Crew Stunned results are treated as Crew Shaken instead.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r35-fury-dread-dreadnought-hk">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-hk-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Hunter-Killer Missile" id="r35-fury-dread-dreadnought-hk-prof" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">Unlimited</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, One Use</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="r35-fury-dread-dreadnought-frag-launchers">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-frag-launchers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Frag Assault Launchers" id="r35-fury-dread-dreadnought-frag-rule" hidden="false">
                  <ns0:description>The Walker counts as equipped with Frag Grenades when charging an enemy in or behind cover. If a Transport is equipped with Frag Assault Launchers, a unit charging in the same turn it disembarks counts as equipped with Frag Grenades for that Assault phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Armoured Sarcophagus" hidden="false" id="r35-fury-dread-dreadnought-sarcophagus">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-sarcophagus-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Armoured Sarcophagus" id="r35-fury-dread-dreadnought-sarc-rule" hidden="false">
                  <ns0:description>Increase Front Armour from 12 to 13. Side and Rear Armour are unaffected.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Veteran Pilot" hidden="false" id="r35-fury-dread-dreadnought-veteran-pilot">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-veteran-pilot-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Veteran Pilot" id="r35-fury-dread-dreadnought-veteran-rule" hidden="false">
                  <ns0:description>Increase Weapon Skill and Ballistic Skill by +1. This Dreadnought therefore has WS5 and BS5.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Havoc Launcher" hidden="false" id="r35-fury-dread-dreadnought-havoc" type="selectionEntry" targetId="gear-havoc">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-havoc-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Dedicated Transport" id="r35-fury-dread-dreadnought-transport" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="r35-fury-dread-dreadnought-transport-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Legion Dreadnought Drop Pod" hidden="false" id="r35-fury-dread-dreadnought-dreadpod" type="selectionEntry" targetId="transport-dreadnought-pod">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-dreadnought-dreadpod-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-dreadnought-unit-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-0">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="r35-fury-dread-da-wing-dreadnought-unit-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-1">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="r35-fury-dread-da-wing-dreadnought-unit-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-2">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="r35-fury-dread-da-wing-dreadnought-unit-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-3">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="r35-fury-dread-da-wing-dreadnought-unit-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-4">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="r35-fury-dread-da-wing-dreadnought-unit-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="r35-fury-dread-da-wing-dreadnought-unit-5">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-dread-da-wing-dreadnought-unit-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="r35-fury-dread-da-wing-dreadnought-unit-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="rite-ancients" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:entryLinks><ns0:entryLink id="r40-da-forward-r35-fury-dread-dreadnought-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-r35-fury-dread-dreadnought-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r35-fury-dread-da-wing-dreadnought-unit-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry>
    <ns0:selectionEntry type="unit" import="true" name="Legion Contemptor Dreadnought" hidden="true" id="r35-fury-contemptor-contemptor-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="r35-fury-contemptor-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="155" />
      </ns0:costs>
      <ns0:profiles>
        <ns0:profile name="Legion Contemptor Dreadnought" id="r35-fury-contemptor-contemptor-prof" typeId="prof-walker" typeName="Walker" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="walker-ws">5</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="walker-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="walker-s">7</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="walker-front">13</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="walker-side">12</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="walker-rear">10</ns0:characteristic>
            <ns0:characteristic name="I" typeId="walker-i">4</ns0:characteristic>
            <ns0:characteristic name="A" typeId="walker-a">2</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r35-fury-contemptor-contemptor-standard" hidden="false">
          <ns0:description>Twin-linked Heavy Bolter; Dreadnought Close Combat Weapon with built-in Twin-linked Bolter; Smoke Launchers; Searchlight.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Atomantic Shielding" id="r35-fury-contemptor-contemptor-atomantic" hidden="false">
          <ns0:description>Each time the vehicle suffers a Glancing or Penetrating Hit from shooting, roll a D6; on a 5+ the hit is ignored. Against a Glancing or Penetrating Hit in close combat, the hit is ignored on a 6+. Make this roll before the Vehicle Damage table. If the vehicle suffers an Explodes! result, add +1" to the explosion radius.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Fleet" id="r35-fury-contemptor-contemptor-fleet" hidden="false">
          <ns0:description>Uses the normal ProHammer Fleet special rule.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Paired Close-Combat Arms" id="r35-fury-contemptor-contemptor-paired" hidden="false">
          <ns0:description>If equipped with two Dreadnought Close Combat Weapons, the Contemptor gains +1 Attack. This bonus is not included in the profile.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Rite of War Selection" id="r35-fury-contemptor-note" hidden="false"><ns0:description>This Troops entry is available while Fury of the Ancients is selected.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Primary Arm" id="r35-fury-contemptor-contemptor-primary" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="r35-fury-contemptor-contemptor-primary-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="r35-fury-contemptor-contemptor-primary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Heavy Bolter" hidden="false" id="r35-fury-contemptor-contemptor-p-tlhb" defaultAmount="1">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-contemptor-contemptor-p-tlhb-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:profiles>
                <ns0:profile name="Twin-linked Heavy Bolter" id="r35-fury-contemptor-contemptor-p-tlhb-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r35-fury-contemptor-contemptor-p-mm">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-contemptor-contemptor-p-mm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:profiles>
                <ns0:profile name="Multi-Melta" id="r35-fury-contemptor-contemptor-p-mm-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Autocannon" hidden="false" id="r35-fury-contemptor-contemptor-p-tlac">
              <ns0:constraints>
                <ns0:constraint id="r35-fury-contemptor-contemptor-p-tlac-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Twin-linked Autocannon" id="r35-fury-contemptor-contemptor-p-tlac-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic>

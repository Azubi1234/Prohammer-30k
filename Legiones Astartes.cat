      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hs-sicaran-wg" hidden="false">
          <ns0:description>Twin-linked Accelerator Autocannon, Heavy Bolter, Extra Armour, Searchlight and Smoke Launchers. Vehicle (Fast, Tank).</ns0:description>
        </ns0:rule>
        <ns0:rule name="Rapid Tracking" id="hs-sicaran-rapid" hidden="false">
          <ns0:description>Jink saves may not be taken against attacks made with the Accelerator Autocannon.</ns0:description>
        </ns0:rule>
      </ns0:rules>

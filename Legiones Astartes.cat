s0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-2-dominator-cohort-opt-6-context" hidden="false"><ns0:description>• For every five models in the squad, one Dominator may replace</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Reaper autocannon" hidden="false" id="r41-unit-iv-2-dominator-cohort-opt-7-reaper-autocannon"><ns0:constraints><ns0:constraint id="r41-unit-iv-2-dominator-cohort-opt-7-reaper-autocannon-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-2-dominator-cohort-opt-7-context" hidden="false"><ns0:description>• For every five models in the squad, one Dominator may replace</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r41-unit-iv-2-dominator-cohort-opt-8-multi-melta"><ns0:constraints><ns0:constraint id="r41-unit-iv-2-dominator-cohort-opt-8-multi-melta-max" field="selections" scope="parent" value="2" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-2-dominator-cohort-opt-8-context" hidden="false"><ns0:description>• For every five models in the squad, one Dominator may replace</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Grenade Harness" hidden="false" id="r41-unit-iv-2-dominator-cohort-opt-9-grenade-harness"><ns0:constraints><ns0:constraint id="r41-unit-iv-2-dominator-cohort-opt-9-grenade-harness-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-2-dominator-cohort-opt-9-context" hidden="false"><ns0:description>• The Dominator Warden may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:entryLinks><ns0:entryLink id="r43-r41-unit-iv-2-dominator-cohort-iw-shrapnel" name="Shrapnel Bolts" type="selectionEntry" targetId="r43-iw-shrapnel-bolts" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-r41-unit-iv-2-dominator-cohort-iw-shrapnel-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="IRON CIRCLE DOMITAR-FERRUM MANIPLE" hidden="false" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple"><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Domitar-Ferrum" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">7</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">7</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">4</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">3</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-source" hidden="false"><ns0:description>Domitar-Ferrum | 4 | 4 | 7 | 7 | 4 | 3 | 3 | 8 | 3+/5+
Force Organisation:
• Elites
Unit Composition:
• 1 Domitar-Ferrum
Unit Type:
• Monstrous Creature
Wargear:
• Olympia-pattern Bolt Cannon
• Graviton Maul
• Karceri Battle Shield
Special Rules:
• Cybernetica Cortex
• Reactor Blast
• Crusader
• Moving Bulwark
• Iron Warriors Construct
OPTIONS
• The maniple may include up to five additional Domitar-Ferrum
for +205 points per model.
MOVING BULWARK If a Domitar-Ferrum is in base contact with another friendly Domitar-Ferrum from the same unit, both models improve their Invulnerable Save from 5+ to 4+. The bonus is lost as soon as the models are no longer in base contact. IRON WARRIORS CONSTRUCT The Iron Circle counts as an Iron Warriors unit for rules which specifically affect friendly Iron Warriors units. It does not possess the Legiones Astartes special rule. KARCERI BATTLE SHIELD The Karceri Battle Shield grants the Domitar-Ferrum its 5+ Invulnerable Save. This is already included in its profile. GRAVITON MAUL The Graviton Maul is a Power Weapon. Attacks made with it are resolved at Strength 10 and have the Concussive special rule. Weapon Range S AP Type Olympia-pattern Bolt Cannon 36" 5 4 Heavy 5, Pinning</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-additional"><ns0:constraints><ns0:constraint id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +205 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-3-iron-circle-domitar-ferrum-maniple-opt-0-context" hidden="false"><ns0:description>• The maniple may include up to five additional Domitar-Ferrum</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="NÂRIK DREYGUR" hidden="false" id="r41-unit-iv-4-narik-dreygur"><ns0:costs><ns0:cost name="Points" typeId="pts" value="140" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-4-narik-dreygur-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-iv-4-narik-dreygur-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Nârik Dreygur" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-4-narik-dreygur-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">3</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-4-narik-dreygur-source" hidden="false"><ns0:description>Nârik Dreygur | 5 | 5 | 4 | 4 | 3 | 5 | 3 | 9 | 2+/5+
BATTLESMITH During the Shooting phase, instead of firing a weapon, Dreygur may attempt to repair a friendly damaged Vehicle with which he is in base contact or embarked upon. On a roll of 5+, remove one Engine Damaged, Weapon Destroyed or Immobilised result. MASTER OF AUTOMATA Nârik Dreygur may join a friendly unit of Battle-Automata despite the normal restrictions on Independent Characters joining Monstrous Creatures. While Dreygur is joined to such a unit, it may use his Leadership characteristic for any Leadership tests it is required to make. CORTEX CONTROLLER Friendly Battle-Automata with a model within 6" of Dreygur automatically pass any Command Uplink or equivalent control test they are required to make. GRAVITON GAUNTLET The Graviton Gauntlet is a Power Weapon. Attacks made with it are resolved at Strength 8 and have the Unwieldy and Concussive special rules.
Unit Composition:
• 1 Nârik Dreygur
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Refractor Field
• Graviton Gauntlet
• Master-crafted Bolt Pistol
• Frag grenades
• Cortex Controller
Special Rules:
• Legiones Astartes (Iron Warriors)
• Independent Character
• Feel No Pain (5+)
• Battlesmith
• Master of Automata
OPTIONS
• Nârik Dreygur may take:
• Krak grenades ................................. +2 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-iv-4-narik-dreygur-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-iv-4-narik-dreygur-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-iv-4-narik-dreygur-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-4-narik-dreygur-opt-0-context" hidden="false"><ns0:description>• Nârik Dreygur may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="ERASMUS GOLG" hidden="false" id="r41-unit-iv-5-erasmus-golg"><ns0:costs><ns0:cost name="Points" typeId="pts" value="175" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-5-erasmus-golg-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-iv-5-erasmus-golg-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name="Erasmus Golg" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-5-erasmus-golg-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">4</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-5-erasmus-golg-source" hidden="false"><ns0:description>Erasmus Golg | 6 | 5 | 4 | 4 | 4 | 4 | 4 | 10 | 2+/4+
TERMINATOR ATTACK If Erasmus Golg is the army's Warlord, Legion Terminator Squads may be selected as Troops choices. Terminator Squads selected in this manner may not be used to fulfil the army's compulsory Troops selections. COMMAND RETINUE Golg may select a Legion Terminator Command Squad, Tyrant Siege Terminator Squad or Dominator Cohort as his retinue. The selected unit does not occupy a separate Force Organisation slot and Golg and his retinue count as a single HQ selection. EXTRICATOR Extricator is a Master-crafted Power Weapon. Attacks made with Extricator are resolved at Strength 10 and have the Unwieldy and Armourbane special rules.
Unit Composition:
• 1 Erasmus Golg
Unit Type:
• Infantry (Character)
Wargear:
• Cataphractii Terminator Armour
• Extricator
• Combi-meltagun
• Nuncio Vox
Special Rules:
• Legiones Astartes (Iron Warriors)
• Independent Character
• Master of the Legion
• Stubborn
• Terminator Attack</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="KYR VHALEN" hidden="false" id="r41-unit-iv-6-kyr-vhalen"><ns0:costs><ns0:cost name="Points" typeId="pts" value="195" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iv-6-kyr-vhalen-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Kyr Vhalen" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iv-6-kyr-vhalen-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">6</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">4</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">4</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+/4+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-6-kyr-vhalen-source" hidden="false"><ns0:description>Kyr Vhalen | 6 | 5 | 4 | 4 | 4 | 5 | 4 | 10 | 2+/4+
Unit Composition:
BATTLESMITH During the Shooting phase, instead of firing a weapon, Vhalen may attempt to repair a friendly damaged Vehicle with which he is in base contact or embarked upon. Normally the repair succeeds on a 5+. Vhalen's Servo-Arm adds +1 to this roll, so he normally succeeds on a 4+. On a successful repair, remove one Engine Damaged, Weapon Destroyed or Immobilised result. SHATTERBLADE Kyr Vhalen's Feel No Pain save is already included in his profile and special rules. In addition, Vhalen and any unit he joins have the Stubborn special rule. CORTEX CONTROLLER Friendly Battle-Automata with a model within 6" of Vhalen automatically pass any Command Uplink or equivalent control test they are required to make. AEGEAS Aegeas is a Master-crafted Rending Weapon which grants +2 Strength. In addition, attacks made with Aegeas have the Blind special rule.
• 1 Kyr Vhalen
Unit Type:
• Infantry (Character)
Wargear:
• Artificer Armour
• Iron Halo
• Aegeas
• Volkite Charger
• Servo-Arm
• Cortex Controller
• Frag grenades
• Melta bombs
Special Rules:
• Legiones Astartes (Iron Warriors)
• Independent Character
• Master of the Legion
• Feel No Pain (5+)
• Battlesmith
• Shatterblade
OPTIONS
• Kyr Vhalen may take:

tic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iv-1-iron-havoc-squad-source" hidden="false"><ns0:description>Iron Havoc | 4 | 5 | 4 | 4 | 1 | 4 | 1 | 8 | 3+
Iron Havoc Sergeant | 4 | 5 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Heavy Support
Unit Composition:
• 4 Iron Havocs
• 1 Iron Havoc Sergeant
Unit Type:
• Infantry
• The Iron Havoc Sergeant is a Character
Wargear:
• Power Armour
• Bolter
• Bolt pistol
• Frag grenades
Special Rules:
• Legiones Astartes (Iron Warriors)
OPTIONS
• The squad may include up to five additional Iron Havocs
for +25 points per model.
HEAVY WEAPONS
• Up to four Iron Havocs may replace their Bolter with:
• Heavy bolter .................................... +10 points
• Missile Launcher ................................ +15 points
• Autocannon ...................................... +20 points
• Lascannon ....................................... +30 points
SQUAD EQUIPMENT
• The entire squad may take:
• Krak grenades ................................... +2 points per model
• Tank Hunters .................................... +3 points per model
IRON HAVOC SERGEANT
• The Iron Havoc Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
• The Iron Havoc Sergeant may take:
• Signum .......................................... +15 points
ENHANCED TARGETING Iron Havocs have Ballistic Skill 5, as shown in their profile.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-iv-1-iron-havoc-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-iv-1-iron-havoc-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-iv-1-iron-havoc-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +25 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-iv-1-iron-havoc-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-iv-1-iron-havoc-squad-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-iv-1-iron-havoc-squad-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iv-1-iron-havoc-squad-opt-0-context" hidden="false"><ns0:description>• The squad may include up to five additional Iron Havocs</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy bolter" hidden="false" id="r41-unit-iv-1-iron-havoc-squad-opt-1-heavy-bolter"><ns0:constraints><ns0:constraint id="r41-unit-iv-1-iron-havoc-squad-opt-1-heavy-bolter
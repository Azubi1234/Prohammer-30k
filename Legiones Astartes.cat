        <ns0:selectionEntryGroup name="Retinue (does not occupy a separate FOC slot)" id="hq-praetor-retinue" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hq-praetor-retinue-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="unit" name="Legion Honour Guard Squad" id="hq-praetor-ret-honour" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-praetor-ret-honour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="135" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Standard Wargear" id="hq-praetor-ret-honour-std" hidden="false">
                  <ns0:description>Every model wears Artificer Armour and carries a Refractor Field, Power Weapon, Bolt Pistol and Frag Grenades.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Legiones Astartes" id="hq-praetor-ret-honour-la" hidden="false">
                  <ns0:description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Honour or Death" id="hq-praetor-ret-honour-hod" hidden="false">
                  <ns0:description>If the Legion Champion is in base contact with one or more enemy Independent Characters, he must direct all of his close-combat attacks against one of them. When attacking an enemy Independent Character in close combat, he may re-roll failed To Hit and To Wound rolls.</ns0:description>
                </ns0:rule>
                <ns0:rule name="Retinue" id="hq-praetor-ret-honour-ret" hidden="false">
                  <ns0:description>Selected for an eligible Praetor or Primarch. It occupies no separate Force Organisation slot; the commander and Honour Guard count as a single HQ selection but do not have to deploy together and operate as separate units after deployment.</ns0:description>
                </ns0:rule>

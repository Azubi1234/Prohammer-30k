    <ns0:selectionEntry type="unit" import="true" name="Lion El'Jonson, The First" hidden="false" id="da22-lion">
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="550" />
      </ns0:costs>
      <ns0:modifiers>
        <ns0:modifier type="set" value="true" field="hidden">
          <ns0:conditions>
            <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
          </ns0:conditions>
        </ns0:modifier>
        <ns0:modifier type="set" value="true" field="hidden">
          <ns0:conditions>
            <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="allegiance-loyalist" shared="true" includeChildSelections="true" includeChildForces="false" />
          </ns0:conditions>
        </ns0:modifier>
      <ns0:modifier type="set" value="true" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers>
      <ns0:constraints>
        <ns0:constraint id="da22-lion-rostermax" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
      </ns0:constraints>
      <ns0:profiles>
        <ns0:profile name="Lion El'Jonson" typeId="prof-model" typeName="Model" hidden="false" id="da22-lion-prof">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="model-ws">9</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="model-bs">6</ns0:characteristic>
            <ns0:characteristic name="S" typeId="model-s">6</ns0:characteristic>
            <ns0:characteristic name="T" typeId="model-t">6</ns0:characteristic>
            <ns0:characteristic name="W" typeId="model-w">6</ns0:characteristic>
            <ns0:characteristic name="I" typeId="model-i">7</ns0:characteristic>
            <ns0:characteristic name="A" typeId="model-a">6</ns0:characteristic>
            <ns0:characteristic name="Ld" typeId="model-ld">10</ns0:characteristic>
            <ns0:characteristic name="Sv" typeId="model-sv">1+/4++</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Fusil Actinaeus" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="da22-lion-fusil">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Salvo 2/4, Twin-linked, Blind</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Primarch / Restrictions" id="da22-lion-base" hidden="false">
          <ns0:description>Primarch; Legiones Astartes (Dark Angels). Loyalist Dark Angels only. As a Primarch: Lord of War, normally 2,000+ points, Primary Detachment only, maximum one Primarch, must be Warlord; Independent Character, Eternal Warrior, Fear, Fearless, Adamantium Will, Fleet, It Will Not Die, Master of the Legion.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Leonine Panoply" id="da22-lion-panoply" hidden="false">
          <ns0:description>Counts as Primarch Armour (1+ Armour, 4+ Invulnerable). The first failed Invulnerable Save made by the Lion during each player turn may be re-rolled.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Stasis Grenades" id="da22-lion-stasis" hidden="false">
          <ns0:description>If the Lion and joined unit successfully charge, or are successfully charged, all enemy units engaged as a result are Initiative 1 until end of current player turn. Neither Assault nor Defensive Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="An Absolute Focus" id="da22-lion-focus" hidden="false">
          <ns0:description>May never require worse than 4+ To Hit in close combat regardless of enemy Weapon Skill or modifiers.</ns0:description>
        </ns0:rule>
        <ns0:rule name="The Point of the Blade" id="da22-lion-point" hidden="false">
          <ns0:description>The Lion and any unit he joins may declare charges against enemy units up to 8" away instead of 6". Difficult Terrain does not reduce this; Dangerous Terrain resolves normally.</ns0:description>
        </ns0:rule>
        <ns0:rule name="The Lion's Choler" id="da22-lion-choler" hidden="false">
          <ns0:description>At 4 Wounds or fewer, +1 Attack. At 2 Wounds or fewer, +2 Attacks instead. Not cumulative.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Knight of Knights" id="da22-lion-knight" hidden="false">
          <ns0:description>Each Assault phase in which he directs attacks against an enemy Independent Character or Primarch, re-roll one failed To Hit OR one failed To Wound against such a model; second result accepted.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Primarch Retinue" id="da22-lion-ret" hidden="false">
          <ns0:description>May select one Legion Honour Guard, Legion Terminator Command Squad, Deathwing Companion Detachment or Deathwing Terminator Companion Detachment as a slotless Primarch Retinue. Terminator Companions may be selected despite the Lion not wearing Terminator Armour.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Choose Weapon" hidden="false" id="da22-lion-blade" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da22-lion-blade-min" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da22-lion-blade-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="The Lion Sword" hidden="false" id="da22-lion-sword">
              <ns0:constraints>
                <ns0:constraint id="da22-lion-sword-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="The Lion Sword" id="da22-lion-sword-rule" hidden="false">
                  <ns0:description>Master-crafted, Two-Handed Power Weapon; attacks at +1 Strength with Fleshbane and Lance; sword-type for Dark Angels rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="The Wolf Blade" hidden="false" id="da22-lion-wolf">
              <ns0:constraints>
                <ns0:constraint id="da22-lion-wolf-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="The Wolf Blade" id="da22-lion-wolf-rule" hidden="false">
                  <ns0:description>Two-Handed Power Weapon; attacks at +3 Strength with Shred; sword-type for Dark Angels rules.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    <ns0:categoryLinks><ns0:categoryLink id="da22-lion-cat" targetId="cat-low" name="Lords of War" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry>
  <ns0:selectionEntry type="unit" import="true" name="Legion Cerberus Heavy Tank Destroyer" hidden="false" id="r32-low-cerberus"><ns0:costs><ns0:cost name="Points" typeId="pts" value="395" /></ns0:costs><ns0:profiles><ns0:profile name="Cerberus Heavy Tank Destroyer" id="r32-low-cerberus-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">13</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Neutron Laser Battery" id="r32-low-cerberus-weapon-neutron-laser-battery-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance D3, Blast, Twin-linked, Concussive, Shock Pulse, Feedback</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-cerberus-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-cerberus-wargear" hidden="false"><ns0:description>Twin-linked Neutron Laser Battery; Searchlight; Smoke Launchers; Flare Shield.</ns0:description></ns0:rule><ns0:rule name="Shock Pulse" id="r32-low-cerberus-weapon-neutron-laser-battery-wr-0-shock-pulse" hidden="false"><ns0:description>A Vehicle suffering a Penetrating Hit may only fire Snap Shots in its following Shooting phase.</ns0:description></ns0:rule><ns0:rule name="Feedback" id="r32-low-cerberus-weapon-neutron-laser-battery-wr-0-feedback" hidden="false"><ns0:description>Whenever this weapon fails an Armour Penetration roll, or fails to wound a non-Vehicle model, roll a D6. On a 1 a firing Vehicle suffers one Glancing Hit; a non-Vehicle firing model suffers one Wound with no Armour Save allowed.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-cerberus-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-cerberus-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-cerberus-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-cerberus-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-cerberus-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-cerberus-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-cerberus-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Flare Shield" id="r32-low-cerberus-flare" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</ns0:description></ns0:rule><ns0:rule name="Reactor Blast" id="r32-low-cerberus-reactor" hidden="false"><ns0:description>When the Cerberus is finally destroyed, add +1 to the Catastrophic Destruction roll.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-cerberus-hk"><ns0:constraints><ns0:constraint id="r32-low-cerberus-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-cerberus-ceramite"><ns0:constraints><ns0:constraint id="r32-low-cerberus-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-cerberus-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-low-cerberus-sponsons" name="Sponsons" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-cerberus-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter Sponsons" hidden="false" id="r32-low-cerberus-sponson-heavy-bolter-sponsons"><ns0:constraints><ns0:constraint id="r32-low-cerberus-sponson-heavy-bolter-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-cerberus-sponson-heavy-bolter-sponsons-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Lascannon Sponsons" hidden="false" id="r32-low-cerberus-sponson-lascannon-sponsons"><ns0:constraints><ns0:constraint id="r32-low-cerberus-sponson-lascannon-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="40" /></ns0:costs><ns0:profiles><ns0:profile name="Lascannon" id="r32-low-cerberus-sponson-lascannon-sponsons-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup id="r32-low-cerberus-pintle" name="Pintle-mounted Weapon" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="r32-low-cerberus-pintle-twin-linked-bolter"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-twin-linked-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Bolter" id="r32-low-cerberus-pintle-twin-linked-bolter-twin-linked-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-weapon" hidden="false" id="r32-low-cerberus-pintle-combi-weapon"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-combi-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Combi-weapon" id="r32-low-cerberus-pintle-combi-weapon-combi-weapon-missing" hidden="false"><ns0:description>Profile supplied by the ProHammer Core Rules or the Legiones Astartes army list.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="r32-low-cerberus-pintle-heavy-bolter"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-heavy-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-cerberus-pintle-heavy-bolter-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r32-low-cerberus-pintle-heavy-flamer"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-heavy-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Flamer" id="r32-low-cerberus-pintle-heavy-flamer-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r32-low-cerberus-pintle-multi-melta"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-multi-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r32-low-cerberus-pintle-multi-melta-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="r32-low-cerberus-pintle-havoc-launcher"><ns0:constraints><ns0:constraint id="r32-low-cerberus-pintle-havoc-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Havoc Launcher" id="r32-low-cerberus-pintle-havoc-launcher-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r32-low-cerberus-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Typhon Heavy Siege Tank" hidden="false" id="r32-low-typhon"><ns0:costs><ns0:cost name="Points" typeId="pts" value="395" /></ns0:costs><ns0:profiles><ns0:profile name="Typhon Heavy Siege Tank" id="r32-low-typhon-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Dreadhammer Siege Cannon — Standard" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast, Ignores Cover</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Dreadhammer Siege Cannon — Diverted" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast, Ignores, Divert Power</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-typhon-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-typhon-wargear" hidden="false"><ns0:description>Dreadhammer Siege Cannon; Searchlight; Smoke Launchers.</ns0:description></ns0:rule><ns0:rule name="Massive Blast" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-wr-0-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Massive Blast" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-wr-1-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Divert Power" id="r32-low-typhon-weapon-dreadhammer-siege-cannon-wr-1-divert-power" hidden="false"><ns0:description>This profile may only be used if the firing vehicle did not move in its Movement phase.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-typhon-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-typhon-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-typhon-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-typhon-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-typhon-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-typhon-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-typhon-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Crushing Weight" id="r32-low-typhon-crushing" hidden="false"><ns0:description>Enemy units taking a Tank Shock Test caused by the Typhon suffer an additional -1 Leadership. When the Typhon Rams, add +1 to its Armour Penetration roll.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-typhon-hk"><ns0:constraints><ns0:constraint id="r32-low-typhon-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-typhon-ceramite"><ns0:constraints><ns0:constraint id="r32-low-typhon-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-typhon-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-low-typhon-sponsons" name="Sponsons" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-typhon-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter Sponsons" hidden="false" id="r32-low-typhon-sponson-heavy-bolter-sponsons"><ns0:constraints><ns0:constraint id="r32-low-typhon-sponson-heavy-bolter-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-typhon-sponson-heavy-bolter-sponsons-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Lascannon Sponsons" hidden="false" id="r32-low-typhon-sponson-lascannon-sponsons"><ns0:constraints><ns0:constraint id="r32-low-typhon-sponson-lascannon-sponsons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="40" /></ns0:costs><ns0:profiles><ns0:profile name="Lascannon" id="r32-low-typhon-sponson-lascannon-sponsons-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup id="r32-low-typhon-pintle" name="Pintle-mounted Weapon" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="r32-low-typhon-pintle-twin-linked-bolter"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-twin-linked-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Bolter" id="r32-low-typhon-pintle-twin-linked-bolter-twin-linked-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-weapon" hidden="false" id="r32-low-typhon-pintle-combi-weapon"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-combi-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Combi-weapon" id="r32-low-typhon-pintle-combi-weapon-combi-weapon-missing" hidden="false"><ns0:description>Profile supplied by the ProHammer Core Rules or the Legiones Astartes army list.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="r32-low-typhon-pintle-heavy-bolter"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-heavy-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-typhon-pintle-heavy-bolter-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r32-low-typhon-pintle-heavy-flamer"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-heavy-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Flamer" id="r32-low-typhon-pintle-heavy-flamer-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r32-low-typhon-pintle-multi-melta"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-multi-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r32-low-typhon-pintle-multi-melta-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="r32-low-typhon-pintle-havoc-launcher"><ns0:constraints><ns0:constraint id="r32-low-typhon-pintle-havoc-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Havoc Launcher" id="r32-low-typhon-pintle-havoc-launcher-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r32-low-typhon-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Falchion Super-heavy Tank Destroyer" hidden="false" id="r32-low-falchion"><ns0:costs><ns0:cost name="Points" typeId="pts" value="525" /></ns0:costs><ns0:profiles><ns0:profile name="Falchion Super-heavy Tank Destroyer" id="r32-low-falchion-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:modifiers><ns0:modifier type="set" field="vehicle-bs" value="4" id="r32-low-falchion-bs"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-falchion-crew" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">3</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Volcano Cannon" id="r32-low-falchion-weapon-twin-linked-volcano-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">120"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Titan Killer, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Quad Lascannon" id="r32-low-falchion-weapon-quad-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-falchion-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-falchion-wargear" hidden="false"><ns0:description>Twin-linked Volcano Cannon; Two Quad Lascannon Sponsons; Searchlight; Smoke Launchers.</ns0:description></ns0:rule><ns0:rule name="Titan Killer" id="r32-low-falchion-weapon-twin-linked-volcano-cannon-wr-0-titan-killer" hidden="false"><ns0:description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-falchion-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-falchion-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-falchion-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-falchion-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-falchion-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-falchion-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-falchion-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-falchion-hk"><ns0:constraints><ns0:constraint id="r32-low-falchion-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Auxiliary Drive" hidden="false" id="r32-low-falchion-aux"><ns0:constraints><ns0:constraint id="r32-low-falchion-aux-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Auxiliary Drive" id="r32-low-falchion-aux-effect" hidden="false"><ns0:description>At the start of the Movement phase, if Immobilised, roll a D6. On a 4+ remove Immobilised and the vehicle may move normally that turn.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-falchion-ceramite"><ns0:constraints><ns0:constraint id="r32-low-falchion-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-falchion-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Space Marine Legion Crew" hidden="false" id="r32-low-falchion-crew"><ns0:constraints><ns0:constraint id="r32-low-falchion-crew-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Space Marine Legion Crew" id="r32-low-falchion-crew-effect" hidden="false"><ns0:description>The vehicle has Ballistic Skill 4.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Neutron Wave Capacitor" hidden="false" id="r32-low-falchion-neutron"><ns0:constraints><ns0:constraint id="r32-low-falchion-neutron-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Volcano Cannon" id="r32-low-falchion-neutron-volcano-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">120"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Titan Killer, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Neutron Wave Capacitor" id="r32-low-falchion-neutron-rule" hidden="false"><ns0:description>The Twin-linked Volcano Cannon gains Shock Pulse and Feedback.</ns0:description></ns0:rule><ns0:rule name="Titan Killer" id="r32-low-falchion-neutron-volcano-wr-0-titan-killer" hidden="false"><ns0:description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-low-falchion-pintle" name="Pintle-mounted Weapon" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="r32-low-falchion-pintle-twin-linked-bolter"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-twin-linked-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Bolter" id="r32-low-falchion-pintle-twin-linked-bolter-twin-linked-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-weapon" hidden="false" id="r32-low-falchion-pintle-combi-weapon"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-combi-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Combi-weapon" id="r32-low-falchion-pintle-combi-weapon-combi-weapon-missing" hidden="false"><ns0:description>Profile supplied by the ProHammer Core Rules or the Legiones Astartes army list.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r32-low-falchion-pintle-heavy-flamer"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-heavy-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Flamer" id="r32-low-falchion-pintle-heavy-flamer-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="r32-low-falchion-pintle-havoc-launcher"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-havoc-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Havoc Launcher" id="r32-low-falchion-pintle-havoc-launcher-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="r32-low-falchion-pintle-heavy-bolter"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-heavy-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-falchion-pintle-heavy-bolter-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r32-low-falchion-pintle-multi-melta"><ns0:constraints><ns0:constraint id="r32-low-falchion-pintle-multi-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r32-low-falchion-pintle-multi-melta-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r32-low-falchion-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Stormblade Super-heavy Tank" hidden="false" id="r32-low-stormblade"><ns0:costs><ns0:cost name="Points" typeId="pts" value="455" /></ns0:costs><ns0:profiles><ns0:profile name="Stormblade Super-heavy Tank" id="r32-low-stormblade-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:modifiers><ns0:modifier type="set" field="vehicle-bs" value="4" id="r32-low-stormblade-bs"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-stormblade-crew" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">3</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Plasma Blastgun — Rapid" id="r32-low-stormblade-weapon-plasma-blastgun-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 2, Massive Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Plasma Blastgun — Overload" id="r32-low-stormblade-weapon-plasma-blastgun-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">96"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Apocalyptic Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Heavy Bolter" id="r32-low-stormblade-weapon-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-stormblade-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-stormblade-wargear" hidden="false"><ns0:description>Plasma Blastgun; Hull-mounted Heavy Bolter; Searchlight; Smoke Launchers.</ns0:description></ns0:rule><ns0:rule name="Massive Blast" id="r32-low-stormblade-weapon-plasma-blastgun-wr-0-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Apocalyptic Blast" id="r32-low-stormblade-weapon-plasma-blastgun-wr-1-apocalyptic-blast" hidden="false"><ns0:description>Uses the 10 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-stormblade-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-stormblade-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-stormblade-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-stormblade-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-stormblade-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-stormblade-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-stormblade-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Sponson Pair (Lascannon + Twin-linked Heavy Bolter)" hidden="false" id="r32-low-stormblade-sponson"><ns0:constraints><ns0:constraint id="r32-low-stormblade-sponson-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:profiles><ns0:profile name="Lascannon" id="r32-low-stormblade-sponson-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-stormblade-sponson-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace a sponson Twin-linked Heavy Bolter with Twin-linked Heavy Flamer" hidden="false" id="r32-low-stormblade-flamer"><ns0:constraints><ns0:constraint id="r32-low-stormblade-flamer-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Twin-linked Heavy Flamer" id="r32-low-stormblade-flamer-twin-linked-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-stormblade-hk"><ns0:constraints><ns0:constraint id="r32-low-stormblade-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-stormblade-ceramite"><ns0:constraints><ns0:constraint id="r32-low-stormblade-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-stormblade-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Super-heavy Command Tank" hidden="false" id="r32-low-stormblade-command"><ns0:constraints><ns0:constraint id="r32-low-stormblade-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Super-heavy Command Tank" id="r32-low-stormblade-command-effect" hidden="false"><ns0:description>Friendly Infantry units within 24 inches may re-roll failed Morale Tests.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Space Marine Legion Crew" hidden="false" id="r32-low-stormblade-crew"><ns0:constraints><ns0:constraint id="r32-low-stormblade-crew-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Space Marine Legion Crew" id="r32-low-stormblade-crew-effect" hidden="false"><ns0:description>The vehicle has Ballistic Skill 4.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-low-stormblade-pintle" name="Pintle-mounted Weapon" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="r32-low-stormblade-pintle-twin-linked-bolter"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-twin-linked-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Bolter" id="r32-low-stormblade-pintle-twin-linked-bolter-twin-linked-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-weapon" hidden="false" id="r32-low-stormblade-pintle-combi-weapon"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-combi-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Combi-weapon" id="r32-low-stormblade-pintle-combi-weapon-combi-weapon-missing" hidden="false"><ns0:description>Profile supplied by the ProHammer Core Rules or the Legiones Astartes army list.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="r32-low-stormblade-pintle-heavy-bolter"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-heavy-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-stormblade-pintle-heavy-bolter-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r32-low-stormblade-pintle-heavy-flamer"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-heavy-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Flamer" id="r32-low-stormblade-pintle-heavy-flamer-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r32-low-stormblade-pintle-multi-melta"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-multi-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r32-low-stormblade-pintle-multi-melta-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="r32-low-stormblade-pintle-havoc-launcher"><ns0:constraints><ns0:constraint id="r32-low-stormblade-pintle-havoc-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Havoc Launcher" id="r32-low-stormblade-pintle-havoc-launcher-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r32-low-stormblade-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Fellblade Super-heavy Tank" hidden="false" id="r32-low-fellblade"><ns0:costs><ns0:cost name="Points" typeId="pts" value="525" /></ns0:costs><ns0:profiles><ns0:profile name="Fellblade Super-heavy Tank" id="r32-low-fellblade-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:modifiers><ns0:modifier type="set" field="vehicle-bs" value="4" id="r32-low-fellblade-bs"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-fellblade-crew" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">3</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Fellblade Accelerator Cannon — HE" id="r32-low-fellblade-weapon-fellblade-accelerator-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">100"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Fellblade Accelerator Cannon — AE" id="r32-low-fellblade-weapon-fellblade-accelerator-cannon-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">100"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Armourbane, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Quad Lascannon" id="r32-low-fellblade-weapon-quad-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-fellblade-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Demolisher Siege Cannon" id="r32-low-fellblade-weapon-demolisher-siege-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-fellblade-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-fellblade-wargear" hidden="false"><ns0:description>Twin-linked Fellblade Accelerator Cannon; Two Quad Lascannon Sponsons; Twin-linked Heavy Bolter; Demolisher Siege Cannon; Searchlight; Smoke Launchers.</ns0:description></ns0:rule><ns0:rule name="Massive Blast" id="r32-low-fellblade-weapon-fellblade-accelerator-cannon-wr-0-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-fellblade-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-fellblade-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-fellblade-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-fellblade-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-fellblade-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-fellblade-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-fellblade-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Replace Quad Lascannon Sponsons with Laser Destroyer Sponsons" hidden="false" id="r32-low-fellblade-laser"><ns0:constraints><ns0:constraint id="r32-low-fellblade-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Laser Destroyer" id="r32-low-fellblade-laser-laser-destroyer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace Twin-linked Heavy Bolter with Twin-linked Heavy Flamer" hidden="false" id="r32-low-fellblade-flamer"><ns0:constraints><ns0:constraint id="r32-low-fellblade-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Twin-linked Heavy Flamer" id="r32-low-fellblade-flamer-twin-linked-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-fellblade-hk"><ns0:constraints><ns0:constraint id="r32-low-fellblade-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-fellblade-ceramite"><ns0:constraints><ns0:constraint id="r32-low-fellblade-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-fellblade-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Super-heavy Command Tank" hidden="false" id="r32-low-fellblade-command"><ns0:constraints><ns0:constraint id="r32-low-fellblade-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Super-heavy Command Tank" id="r32-low-fellblade-command-effect" hidden="false"><ns0:description>Friendly Infantry units within 24 inches may re-roll failed Morale Tests.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Space Marine Legion Crew" hidden="false" id="r32-low-fellblade-crew"><ns0:constraints><ns0:constraint id="r32-low-fellblade-crew-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Space Marine Legion Crew" id="r32-low-fellblade-crew-effect" hidden="false"><ns0:description>The vehicle has Ballistic Skill 4.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-low-fellblade-pintle" name="Pintle-mounted Weapon" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="r32-low-fellblade-pintle-twin-linked-bolter"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-twin-linked-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Bolter" id="r32-low-fellblade-pintle-twin-linked-bolter-twin-linked-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Combi-weapon" hidden="false" id="r32-low-fellblade-pintle-combi-weapon"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-combi-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Combi-weapon" id="r32-low-fellblade-pintle-combi-weapon-combi-weapon-missing" hidden="false"><ns0:description>Profile supplied by the ProHammer Core Rules or the Legiones Astartes army list.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="r32-low-fellblade-pintle-heavy-flamer"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-heavy-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Flamer" id="r32-low-fellblade-pintle-heavy-flamer-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter" hidden="false" id="r32-low-fellblade-pintle-heavy-bolter"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-heavy-bolter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Heavy Bolter" id="r32-low-fellblade-pintle-heavy-bolter-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Multi-Melta" hidden="false" id="r32-low-fellblade-pintle-multi-melta"><ns0:constraints><ns0:constraint id="r32-low-fellblade-pintle-multi-melta-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Multi-Melta" id="r32-low-fellblade-pintle-multi-melta-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r32-low-fellblade-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Glaive Super-heavy Special Weapons Tank" hidden="false" id="r32-low-glaive"><ns0:costs><ns0:cost name="Points" typeId="pts" value="625" /></ns0:costs><ns0:profiles><ns0:profile name="Glaive Super-heavy Special Weapons Tank" id="r32-low-glaive-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Volkite Carronade" id="r32-low-glaive-weapon-volkite-carronade-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Heavy Beam, Deflagrate, Haywire, Ignores Cover</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Quad Lascannon" id="r32-low-glaive-weapon-quad-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-glaive-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-glaive-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-glaive-wargear" hidden="false"><ns0:description>Volkite Carronade; Two Quad Lascannon Sponsons; Twin-linked Heavy Bolter; Searchlight; Smoke Launchers.</ns0:description></ns0:rule><ns0:rule name="Heavy Beam" id="r32-low-glaive-weapon-volkite-carronade-wr-0-heavy-beam" hidden="false"><ns0:description>Draw a 1 inch wide line from the barrel to maximum range. The first touched model must be an enemy. Every model under the beam suffers one automatic hit; vehicles are struck against the facing from which the beam entered.</ns0:description></ns0:rule><ns0:rule name="Deflagrate" id="r32-low-glaive-weapon-volkite-carronade-wr-0-deflagrate" hidden="false"><ns0:description>After resolving attacks, immediately resolve one additional automatic hit against the same unit for each unsaved Wound caused. These extra hits cannot generate further hits.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-glaive-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-glaive-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-glaive-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-glaive-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-glaive-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-glaive-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-glaive-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Replace Quad Lascannon Sponsons with Laser Destroyer Sponsons" hidden="false" id="r32-low-glaive-laser"><ns0:constraints><ns0:constraint id="r32-low-glaive-laser-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Laser Destroyer" id="r32-low-glaive-laser-laser-destroyer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace Twin-linked Heavy Bolter with Twin-linked Heavy Flamer" hidden="false" id="r32-low-glaive-flamer"><ns0:constraints><ns0:constraint id="r32-low-glaive-flamer-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Twin-linked Heavy Flamer" id="r32-low-glaive-flamer-twin-linked-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-glaive-hk"><ns0:constraints><ns0:constraint id="r32-low-glaive-hk-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-low-glaive-ceramite"><ns0:constraints><ns0:constraint id="r32-low-glaive-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-low-glaive-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r32-low-glaive-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Mastodon Heavy Assault Transport" hidden="false" id="r32-low-mastodon"><ns0:costs><ns0:cost name="Points" typeId="pts" value="700" /></ns0:costs><ns0:profiles><ns0:profile name="Mastodon Heavy Assault Transport" id="r32-low-mastodon-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">14</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">14</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">4</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Siege Melta Array" id="r32-low-mastodon-weapon-siege-melta-array-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Blast, Melta, Stone Burner</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Heavy Flamer" id="r32-low-mastodon-weapon-heavy-flamer-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Lascannon" id="r32-low-mastodon-weapon-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Skyreaper Battery" id="r32-low-mastodon-weapon-skyreaper-battery-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 5, Twin-linked, Skyfire, Interceptor</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-mastodon-type" hidden="false"><ns0:description>Vehicle (Tank, Super-heavy)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-mastodon-wargear" hidden="false"><ns0:description>Siege Melta Array; Two Heavy Flamers; Two Lascannons; Skyreaper Battery; Smoke Launchers; Searchlight; Armoured Ceramite; Two Void Shields.</ns0:description></ns0:rule><ns0:rule name="Stone Burner" id="r32-low-mastodon-weapon-siege-melta-array-wr-0-stone-burner" hidden="false"><ns0:description>A Penetrating Hit against a Building or Fortification becomes D3 Penetrating Hits.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-mastodon-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-mastodon-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-mastodon-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-mastodon-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-mastodon-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-mastodon-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-mastodon-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-low-mastodon-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule><ns0:rule name="Two Void Shields" id="r32-low-mastodon-void" hidden="false"><ns0:description>The Mastodon is protected by two Void Shields. A Void Shield has Armour Value 12. Shooting hits are resolved against active shields before the vehicle. A Glancing or Penetrating Hit collapses one shield. At the end of each controlling player's turn each collapsed shield is restored on a 5+.</ns0:description></ns0:rule><ns0:rule name="Assault Vehicle" id="r32-low-mastodon-assault" hidden="false"><ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description></ns0:rule><ns0:rule name="Enhanced Defensive Fire" id="r32-low-mastodon-defensive" hidden="false"><ns0:description>If at least one friendly unit is embarked, the Mastodon may make a Stand &amp; Shoot reaction when charged. Only its sponson weapons may fire; Lascannons fire at BS2 and Heavy Flamers inflict D3+1 automatic hits against an eligible charging unit in arc.</ns0:description></ns0:rule><ns0:rule name="Reinforced Shell" id="r32-low-mastodon-shell" hidden="false"><ns0:description>Subtract 2 from Catastrophic Destruction rolls. If the modified result is 0 or less, the Mastodon is destroyed without exploding and its hull becomes a Ruin. Embarked models suffer an S4 hit; transported vehicles are struck against their lowest Armour Value.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-low-mastodon-cap" hidden="false"><ns0:description>40 models. Up to two Dreadnoughts may be transported, each counting as 10 models.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-low-mastodon-access" hidden="false"><ns0:description>One front access point and one rear access point. No Fire Points.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Super-heavy Command Tank" hidden="false" id="r32-low-mastodon-command"><ns0:constraints><ns0:constraint id="r32-low-mastodon-command-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Super-heavy Command Tank" id="r32-low-mastodon-command-effect" hidden="false"><ns0:description>Friendly Infantry units within 24 inches may re-roll failed Morale Tests.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="r32-low-mastodon-hk"><ns0:constraints><ns0:constraint id="r32-low-mastodon-hk-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Command Vox Relay" hidden="false" id="r32-low-mastodon-vox"><ns0:constraints><ns0:constraint id="r32-low-mastodon-vox-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:rules><ns0:rule name="Command Vox Relay" id="r32-low-mastodon-vox-rule" hidden="false"><ns0:description>Replaces the Skyreaper Battery. While on the battlefield, add +1 or subtract -1 from friendly Reserve rolls. When an enemy suffers a Deep Strike Mishap, the controlling player may reposition it up to 18 inches from its intended target instead of 12 inches.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r32-low-mastodon-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Thunderhawk Transporter" hidden="false" id="r32-low-transporter"><ns0:costs><ns0:cost name="Points" typeId="pts" value="400" /></ns0:costs><ns0:profiles><ns0:profile name="Thunderhawk Transporter" id="r32-low-transporter-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:modifiers><ns0:modifier type="set" field="vehicle-rear" value="12" id="r32-low-transporter-rear"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-transporter-voidhull" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">10</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-transporter-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-transporter-type" hidden="false"><ns0:description>Vehicle (Super-heavy, Flyer, Hover, Transport)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-transporter-wargear" hidden="false"><ns0:description>Four Twin-linked Heavy Bolters; Armoured Ceramite.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-transporter-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-transporter-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-transporter-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-transporter-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-transporter-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-transporter-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-transporter-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-low-transporter-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule><ns0:rule name="Loading Vehicles" id="r32-low-transporter-load" hidden="false"><ns0:description>While Hovering, an empty Transporter may move over a stationary friendly vehicle that has not moved that turn; that vehicle is embarked. The Transporter may move normally from its following turn.</ns0:description></ns0:rule><ns0:rule name="Unloading Vehicles" id="r32-low-transporter-unload" hidden="false"><ns0:description>If the Transporter remains stationary while Hovering, transported vehicles may disembark and move normally that turn.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-low-transporter-cap" hidden="false"><ns0:description>15 models, plus either two Rhino-sized vehicles or one Land Raider-sized vehicle. Transported vehicles may contain passengers.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-low-transporter-access" hidden="false"><ns0:description>One access hatch on each side of the cockpit section.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Chaff Launcher" hidden="false" id="r32-low-transporter-chaff-launcher"><ns0:constraints><ns0:constraint id="r32-low-transporter-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Chaff Launcher" id="r32-low-transporter-chaff-launcher-effect" hidden="false"><ns0:description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="r32-low-transporter-armoured-cockpit"><ns0:constraints><ns0:constraint id="r32-low-transporter-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Cockpit" id="r32-low-transporter-armoured-cockpit-effect" hidden="false"><ns0:description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Illum Flares" hidden="false" id="r32-low-transporter-illum-flares"><ns0:constraints><ns0:constraint id="r32-low-transporter-illum-flares-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Illum Flares" id="r32-low-transporter-illum-flares-effect" hidden="false"><ns0:description>May drop one flare in each friendly Movement phase in the same manner as a Bomb. After scatter, friendly units firing at an enemy with at least one model within 12 inches of the marker gain Night Vision for that Shooting phase.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Flare Shield" hidden="false" id="r32-low-transporter-flare-shield"><ns0:constraints><ns0:constraint id="r32-low-transporter-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Flare Shield" id="r32-low-transporter-flare-shield-effect" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-transporter-ramjet-diffraction-grid"><ns0:constraints><ns0:constraint id="r32-low-transporter-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Ramjet Diffraction Grid" id="r32-low-transporter-ramjet-diffraction-grid-effect" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-transporter-voidhull"><ns0:constraints><ns0:constraint id="r32-low-transporter-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:rules><ns0:rule name="Void-crafted Hull" id="r32-low-transporter-voidhull-rule" hidden="false"><ns0:description>Increase the Thunderhawk Transporter's Rear Armour from 10 to 12.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Hellstrike Missile" hidden="false" id="r32-low-transporter-hellstrike"><ns0:constraints><ns0:constraint id="r32-low-transporter-hellstrike-max" type="max" value="6" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Hellstrike Missile" id="r32-low-transporter-hellstrike-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Sunder" id="r32-low-transporter-hellstrike-hellstrike-missile-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r32-low-transporter-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Thunderhawk Gunship" hidden="false" id="r32-low-thunderhawk"><ns0:costs><ns0:cost name="Points" typeId="pts" value="685" /></ns0:costs><ns0:profiles><ns0:profile name="Thunderhawk Gunship" id="r32-low-thunderhawk-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:modifiers><ns0:modifier type="set" field="vehicle-rear" value="12" id="r32-low-thunderhawk-rear"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="r32-low-thunderhawk-voidhull" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">10</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">3</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Thunderhawk Cannon" id="r32-low-thunderhawk-weapon-thunderhawk-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-thunderhawk-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Hellstrike Missile" id="r32-low-thunderhawk-weapon-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Lascannon" id="r32-low-thunderhawk-weapon-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-thunderhawk-type" hidden="false"><ns0:description>Vehicle (Super-heavy, Flyer, Hover, Transport)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-thunderhawk-wargear" hidden="false"><ns0:description>Thunderhawk Cannon; Four Twin-linked Heavy Bolters; Six Hellstrike Missiles; Two Lascannons; Armoured Ceramite; Power of the Machine Spirit.</ns0:description></ns0:rule><ns0:rule name="Massive Blast" id="r32-low-thunderhawk-weapon-thunderhawk-cannon-wr-0-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Sunder" id="r32-low-thunderhawk-weapon-hellstrike-missile-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-thunderhawk-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-thunderhawk-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-thunderhawk-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-thunderhawk-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-thunderhawk-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-thunderhawk-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-thunderhawk-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-low-thunderhawk-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule><ns0:rule name="Power of the Machine Spirit" id="r32-low-thunderhawk-potms" hidden="false"><ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description></ns0:rule><ns0:rule name="Assault Vehicle" id="r32-low-thunderhawk-assault" hidden="false"><ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-low-thunderhawk-cap" hidden="false"><ns0:description>30 models. May transport Dreadnoughts, each counting as 10 models, as well as Jump Infantry and Bikes. Dreadnoughts may only embark or disembark through the forward ramp.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-low-thunderhawk-access" hidden="false"><ns0:description>One access hatch on each side and one forward assault ramp.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Replace Thunderhawk Cannon with Turbo-laser Destructor" hidden="false" id="r32-low-thunderhawk-turbo"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-turbo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="90" /></ns0:costs><ns0:profiles><ns0:profile name="Turbo-laser Destructor" id="r32-low-thunderhawk-turbo-turbo-laser-destructor-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">96"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Large Blast, Titan Killer</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Titan Killer" id="r32-low-thunderhawk-turbo-turbo-laser-destructor-wr-0-titan-killer" hidden="false"><ns0:description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace six Hellstrike Missiles with six Thunderhawk Cluster Bombs" hidden="false" id="r32-low-thunderhawk-bombs"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-bombs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="60" /></ns0:costs><ns0:profiles><ns0:profile name="Thunderhawk Cluster Bomb" id="r32-low-thunderhawk-bombs-thunderhawk-cluster-bomb-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">—</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Bomb 6, Barrage, Large Blast, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Chaff Launcher" hidden="false" id="r32-low-thunderhawk-chaff-launcher"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Chaff Launcher" id="r32-low-thunderhawk-chaff-launcher-effect" hidden="false"><ns0:description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="r32-low-thunderhawk-armoured-cockpit"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Cockpit" id="r32-low-thunderhawk-armoured-cockpit-effect" hidden="false"><ns0:description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Flare Shield" hidden="false" id="r32-low-thunderhawk-flare-shield"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-flare-shield-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Flare Shield" id="r32-low-thunderhawk-flare-shield-effect" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike the Front Armour by 1, or by 2 if the weapon has Blast or Template. No effect against close combat, Haywire or Titan Killer.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-low-thunderhawk-ramjet-diffraction-grid"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:rules><ns0:rule name="Ramjet Diffraction Grid" id="r32-low-thunderhawk-ramjet-diffraction-grid-effect" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim Cover Saves from Night Fighting.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Void-crafted Hull" hidden="false" id="r32-low-thunderhawk-voidhull"><ns0:constraints><ns0:constraint id="r32-low-thunderhawk-voidhull-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:rules><ns0:rule name="Void-crafted Hull" id="r32-low-thunderhawk-voidhull-rule" hidden="false"><ns0:description>Increase the Thunderhawk's Rear Armour from 10 to 12.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r32-low-thunderhawk-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Sokar Pattern Stormbird" hidden="false" id="r32-low-stormbird"><ns0:costs><ns0:cost name="Points" typeId="pts" value="850" /></ns0:costs><ns0:profiles><ns0:profile name="Sokar Pattern Stormbird" id="r32-low-stormbird-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">14</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic><ns0:characteristic name="SP" typeId="vehicle-sp">4</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Lascannon" id="r32-low-stormbird-weapon-twin-linked-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-low-stormbird-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Dreadstrike Missile" id="r32-low-stormbird-weapon-dreadstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">120"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Blast, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-low-stormbird-type" hidden="false"><ns0:description>Vehicle (Super-heavy, Flyer, Hover, Transport)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-low-stormbird-wargear" hidden="false"><ns0:description>Four Twin-linked Lascannon Turrets; Three Twin-linked Heavy Bolters; Six Dreadstrike Missiles; Armoured Ceramite; Power of the Machine Spirit; Dual Void Shield Generator.</ns0:description></ns0:rule><ns0:rule name="Structure Points" id="r32-low-stormbird-low-0" hidden="false"><ns0:description>A Super-heavy Vehicle uses the number of Structure Points listed in its unit entry. When it suffers a Wrecked or Explodes! result while one or more Structure Points remain, one Structure Point is expended and the result is reduced sufficiently for the vehicle to survive. Once no Structure Points remain, a subsequent Wrecked or Explodes! result destroys it. Structure Points may also be used to Jury-Rig damage as normal.</ns0:description></ns0:rule><ns0:rule name="Massive Firepower" id="r32-low-stormbird-low-1" hidden="false"><ns0:description>A Super-heavy Vehicle may fire Ordnance weapons without preventing its other weapons from firing, automatically passes Split Fire tests, and each weapon may fire at a separate eligible target subject to normal range, Line of Sight and firing arc.</ns0:description></ns0:rule><ns0:rule name="Lumbering War Engine" id="r32-low-stormbird-low-2" hidden="false"><ns0:description>Unless otherwise stated, a Super-heavy Vehicle may move up to 6" and fire all weapons normally whether stationary or moving up to 6". It may pivot up to 90 degrees during the move and may not move Flat Out unless specifically permitted. This rule does not apply to Super-heavy Flyers, which use the normal Flyer movement rules.</ns0:description></ns0:rule><ns0:rule name="Super-heavy Tank Shock" id="r32-low-stormbird-low-3" hidden="false"><ns0:description>A Super-heavy Vehicle with the Tank unit type may Tank Shock and Ram using the normal ProHammer rules. Enemy units taking a Tank Shock Test caused by it suffer -1 Leadership.</ns0:description></ns0:rule><ns0:rule name="Crushing Advance" id="r32-low-stormbird-low-4" hidden="false"><ns0:description>Super-heavy Vehicles ignore low walls, hedges, rubble, barricades and similarly minor obstacles. Other Difficult Terrain is Dangerous Terrain as normal. A failed Dangerous Terrain test causes an Engine Damaged result instead of Immobilised.</ns0:description></ns0:rule><ns0:rule name="Immense Machine" id="r32-low-stormbird-low-5" hidden="false"><ns0:description>Crew Shaken: the attacker chooses one weapon; that weapon may only fire Snap Shots until the end of the vehicle's next turn. Crew Stunned: the vehicle may not move in its next Movement phase and the attacker chooses one weapon that may only fire Snap Shots until the end of the vehicle's next turn; all other weapons may fire normally. Other damage results are resolved normally, including Structure Points.</ns0:description></ns0:rule><ns0:rule name="Catastrophic Destruction" id="r32-low-stormbird-low-6" hidden="false"><ns0:description>When finally destroyed after reaching 0 Structure Points, roll a D6. 1-3: Wrecked. 4-5: Explosion; models within D6" suffer S5 AP- and vehicles are hit at S5 against Side Armour. 6: Catastrophic Explosion; roll one D3 per starting Structure Point and total the result for the radius in inches; models suffer S6 AP- and vehicles are hit at S6 against Side Armour.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-low-stormbird-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule><ns0:rule name="Power of the Machine Spirit" id="r32-low-stormbird-potms" hidden="false"><ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description></ns0:rule><ns0:rule name="Assault Vehicle" id="r32-low-stormbird-assault" hidden="false"><ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description></ns0:rule><ns0:rule name="Dual Void Shield Generator" id="r32-low-stormbird-dualvoid" hidden="false"><ns0:description>The Stormbird is protected by two independent AV12 Void Shields. Hits are resolved against active shields first; a Glancing or Penetrating Hit collapses one shield. At the end of each controlling player's turn each collapsed shield is restored on a 5+.</ns0:description></ns0:rule><ns0:rule name="Shield Projection" id="r32-low-stormbird-proj" hidden="false"><ns0:description>If Hovering and stationary, the Stormbird may project its active Void Shields at the beginning of its turn. Until the beginning of its next turn, friendly units wholly or partially within 12 inches of its hull or wings are protected by those shields.</ns0:description></ns0:rule><ns0:rule name="Reinforced Structure" id="r32-low-stormbird-reinf" hidden="false"><ns0:description>The Stormbird has a 5+ Invulnerable Save against attacks which penetrate its Void Shields.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-low-stormbird-cap" hidden="false"><ns0:description>50 models. May transport Dreadnoughts (10 models each), Jump Infantry, Rapier Batteries, Bikes, Jetbikes, and one Rhino including its passengers (counting as 25 models). A transported Rhino is an exception to the normal single-unit Transport rule.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-low-stormbird-access" hidden="false"><ns0:description>One side access point on each side and one rear assault ramp. Dreadnoughts and a transported Rhino may only use the rear ramp.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Replace six Dreadstrike Missiles with Macro-bomb Cluster Payload" hidden="false" id="r32-low-stormbird-macro"><ns0:constraints><ns0:constraint id="r32-low-stormbird-macro-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="50" /></ns0:costs><ns0:profiles><ns0:profile name="Macro-bomb Cluster" id="r32-low-stormbird-macro-macro-bomb-cluster-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">—</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Bomb 1, Apocalyptic Barrage (3D6), Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Sunder" id="r32-low-stormbird-macro-macro-bomb-cluster-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace a Twin-linked Lascannon Turret with Quad Heavy Bolter" hidden="false" id="r32-low-stormbird-quad"><ns0:constraints><ns0:constraint id="r32-low-stormbird-quad-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Quad Heavy Bolter" id="r32-low-stormbird-quad-quad-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 6, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Orbital Strike" hidden="false" id="r32-low-stormbird-orbital"><ns0:constraints><ns0:constraint id="r32-low-stormbird-orbital-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:profiles><ns0:profile name="Orbital Strike" id="r32-low-stormbird-orbital-orbital-strike-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Unlimited</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Ordnance 1, Massive Blast, Barrage, Titan Killer, Indirect Only</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Massive Blast" id="r32-low-stormbird-orbital-orbital-strike-wr-0-massive-blast" hidden="false"><ns0:description>Uses the 7 inch Blast marker.</ns0:description></ns0:rule><ns0:rule name="Titan Killer" id="r32-low-stormbird-orbital-orbital-strike-wr-0-titan-killer" hidden="false"><ns0:description>When a Titan Killer weapon scores a Penetrating Hit against a Super-heavy Vehicle, resolve the hit normally and then the target loses D3 Structure Points. Against a non-Vehicle model an unsaved Wound inflicts D3 Wounds instead of 1.</ns0:description></ns0:rule><ns0:rule name="Indirect Only" id="r32-low-stormbird-orbital-orbital-strike-wr-0-indirect-only" hidden="false"><ns0:description>Does not require Line of Sight, is always resolved using Barrage, and may not be fired directly.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r32-low-stormbird-cat" name="Lords of War" targetId="cat-low" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Primaris-Lightning Strike Fighter" hidden="false" id="r32-aero-lightning"><ns0:costs><ns0:cost name="Points" typeId="pts" value="135" /></ns0:costs><ns0:profiles><ns0:profile name="Primaris-Lightning Strike Fighter" id="r32-aero-lightning-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">11</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">10</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Lascannon" id="r32-aero-lightning-weapon-twin-linked-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-aero-lightning-type" hidden="false"><ns0:description>Vehicle (Flyer)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-aero-lightning-wargear" hidden="false"><ns0:description>Twin-linked Lascannon; Chaff Launcher; Armoured Cockpit; Three Dual Hardpoint Mounts.</ns0:description></ns0:rule><ns0:rule name="Flyer" id="r32-aero-lightning-aero-flyer" hidden="false"><ns0:description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</ns0:description></ns0:rule><ns0:rule name="Air-to-Air Targeting" id="r32-aero-lightning-aero-air-to-air-targeting" hidden="false"><ns0:description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</ns0:description></ns0:rule><ns0:rule name="Agile" id="r32-aero-lightning-agile" hidden="false"><ns0:description>When this Flyer enters Evasion, improve the Cover Save granted by Evasion by +1, to a maximum of 3+.</ns0:description></ns0:rule><ns0:rule name="Deep Strike" id="r32-aero-lightning-deep" hidden="false"><ns0:description>Uses the normal ProHammer Deep Strike rules except as modified below.</ns0:description></ns0:rule><ns0:rule name="Supersonic" id="r32-aero-lightning-super" hidden="false"><ns0:description>Uses the normal ProHammer special rule.</ns0:description></ns0:rule><ns0:rule name="Chaff Launcher" id="r32-aero-lightning-chaff" hidden="false"><ns0:description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</ns0:description></ns0:rule><ns0:rule name="Armoured Cockpit" id="r32-aero-lightning-cockpit" hidden="false"><ns0:description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Battle Servitor Control" hidden="false" id="r32-aero-lightning-battle-servitor-control"><ns0:constraints><ns0:constraint id="r32-aero-lightning-battle-servitor-control-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:rules><ns0:rule name="Battle Servitor Control" id="r32-aero-lightning-battle-servitor-control-effect" hidden="false"><ns0:description>The vehicle gains Tank Hunters.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Ground-tracking Auguries" hidden="false" id="r32-aero-lightning-ground-tracking-auguries"><ns0:constraints><ns0:constraint id="r32-aero-lightning-ground-tracking-auguries-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Ground-tracking Auguries" id="r32-aero-lightning-ground-tracking-auguries-effect" hidden="false"><ns0:description>The vehicle gains Strafing Run.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Ramjet Diffraction Grid" hidden="false" id="r32-aero-lightning-ramjet-diffraction-grid"><ns0:constraints><ns0:constraint id="r32-aero-lightning-ramjet-diffraction-grid-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Ramjet Diffraction Grid" id="r32-aero-lightning-ramjet-diffraction-grid-effect" hidden="false"><ns0:description>Reduce the Strength of shooting attacks that strike Side or Rear Armour by 1, to a minimum of 1. The vehicle may not claim a Cover Save granted by Night Fighting.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Rad Missiles for a Twin-linked Missile Launcher" hidden="false" id="r32-aero-lightning-rad"><ns0:constraints><ns0:constraint id="r32-aero-lightning-rad-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Rad Missile" id="r32-aero-lightning-rad-rad-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Fleshbane, Rad-phage</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Rad Missiles for a Twin-linked Missile Launcher" id="r32-aero-lightning-rad-rule" hidden="false"><ns0:description>May only be selected for a Twin-linked Missile Launcher carried on a Dual Hardpoint Mount.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-aero-lightning-hardpoints" name="Dual Hardpoint Mounts" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-aero-lightning-hardpoints-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Autocannon" hidden="false" id="r32-aero-lightning-twin-linked-autocannon"><ns0:constraints><ns0:constraint id="r32-aero-lightning-twin-linked-autocannon-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Autocannon" id="r32-aero-lightning-twin-linked-autocannon-twin-linked-autocannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Multi-laser" hidden="false" id="r32-aero-lightning-twin-linked-multi-laser"><ns0:constraints><ns0:constraint id="r32-aero-lightning-twin-linked-multi-laser-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Multi-laser" id="r32-aero-lightning-twin-linked-multi-laser-twin-linked-multi-laser-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Missile Launcher (Frag/Krak)" hidden="false" id="r32-aero-lightning-twin-linked-missile-launcher-frag-krak"><ns0:constraints><ns0:constraint id="r32-aero-lightning-twin-linked-missile-launcher-frag-krak-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:profiles><ns0:profile name="Missile Launcher — Frag" id="r32-aero-lightning-twin-linked-missile-launcher-frag-krak-missile-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Missile Launcher — Krak" id="r32-aero-lightning-twin-linked-missile-launcher-frag-krak-missile-launcher-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Two Sunfury Heavy Missiles" hidden="false" id="r32-aero-lightning-two-sunfury-heavy-missiles"><ns0:constraints><ns0:constraint id="r32-aero-lightning-two-sunfury-heavy-missiles-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="25" /></ns0:costs><ns0:profiles><ns0:profile name="Sunfury Heavy Missile" id="r32-aero-lightning-two-sunfury-heavy-missiles-sunfury-heavy-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Blind, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Two Kraken Penetrator Heavy Missiles" hidden="false" id="r32-aero-lightning-two-kraken-penetrator-heavy-missiles"><ns0:constraints><ns0:constraint id="r32-aero-lightning-two-kraken-penetrator-heavy-missiles-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:profiles><ns0:profile name="Kraken Penetrator Heavy Missile" id="r32-aero-lightning-two-kraken-penetrator-heavy-missiles-kraken-penetrator-heavy-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Armourbane, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Phosphex Bomb Cluster" hidden="false" id="r32-aero-lightning-phosphex-bomb-cluster"><ns0:constraints><ns0:constraint id="r32-aero-lightning-phosphex-bomb-cluster-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Phosphex Bomb Cluster" id="r32-aero-lightning-phosphex-bomb-cluster-phosphex-bomb-cluster-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">—</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Bomb 2, Barrage, Blast, Poisoned (3+), Crawling Fire, Lingering Death, Deadly Cargo, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Two Electromagnetic Storm Charges" hidden="false" id="r32-aero-lightning-two-electromagnetic-storm-charges"><ns0:constraints><ns0:constraint id="r32-aero-lightning-two-electromagnetic-storm-charges-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Electromagnetic Storm Charge" id="r32-aero-lightning-two-electromagnetic-storm-charges-electromagnetic-storm-charge-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">—</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Bomb 1, Large Blast, Haywire, Concussive, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r34-cat-primaris-lightning-strike-fighter" name="Fast Attack" targetId="cat-fast" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Xiphon Pattern Interceptor" hidden="false" id="r32-aero-xiphon"><ns0:costs><ns0:cost name="Points" typeId="pts" value="205" /></ns0:costs><ns0:profiles><ns0:profile name="Xiphon Pattern Interceptor" id="r32-aero-xiphon-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">11</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">11</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Lascannon" id="r32-aero-xiphon-weapon-twin-linked-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Xiphon Rotary Missile Launcher" id="r32-aero-xiphon-weapon-xiphon-rotary-missile-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">60"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Cluster Warhead, Terminal Tracking</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-aero-xiphon-type" hidden="false"><ns0:description>Vehicle (Flyer)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-aero-xiphon-wargear" hidden="false"><ns0:description>Two Twin-linked Lascannons; Xiphon Rotary Missile Launcher; Armoured Ceramite.</ns0:description></ns0:rule><ns0:rule name="Cluster Warhead" id="r32-aero-xiphon-weapon-xiphon-rotary-missile-launcher-wr-0-cluster-warhead" hidden="false"><ns0:description>If this weapon scores a Penetrating Hit against a target with an Armour Value, roll D3 times on the Vehicle Damage table and apply the highest result. Only one Penetrating Hit is inflicted.</ns0:description></ns0:rule><ns0:rule name="Terminal Tracking" id="r32-aero-xiphon-weapon-xiphon-rotary-missile-launcher-wr-0-terminal-tracking" hidden="false"><ns0:description>Successful Cover Saves, including Evasion, made against this weapon must be re-rolled.</ns0:description></ns0:rule><ns0:rule name="Flyer" id="r32-aero-xiphon-aero-flyer" hidden="false"><ns0:description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</ns0:description></ns0:rule><ns0:rule name="Air-to-Air Targeting" id="r32-aero-xiphon-aero-air-to-air-targeting" hidden="false"><ns0:description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</ns0:description></ns0:rule><ns0:rule name="Agile" id="r32-aero-xiphon-agile" hidden="false"><ns0:description>When this Flyer enters Evasion, improve the Cover Save granted by Evasion by +1, to a maximum of 3+.</ns0:description></ns0:rule><ns0:rule name="Deep Strike" id="r32-aero-xiphon-deep" hidden="false"><ns0:description>Uses the normal ProHammer Deep Strike rules except as modified below.</ns0:description></ns0:rule><ns0:rule name="Supersonic" id="r32-aero-xiphon-super" hidden="false"><ns0:description>Uses the normal ProHammer special rule.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-aero-xiphon-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Ground-tracking Auguries" hidden="false" id="r32-aero-xiphon-ground-tracking-auguries"><ns0:constraints><ns0:constraint id="r32-aero-xiphon-ground-tracking-auguries-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Ground-tracking Auguries" id="r32-aero-xiphon-ground-tracking-auguries-effect" hidden="false"><ns0:description>The vehicle gains Strafing Run.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Chaff Launcher" hidden="false" id="r32-aero-xiphon-chaff-launcher"><ns0:constraints><ns0:constraint id="r32-aero-xiphon-chaff-launcher-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Chaff Launcher" id="r32-aero-xiphon-chaff-launcher-effect" hidden="false"><ns0:description>Once per battle, when the vehicle suffers a Glancing or Penetrating Hit caused by a Missile weapon, roll a D6. On a 4+ the hit is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Cockpit" hidden="false" id="r32-aero-xiphon-armoured-cockpit"><ns0:constraints><ns0:constraint id="r32-aero-xiphon-armoured-cockpit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Cockpit" id="r32-aero-xiphon-armoured-cockpit-effect" hidden="false"><ns0:description>Whenever the vehicle suffers Crew Shaken or Crew Stunned, roll a D6. On a 4+ the result is ignored.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r34-cat-xiphon-pattern-interceptor" name="Fast Attack" targetId="cat-fast" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Storm Eagle Assault Gunship" hidden="false" id="r32-aero-stormeagle"><ns0:costs><ns0:cost name="Points" typeId="pts" value="210" /></ns0:costs><ns0:profiles><ns0:profile name="Storm Eagle Assault Gunship" id="r32-aero-stormeagle-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Twin-linked Heavy Bolter" id="r32-aero-stormeagle-weapon-twin-linked-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 3, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Vengeance Launcher" id="r32-aero-stormeagle-weapon-vengeance-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 2, Large Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Tempest Rocket" id="r32-aero-stormeagle-weapon-tempest-rocket-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">60"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-aero-stormeagle-type" hidden="false"><ns0:description>Vehicle (Flyer, Hover, Transport)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-aero-stormeagle-wargear" hidden="false"><ns0:description>Twin-linked Heavy Bolter; Vengeance Launcher; Four Tempest Rockets.</ns0:description></ns0:rule><ns0:rule name="Sunder" id="r32-aero-stormeagle-weapon-tempest-rocket-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule><ns0:rule name="Flyer" id="r32-aero-stormeagle-aero-flyer" hidden="false"><ns0:description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</ns0:description></ns0:rule><ns0:rule name="Air-to-Air Targeting" id="r32-aero-stormeagle-aero-air-to-air-targeting" hidden="false"><ns0:description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</ns0:description></ns0:rule><ns0:rule name="Deep Striike" id="r32-aero-stormeagle-deep-striike" hidden="false"><ns0:description>Uses the normal ProHammer special rule.</ns0:description></ns0:rule><ns0:rule name="Assault Vehicle" id="r32-aero-stormeagle-assault-vehicle" hidden="false"><ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description></ns0:rule><ns0:rule name="Power of the Machine Spirit" id="r32-aero-stormeagle-power-of-the-machine-spirit" hidden="false"><ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-aero-stormeagle-cap" hidden="false"><ns0:description>20 models.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-aero-stormeagle-access" hidden="false"><ns0:description>One on each side, one front ramp and one rear ramp.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-aero-stormeagle-ceramite"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-aero-stormeagle-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Searchlight" hidden="false" id="r32-aero-stormeagle-search"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-search-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="1" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="r32-aero-stormeagle-extra"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-extra-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Extra Armour" id="r32-aero-stormeagle-extra-rule" hidden="false"><ns0:description>Uses the normal ProHammer Extra Armour rules.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup id="r32-aero-stormeagle-nose" name="Twin-linked Heavy Bolter Replacement" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-nose-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Missile Launcher" hidden="false" id="r32-aero-stormeagle-ml"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-ml-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:profiles><ns0:profile name="Missile Launcher — Frag" id="r32-aero-stormeagle-ml-missile-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Missile Launcher — Krak" id="r32-aero-stormeagle-ml-missile-launcher-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Multi-Melta" hidden="false" id="r32-aero-stormeagle-mm"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-mm-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="15" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Multi-Melta" id="r32-aero-stormeagle-mm-twin-linked-multi-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Melta, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup><ns0:selectionEntryGroup id="r32-aero-stormeagle-rockets" name="Tempest Rocket Replacement" hidden="false" collective="false" import="true"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-rockets-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Four Hellstrike Missiles" hidden="false" id="r32-aero-stormeagle-hellstrike"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-hellstrike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Hellstrike Missile" id="r32-aero-stormeagle-hellstrike-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Sunder" id="r32-aero-stormeagle-hellstrike-hellstrike-missile-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Two Twin-linked Lascannons" hidden="false" id="r32-aero-stormeagle-lascannons"><ns0:constraints><ns0:constraint id="r32-aero-stormeagle-lascannons-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="40" /></ns0:costs><ns0:profiles><ns0:profile name="Twin-linked Lascannon" id="r32-aero-stormeagle-lascannons-twin-linked-lascannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:categoryLinks><ns0:categoryLink id="r34-cat-legion-storm-eagle-assault-gunship" name="Fast Attack" targetId="cat-fast" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Fire Raptor Gunship" hidden="false" id="r32-aero-fireraptor"><ns0:costs><ns0:cost name="Points" typeId="pts" value="200" /></ns0:costs><ns0:profiles><ns0:profile name="Fire Raptor Gunship" id="r32-aero-fireraptor-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Avenger Bolt Cannon" id="r32-aero-fireraptor-weapon-avenger-bolt-cannon-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 7</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Quad Heavy Bolter" id="r32-aero-fireraptor-weapon-quad-heavy-bolter-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 6, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Tempest Rocket" id="r32-aero-fireraptor-weapon-tempest-rocket-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">60"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-aero-fireraptor-type" hidden="false"><ns0:description>Vehicle (Flyer, Hover)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-aero-fireraptor-wargear" hidden="false"><ns0:description>Twin-linked Avenger Bolt Cannon; Two Quad Heavy Bolter Turrets; Four Tempest Rockets; Extra Armour.</ns0:description></ns0:rule><ns0:rule name="Sunder" id="r32-aero-fireraptor-weapon-tempest-rocket-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule><ns0:rule name="Flyer" id="r32-aero-fireraptor-aero-flyer" hidden="false"><ns0:description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</ns0:description></ns0:rule><ns0:rule name="Air-to-Air Targeting" id="r32-aero-fireraptor-aero-air-to-air-targeting" hidden="false"><ns0:description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</ns0:description></ns0:rule><ns0:rule name="Deep Strike" id="r32-aero-fireraptor-deep-strike" hidden="false"><ns0:description>Uses the normal ProHammer Deep Strike rules except as modified below.</ns0:description></ns0:rule><ns0:rule name="Strafing Run" id="r32-aero-fireraptor-strafing-run" hidden="false"><ns0:description>When shooting Assault, Heavy, Rapid Fire or Salvo weapons at ground units that are not Flyers or Skimmers, the vehicle gains +1 Ballistic Skill and all such shots count as Pinning, as defined in ProHammer Classic.</ns0:description></ns0:rule><ns0:rule name="Power of the Machine Spirit" id="r32-aero-fireraptor-power-of-the-machine-spirit" hidden="false"><ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description></ns0:rule><ns0:rule name="Independent Turret Fire" id="r32-aero-fireraptor-turrets" hidden="false"><ns0:description>The two waist-mounted turrets operate independently. Each may fire at a different target from the gunship's other weapons and from the other turret. Weapons fired by these turrets do not count towards the number of weapons normally permitted by movement speed.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Replace both Quad Heavy Bolter Turrets with two Reaper Autocannon Batteries" hidden="false" id="r32-aero-fireraptor-reaper"><ns0:constraints><ns0:constraint id="r32-aero-fireraptor-reaper-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Reaper Autocannon Battery" id="r32-aero-fireraptor-reaper-reaper-autocannon-battery-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 4, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace four Tempest Rockets with four Hellstrike Missiles" hidden="false" id="r32-aero-fireraptor-hellstrike"><ns0:constraints><ns0:constraint id="r32-aero-fireraptor-hellstrike-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:profiles><ns0:profile name="Hellstrike Missile" id="r32-aero-fireraptor-hellstrike-hellstrike-missile-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">72"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sunder, One Use</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Sunder" id="r32-aero-fireraptor-hellstrike-hellstrike-missile-wr-0-sunder" hidden="false"><ns0:description>May re-roll failed Armour Penetration rolls against Vehicles.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Searchlight" hidden="false" id="r32-aero-fireraptor-search"><ns0:constraints><ns0:constraint id="r32-aero-fireraptor-search-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="1" /></ns0:costs></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Armoured Ceramite" hidden="false" id="r32-aero-fireraptor-ceramite"><ns0:constraints><ns0:constraint id="r32-aero-fireraptor-ceramite-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="20" /></ns0:costs><ns0:rules><ns0:rule name="Armoured Ceramite" id="r32-aero-fireraptor-ceramite-effect" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r34-cat-legion-fire-raptor-gunship" name="Heavy Support" targetId="cat-heavy" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Caestus Assault Ram" hidden="false" id="r32-aero-caestus"><ns0:costs><ns0:cost name="Points" typeId="pts" value="305" /></ns0:costs><ns0:profiles><ns0:profile name="Caestus Assault Ram" id="r32-aero-caestus-profile" typeId="prof-vehicle" typeName="Vehicle" hidden="false"><ns0:characteristics><ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic><ns0:characteristic name="Front" typeId="vehicle-front">13</ns0:characteristic><ns0:characteristic name="Side" typeId="vehicle-side">13</ns0:characteristic><ns0:characteristic name="Rear" typeId="vehicle-rear">11</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Magna-Melta" id="r32-aero-caestus-weapon-magna-melta-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast, Melta</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Havoc Launcher" id="r32-aero-caestus-weapon-havoc-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Twin-linked</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Unit Type" id="r32-aero-caestus-type" hidden="false"><ns0:description>Vehicle (Flyer, Hover, Transport)</ns0:description></ns0:rule><ns0:rule name="Wargear" id="r32-aero-caestus-wargear" hidden="false"><ns0:description>Twin-linked Magna-Melta; Two Havoc Launchers; Armoured Ceramite; Extra Armour.</ns0:description></ns0:rule><ns0:rule name="Flyer" id="r32-aero-caestus-aero-flyer" hidden="false"><ns0:description>Uses the normal ProHammer Vehicle and Flyer rules, including deployment from Reserves, Zooming/Hovering where applicable, movement, turning, leaving the battlefield, Hard to Hit, Evasion and Flyer damage.</ns0:description></ns0:rule><ns0:rule name="Air-to-Air Targeting" id="r32-aero-caestus-aero-air-to-air-targeting" hidden="false"><ns0:description>When a Zooming Flyer fires at another Flyer or Flying Monster, it may use its normal Ballistic Skill when rolling To Hit.</ns0:description></ns0:rule><ns0:rule name="Deep Striike" id="r32-aero-caestus-deep-striike" hidden="false"><ns0:description>Uses the normal ProHammer special rule.</ns0:description></ns0:rule><ns0:rule name="Assault Vehicle" id="r32-aero-caestus-assault-vehicle" hidden="false"><ns0:description>A Dreadnought may charge during a turn in which it disembarks from this Drop Pod, but may not charge during the same turn in which the Drop Pod itself arrived by Deep Strike.</ns0:description></ns0:rule><ns0:rule name="Power of the Machine Spirit" id="r32-aero-caestus-power-of-the-machine-spirit" hidden="false"><ns0:description>Use the normal ProHammer Power of the Machine Spirit rule.</ns0:description></ns0:rule><ns0:rule name="Armoured Ceramite" id="r32-aero-caestus-ceramite" hidden="false"><ns0:description>Weapons with the Melta special rule do not roll an additional D6 for Armour Penetration against this vehicle.</ns0:description></ns0:rule><ns0:rule name="Caestus Ram" id="r32-aero-caestus-ram" hidden="false"><ns0:description>May declare a Ram against an enemy vehicle despite lacking the Tank type. The Ram inflicts S10; roll two dice for Armour Penetration and use the higher, and add +1 to the Vehicle Damage roll. The Caestus has a 5+ Invulnerable Save against Glancing or Penetrating Hits striking its Front Armour, including from Ramming.</ns0:description></ns0:rule><ns0:rule name="Misericord" id="r32-aero-caestus-misericord" hidden="false"><ns0:description>May only transport models wearing Power Armour, Artificer Armour or Terminator Armour. Terminators count as one model each.</ns0:description></ns0:rule><ns0:rule name="Transport Capacity" id="r32-aero-caestus-cap" hidden="false"><ns0:description>10 models.</ns0:description></ns0:rule><ns0:rule name="Access Points" id="r32-aero-caestus-access" hidden="false"><ns0:description>Two front access points.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Frag Assault Launchers" hidden="false" id="r32-aero-caestus-frag"><ns0:constraints><ns0:constraint id="r32-aero-caestus-frag-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Frag Assault Launchers" id="r32-aero-caestus-frag-rule" hidden="false"><ns0:description>A unit that charges in the same turn it disembarks from a Caestus with Frag Assault Launchers counts as equipped with Frag Grenades for that Assault phase.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Auxiliary Drive" hidden="false" id="r32-aero-caestus-aux"><ns0:constraints><ns0:constraint id="r32-aero-caestus-aux-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Auxiliary Drive" id="r32-aero-caestus-aux-effect" hidden="false"><ns0:description>At the start of the Movement phase, if Immobilised, roll a D6. On a 4+ remove Immobilised and the vehicle may move normally that turn.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Replace two Havoc Launchers with two Missile Launchers (Frag/Krak)" hidden="false" id="r32-aero-caestus-missiles"><ns0:constraints><ns0:constraint id="r32-aero-caestus-missiles-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:profiles><ns0:profile name="Missile Launcher — Frag" id="r32-aero-caestus-missiles-missile-launcher-p0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Missile Launcher — Krak" id="r32-aero-caestus-missiles-missile-launcher-p1" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">48"</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Heavy 1</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles></ns0:selectionEntry></ns0:selectionEntries><ns0:categoryLinks><ns0:categoryLink id="r34-cat-legion-caestus-assault-ram" name="Heavy Support" targetId="cat-heavy" hidden="false" primary="true" /></ns0:categoryLinks></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="Legion Veteran Squad" hidden="true" id="r35-pride-veteran-veteran-unit">
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-troops" id="r35-pride-veteran-cat" primary="true" name="Troops" hidden="false" />
      </ns0:categoryLinks>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="r35-pride-veteran-veteran-standard" hidden="false">
          <ns0:description>Every model is equipped with Power Armour, a Bolter, Bolt Pistol, Chainsword and Frag Grenades unless replaced by an option below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="r35-pride-veteran-veteran-legiones" hidden="false">
          <ns0:description>All models have the Legiones Astartes special rule and And They Shall Know No Fear as presented in ProHammer Classic. They are not Fearless.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Veteran Tactics" id="r35-pride-veteran-veteran-tactics-rule" hidden="false">
          <ns0:description>When constructing the army, select one Veteran Tactic for this squad. The chosen ability applies to every model in the squad for the duration of the battle.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dedicated Transport" id="r35-pride-veteran-veteran-transport-rule" hidden="false">
          <ns0:description>If not equipped with Jump Packs, the squad may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where permitted. Land Raider choices will become selectable when their vehicle entries are added; the rule remains in force now.</ns0:description>
        </ns0:rule>
      <ns0:rule name="Rite of War Selection" id="r35-pride-veteran-note" hidden="false"><ns0:description>This Troops entry is available while Pride of the Legion is selected.</ns0:description></ns0:rule></ns0:rules>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Veterans (included)" hidden="false" id="r35-pride-veteran-veteran-included" defaultAmount="4">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-veteran-veteran-included-min" type="min" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r35-pride-veteran-veteran-included-max" type="max" value="4" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veterans (included)" id="r35-pride-veteran-veteran-included-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Legion Veteran Sergeant" hidden="false" id="r35-pride-veteran-veteran-sergeant" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-veteran-veteran-sergeant-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r35-pride-veteran-veteran-sergeant-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
          <ns0:profiles>
            <ns0:profile name="Legion Veteran Sergeant" id="r35-pride-veteran-veteran-sergeant-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
        <ns0:selectionEntry type="model" import="true" name="Additional Legion Veteran" hidden="false" id="r35-pride-veteran-veteran-additional">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-veteran-veteran-additional-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="20" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Additional Legion Veteran" id="r35-pride-veteran-veteran-additional-prof" typeId="prof-model" typeName="Model" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
                <ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic>
                <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
                <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
                <ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic>
                <ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic>
                <ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic>
                <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
                <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
              </ns0:characteristics>
            </ns0:profile>
          </ns0:profiles>
        </ns0:selectionEntry>
      </ns0:selectionEntries>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="125" />
      </ns0:costs>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Veteran Tactic (choose one)" id="r35-pride-veteran-veteran-tactics" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="r35-pride-veteran-veteran-tactics-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
            <ns0:constraint id="r35-pride-veteran-veteran-tactics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Resolve" hidden="false" id="r35-pride-veteran-veteran-tactic-resolve">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-veteran-tactic-resolve-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Resolve" id="r35-pride-veteran-veteran-tactic-resolve-rule" hidden="false">
                  <ns0:description>The squad gains the Stubborn special rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Assault Veterans" hidden="false" id="r35-pride-veteran-veteran-tactic-assault">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-veteran-tactic-assault-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Assault Veterans" id="r35-pride-veteran-veteran-tactic-assault-rule" hidden="false">
                  <ns0:description>The squad gains the Furious Charge special rule.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Counter-Assault" hidden="false" id="r35-pride-veteran-veteran-tactic-counter">
              <ns0:constraints>
                <ns0:constraint id="r35-pride-veteran-veteran-tactic-counter-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Counter-Assault" id="r35-pride-veteran-veteran-tactic-counter-rule" hidden="false">
                  <ns0:description>The squad gains the Counter-Attack special rule.</ns0:description>
                </ns0:rule>

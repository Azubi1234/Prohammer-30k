          <ns0:constraints>
            <ns0:constraint id="r35-sky-troops-fa-sky-included-min" type="min" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="r35-sky-troops-fa-sky-included-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />

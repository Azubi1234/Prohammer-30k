                </entryLink>
                <entryLink import="true" name="Calibanite Plasma Pistol" hidden="false" id="da22-alt-pp-1" type="selectionEntry" targetId="da22-plasma-pistol">
                  <costs>
                    <cost name="Points" typeId="pts" value="15" />
                  </costs>
                  <modifiers>

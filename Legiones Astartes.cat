          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Combi-Weapon" id="rule-combi-flamer" hidden="false">
          <description>The Bolter component may be fired normally. The secondary component may be fired once per battle. Both components may not be fired in the same Shooting phase.</description>

          <ns0:rules>
            <ns0:rule name="Sergeant Armoury Restrictions" id="r42-role-xiv-0-effects-superior-firepower-legion-veteran-squads-veteran-sgt-arm-rule" hidden="false">
              <ns0:description>The Sergeant may select up to 50 points of permitted Space Marine Armoury equipment. Unit-specific options and equipment already carried are not repeated here. No item may be selected more than once unless specifically permitted. A Pair of Lightning Claws counts as two weapon choices.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntryGroup>

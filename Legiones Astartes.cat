            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Combi-Plasma Gun - Plasma Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-plasma-p">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">7</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Gets Hot, One Use</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Combi-Weapon" id="rule-combi-plasma" hidden="false">
          <ns0:description>The Bolter component may be fired normally. The Plasma Gun component may be fired once per battle. Both components may not be fired in the same Shooting phase.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Combi-Volkite Charger" hidden="false" id="gear-combi-volkite">
      <ns0:profiles>
        <ns0:profile name="Combi-Volkite Charger - Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-b">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
        <ns0:profile name="Combi-Volkite Charger - Volkite" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-combi-volkite-v">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">15"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 2, Rending, One Use</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Combi-Weapon" id="rule-combi-volkite" hidden="false">
          <ns0:description>The Bolter component may be fired normally. The Volkite Charger component may be fired once per battle. Both components may not be fired in the same Shooting phase.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Lightning Claw" hidden="false" id="gear-lightning-claw">
      <ns0:rules>
        <ns0:rule name="Lightning Claw" id="rule-lightning-claw" hidden="false">
          <ns0:description>Power Weapon; re-roll failed To Wound rolls; Specialist Weapon.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Pair of Lightning Claws" hidden="false" id="gear-pair-claws">
      <ns0:rules>
        <ns0:rule name="Pair of Lightning Claws" id="rule-pair-claws" hidden="false">
          <ns0:description>Counts as two weapon choices. Power Weapon; re-roll failed To Wound rolls; Specialist Weapon; +1 Attack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Power Fist" hidden="false" id="gear-power-fist">
      <ns0:rules>
        <ns0:rule name="Power Fist" id="rule-power-fist" hidden="false">
          <ns0:description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Power Weapon" hidden="false" id="gear-power-weapon">
      <ns0:rules>
        <ns0:rule name="Power Weapon" id="rule-power-weapon" hidden="false">
          <ns0:description>Ignores Armour Saves.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="gear-rending">
      <ns0:rules>
        <ns0:rule name="Rending" id="rule-rending-melee" hidden="false">
          <ns0:description>On a natural To Wound roll of 6, the wound is automatically successful and treated as a Power Weapon attack. Against vehicles, an Armour Penetration roll of 6 adds an additional D3.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Thunder Hammer" hidden="false" id="gear-thunder">
      <ns0:rules>
        <ns0:rule name="Thunder Hammer" id="rule-thunder" hidden="false">
          <ns0:description>Double Strength, Power Weapon, Unwieldy, Specialist Weapon, Concussive.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Combat Shield" hidden="false" id="gear-combat-shield">
      <ns0:rules>
        <ns0:rule name="Combat Shield" id="rule-combat-shield" hidden="false">
          <ns0:description>Grants a 6+ Invulnerable Save. It does not occupy a hand and does not prevent the bonus Attack for fighting with two weapons.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Auspex" hidden="false" id="gear-auspex">
      <ns0:rules>
        <ns0:rule name="Auspex" id="rule-auspex" hidden="false">
          <ns0:description>After enemy Infiltrators deploy, roll 4D6 for the unit. If an enemy Infiltrating unit is within that distance and line of sight, the bearer's unit may immediately fire at it once before the battle begins. A unit may only make one Auspex attack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Bionics" hidden="false" id="gear-bionics">
      <ns0:rules>
        <ns0:rule name="Bionics" id="rule-bionics" hidden="false">
          <ns0:description>When the bearer loses its final Wound, leave it on the battlefield. At the beginning of its controlling player's next turn, roll a D6. On a 6 it returns with 1 Wound; otherwise remove it. Bionics cannot normally be used if the bearer's entire unit was destroyed at the same time.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Melta Bombs" hidden="false" id="gear-melta-bombs">
      <ns0:rules>
        <ns0:rule name="Melta Bombs" id="rule-melta-bombs" hidden="false">
          <ns0:description>Against a vehicle in close combat, exchange the bearer's normal attacks for one Melta Bomb attack. If it hits, resolve Armour Penetration at S8 + 2D6.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Purity Seals" hidden="false" id="gear-purity">
      <ns0:rules>
        <ns0:rule name="Purity Seals" id="rule-purity" hidden="false">
          <ns0:description>When the bearer's unit Falls Back, roll one additional D6 for Fall Back distance and discard one die of the controlling player's choice. This benefit is not cumulative.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Teleport Homer" hidden="false" id="gear-homer">
      <ns0:rules>
        <ns0:rule name="Teleport Homer" id="rule-homer" hidden="false">
          <ns0:description>Friendly units arriving by teleportation do not scatter if the first model is placed within 6" of an active Homer that was on the battlefield at the start of the turn.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Krak Grenades" hidden="false" id="gear-krak">
      <ns0:rules>
        <ns0:rule name="Krak Grenades" id="rule-krak" hidden="false">
          <ns0:description>Against a vehicle in close combat, a model may exchange its normal attacks for one Krak Grenade attack. If it hits, resolve Armour Penetration at S6 + D6.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="gear-vexilla">
      <ns0:rules>
        <ns0:rule name="Legion Vexilla" id="rule-vexilla" hidden="false">
          <ns0:description>A unit containing a Legion Vexilla adds +1 to its combat-resolution score. This bonus is not cumulative. If the bearer is slain, the unit loses the bonus.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="gear-nuncio">
      <ns0:rules>
        <ns0:rule name="Nuncio Vox" id="rule-nuncio" hidden="false">
          <ns0:description>A friendly unit arriving by Deep Strike does not scatter if its centre model is initially placed within 6" of the bearer. The bearer must have been on the battlefield at the beginning of the turn, must not be Pinned or Falling Back, and must not be embarked upon a Transport.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Twin-linked Bolter" hidden="false" id="gear-tl-bolter">
      <ns0:profiles>
        <ns0:profile name="Twin-linked Bolter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-tl-bolter">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">24"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer" hidden="false" id="gear-heavy-flamer">
      <ns0:profiles>
        <ns0:profile name="Heavy Flamer" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-heavy-flamer">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="gear-hk">
      <ns0:profiles>
        <ns0:profile name="Hunter-Killer Missile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-hk">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Unlimited</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">3</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, One Use</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="model" import="true" name="Legion Rhino Armoured Carrier" hidden="false" id="transport-rhino">
      <ns0:profiles>
        <ns0:profile name="Legion Rhino Armoured Carrier" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-rhino">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">11</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">11</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">10</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="50" />
      </ns0:costs>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Storm Bolter" hidden="false" id="rhino-sb" type="selectionEntry" targetId="gear-storm-bolter" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-sb-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
      </ns0:entryLinks>
      <ns0:rules>
        <ns0:rule name="Transport" id="rule-rhino-transport" hidden="false">
          <ns0:description>Transport Capacity: 10 models. Models in Terminator Armour, models equipped with Jump Packs, and models mounted on Bikes or Jetbikes may not embark. Access Points: one on each side and one at the rear. Fire Points: up to two transported models may fire through the top hatch.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Repair" id="rule-rhino-repair" hidden="false">
          <ns0:description>If the Rhino is Immobilised, during its controlling player's Shooting phase it may give up firing all weapons and roll a D6. On a 6, remove one Immobilised result; it may move normally from the beginning of its following Movement phase.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Smoke Launchers and Searchlight" id="rule-rhino-standard" hidden="false">
          <ns0:description>The Rhino includes Smoke Launchers and a Searchlight and uses their normal ProHammer rules.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Vehicle Upgrades" id="rhino-upgrades" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Dozer Blade" hidden="false" id="rhino-dozer">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-dozer-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Extra Armour" hidden="false" id="rhino-extra">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-extra-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Hunter-Killer Missile" hidden="false" id="rhino-hk">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-hk-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
              <ns0:entryLinks>
                <ns0:entryLink import="true" name="Hunter-Killer Missile" hidden="false" id="rhino-hk-profile" type="selectionEntry" targetId="gear-hk" defaultAmount="1" />
              </ns0:entryLinks>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Auxiliary Drive" hidden="false" id="rhino-aux">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-aux-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Auxiliary Drive" id="rule-rhino-aux" hidden="false">
                  <ns0:description>At the start of the controlling player's Movement phase, if the Rhino is Immobilised, roll a D6. On a 4+, remove one Immobilised result and the vehicle may move normally during that Movement phase.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Pintle-mounted Weapon" id="rhino-pintle" hidden="false">
          <ns0:constraints>
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="rhino-pintle-max" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:entryLinks>
            <ns0:entryLink import="true" name="Twin-linked Bolter" hidden="false" id="rhino-p-tlb" type="selectionEntry" targetId="gear-tl-bolter">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Combi-Flamer" hidden="false" id="rhino-p-cf" type="selectionEntry" targetId="gear-combi-flamer">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Combi-Meltagun" hidden="false" id="rhino-p-cm" type="selectionEntry" targetId="gear-combi-melta">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Combi-Plasma Gun" hidden="false" id="rhino-p-cp" type="selectionEntry" targetId="gear-combi-plasma">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Combi-Volkite Charger" hidden="false" id="rhino-p-cv" type="selectionEntry" targetId="gear-combi-volkite">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="5" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Heavy Bolter" hidden="false" id="rhino-p-hb" type="selectionEntry" targetId="gear-heavy-bolter">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Heavy Flamer" hidden="false" id="rhino-p-hf" type="selectionEntry" targetId="gear-heavy-flamer">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Multi-Melta" hidden="false" id="rhino-p-mm" type="selectionEntry" targetId="gear-multimelta">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
            <ns0:entryLink import="true" name="Havoc Launcher" hidden="false" id="rhino-p-havoc" type="selectionEntry" targetId="gear-havoc">
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="15" />
              </ns0:costs>
            </ns0:entryLink>
          </ns0:entryLinks>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Havoc Launcher" hidden="false" id="gear-havoc">
      <ns0:rules>
        <ns0:rule name="Havoc Launcher" id="rule-havoc" hidden="false">
          <ns0:description>Use the Havoc Launcher profile from the applicable ProHammer/Legion vehicle weapons rules; no profile is reproduced in the current Legiones Astartes Army List.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="model" import="true" name="Legion Drop Pod" hidden="false" id="transport-drop-pod">
      <ns0:profiles>
        <ns0:profile name="Legion Drop Pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-drop-pod">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="50" />
      </ns0:costs>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Storm Bolter" hidden="false" id="dp-sb" type="selectionEntry" targetId="gear-storm-bolter" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint type="min" value="1" field="selections" scope="parent" shared="true" id="dp-sb-min" includeChildSelections="false" automatic="true" />
            <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-sb-max" includeChildSelections="false" automatic="true" />
          </ns0:constraints>
        </ns0:entryLink>
      </ns0:entryLinks>
      <ns0:rules>
        <ns0:rule name="Transport" id="dp-transport-rule" hidden="false">
          <ns0:description>Transport Capacity: 10 models. Models in Terminator Armour count as two models. Models equipped with Jump Packs, Bikes or Jetbikes may not embark.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Deep Strike" id="dp-deepstrike" hidden="false">
          <ns0:description>Uses the normal ProHammer Deep Strike rules except as modified below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Drop Pod Assault" id="dp-assault" hidden="false">
          <ns0:description>The Drop Pod and its passengers begin in Reserve. At the beginning of the controlling player's first turn, choose half of all friendly vehicles with Drop Pod Assault, rounding up; those Drop Pods arrive automatically using Deep Strike. The remainder use normal Reserves. Passengers must immediately disembark when the Pod lands and may not charge that turn. No unit may embark on the Pod after its original passengers disembark.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Inertial Guidance System" id="dp-igs" hidden="false">
          <ns0:description>If the Drop Pod would scatter onto impassable terrain or another model, reduce the scatter distance by the minimum amount required to avoid the obstacle. If no legal position is possible, resolve the Deep Strike normally.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Immobile" id="dp-immobile" hidden="false">
          <ns0:description>After arriving, the Drop Pod may not move for the remainder of the battle. It counts as having suffered an Immobilised result but suffers no additional damage for doing so.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Options" id="dp-options" hidden="false">
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwind Missile Launcher" hidden="false" id="dp-deathwind">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-deathwind-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="20" />
              </ns0:costs>
              <ns0:profiles>
                <ns0:profile name="Deathwind Missile Launcher" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-deathwind">
                  <ns0:characteristics>
                    <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
                    <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
                    <ns0:characteristic name="AP" typeId="ranged-ap">-</ns0:characteristic>
                    <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Large Blast</ns0:characteristic>
                  </ns0:characteristics>
                </ns0:profile>
              </ns0:profiles>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Locator Beacon" hidden="false" id="dp-beacon">
              <ns0:constraints>
                <ns0:constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dp-beacon-max" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="10" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Locator Beacon" id="rule-dp-beacon" hidden="false">
                  <ns0:description>Friendly units arriving by Deep Strike within 6" of a Locator Beacon do not scatter.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="model" import="true" name="Anvillus Pattern Dreadclaw Drop Pod" hidden="false" id="transport-dreadclaw">
      <ns0:profiles>
        <ns0:profile name="Anvillus Pattern Dreadclaw Drop Pod" typeId="prof-vehicle" typeName="Vehicle" hidden="false" id="prof-dreadclaw">
          <ns0:characteristics>
            <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>
            <ns0:characteristic name="Front" typeId="vehicle-front">12</ns0:characteristic>
            <ns0:characteristic name="Side" typeId="vehicle-side">12</ns0:characteristic>
            <ns0:characteristic name="Rear" typeId="vehicle-rear">12</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="65" />
      </ns0:costs>
      <ns0:rules>
        <ns0:rule name="Transport" id="dc-transport-rule" hidden="false">
          <ns0:description>Transport Capacity: 10 models in Power Armour, or 5 models in Terminator Armour, or one Dreadnought where specifically permitted. Passengers may disembark from any point around the hull.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Deep Strike" id="dc-deepstrike" hidden="false">
          <ns0:description>Uses the normal ProHammer Deep Strike rules except as modified below.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Dreadclaw Assault" id="dc-assault" hidden="false">
          <ns0:description>The Dreadclaw and its passengers begin in Reserve. At the beginning of the controlling player's first turn, roll a D6; on a 4+, it becomes available. From the second turn onward use normal Reserve rules. When available it enters by Deep Strike. Passengers do not immediately disembark. A unit may not charge during the same turn in which the Dreadclaw arrived by Deep Strike.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Inertial Guidance System" id="dc-igs" hidden="false">
          <ns0:description>If the Dreadclaw would scatter onto impassable terrain or another model, reduce the scatter distance by the minimum amount required to avoid the obstacle.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Assault Pod" id="dc-assault-pod" hidden="false">
          <ns0:description>Units disembarking from a Dreadclaw may charge during the same turn in which they disembark. This does not allow a unit to charge during the same turn in which the Dreadclaw arrived by Deep Strike.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Hover Jets" id="dc-hover" hidden="false">
          <ns0:description>After landing, the Dreadclaw remains operational and moves as a Fast Skimmer. It may continue to transport its original passengers. Once those passengers have completely disembarked, the Dreadclaw may not embark another unit.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Hardened Power Armour" hidden="false" id="gear-hardened-power-armour">
      <ns0:rules>
        <ns0:rule name="Hardened Armour" id="rule-hardened-armour" hidden="false">
          <ns0:description>Failed Armour Saves caused by Blast or Template weapons may be re-rolled. When the unit makes an Advance Move, reduce the additional distance rolled by 1". Reduce any Charge distance or Pursuit distance rolled by the unit by 1". In missions which use Void Hardened armour, models with Hardened Armour count as Void Hardened. These movement penalties also apply to a model wearing Artificer Armour if that model is part of a Breacher Squad.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Boarding Shield" hidden="false" id="gear-boarding-shield">
      <ns0:rules>
        <ns0:rule name="Boarding Shield" id="rule-boarding-shield" hidden="false">
          <ns0:description>Grants a 5+ Invulnerable Save. A Boarding Shield occupies one of the bearer's hands in close combat; the bearer therefore only receives the +1 Attack bonus for fighting with two weapons if another rule specifically allows it.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Graviton Gun" hidden="false" id="gear-graviton-gun">
      <ns0:profiles>
        <ns0:profile name="Graviton Gun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-graviton-gun">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">Special</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Blast, Concussive, Graviton</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Graviton" id="rule-graviton-gun" hidden="false">
          <ns0:description>Against non-vehicle models, the number required To Wound is equal to the target's Armour Save: 2+ armour is wounded on a 2+, 3+ on a 3+, 4+ on a 4+, and so on. Against vehicles, do not make a normal Armour Penetration roll; roll a D6 for each hit and on a 6 the vehicle is Immobilised.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Lascutter" hidden="false" id="gear-lascutter">
      <ns0:profiles>
        <ns0:profile name="Lascutter" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-lascutter">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">-</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">9</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Melee, Unwieldy, Cumbersome</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Cumbersome" id="rule-cumbersome-lascutter" hidden="false">
          <ns0:description>A model attacking with a Cumbersome weapon may make only one attack with that weapon during the Assault phase, regardless of its Attacks characteristic or any bonuses. That attack is made at Weapon Skill 1.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Breaching Charge" hidden="false" id="gear-breaching-charge">
      <ns0:profiles>
        <ns0:profile name="Breaching Charge" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-breaching-charge">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Special</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Melee, Blast, One Use, Wrecker</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Breaching Charge" id="rule-breaching-charge" hidden="false">
          <ns0:description>May be used once per battle during an Assault phase instead of the bearer's normal close-combat attacks. The bearer makes a single attack against an enemy unit with which he is engaged. If it hits, place a Blast marker in base contact with the bearer so that it covers as many enemy models as possible without covering friendly models; models beneath the marker are struck using the Breaching Charge profile.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Wrecker" id="rule-wrecker-breaching" hidden="false">
          <ns0:description>Against Fortifications, buildings, barricades or other immobile structures, a Wrecker attack may re-roll a failed Armour Penetration roll. Where a mission uses a Building Damage table, add +1 to any roll made on that table by a Wrecker attack.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Recon Armour" hidden="false" id="gear-recon-armour">
      <ns0:rules>
        <ns0:rule name="Recon Armour" id="rule-recon-armour" hidden="false">
          <ns0:description>Recon Armour confers a 4+ Armour Save.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Astartes Shotgun" hidden="false" id="gear-astartes-shotgun">
      <ns0:profiles>
        <ns0:profile name="Astartes Shotgun" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-astartes-shotgun">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">12"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">-</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 2</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Sniper Rifle" hidden="false" id="gear-sniper-rifle">
      <ns0:profiles>
        <ns0:profile name="Sniper Rifle" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false" id="prof-sniper-rifle">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">36"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">3</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">6</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Heavy 1, Sniper</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Sniper" id="rule-sniper-rifle" hidden="false">
          <ns0:description>Uses the normal Sniper weapon rules from ProHammer Classic.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Combat Blade" hidden="false" id="gear-combat-blade">
      <ns0:rules>
        <ns0:rule name="Combat Blade" id="rule-combat-blade" hidden="false">
          <ns0:description>Close Combat Weapon. Uses the bearer' Strength and permits normal Armour Saves.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Cameleoline" hidden="false" id="gear-cameleoline">
      <ns0:rules>
        <ns0:rule name="Cameleoline" id="rule-cameleoline" hidden="false">
          <ns0:description>A model equipped with Cameleoline gains the Stealth special rule.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Foeblaster Boltgun" hidden="false" id="gear-foeblaster">
      <ns0:profiles>
        <ns0:profile name="Foeblaster Boltgun" id="gear-foeblaster-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">18"</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Rapid Fire, Twin-linked</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Heavy Flamer with Suspensor Web" hidden="false" id="gear-heavy-flamer-susp">
      <ns0:profiles>
        <ns0:profile name="Heavy Flamer with Suspensor Web" id="gear-heavy-flamer-susp-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic>
            <ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic>
            <ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic>
            <ns0:characteristic name="Type" typeId="ranged-type">Assault 1</ns0:characteristic>
          </ns0:characteristics>
        </ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Suspensor Web" id="gear-heavy-flamer-susp-rule-0" hidden="false">
          <ns0:description>A Heavy weapon fitted with a Suspensor Web may instead be fired as an Assault weapon at half its normal maximum range. Its number of shots and all other characteristics are unchanged.</ns0:description>
        </ns0:rule>
      </ns0:rules>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="upgrade" import="true" name="Heavy Bolter with Suspensor Web" hidden="false" id="gear-heavy-bolter-susp">
      <ns0:profiles>
        <ns0:profile name="Heavy Bolter with Suspensor Web" id="gear-heavy-bolter-susp-prof-0" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false">

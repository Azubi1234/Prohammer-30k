onEntry><ns0:selectionEntry type="upgrade" import="true" name="Stealth Adept (base unit; +1 pts/model)" hidden="false" id="r41-unit-viii-0-terror-squad-opt-9-stealth-adept"><ns0:constraints><ns0:constraint id="r41-unit-viii-0-terror-squad-opt-9-stealth-adept-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="5" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-viii-0-terror-squad-opt-9-context" hidden="false"><ns0:description>• The entire squad may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r41-unit-viii-0-terror-squad-opt-9-squadwide" hidden="false"><ns0:description>The source prices this option at +1 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="NIGHT RAPTOR SQUAD" hidden="false" id="r41-unit-viii-1-night-raptor-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="140" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-viii-1-night-raptor-squad-cat" name="Fast Attack" hidden="false" targetId="cat-fast" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-viii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Night Raptor" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-1-night-raptor-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">8</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Raptor Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-1-night-raptor-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Headtaker" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-viii-1-night-raptor-squad-profile-2"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-viii-1-night-raptor-squad-source" hidden="false"><ns0:description>Night Raptor | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 8 | 3+
Raptor Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Headtaker | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+
Force Organisation:
• Fast Attack
Unit Composition:
• 4 Night Raptors
• 1 Raptor Sergeant
Unit Type:
• Jump Infantry
• The Raptor Sergeant is a Character
Wargear:
• Power Armour
• Jump Pack
• Bolt pistol
• Chainsword
• Frag grenades
• Trophies of Judgement
Special Rules:
• Legiones Astartes (Night Lords)
• Hit &amp; Run
OPTIONS
• The squad may include up to ten additional Night Raptors
for +28 points per model.
• Up to five models may replace their Chainsword with:
• Rending Weapon ................................ +5 points
• Power weapon ................................. +10 points
• Up to two Night Raptors may replace their Bolt pistol with:
• Volkite Serpenta .............................. +5 points
• Hand Flamer ................................... +5 points
• Plasma Pistol ................................ +15 points
• Up to two models may take:
• Melta bombs .................................... +5 points
• The entire squad may take:
• Krak grenades ............................ +2 points per model
• Stealth Adept ............................ +1 point per model
HEADTAKER
The Raptor Sergeant may be upgraded to a Headtaker for +15 points. A Headtaker has Weapon Skill 5.
The Headtaker may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury and Night Lords Armoury</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-viii-1-night-raptor-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-viii-1-night-raptor-squad-additional-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="28" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-viii-1-night-raptor-squad-additional-rule" hidden="false"><ns0:description>May include up to 10 additional models at +28 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-viii-1-night-raptor-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-viii-1-night-raptor-squad-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-viii-1-night-raptor-squad-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="28" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-viii-1-night-raptor-squad-opt-0-context" hidden="false"><ns0:description>• The squad may include up to ten additional Night Raptors</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Rending Weapon" hidden="false" id="r41-unit-viii-1-night-raptor-squad-opt-1-rending-weapon"><
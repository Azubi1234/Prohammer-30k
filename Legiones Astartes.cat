                <entryLink import="true" name="Bolt Pistol" hidden="false" id="load-ex-p" type="selectionEntry" targetId="gear-bolt-pistol" defaultAmount="1" />
                <entryLink import="true" name="Chainsword" hidden="false" id="load-ex-c" type="selectionEntry" targetId="gear-chainsword" defaultAmount="1" />

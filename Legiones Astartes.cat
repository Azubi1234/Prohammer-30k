            <ns0:constraint id="hs-vindicator-model-max" type="max" value="3" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
          <ns0:costs>
            <ns0:cost name="Points" typeId="pts" value="120" />
          </ns0:costs>
          <ns0:profiles>
            <ns0:profile name="Legion Vindicator" id="hs-vindicator-model-prof" typeId="prof-vehicle" typeName="Vehicle" hidden="false">
              <ns0:characteristics>
                <ns0:characteristic name="BS" typeId="vehicle-bs">4</ns0:characteristic>

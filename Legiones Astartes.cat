          </ns0:constraints>
        </ns0:entryLink>
      <ns0:entryLink id="r40-da-forward-recon-unit" name="Forward Deployment — Infiltrate" type="selectionEntry" targetId="r40-da-forward-deployment" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r40-da-forward-recon-unit-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="force" childId="da22-rite-serpent" shared="true" includeChildSelections="true" /><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="da-wing-recon-unit-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
      <ns0:selectionEntries>
        <ns0:selectionEntry type="model" import="true" name="Legion Recon Marine" hidden="false" id="recon-marine" defaultAmount="4">

DAWNBREAKER CHAMPION
The Dawnbreaker Champion may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-ix-0-dawnbreaker-cohort-additional"><ns0:constraints><ns0:constraint id="r41-unit-ix-0-dawnbreaker-cohort-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="35" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-ix-0-dawnbreaker-cohort-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +35 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-ix-0-dawnbreaker-cohort-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Pair of Equinox Blades" hidden="false" id="r41-unit-ix-0-dawnbreaker-cohort-opt-0-pair-of-equinox-blades"><ns0:constraints><ns0:constraint id="r41-unit-ix-0-dawnbreaker-cohort-opt-0-pair-of-equinox-blades-max" field="selections" scope="parent" value="10" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="0" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-ix-0-dawnbreaker-cohort-opt-0-context" hidden="false"><ns0:description>• Any model may replace his Falling-star Spear with:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades (base unit; +2 pts/model)" hidden="false" id="r41-unit-i
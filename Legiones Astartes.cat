    <ns0:selectionEntry type="unit" import="true" name="PALATINE BLADE SQUAD" hidden="false" id="r41-unit-iii-0-palatine-blade-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-iii-0-palatine-blade-squad-cat" name="Elites" hidden="false" targetId="cat-elites" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Palatine Blade" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Palatine Primus" typeId="prof-model" typeName="Model" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">2+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r41-unit-iii-0-palatine-blade-squad-source" hidden="false"><ns0:description>Palatine Blade | 5 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 2+
Palatine Primus | 5 | 4 | 4 | 4 | 1 | 5 | 3 | 9 | 2+
Force Organisation:
DUELISTS When fighting an enemy unit containing one or more Characters or Independent Characters, models in this squad may re-roll close-combat To Hit rolls of 1.
• Elites
Unit Composition:
• 4 Palatine Blades
• 1 Palatine Primus
Unit Type:
• Infantry
• The Palatine Primus is a Character
Wargear:
• Artificer Armour
• Bolt pistol
• Rending Weapon
• Frag grenades
Special Rules:
• Legiones Astartes (Emperor's Children)
• Duelists
OPTIONS
• The squad may include up to five additional Palatine Blades
for +30 points per model.
• Any model may replace its Rending Weapon with:
• Power weapon ................................. +10 points
• Any model may take:
• Combat Shield ................................ +5 points
• Melta bombs .................................. +5 points
• The Palatine Primus may select up to 50 points of additional
permitted weapons and wargear from the Space Marine Armoury.
• The entire squad may take:
• Krak grenades .............................. +2 points per model
JUMP PACKS
The entire squad may be equipped with Jump Packs for +15 points per model. If equipped with Jump Packs, the unit becomes Jump Infantry and follows the normal ProHammer rules for Jump Infantry. It may not select a Dedicated Transport.
DEDICATED TRANSPORT
A squad without Jump Packs may select a Rhino, Drop Pod, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-additional"><ns0:constraints><ns0:constraint id="r41-unit-iii-0-palatine-blade-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r41-unit-iii-0-palatine-blade-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +30 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="for" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-opt-0-for"><ns0:constraints><ns0:constraint id="r41-unit-iii-0-palatine-blade-squad-opt-0-for-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="30" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-iii-0-palatine-blade-squad-opt-0-context" hidden="false"><ns0:description>• The squad may include up to five additional Palatine Blades</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Power weapon" hidden="false" id="r41-unit-iii-0-palatine-blade-squad-opt-1-power-weapon"
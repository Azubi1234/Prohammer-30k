• Krak grenades ..................................... +2 points</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r41-unit-xii-8-gahlan-surlak-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Krak grenades" hidden="false" id="r41-unit-xii-8-gahlan-surlak-opt-0-krak-grenades"><ns0:constraints><ns0:constraint id="r41-unit-xii-8-gahlan-surlak-opt-0-krak-grenades-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="2" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r41-unit-xii-8-gahlan-surlak-opt-0-context" hidden="false"><ns0:description>• Surlak may take:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="KARGOS, THE BLOODSPITTER" hidden="false" id="r41-unit-xii-9-kargos-the-bloodspitter"><ns0:costs><ns0:cost name="Points" typeId="pts" value="120" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r41-unit-xii-9-kargos-the-bloodspitter-cat" name="HQ" hidden="false" targetId="cat-hq" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-xii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:constraints><ns0:constraint id="r41-unit-xii-9-kargos-the-bloodspitter-unique" field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:profiles><ns0:profile name=
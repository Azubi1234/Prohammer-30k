          <ns0:rules>
            <ns0:rule name="Retinue Restriction" id="hq-praetor-ret-rule" hidden="false">
              <ns0:description>A Praetor may select one Honour Guard Squad. If equipped with any form of Terminator Armour, he may instead select a Legion Terminator Command Squad where permitted.</ns0:description>
            </ns0:rule>
          </ns0:rules>
        </ns0:selectionEntryGroup>
        <ns0:selectionEntryGroup name="Hexagrammaton Wing" hidden="false" id="da-wing-hq-praetor" collective="false" import="true">
          <ns0:constraints>
            <ns0:constraint id="da-wing-hq-praetor-min" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="min" />
            <ns0:constraint id="da-wing-hq-praetor-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
          </ns0:constraints>
          <ns0:modifiers>
            <ns0:modifier type="set" value="true" field="hidden">
              <ns0:conditions>
                <ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
            <ns0:modifier type="set" value="1" field="da-wing-hq-praetor-min">
              <ns0:conditions>
                <ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-i" shared="true" includeChildSelections="true" includeChildForces="false" />
              </ns0:conditions>
            </ns0:modifier>
          </ns0:modifiers>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" import="true" name="Stormwing" hidden="false" id="da-wing-hq-praetor-0">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-0-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Stormwing" id="da-wing-hq-praetor-0-rule" hidden="false">
                  <ns0:description>First Fire/Overwatch: re-roll To Hit rolls of 1 with Bolters, Bolt Pistols, Storm Bolters, Foeblaster Boltguns and bolter component of combi-weapons. If The Storm of War is selected: stationary Stormwing units also use the Stormwing re-roll during the normal Shooting phase; Stormwing Infantry containing a Stormwing Character gains Stubborn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Deathwing" hidden="false" id="da-wing-hq-praetor-1">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-1-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Deathwing" id="da-wing-hq-praetor-1-rule" hidden="false">
                  <ns0:description>With a sword-type weapon against an enemy whose Weapon Skill is higher than the model’s own, re-roll To Hit rolls of 1 in close combat. If The Unbroken Vow is selected: a Deathwing unit within 6" of an Objective gains Feel No Pain (6+), or improves existing Feel No Pain by one step to a maximum of 4+; a Deathwing Independent Character within 12" of an Objective gains +1 Attack.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Dreadwing" hidden="false" id="da-wing-hq-praetor-2">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-2-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Dreadwing" id="da-wing-hq-praetor-2-rule" hidden="false">
                  <ns0:description>Flame, Plasma and Volkite attacks against this unit are -1 Strength (minimum 1); against Dreadwing Vehicles/Dreadnoughts this also reduces Armour Penetration Strength. If The Eskaton Imperative is selected: Dreadwing Infantry gain Move Through Cover and all Dreadwing models may re-roll failed Dangerous Terrain tests.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ironwing" hidden="false" id="da-wing-hq-praetor-3">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-3-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ironwing" id="da-wing-hq-praetor-3-rule" hidden="false">
                  <ns0:description>Re-roll Armour Penetration rolls of 1 against enemy Vehicles. Ironwing Vehicles firing Snap Shots hit on 5+ instead of 6+. If The Steel Fist is selected: a Transport Vehicle carrying an Ironwing Independent Character gains a 6+ Invulnerable Save against shooting, or improves an existing Invulnerable Save by one step to a maximum of 4+.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Firewing" hidden="false" id="da-wing-hq-praetor-4">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-4-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Firewing" id="da-wing-hq-praetor-4-rule" hidden="false">
                  <ns0:description>Re-roll To Hit rolls of 1 when attacking an enemy unit containing an Independent Character, in shooting and close combat. If The Serpent’s Bane is selected: against a nominated Priority Target, Firewing models re-roll To Hit rolls of 1 and To Wound rolls of 1 (Armour Penetration rolls of 1 against Vehicles); a Firewing Independent Character gains +1 Attack in melee with a Priority Target. Up to three Firewing Troops units may select Forward Deployment — Infiltrate.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" import="true" name="Ravenwing" hidden="false" id="da-wing-hq-praetor-5">
              <ns0:constraints>
                <ns0:constraint id="da-wing-hq-praetor-5-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" />
              </ns0:constraints>
              <ns0:rules>
                <ns0:rule name="Ravenwing" id="da-wing-hq-praetor-5-rule" hidden="false">
                  <ns0:description>Dark Angels Bikes and Jetbikes gain Skilled Rider; Dark Angels Land Speeders gain Jink. If The Seeker’s Arrow is selected: Ravenwing Infantry, Bikes and Jetbikes gain Outflank; Ravenwing Bikes and Jetbikes gain Hit &amp; Run. At the start of each Dark Angels turn choose +2" Turbo-Boost/Advance, +2" Charge, or +2" Consolidation for all Ravenwing units until the next Dark Angels turn.</ns0:description>
                </ns0:rule>
              </ns0:rules>
            </ns0:selectionEntry>
          </ns0:selectionEntries>
        </ns0:selectionEntryGroup>
      </ns0:selectionEntryGroups>
    </ns0:selectionEntry>
    <ns0:selectionEntry type="unit" name="Legion Centurion" id="hq-centurion" hidden="false" import="true">
      <ns0:constraints>
        <ns0:constraint id="hq-centurion-max" type="max" value="2" field="selections" scope="parent" shared="true" includeChildSelections="false" />
      </ns0:constraints>
      <ns0:costs>
        <ns0:cost name="Points" typeId="pts" value="50" />
      </ns0:costs>
      <ns0:categoryLinks>
        <ns0:categoryLink targetId="cat-hq" id="hq-centurion-foc-cat" primary="true" name="HQ" hidden="false" />
      </ns0:categoryLinks>
      <ns0:profiles>
        <ns0:profile name="Legion Centurion" id="hq-centurion-prof" typeId="prof-model" typeName="Model" hidden="false">
          <ns0:characteristics>
            <ns0:characteristic name="WS" typeId="model-ws">5</ns0:characteristic>
            <ns0:characteristic name="BS" typeId="model-bs">5</ns0:characteristic>
            <ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic>
            <ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic>
            <ns0:characteristic name="W" typeId="model-w">2</ns0:characteristic>
            <ns0:characteristic name="I" typeId="model-i">5</ns0:characteristic>
            <ns0:characteristic name="A" typeId="model-a">3</ns0:characteristic>
            <ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic>
            <ns0:characteristic name="Sv" typeId="model-sv">3+</ns0:characteristic>
          </ns0:characteristics>
        <ns0:modifiers><ns0:modifier type="set" field="model-sv" value="2+" id="r29-cent-sv-forge"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-forge" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" field="model-sv" value="2+/4+" id="r29-cent-sv-null"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-null" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:profile>
      </ns0:profiles>
      <ns0:rules>
        <ns0:rule name="Standard Wargear" id="hq-centurion-std" hidden="false">
          <ns0:description>Power Armour, Bolt Pistol, Chainsword and Frag Grenades.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legiones Astartes" id="hq-centurion-la" hidden="false">
          <ns0:description>The model has the Legiones Astartes special rule, also has And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless unless another rule says otherwise.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Independent Character" id="hq-centurion-ic" hidden="false">
          <ns0:description>Follows the Independent Character rules in ProHammer Classic.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Frag Grenades" id="hq-centurion-frag" hidden="false">
          <ns0:description>Uses the normal ProHammer Frag Grenade and Assault Grenade rules. Against vehicles, Frag Grenades have Strength 4 + D6 Armour Penetration.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Legion Consuls" id="hq-centurion-consulrule" hidden="false">
          <ns0:description>A Legion Centurion may be upgraded to no more than one Consul type. A Consul retains the Centurion profile, wargear, special rules and Armoury access unless stated otherwise. Wargear granted by a Consul is included in its upgrade cost and does not count toward the Armoury allowance. Consul restrictions override normal Centurion options.</ns0:description>
        </ns0:rule>
        <ns0:rule name="Space Marine Armoury" id="hq-centurion-armoury-rule" hidden="false">
          <ns0:description>The Centurion may select up to 100 points of weapons and wargear from the Space Marine Armoury. Armour, Mobility, Weapon Replacements and Additional Wargear all count toward the same 100-point limit. All normal Armoury restrictions apply. Consul-granted wargear is included in the Consul cost and does not count against this allowance.</ns0:description>
        </ns0:rule>
      </ns0:rules>
      <ns0:entryLinks>
        <ns0:entryLink import="true" name="Bolt Pistol" id="hq-centurion-bp" type="selectionEntry" targetId="gear-bolt-pistol" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="hq-centurion-bp-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="hq-centurion-bp-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
        <ns0:entryLink import="true" name="Chainsword" id="hq-centurion-cs" type="selectionEntry" targetId="gear-chainsword" hidden="false" defaultAmount="1">
          <ns0:constraints>
            <ns0:constraint id="hq-centurion-cs-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
            <ns0:constraint id="hq-centurion-cs-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
          </ns0:constraints>
        </ns0:entryLink>
      <ns0:entryLink id="r43-hq-centurion-ec-spear" name="Phoenix Spear" type="selectionEntry" targetId="r43-ec-phoenix-spear" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-ec-spear-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-ec-lasers" name="Digital Lasers" type="selectionEntry" targetId="r43-ec-digital-lasers" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-ec-lasers-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-ec-shrieker" name="Sonic Shrieker" type="selectionEntry" targetId="r43-ec-sonic-shrieker" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-ec-shrieker-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iii" shared="true" includeChildSelections="true" includeChildForces="false" /><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="allegiance-traitor" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-iw-servo" name="Servo-Arm" type="selectionEntry" targetId="r43-iw-servo-arm" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-iw-servo-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-iw-bionics" name="Bionics" type="selectionEntry" targetId="r43-iw-bionics" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-iw-bionics-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-iv" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-ws-glaive" name="Power Glaive" type="selectionEntry" targetId="r43-ws-power-glaive" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-ws-glaive-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-ws-lance" name="Chogorian Warlance" type="selectionEntry" targetId="r43-ws-warlance" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-ws-lance-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-frost-weapon" name="Frost Weapon" type="selectionEntry" targetId="r43-sw-frost-weapon" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-frost-weapon-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-great-frost-blade" name="Great Frost Blade" type="selectionEntry" targetId="r43-sw-great-frost-blade" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-great-frost-blade-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-wolf-pelt" name="Wolf Pelt" type="selectionEntry" targetId="r43-sw-wolf-pelt" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-wolf-pelt-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-wolf-tooth-necklace" name="Wolf Tooth Necklace" type="selectionEntry" targetId="r43-sw-wolf-tooth-necklace" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-wolf-tooth-necklace-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-wolf-tail-talisman" name="Wolf Tail Talisman" type="selectionEntry" targetId="r43-sw-wolf-tail-talisman" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-wolf-tail-talisman-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink><ns0:entryLink id="r43-hq-centurion-r43-sw-runic-armour" name="Runic Armour" type="selectionEntry" targetId="r43-sw-runic-armour" hidden="true" import="true"><ns0:constraints><ns0:constraint id="r43-hq-centurion-r43-sw-runic-armour-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:constraints><ns0:modifiers><ns0:modifier type="set" value="false" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:entryLink></ns0:entryLinks>
      <ns0:selectionEntryGroups>
        <ns0:selectionEntryGroup name="Legion Consul Upgrade" id="hq-centurion-consuls" hidden="false">
          <ns0:constraints>
            <ns0:constraint id="hq-centurion-consuls-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" />
          </ns0:constraints>
          <ns0:selectionEntries>
            <ns0:selectionEntry type="upgrade" name="Legion Chaplain Consul" id="hq-consul-chaplain" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-chaplain-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="35" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Chaplain Consul" id="hq-consul-chaplain-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Chaplain Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Honour of the Legion" id="r29-chap-honour" hidden="false"><ns0:description>The Chaplain and any unit he has joined have the Fearless special rule.</ns0:description></ns0:rule><ns0:rule name="Liturgies of Battle" id="r29-chap-liturgies" hidden="false"><ns0:description>In a player turn in which the Chaplain and a unit he has joined successfully charge, the Chaplain and all models in that unit may re-roll failed To Hit rolls in close combat for that Assault phase.</ns0:description></ns0:rule></ns0:rules>
            <ns0:entryLinks><ns0:entryLink import="true" name="Crozius Arcanum" id="r29-chap-crozius" type="selectionEntry" targetId="r29-gear-crozius" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-chap-crozius-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-chap-crozius-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink><ns0:entryLink import="true" name="Rosarius" id="r29-chap-rosarius" type="selectionEntry" targetId="r29-gear-rosarius" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-chap-rosarius-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-chap-rosarius-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier></ns0:modifiers></ns0:selectionEntry>
            <ns0:selectionEntry type="upgrade" name="Legion Librarian Consul" id="hq-consul-librarian" hidden="false" import="true">
              <ns0:constraints>
                <ns0:constraint id="hq-consul-librarian-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </ns0:constraints>
              <ns0:costs>
                <ns0:cost name="Points" typeId="pts" value="25" />
              </ns0:costs>
              <ns0:rules>
                <ns0:rule name="Legion Librarian Consul" id="hq-consul-librarian-rule" hidden="false">
                  <ns0:description>This Centurion is upgraded to Legion Librarian Consul. Granted wargear and special rules are shown separately below.</ns0:description>
                </ns0:rule>
              <ns0:rule name="Psyker (Mastery Level 1)" id="r29-lib-psyker" hidden="false"><ns0:description>The Librarian is a Psyker with Mastery Level 1 and follows the ProHammer Classic psychic rules.</ns0:description></ns0:rule><ns0:rule name="Legion Support Officer" id="r29-lib-support" hidden="false"><ns0:description>May not fulfil the compulsory HQ selection unless another rule specifically permits it.</ns0:description></ns0:rule><ns0:rule name="Psychic Powers" id="r29-lib-powers" hidden="false"><ns0:description>Select powers from Biomancy, Divination, Pyromancy, Telekinesis or Telepathy. Daemonology is not available. ProHammer allows powers to be chosen rather than randomly generated.</ns0:description></ns0:rule></ns0:rules>
              <ns0:selectionEntries>
                <ns0:selectionEntry type="upgrade" name="Epistolary — Mastery Level 2" id="hq-consul-librarian-epistolary" hidden="false" import="true">
                  <ns0:constraints>
                    <ns0:constraint id="hq-consul-librarian-epistolary-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </ns0:constraints>
                  <ns0:costs>
                    <ns0:cost name="Points" typeId="pts" value="25" />
                  </ns0:costs>
                </ns0:selectionEntry>
              </ns0:selectionEntries>
            <ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Psychic Discipline(s)" id="r29-lib-discipline-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-lib-discipline-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-lib-discipline-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Biomancy" id="r29-lib-discipline-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-discipline-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Biomancy" id="r29-lib-discipline-0-rule" hidden="false"><ns0:description>This Psyker may select powers from the Biomancy discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Divination" id="r29-lib-discipline-1" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-discipline-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Divination" id="r29-lib-discipline-1-rule" hidden="false"><ns0:description>This Psyker may select powers from the Divination discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Pyromancy" id="r29-lib-discipline-2" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-discipline-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Pyromancy" id="r29-lib-discipline-2-rule" hidden="false"><ns0:description>This Psyker may select powers from the Pyromancy discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Telekinesis" id="r29-lib-discipline-3" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-discipline-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Telekinesis" id="r29-lib-discipline-3-rule" hidden="false"><ns0:description>This Psyker may select powers from the Telekinesis discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Telepathy" id="r29-lib-discipline-4" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-discipline-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Telepathy" id="r29-lib-discipline-4-rule" hidden="false"><ns0:description>This Psyker may select powers from the Telepathy discipline as permitted by its Consul entry and ProHammer Classic.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:modifiers><ns0:modifier type="set" value="2" field="r29-lib-discipline-max"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian-epistolary" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntryGroup><ns0:selectionEntryGroup name="Psychic Powers" id="r29-lib-power-group" hidden="false"><ns0:constraints><ns0:constraint id="r29-lib-power-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /><ns0:constraint id="r29-lib-power-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="true" /></ns0:constraints><ns0:selectionEntries><ns0:selectionEntry type="upgrade" name="Smite" id="r29-lib-power-0" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-0-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Smite" id="r29-lib-power-0-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 4</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Smite" id="r29-lib-power-0-rule" hidden="false"><ns0:description>Witchfire. Range 18”, S4 AP2 Assault 4.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Iron Arm" id="r29-lib-power-1" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-1-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Iron Arm" id="r29-lib-power-1-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Adds +2 Strength and +1 Toughness.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Enfeeble" id="r29-lib-power-2" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-2-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Enfeeble" id="r29-lib-power-2-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. -1 Strength and Toughness; treats all movement as Difficult Terrain.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Life Leech" id="r29-lib-power-3" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-3-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Life Leech" id="r29-lib-power-3-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">2</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Life Leech" id="r29-lib-power-3-rule" hidden="false"><ns0:description>Witchfire. Range 18”, S6 AP2 Assault 2. If it causes at least one unsaved Wound, a model within 6” of the Psyker regains a Wound.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Warp Speed" id="r29-lib-power-4" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-4-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Warp Speed" id="r29-lib-power-4-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Adds +3 Initiative and +3 Attacks and grants Fleet.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Endurance" id="r29-lib-power-5" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-5-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Endurance" id="r29-lib-power-5-rule" hidden="false"><ns0:description>Blessing — friendly unit within 24”. The unit gains Eternal Warrior, Feel No Pain (5+) and Relentless.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Haemorrhage" id="r29-lib-power-6" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-6-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Haemorrhage" id="r29-lib-power-6-rule" hidden="false"><ns0:description>Focused Witchfire — range 18”. Resolve the ProHammer Haemorrhage Toughness-test chain effect.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-0" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Prescience" id="r29-lib-power-7" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-7-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Prescience" id="r29-lib-power-7-rule" hidden="false"><ns0:description>Blessing — friendly unit within 12”. Re-roll all failed To Hit rolls.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Foreboding" id="r29-lib-power-8" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-8-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Foreboding" id="r29-lib-power-8-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit gain Counter-Attack and may fire reaction fire using the full number of allowed shots.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Forewarning" id="r29-lib-power-9" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-9-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Forewarning" id="r29-lib-power-9-rule" hidden="false"><ns0:description>Blessing — friendly unit within 12”. Unit gains a 4+ Invulnerable Save.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Perfect Timing" id="r29-lib-power-10" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-10-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Perfect Timing" id="r29-lib-power-10-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit ignore Cover when shooting.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Precognition" id="r29-lib-power-11" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-11-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Precognition" id="r29-lib-power-11-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Re-roll failed To Hit, To Wound and Saving Throw rolls as described in ProHammer.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Misfortune" id="r29-lib-power-12" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-12-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Misfortune" id="r29-lib-power-12-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. Attacks against the target count as Rending.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Scrier’s Gaze" id="r29-lib-power-13" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-13-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Scrier’s Gaze" id="r29-lib-power-13-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Apply the ProHammer Reserve, Outflank and mystery-objective re-roll benefits.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-1" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Flame Breath" id="r29-lib-power-14" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-14-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Flame Breath" id="r29-lib-power-14-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">Template</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">5</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">4</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Soul Blaze</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Flame Breath" id="r29-lib-power-14-rule" hidden="false"><ns0:description>Witchfire. Template, S5 AP4 Assault 1, Soul Blaze.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Fiery Form" id="r29-lib-power-15" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-15-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Fiery Form" id="r29-lib-power-15-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Gains a 4+ Invulnerable Save; melee attacks cause Soul Blaze; re-roll failed Wounds inflicted by other Pyromancy powers.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Molton Beam" id="r29-lib-power-16" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-16-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Molton Beam" id="r29-lib-power-16-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">8</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Melta</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Molton Beam" id="r29-lib-power-16-rule" hidden="false"><ns0:description>Beam. Range 12”, S8 AP1 Assault 1, Melta.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Fire Shield" id="r29-lib-power-17" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-17-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Fire Shield" id="r29-lib-power-17-rule" hidden="false"><ns0:description>Blessing — friendly unit within 24”. Gains a 4+ Cover Save; enemy units within 6” treat all terrain, including open ground, as Dangerous Terrain.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Sunburst" id="r29-lib-power-18" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-18-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Sunburst" id="r29-lib-power-18-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">9”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2D6, Ignores Cover, Soul Blaze</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Sunburst" id="r29-lib-power-18-rule" hidden="false"><ns0:description>Nova. Range 9”, S4 AP5 Assault 2D6, Ignores Cover, Soul Blaze.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Inferno" id="r29-lib-power-19" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-19-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Inferno" id="r29-lib-power-19-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">24”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">5</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Large Blast, Ignores Cover, Soul Blaze</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Inferno" id="r29-lib-power-19-rule" hidden="false"><ns0:description>Witchfire. Range 24”, S4 AP5 Assault 1, Large Blast, Ignores Cover, Soul Blaze.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Spontaneous Combustion" id="r29-lib-power-20" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-20-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Spontaneous Combustion" id="r29-lib-power-20-rule" hidden="false"><ns0:description>Focused Witchfire — range 18”. Resolve the S6 AP3 Soul Blaze hit and secondary blast as described in ProHammer.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-2" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Assail" id="r29-lib-power-21" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-21-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Assail" id="r29-lib-power-21-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">18”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">6</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">–</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Strikedown</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Assail" id="r29-lib-power-21-rule" hidden="false"><ns0:description>Beam. Range 18”, S6 AP– Assault 1, Strikedown.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Crush" id="r29-lib-power-22" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-22-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Crush" id="r29-lib-power-22-rule" hidden="false"><ns0:description>Focused Witchfire — range 18”. Roll 2D6 for the hit’s Strength and another D6 for AP.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Objuration Mechanicum" id="r29-lib-power-23" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-23-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Objuration Mechanicum" id="r29-lib-power-23-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. Target ranged weapons gain Gets Hot; Vehicles suffer an immediate Haywire hit.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Shockwave" id="r29-lib-power-24" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-24-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Shockwave" id="r29-lib-power-24-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">9”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">4</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">–</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 2D6, Pinning</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Shockwave" id="r29-lib-power-24-rule" hidden="false"><ns0:description>Nova. Range 9”, S4 AP– Assault 2D6, Pinning.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Levitation" id="r29-lib-power-25" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-25-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Levitation" id="r29-lib-power-25-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and joined unit immediately move up to 12”; cannot charge that turn and count as having moved.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Telekine Dome" id="r29-lib-power-26" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-26-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Telekine Dome" id="r29-lib-power-26-rule" hidden="false"><ns0:description>Blessing — targets Psyker. Psyker and all friendly models within 12” gain a 5+ Invulnerable Save against shooting attacks.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Psychic Maelstrom" id="r29-lib-power-27" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-27-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:profiles><ns0:profile name="Psychic Maelstrom" id="r29-lib-power-27-profile" typeId="prof-ranged" typeName="Ranged Weapon" hidden="false"><ns0:characteristics><ns0:characteristic name="Range" typeId="ranged-range">12”</ns0:characteristic><ns0:characteristic name="S" typeId="ranged-s">10</ns0:characteristic><ns0:characteristic name="AP" typeId="ranged-ap">1</ns0:characteristic><ns0:characteristic name="Type" typeId="ranged-type">Assault 1, Barrage, Large Blast</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Psychic Maelstrom" id="r29-lib-power-27-rule" hidden="false"><ns0:description>Witchfire. Range 12”, S10 AP1 Assault 1, Barrage, Large Blast.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-3" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Psychic Shriek" id="r29-lib-power-28" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-28-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Psychic Shriek" id="r29-lib-power-28-rule" hidden="false"><ns0:description>Witchfire — range 18”. Roll 3D6 and subtract target Leadership; target suffers Wounds equal to the result with no Armour or Cover Saves.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Dominate" id="r29-lib-power-29" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-29-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Dominate" id="r29-lib-power-29-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. Target must pass a Leadership test whenever it attempts to move, Advance, shoot, charge or use a psychic power.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Mental Fortitude" id="r29-lib-power-30" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-30-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Mental Fortitude" id="r29-lib-power-30-rule" hidden="false"><ns0:description>Blessing — friendly unit within 24”. If Falling Back, immediately Regroups; target gains Fearless.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Terrify" id="r29-lib-power-31" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-31-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Terrify" id="r29-lib-power-31-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. -1 Leadership; treats opposing units as causing Fear; must take a Casualty Test at end of turn.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Hallucination" id="r29-lib-power-32" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-32-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Hallucination" id="r29-lib-power-32-rule" hidden="false"><ns0:description>Malediction — enemy unit within 24”. Roll a D6 and apply the ProHammer Hallucination result.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Invisibility" id="r29-lib-power-33" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-33-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Invisibility" id="r29-lib-power-33-rule" hidden="false"><ns0:description>Blessing — friendly unit within 24”. Opposing units suffer -1 To Hit with ranged and melee attacks against the target.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry><ns0:selectionEntry type="upgrade" name="Shrouding" id="r29-lib-power-34" hidden="false" import="true"><ns0:constraints><ns0:constraint id="r29-lib-power-34-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints><ns0:rules><ns0:rule name="Shrouding" id="r29-lib-power-34-rule" hidden="false"><ns0:description>Blessing — targets Psyker. All friendly models within 6” gain Shrouded.</ns0:description></ns0:rule></ns0:rules><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="root-entry" childId="r29-lib-discipline-4" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntry></ns0:selectionEntries><ns0:modifiers><ns0:modifier type="set" value="2" field="r29-lib-power-min"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian-epistolary" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="2" field="r29-lib-power-max"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="root-entry" childId="hq-consul-librarian-epistolary" shared="true" includeChildSelections="true" /></ns0:conditions></ns0:modifier></ns0:modifiers></ns0:selectionEntryGroup></ns0:selectionEntryGroups><ns0:entryLinks><ns0:entryLink import="true" name="Force Weapon" id="r29-lib-force" type="selectionEntry" targetId="gear-hq-force" hidden="false" defaultAmount="1"><ns0:constraints><ns0:constraint id="r29-lib-force-min" type="min" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" /><ns0:constraint id="r29-lib-force-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" /></ns0:constraints></ns0:entryLink></ns0:entryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-vi" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" field="selections" scope="roster" childId="legion-v" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:conditionGroup></ns0:conditionGroups></ns0:modifier><ns0:modifier type="set" value="true" field="hidden"><ns0:conditionGroups><ns0:conditionGroup type="and"><ns0:conditions><ns0:condition type="atLeast" value="1" fiel
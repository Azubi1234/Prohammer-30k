            <selectionEntry type="unit" name="Legion Terminator Command Squad" id="hq-praetor-ret-termcommand" hidden="false" import="true">
              <constraints>
                <constraint id="hq-praetor-ret-termcommand-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <costs>
                <cost name="Points" typeId="pts" value="215" />
              </costs>
              <rules>
                <rule name="Standard Wargear" id="hq-praetor-ret-tc-std" hidden="false">
                  <description>Five Terminator Veterans, each equipped with the selected Terminator Armour pattern, a Combi-Bolter and a Power Weapon.</description>
                </rule>
                <rule name="Legiones Astartes" id="hq-praetor-ret-tc-la" hidden="false">
                  <description>Every model has Legiones Astartes and And They Shall Know No Fear as presented in ProHammer Classic, and is not Fearless.</description>
                </rule>
                <rule name="Retinue" id="hq-praetor-ret-tc-ret" hidden="false">
                  <description>May only be selected for an eligible HQ character equipped with Terminator, Tartaros or Cataphractii Terminator Armour. It occupies no separate Force Organisation slot; the character and squad count as one HQ selection but may deploy and operate separately.</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry type="model" name="Terminator Veterans" id="hq-praetor-ret-tc-vets" hidden="false" import="true" defaultAmount="5">
                  <constraints>
                    <constraint id="hq-praetor-ret-tc-vets-min" type="min" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" automatic="true" />
                    <constraint id="hq-praetor-ret-tc-vets-max" type="max" value="5" field="selections" scope="parent" shared="true" includeChildSelections="false" />
                  </constraints>
                  <profiles>

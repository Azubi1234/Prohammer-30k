d may take:</ns0:description></ns0:rule><ns0:rule name="Squad-wide cost note" id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-5-squadwide" hidden="false"><ns0:description>The source prices this option at +5 points per model. The displayed selection charges the parsed base unit only; apply the same per-model surcharge for any additional models selected.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Legion Vexilla" hidden="false" id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-6-legion-vexilla"><ns0:constraints><ns0:constraint id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-6-legion-vexilla-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-6-context" hidden="false"><ns0:description>• One model may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry><ns0:selectionEntry type="upgrade" import="true" name="Nuncio Vox" hidden="false" id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-7-nuncio-vox"><ns0:constraints><ns0:constraint id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-7-nuncio-vox-max" field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="10" /></ns0:costs><ns0:rules><ns0:rule name="Option restriction" id="r42-role-vii-0-effects-warders-of-the-phalanx-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-7-context" hidden="false"><ns0:description>• One other model may carry:</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries></ns0:selectionEntryGroup></ns0:selectionEntryGroups></ns0:selectionEntry><ns0:selectionEntry type="unit" import="true" name="PHALANX WARDER SQUAD" hidden="true" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad"><ns0:costs><ns0:cost name="Points" typeId="pts" value="150" /></ns0:costs><ns0:categoryLinks><ns0:categoryLink id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-cat" name="Troops" hidden="false" targetId="cat-troops" primary="true" /></ns0:categoryLinks><ns0:modifiers><ns0:modifier type="set" value="true" field="hidden"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="legion-vii" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier><ns0:modifier type="set" value="true" field="hidden" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-hide"><ns0:conditions><ns0:condition type="lessThan" value="1" field="selections" scope="roster" childId="r25-rite-vii-1-hammerfall-strike-force" shared="true" includeChildSelections="true" includeChildForces="false" /></ns0:conditions></ns0:modifier></ns0:modifiers><ns0:profiles><ns0:profile name="Phalanx Warder" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-profile-0"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">1</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile><ns0:profile name="Warder Sergeant" typeId="prof-model" typeName="Model" hidden="false" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-profile-1"><ns0:characteristics><ns0:characteristic name="WS" typeId="model-ws">4</ns0:characteristic><ns0:characteristic name="BS" typeId="model-bs">4</ns0:characteristic><ns0:characteristic name="S" typeId="model-s">4</ns0:characteristic><ns0:characteristic name="T" typeId="model-t">4</ns0:characteristic><ns0:characteristic name="W" typeId="model-w">1</ns0:characteristic><ns0:characteristic name="I" typeId="model-i">4</ns0:characteristic><ns0:characteristic name="A" typeId="model-a">2</ns0:characteristic><ns0:characteristic name="Ld" typeId="model-ld">9</ns0:characteristic><ns0:characteristic name="Sv" typeId="model-sv">3+/5+</ns0:characteristic></ns0:characteristics></ns0:profile></ns0:profiles><ns0:rules><ns0:rule name="Source Entry" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-source" hidden="false"><ns0:description>Phalanx Warder | 4 | 4 | 4 | 4 | 1 | 4 | 1 | 9 | 3+/5+
Warder Sergeant | 4 | 4 | 4 | 4 | 1 | 4 | 2 | 9 | 3+/5+
Force Organisation:
• Elites
Unit Composition:
• 4 Phalanx Warders
• 1 Warder Sergeant
Unit Type:
• Infantry
• The Warder Sergeant is a Character
Wargear:
• Power Armour
• Boarding Shield
• Bolter
• Power weapon
Special Rules:
• Legiones Astartes (Imperial Fists)
• Stubborn
• Counter-Attack
OPTIONS
• The squad may include up to five additional Phalanx Warders for +28 points per model.
• For every five models, one Phalanx Warder may replace his
Bolter with:
• Flamer ............................................ +5 points
• Meltagun ......................................... +10 points
• Plasma gun ....................................... +15 points
• The entire squad may take:
• Frag grenades ............................... +1 point per model
• Krak grenades .............................. +2 points per model
• Melta bombs ................................ +5 points per model
• One model may carry:
• Legion Vexilla ................................... +10 points
• One other model may carry:
• Nuncio Vox ...................................... +10 points
WARDER SERGEANT
The Warder Sergeant may select up to 50 points of permitted weapons and wargear from the Space Marine Armoury.
DEDICATED TRANSPORT
The squad may select a Rhino, Dreadclaw Drop Pod or Land Raider where Transport Capacity permits.</ns0:description></ns0:rule><ns0:rule id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-rite-note" name="Rite of War Interaction" hidden="false"><ns0:description>Originally devised for forces deployed from the Phalanx, the Hammerfall Strike Force concentrates elite ship-borne formations for sudden teleport assaults into the heart of the enemy position.
EFFECTS
LANDING FORCE
Phalanx Warder Squads may be selected as Troops choices.
They may fulfil compulsory Troops selections.
TELEPORT ARRAY
Any Imperial Fists Infantry unit may purchase Teleportation Transponders for +15 points per unit.
An Imperial Fists Independent Character may purchase Teleportation Transponders for +10 points.
This overrides the normal restriction limiting Teleportation Transponders to models wearing Terminator Armour.
A unit equipped with Teleportation Transponders may deploy using Deep Strike even if the mission would not normally permit Deep Strike.
An Independent Character intending to Deep Strike as part of another unit must purchase Teleportation Transponders separately.
BLINDING LUMINESCENCE
An Imperial Fists unit arriving by Deep Strike using Teleportation Transponders gains the Shrouded special rule from the moment it is placed on the battlefield until the beginning of its next player turn.
After the unit has been placed, every enemy unit with at least one model:
• within 12" of the arriving unit; and
• with line of sight to at least one model in the arriving unit
must immediately take an Initiative test. If the test is failed, that enemy unit suffers the effects of the Blind special rule:
• Weapon Skill 1
• Ballistic Skill 1
until the end of its next player turn.
Each enemy unit only makes one such test per arriving Imperial Fists unit.
LIMITATIONS
The army's Warlord must be equipped with Teleportation Transponders.
Every Vehicle in the Detachment must begin the battle in Reserve.
The Detachment may not include a Fortification.</ns0:description></ns0:rule><ns0:rule id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-clone-cleanup" name="Builder compatibility" hidden="false"><ns0:description>Removed 1 obsolete armoury link(s) inherited from the generic source entry while creating this Rite-specific battlefield-role copy.</ns0:description></ns0:rule></ns0:rules><ns0:selectionEntries><ns0:selectionEntry type="model" import="true" name="Additional model" hidden="false" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-additional"><ns0:constraints><ns0:constraint id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-additional-max" field="selections" scope="parent" value="5" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" type="max" /></ns0:constraints><ns0:costs><ns0:cost name="Points" typeId="pts" value="28" /></ns0:costs><ns0:rules><ns0:rule name="Additional model" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-additional-rule" hidden="false"><ns0:description>May include up to 5 additional models at +28 points each, as stated in the source entry.</ns0:description></ns0:rule></ns0:rules></ns0:selectionEntry></ns0:selectionEntries><ns0:selectionEntryGroups><ns0:selectionEntryGroup name="Options" hidden="false" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-options" collective="false" import="true"><ns0:selectionEntries><ns0:selectionEntry type="upgrade" import="true" name="Flamer" hidden="false" id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-0-flamer"><ns0:constraints><ns0:constraint id="r42-role-vii-1-effects-landing-force-phalanx-warder-squads-r41-unit-vii-1-phalanx-warder-squad-opt-0-flamer-max" field="selections" scope="parent" value="2" p
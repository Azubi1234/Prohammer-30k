          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Terminator Armour" hidden="false" id="terminator-armour-normal" defaultAmount="1">
              <constraints>
                <constraint id="terminator-armour-normal-max" type="max" value="1" field="selections" scope="parent" shared="true" includeChildSelections="false" />
              </constraints>
              <rules>
                <rule name="Terminator Armour" id="terminator-armour-normal-rule" hidden="false">
                  <description>2+ Armour Save, 5+ Invulnerable Save; Relentless, Bulky, Deep Strike; may not Pursue. Models in any form of Terminator Armour may not embark upon Rhinos or Drop Pods.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tartaros Terminator Armour" hidden="false" id="terminator-armour-tartaros">
              <constraints>
